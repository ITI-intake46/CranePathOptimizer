<Window x:Class="WPF_IFC_test1.Dialogs.LoadChartViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saved Load Charts"
        Width="860" Height="580"
        MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#1A1B2D">

    <Window.Resources>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6D9A"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>

        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0C4E8"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"    Value="#222340"/>
            <Setter Property="Foreground"    Value="#8082AC"/>
            <Setter Property="BorderBrush"   Value="#2E3058"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="14,0"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Height"        Value="34"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2C50"/>
                    <Setter Property="Foreground" Value="#AAAACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#161728" Padding="18,12">
            <StackPanel>
                <TextBlock Text="📋  Saved Load Charts"
                           Foreground="#D8DAF2" FontSize="15" FontWeight="Bold"/>
                <TextBlock Foreground="#383A5E" FontSize="11" Margin="0,2,0,0"
                           Text="Click a chart on the left to view its saved dimensions and data."/>
            </StackPanel>
        </Border>

        <!-- ══ Main ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Chart List ──────────────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search box -->
                <Border Grid.Row="0" Background="#14152A" BorderBrush="#2A2B48"
                        BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                    <TextBox x:Name="TxtSearch"
                             Background="Transparent" Foreground="#C0C4E8"
                             BorderThickness="0" Padding="8,6"
                             CaretBrush="#C0C4E8"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Foreground="#30315A" FontSize="10"
                                                                   FontStyle="Italic" Margin="10,0,0,0"
                                                                   Text="🔍  Search cranes..."/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>

                <!-- List -->
                <Border Grid.Row="1" BorderBrush="#1E2040" BorderThickness="1" CornerRadius="5"
                        Background="#0E0F20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChartListPanel" Margin="0,4"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ── Right: Detail Panel ───────────────────────────────────── -->
            <Grid Grid.Column="2">

                <!-- Empty state -->
                <Border x:Name="DetailEmpty"
                        BorderBrush="#18193A" BorderThickness="1"
                        CornerRadius="6" Background="#0E0F20"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="42" HorizontalAlignment="Center" Opacity="0.18"/>
                        <TextBlock Text="Select a chart on the left"
                                   Foreground="#1E2040" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBlock Text="to view its saved data"
                                   Foreground="#181930" FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Detail content -->
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel Margin="0,0,4,0">

                        <!-- ── Title bar ─────────────────────────────────────── -->
                        <Border Background="#0C0D1E" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DetailModel"
                                               Foreground="#D8DAF2" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock x:Name="DetailManufacturer"
                                               Foreground="#4A4C78" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Border x:Name="DetailCatBadge"
                                            CornerRadius="4" Padding="8,3">
                                        <TextBlock x:Name="DetailCategory"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock x:Name="DetailImportDate"
                                               Foreground="#2A3050" FontSize="9"
                                               HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── Two-column section ──────────────────────────── -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: Chart config -->
                            <Border Grid.Column="0" Background="#080A1C" CornerRadius="6"
                                    BorderBrush="#1A2040" BorderThickness="1" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="CHART CONFIGURATION" Foreground="#222450"
                                               FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>

                                    <TextBlock Text="Chart Type" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="DetailChartType" Style="{StaticResource Val}"/>

                                    <TextBlock Text="Outrigger Config" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="DetailOutrigger" Style="{StaticResource Val}"/>

                                    <TextBlock Text="Counterweight" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="DetailCounterweight" Style="{StaticResource Val}"/>

                                    <TextBlock Text="Crane Derating" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="DetailDerating" Style="{StaticResource Val}"/>

                                    <TextBlock Text="Import Method" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="DetailMethod" Style="{StaticResource Val}"/>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT: Physical dimensions -->
                            <Border Grid.Column="2" Background="#080A1C" CornerRadius="6"
                                    BorderBrush="#1A2040" BorderThickness="1" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="PHYSICAL DIMENSIONS" Foreground="#222450"
                                               FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>

                                    <TextBlock Text="L  Total Length" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="DetailLength" Style="{StaticResource Val}"/>

                                    <TextBlock Text="H  Transport Height" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="DetailHeight" Style="{StaticResource Val}"/>

                                    <TextBlock Text="W  Outrigger Span (pad-to-pad)" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="DetailOutriggerSpan" Style="{StaticResource Val}"/>

                                    <TextBlock Text="B  Span to Span (front-rear)" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="DetailSpanToSpan" Style="{StaticResource Val}"/>

                                    <TextBlock Text="Bounding Radius" Style="{StaticResource Lbl}"/>
                                    <TextBlock x:Name="DetailBoundingRadius" Style="{StaticResource Val}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ── Capacity summary ───────────────────────────── -->
                        <Border Background="#080A1C" CornerRadius="6"
                                BorderBrush="#1A2040" BorderThickness="1"
                                Padding="12,10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="DATA POINTS" Foreground="#222450"
                                               FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DetailPointCount"
                                               Foreground="#4A8AB8" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Fill="#1A2040" Width="1" Margin="0,4"/>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="MAX CAPACITY" Foreground="#222450"
                                               FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DetailMaxCap"
                                               Foreground="#3AAA5A" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Rectangle Grid.Column="3" Fill="#1A2040" Width="1" Margin="0,4"/>
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="MAX RADIUS" Foreground="#222450"
                                               FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DetailMaxRadius"
                                               Foreground="#9A7A3A" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- ══ Bottom Bar ════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0C0D1E" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus"
                           Foreground="#2A3A4A" FontSize="10"
                           VerticalAlignment="Center"
                           Text="Loading saved charts..."/>
                <Button x:Name="BtnEdit"
                        Grid.Column="1" Content="✏ Edit"
                        Style="{StaticResource SecBtn}"
                        Width="90" IsEnabled="False"
                        Click="BtnEdit_Click"
                        ToolTip="Re-open this chart in the import dialog for editing"/>
                <Button x:Name="BtnDelete"
                        Grid.Column="3" Content="🗑 Delete"
                        Width="90" Height="34" IsEnabled="False"
                        Background="#3A1215" Foreground="#E05A60"
                        BorderBrush="#5A2025" BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnDelete_Click"
                        ToolTip="Permanently delete this chart from the database"/>
                <Button Grid.Column="5" Content="Close"
                        Style="{StaticResource SecBtn}"
                        Width="80" Click="CloseBtn_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window>
