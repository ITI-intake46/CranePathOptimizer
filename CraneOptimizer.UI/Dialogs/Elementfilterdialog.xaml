<Window x:Class="WPF_IFC_test1.Dialogs.ElementFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter &amp; Sort Elements"
        Width="680" MinWidth="560"
        Height="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#1E1E1E"
        Foreground="#CCCCCC"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>

        <!-- ── Colour palette ──────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgBrush"      Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Surf1"        Color="#252526"/>
        <SolidColorBrush x:Key="Surf2"        Color="#2D2D30"/>
        <SolidColorBrush x:Key="Surf3"        Color="#3E3E42"/>
        <SolidColorBrush x:Key="BorderBr"     Color="#3F3F46"/>
        <SolidColorBrush x:Key="AccentBr"     Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentLight"  Color="#4FC3F7"/>
        <SolidColorBrush x:Key="TextBr"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecBr"    Color="#AAAAAA"/>
        <SolidColorBrush x:Key="SuccessBr"    Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarnBr"       Color="#F39C12"/>
        <SolidColorBrush x:Key="DangerBr"     Color="#E74C3C"/>

        <!-- ── Section header ─────────────────────────────────────────────── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#4FC3F7"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
        </Style>

        <!-- ── Label ─────────────────────────────────────────────────────── -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Text input ────────────────────────────────────────────────── -->
        <Style x:Key="TextInput" TargetType="TextBox">
            <Setter Property="Background"          Value="#2D2D30"/>
            <Setter Property="Foreground"          Value="#FFFFFF"/>
            <Setter Property="CaretBrush"          Value="#FFFFFF"/>
            <Setter Property="BorderBrush"         Value="#3F3F46"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="Padding"             Value="8,5"/>
            <Setter Property="FontSize"            Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── CheckBox ──────────────────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"   Value="#CCCCCC"/>
            <Setter Property="Margin"       Value="0,2"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── RadioButton ───────────────────────────────────────────────── -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"   Value="#CCCCCC"/>
            <Setter Property="Margin"       Value="0,3"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── ComboBox ──────────────────────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"       Value="#2D2D30"/>
            <Setter Property="Foreground"       Value="#CCCCCC"/>
            <Setter Property="BorderBrush"      Value="#3F3F46"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="6,4"/>
            <Setter Property="FontSize"         Value="11"/>
        </Style>

        <!-- ── Separator ─────────────────────────────────────────────────── -->
        <Style x:Key="HSep" TargetType="Rectangle">
            <Setter Property="Height"  Value="1"/>
            <Setter Property="Fill"    Value="#3F3F46"/>
            <Setter Property="Margin"  Value="0,10"/>
        </Style>

        <!-- ── Action button ─────────────────────────────────────────────── -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"       Value="#007ACC"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="20,8"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E8BBF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005F9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary button ──────────────────────────────────────────── -->
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"       Value="#3E3E42"/>
            <Setter Property="Foreground"       Value="#CCCCCC"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="BorderBrush"      Value="#555"/>
            <Setter Property="Padding"          Value="16,8"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Danger button ──────────────────────────────────────────────── -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource SecBtn}">
            <Setter Property="Background"  Value="#3A1414"/>
            <Setter Property="Foreground"  Value="#E74C3C"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
        </Style>

        <!-- ── Tag chip ───────────────────────────────────────────────────── -->
        <Style x:Key="FilterTag" TargetType="Border">
            <Setter Property="Background"       Value="#0D3F5C"/>
            <Setter Property="BorderBrush"      Value="#007ACC"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="10"/>
            <Setter Property="Padding"          Value="8,3"/>
            <Setter Property="Margin"           Value="0,0,4,4"/>
        </Style>

        <!-- ── Scroll bar minimal ────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- ── Tab styling ───────────────────────────────────────────────── -->
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Background"   Value="#252526"/>
            <Setter Property="Foreground"   Value="#AAAAAA"/>
            <Setter Property="BorderBrush"  Value="#3F3F46"/>
            <Setter Property="Padding"      Value="14,6"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolVis"/>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title bar -->
            <RowDefinition Height="Auto"/>
            <!-- Active filter tags -->
            <RowDefinition Height="*"/>
            <!-- Tab content -->
            <RowDefinition Height="Auto"/>
            <!-- Result summary -->
            <RowDefinition Height="Auto"/>
            <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             Title bar
        ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#252526"
                BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Filter &amp; Sort Elements" Foreground="White"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSubtitle" Foreground="#888" FontSize="11" Margin="0,1,0,0"
                                   Text="No model loaded"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource SecBtn}" Padding="8,4" FontSize="11"
                        Click="BtnResetAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕ " Foreground="#E74C3C"/>
                        <TextBlock Text="Clear All Filters"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Active filter tags strip
        ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#252526" Padding="12,6,12,6"
                BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Active Filters:" Foreground="#777" FontSize="10"
                           Margin="0,0,0,4"
                           Visibility="{Binding ElementName=TagsPanel, Path=Children.Count,
                                                Converter={StaticResource BoolVis}}"/>
                <WrapPanel x:Name="TagsPanel" Orientation="Horizontal"/>
                <TextBlock Text="No active filters — showing all elements" Foreground="#555"
                           FontSize="10" FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=TagsPanel,
                                                      Path=Children.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Tab content
        ════════════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="2" Background="#1E1E1E" BorderBrush="#3F3F46"
                    BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabItemStyle}"/>
            </TabControl.Resources>

            <!-- ── Tab 1: Filters ───────────────────────────────────────── -->
            <TabItem Header="🔍  Filters">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="#1E1E1E" Padding="0">
                    <StackPanel Margin="16,14,16,16">

                        <!-- Search -->
                        <TextBlock Text="SEARCH" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSearch" Style="{StaticResource TextInput}"
                                     TextChanged="TxtSearch_TextChanged"
                                     Tag="Search by name, type, mark, material…"/>
                            <Button Grid.Column="1" Style="{StaticResource SecBtn}"
                                    Padding="8,5" Margin="4,0,0,0" FontSize="11"
                                    Click="BtnClearSearch_Click" ToolTip="Clear search">
                                <TextBlock Text="✕" Foreground="#AAA"/>
                            </Button>
                        </Grid>
                        <!-- Placeholder text -->
                        <TextBlock IsHitTestVisible="False" Foreground="#555"
                                   FontStyle="Italic" FontSize="11" Margin="10,-22,0,0"
                                   VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TxtSearch, Path=Text}"
                                                     Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            Search by name, type, mark, material…
                        </TextBlock>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Element types -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ELEMENT TYPES" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SecBtn}" Padding="8,3" FontSize="10"
                                        Margin="0,0,4,0" Click="BtnSelectAllTypes_Click">All</Button>
                                <Button Style="{StaticResource SecBtn}" Padding="8,3" FontSize="10"
                                        Click="BtnClearAllTypes_Click">None</Button>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="TypesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Tag="{Binding TypeName}"
                                              Width="185" Margin="0,1,8,1"
                                              Checked="TypeFilter_Changed"
                                              Unchecked="TypeFilter_Changed"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Materials -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MATERIALS" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SecBtn}" Padding="8,3" FontSize="10"
                                        Margin="0,0,4,0" Click="BtnSelectAllMaterials_Click">All</Button>
                                <Button Style="{StaticResource SecBtn}" Padding="8,3" FontSize="10"
                                        Click="BtnClearAllMaterials_Click">None</Button>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="MaterialsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Tag="{Binding TypeName}"
                                              Width="185" Margin="0,1,8,1"
                                              Checked="MaterialFilter_Changed"
                                              Unchecked="MaterialFilter_Changed"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtNoMaterials" Text="No material data in model"
                                   Foreground="#555" FontStyle="Italic" FontSize="11"
                                   Visibility="Collapsed"/>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Weight range -->
                        <TextBlock Text="WEIGHT RANGE (kg)" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Text="Min" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtWeightMin" Style="{StaticResource TextInput}"
                                     Text="0" Margin="0,0,8,0" TextChanged="WeightRange_Changed"/>
                            <TextBlock Grid.Column="2" Text="Max" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" x:Name="TxtWeightMax" Style="{StaticResource TextInput}"
                                     TextChanged="WeightRange_Changed"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                       x:Name="TxtWeightRange" Foreground="#666" FontSize="10"
                                       Margin="0,4,0,0"/>
                        </Grid>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Height range -->
                        <TextBlock Text="HEIGHT RANGE (m)" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Min" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtHeightMin" Style="{StaticResource TextInput}"
                                     Text="0" Margin="0,0,8,0" TextChanged="HeightRange_Changed"/>
                            <TextBlock Grid.Column="2" Text="Max" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" x:Name="TxtHeightMax" Style="{StaticResource TextInput}"
                                     TextChanged="HeightRange_Changed"/>
                        </Grid>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Only selected -->
                        <CheckBox x:Name="ChkOnlySelected"
                                  Content="Show only currently selected elements"
                                  Foreground="#CCCCCC" FontSize="12"
                                  Checked="OnlySelected_Changed" Unchecked="OnlySelected_Changed"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 2: Sort & Group ──────────────────────────────────── -->
            <TabItem Header="⇅  Sort &amp; Group">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
                    <StackPanel Margin="16,14,16,16">

                        <!-- Sort -->
                        <TextBlock Text="SORT BY" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbSortField" Margin="0,0,8,0"
                                      SelectionChanged="Sort_Changed">
                                <ComboBoxItem Content="Name (A → Z)"         Tag="Name"/>
                                <ComboBoxItem Content="Type (A → Z)"         Tag="Type"/>
                                <ComboBoxItem Content="Weight ↑ (light first)" Tag="WeightAsc"/>
                                <ComboBoxItem Content="Weight ↓ (heavy first)" Tag="WeightDesc"/>
                                <ComboBoxItem Content="Height ↑ (short first)" Tag="HeightAsc"/>
                                <ComboBoxItem Content="Height ↓ (tall first)"  Tag="HeightDesc"/>
                                <ComboBoxItem Content="Mark / Tag"           Tag="Mark"/>
                            </ComboBox>
                            <CheckBox Grid.Column="1" x:Name="ChkSortDesc"
                                      Content="Descending" VerticalAlignment="Center"
                                      Checked="Sort_Changed" Unchecked="Sort_Changed"/>
                        </Grid>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Group by -->
                        <TextBlock Text="GROUP BY" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Grouping organises the list visually by the chosen category."
                                   Foreground="#777" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <StackPanel>
                            <RadioButton x:Name="RbGroupNone"     Content="No grouping (flat list)" IsChecked="True"
                                         GroupName="GroupBy" Checked="Group_Changed"/>
                            <RadioButton x:Name="RbGroupType"     Content="Group by element type"
                                         GroupName="GroupBy" Checked="Group_Changed"/>
                            <RadioButton x:Name="RbGroupMaterial" Content="Group by material"
                                         GroupName="GroupBy" Checked="Group_Changed"/>
                            <RadioButton x:Name="RbGroupWeight"   Content="Group by weight category  (Light / Medium / Heavy)"
                                         GroupName="GroupBy" Checked="Group_Changed"/>
                        </StackPanel>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Weight category legend -->
                        <TextBlock Text="WEIGHT CATEGORIES" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                CornerRadius="4" Padding="12,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Light     — below 500 kg"
                                               Foreground="#CCCCCC" FontSize="11" Margin="6,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="#F39C12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Medium  — 500 kg to 5 000 kg"
                                               Foreground="#CCCCCC" FontSize="11" Margin="6,0,0,0"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="#E74C3C" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Heavy    — above 5 000 kg"
                                               Foreground="#CCCCCC" FontSize="11" Margin="6,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 3: Hierarchy ─────────────────────────────────────── -->
            <TabItem Header="🌲  Hierarchy">
                <Grid Background="#1E1E1E">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="#252526" Padding="12,8"
                            BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hierarchy by:" Foreground="#AAA" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbHierarchyMode" Width="150"
                                      SelectionChanged="HierarchyMode_Changed">
                                <ComboBoxItem Content="Type → Element"    Tag="Type"     IsSelected="True"/>
                                <ComboBoxItem Content="Material → Element" Tag="Material"/>
                                <ComboBoxItem Content="Weight Category"   Tag="Weight"/>
                            </ComboBox>
                            <Button Style="{StaticResource SecBtn}" Margin="8,0,0,0"
                                    Padding="8,4" FontSize="10" Click="BtnExpandAll_Click">
                                Expand All
                            </Button>
                            <Button Style="{StaticResource SecBtn}" Margin="4,0,0,0"
                                    Padding="8,4" FontSize="10" Click="BtnCollapseAll_Click">
                                Collapse All
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- TreeView -->
                    <TreeView Grid.Row="1" x:Name="HierarchyTree"
                              Background="#1E1E1E" BorderThickness="0"
                              SelectedItemChanged="HierarchyTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground"     Value="#CCCCCC"/>
                                <Setter Property="Background"     Value="Transparent"/>
                                <Setter Property="Padding"        Value="4,2"/>
                                <Setter Property="IsExpanded"     Value="True"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#094771"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A2D2E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════════════
             Result summary bar
        ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#252526"
                BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Result: " Foreground="#666" FontSize="11"/>
                    <TextBlock x:Name="TxtResultCount" Foreground="#4FC3F7"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtResultOf" Foreground="#666" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Action buttons
        ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#252526"
                BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource DangerBtn}" Padding="12,7"
                            Click="BtnResetAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕  "/>
                            <TextBlock Text="Clear All"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecBtn}" Margin="0,0,8,0"
                            Click="BtnCancel_Click">Cancel</Button>
                    <Button Style="{StaticResource ActionBtn}"
                            Click="BtnApply_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✔  "/>
                            <TextBlock Text="Apply Filter"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
