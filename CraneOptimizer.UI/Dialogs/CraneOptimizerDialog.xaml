<Window x:Class="WPF_IFC_test1.Dialogs.CraneOptimizerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crane Position Optimizer"
        MinWidth="1000" MinHeight="700" Width="1100" Height="760"
        Background="#1E1E2E" Foreground="#CDD6F4"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- ── Styles ── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"     Value="#181825"/>
            <Setter Property="BorderBrush"    Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="10"/>
            <Setter Property="Margin"         Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#89B4FA"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"     Value="#313244"/>
            <Setter Property="Foreground"     Value="#CDD6F4"/>
            <Setter Property="BorderBrush"    Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="4,2"/>
            <Setter Property="Height"         Value="24"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background"  Value="#313244"/>
            <Setter Property="Foreground"  Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Height"      Value="26"/>
            <Setter Property="Padding"     Value="4,2"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height"         Value="32"/>
            <Setter Property="Padding"        Value="16,0"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TreeCb" TargetType="CheckBox">
            <Setter Property="Foreground"  Value="#CDD6F4"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Main two-column body ── -->
        <Grid Grid.Row="0" Margin="12,12,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT PANEL ══════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Crane Selection -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CRANE SELECTION" Style="{StaticResource Section}"/>
                            <TextBlock Text="Crane to optimise:" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="CboCrane" SelectionChanged="CboCrane_SelectionChanged"
                                      DisplayMemberPath="Name"/>
                            <TextBlock x:Name="TxtChartStatus" Margin="0,4,0,0"
                                       FontSize="10" Foreground="#A6E3A1"/>
                        </StackPanel>
                    </Border>

                    <!-- Algorithm Settings -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ALGORITHM SETTINGS" Style="{StaticResource Section}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Population Size" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="0" Grid.Column="2" x:Name="TxtPopulation" Text="30"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Generations" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="2" Grid.Column="2" x:Name="TxtGenerations" Text="30"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Mutation Rate" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="4" Grid.Column="2" x:Name="TxtMutRate" Text="0.10"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Mutation Sigma" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="6" Grid.Column="2" x:Name="TxtMutSigma" Text="0.05"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Grid Step (m)" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="8" Grid.Column="2" x:Name="TxtGridStep" Text="2.0"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Convergence (%)" Style="{StaticResource Lbl}" VerticalAlignment="Center"
                                           ToolTip="Early-stop threshold. Set 0 to always run all Max Generations."/>
                                <TextBox   Grid.Row="10" Grid.Column="2" x:Name="TxtConverge" Text="0"
                                           ToolTip="0 = run all generations (recommended). Higher = stop earlier when improvement stalls."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Penalty Weights -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PENALTY WEIGHTS" Style="{StaticResource Section}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Non-Liftable penalty" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="0" Grid.Column="2" x:Name="TxtPenNL" Text="20"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Unreachable penalty" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="2" Grid.Column="2" x:Name="TxtPenUR" Text="100"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Exclusion Zone -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="EXCLUSION ZONE" Style="{StaticResource Section}"/>
                            <RadioButton x:Name="RbExcStandard"
                                         Content="Use crane's exclusion radius"
                                         IsChecked="True"
                                         Foreground="#CDD6F4" FontSize="11" Margin="0,0,0,4"
                                         GroupName="ExcMode"
                                         Checked="RbExclusion_Checked"/>
                            <RadioButton x:Name="RbExcDimensions"
                                         Content="Use crane dimensions (L × W)"
                                         Foreground="#CDD6F4" FontSize="11" Margin="0,0,0,4"
                                         GroupName="ExcMode"
                                         Checked="RbExclusion_Checked"/>
                            <RadioButton x:Name="RbExcIgnore"
                                         Content="Ignore exclusion zone entirely"
                                         Foreground="#FAB387" FontSize="11"
                                         GroupName="ExcMode"
                                         Checked="RbExclusion_Checked"/>
                            <TextBlock x:Name="TxtExcInfo"
                                       FontSize="10" Foreground="#6C7086"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Results (shown after run) -->
                    <Border x:Name="PanelResults" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="RESULTS" Style="{StaticResource Section}"/>
                            <TextBlock x:Name="TxtScore"    FontSize="20" FontWeight="Bold"
                                       Foreground="#A6E3A1" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtPosition" FontSize="11" Foreground="#CBA6F7"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtCountL"  FontSize="16" FontWeight="Bold"
                                               Foreground="#A6E3A1" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Liftable" FontSize="9" Foreground="#6C7086"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtCountNL" FontSize="16" FontWeight="Bold"
                                               Foreground="#FAB387" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Non-Liftable" FontSize="9" Foreground="#6C7086"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtCountUR" FontSize="16" FontWeight="Bold"
                                               Foreground="#F38BA8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Unreachable" FontSize="9" Foreground="#6C7086"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TxtCoverage" FontSize="11" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" Foreground="#89DCEB"/>
                            <TextBlock x:Name="TxtStopReason" FontSize="10" Margin="0,4,0,0"
                                       Foreground="#6C7086" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══ RIGHT PANEL ═════════════════════════════════════════════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Quick-filter buttons -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8,6">
                    <DockPanel>
                        <TextBlock Text="ELEMENT SELECTION" Style="{StaticResource Section}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Style="{StaticResource Btn}" Background="#313244" Foreground="#CDD6F4"
                                    Content="✔ Include All"   Click="BtnIncludeAll_Click"   Margin="0,0,4,0"/>
                            <Button Style="{StaticResource Btn}" Background="#313244" Foreground="#CDD6F4"
                                    Content="✖ Exclude All"   Click="BtnExcludeAll_Click"   Margin="0,0,4,0"/>
                            <Button Style="{StaticResource Btn}" Background="#313244" Foreground="#FAB387"
                                    Content="⊖ No Slabs"      Click="BtnNoSlabs_Click"      Margin="0,0,4,0"/>
                            <Button Style="{StaticResource Btn}" Background="#313244" Foreground="#FAB387"
                                    Content="⊖ No Stairs"     Click="BtnNoStairs_Click"     Margin="0,0,4,0"/>
                            <Button Style="{StaticResource Btn}" Background="#313244" Foreground="#FAB387"
                                    Content="⊖ No Roofs"      Click="BtnNoRoofs_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Element hierarchy tree -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <TreeView x:Name="ElementTree"
                              Background="#181825" Foreground="#CDD6F4"
                              BorderThickness="0" Padding="4"
                              ItemsSource="{Binding RootNodes}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                                <Setter Property="Padding"    Value="2,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Border x:Name="Bd" Background="Transparent" Padding="2,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      Width="14" Height="14"
                                                                      Background="Transparent" BorderThickness="0"
                                                                      Visibility="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <TextBlock x:Name="Arrow" Text="▶" Foreground="#6C7086" FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                        <ContentPresenter Grid.Column="1" ContentSource="Header"/>
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0"
                                                                Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#313244"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,1">
                                    <CheckBox IsChecked="{Binding IsChecked}"
                                              Style="{StaticResource TreeCb}"
                                              VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Label}"   VerticalAlignment="Center"/>
                                    <TextBlock Text=" — " Foreground="#6C7086" VerticalAlignment="Center"
                                               Visibility="{Binding IsLeaf, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding SubLabel}" Foreground="#6C7086"
                                               FontSize="10" VerticalAlignment="Center"
                                               Visibility="{Binding IsLeaf, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding SubLabel}" Foreground="#89B4FA"
                                               FontSize="10" VerticalAlignment="Center"
                                               Visibility="{Binding IsParent, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Bottom bar ── -->
        <Border Grid.Row="1" Background="#181825" BorderBrush="#313244" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Progress -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="ProgBar" Width="300" Height="16"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="#89B4FA" Background="#313244"
                                 BorderThickness="0" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtStatus" Foreground="#A6ADC8" FontSize="11"
                               VerticalAlignment="Center" Text="Ready"/>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnRun"   Style="{StaticResource Btn}"
                            Background="#89B4FA" Foreground="#1E1E2E"
                            Content="⚡  Run Optimizer"
                            Click="BtnRun_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnCancel" Style="{StaticResource Btn}"
                            Background="#45475A" Foreground="#CDD6F4"
                            Content="✖  Cancel"
                            Click="BtnCancel_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="BtnApply"  Style="{StaticResource Btn}"
                            Background="#A6E3A1" Foreground="#1E1E2E"
                            Content="✔  Apply Best Result"
                            Click="BtnApply_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
