<Window x:Class="WPF_IFC_test1.Dialogs.LoadChartImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Crane Load Chart"
        Width="860" Height="740"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#1A1B2D">

    <Window.Resources>

        <!-- ── Input Fields ─────────────────────────────────────────────── -->
        <Style x:Key="DarkField" TargetType="TextBox">
            <Setter Property="Background" Value="#14152A"/>
            <Setter Property="Foreground" Value="#D0D4F0"/>
            <Setter Property="BorderBrush" Value="#2A2B48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#D0D4F0"/>
        </Style>

        <!-- ── ComboBox ──────────────────────────────────────────────────── -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#14152A"/>
            <Setter Property="Foreground" Value="#D0D4F0"/>
            <Setter Property="BorderBrush" Value="#2A2B48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                        IsHitTestVisible="False"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        Margin="8,0,28,0"
                                        VerticalAlignment="Center"/>
                                    <TextBlock Text="▾" Foreground="#4A4C78"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" FontSize="11"/>
                                    <ToggleButton Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True">
                                <Border Background="#1C1D38" BorderBrush="#2A2B48"
                                        BorderThickness="1" CornerRadius="2"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#1C1D38"/>
                        <Setter Property="Foreground" Value="#C0C4E8"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252650"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1A3560"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Labels ───────────────────────────────────────────────────── -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6D9A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ── Primary Button (Save to Database) ───────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1560A0"/>
            <Setter Property="Foreground" Value="#D0D8F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1A1C38"/>
                    <Setter Property="Foreground" Value="#383A60"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A72B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Secondary Button (Cancel, Clear, Re-read) ─────────────────── -->
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background" Value="#222340"/>
            <Setter Property="Foreground" Value="#8082AC"/>
            <Setter Property="BorderBrush" Value="#2E3058"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2C50"/>
                    <Setter Property="Foreground" Value="#AAAACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Method Tabs (CSV / PDF) ───────────────────────────────────── -->
        <Style x:Key="MethodTab" TargetType="RadioButton">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Background" Value="#14152A"/>
            <Setter Property="Foreground" Value="#505278"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1C1E38"/>
                    <Setter Property="Foreground" Value="#C0C4E8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#191B33"/>
                    <Setter Property="Foreground" Value="#9090BB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Watermark TextBox ─────────────────────────────────────────── -->
        <Style x:Key="WatermarkField" TargetType="TextBox" BasedOn="{StaticResource DarkField}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                <VisualBrush.Visual>
                                    <TextBlock Foreground="#30315A" FontSize="11" FontStyle="Italic"
                                               Margin="10,0,0,0"
                                               Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Slim Scrollbar ───────────────────────────────────────────── -->
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Opacity="0" Height="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2A3060" CornerRadius="3"
                                                        Margin="1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Opacity="0" Height="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource SlimScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid Cell ─────────────────────────────────────────────── -->
        <Style x:Key="EditCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0B8E0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#1C1E38"/>
            <Setter Property="Padding" Value="5,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A3560"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Background" Value="#0D2748"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#161728" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🏗️  Import Crane Load Chart"
                               Foreground="#D8DAF2" FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtSubtitle"
                               Foreground="#383A5E" FontSize="11" Margin="0,2,0,0"
                               Text="Drop a file — extracted numbers appear in the grid for you to verify before saving."/>
                </StackPanel>
                <!-- Method tabs -->
                <Border Grid.Column="1" CornerRadius="5" Background="#14152A" Padding="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RboCsv" Style="{StaticResource MethodTab}"
                                     IsChecked="True" GroupName="M" Checked="Method_Checked"
                                     Content="📄  CSV  (recommended)"/>
                        <RadioButton x:Name="RboPdf" Style="{StaticResource MethodTab}"
                                     GroupName="M" Checked="Method_Checked"
                                     Content="📑  PDF  (verify after)"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Main ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Panel ──────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,8">

                    <!-- Drop zone -->
                    <Border x:Name="DropZone"
                        AllowDrop="True"
                        Drop="DropZone_Drop"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        DragOver="DropZone_DragOver"
                        BorderBrush="#2E6EBF" BorderThickness="2"
                        CornerRadius="7" Background="#0F1122"
                        Padding="14,20" Cursor="Hand"
                        MouseLeftButtonUp="DropZone_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="DropIcon" Text="📄" FontSize="28"
                                   HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DropTitle" Text="Drop CSV here"
                                   Foreground="#C8CCE8" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,3"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="DropSub" Text="or click to browse"
                                   Foreground="#233560" FontSize="10"
                                   HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress bar for PDF extraction -->
                    <ProgressBar x:Name="ProgressBar"
                             IsIndeterminate="True"
                             Height="3" Margin="0,6,0,0"
                             Foreground="#2E6EBF"
                             Background="#0F1122"
                             Visibility="Collapsed"/>

                    <!-- Selected file info -->
                    <Border x:Name="FileInfoPanel" Visibility="Collapsed"
                        Background="#0C1320" CornerRadius="5"
                        Padding="10,8" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtFileName" Foreground="#4499EE"
                                   FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtFileSize" Foreground="#2A4460"
                                   FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- PDF: page number selector -->
                    <StackPanel x:Name="PdfPagePanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="PDF Page Number" Style="{StaticResource Lbl}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPageNumber" Style="{StaticResource DarkField}"
                                 Text="0"
                                 ToolTip="0 = auto-detect the page with the most numbers"/>
                            <Button Grid.Column="2" Content="Re-read"
                                Style="{StaticResource SecBtn}"
                                Width="68" FontSize="10" Height="30"
                                Click="ReExtract_Click"/>
                        </Grid>
                        <TextBlock Text="0 = auto-detect" Foreground="#2A3A4A"
                               FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- ── Axis orientation ──────────────────────────────────── -->
                    <Border x:Name="AxisPanel" Visibility="Collapsed"
                        Background="#0C1020" CornerRadius="5"
                        Padding="10,9" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="TABLE ORIENTATION" Foreground="#282A48"
                                   FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                            <RadioButton x:Name="RboRowsRadius"
                                     GroupName="Axis" IsChecked="True"
                                     Foreground="#7A7CA8" FontSize="10"
                                     Margin="0,0,0,5" Cursor="Hand"
                                     Checked="AxisOrientation_Changed">
                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#7A7CA8"
                                       Text="Rows = Radius  /  Cols = Boom"/>
                            </RadioButton>
                            <RadioButton x:Name="RboRowsBoom"
                                     GroupName="Axis"
                                     Foreground="#7A7CA8" FontSize="10"
                                     Cursor="Hand"
                                     Checked="AxisOrientation_Changed">
                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#7A7CA8"
                                       Text="Rows = Boom  /  Cols = Radius"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Section label -->
                    <TextBlock Text="CRANE DETAILS" Foreground="#282A48"
                           FontSize="9" FontWeight="Bold" Margin="0,14,0,6"/>

                    <!-- ── Crane Type (Tower / Mobile) ───────────────────────── -->
                    <TextBlock Text="Crane Type" Style="{StaticResource Lbl}"/>
                    <Border Background="#0C1020" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RboCraneTypeMobile" GroupName="CraneTypeGrp"
                                         IsChecked="True"
                                         Foreground="#27AE60" FontSize="10" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚛 " FontSize="10"/>
                                    <TextBlock Text="Mobile" Foreground="#27AE60" FontSize="10"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RboCraneTypeTower" Grid.Column="1" GroupName="CraneTypeGrp"
                                         Foreground="#F39C12" FontSize="10" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏗️ " FontSize="10"/>
                                    <TextBlock Text="Tower" Foreground="#F39C12" FontSize="10"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <TextBlock Text="Crane Model" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtModel" Style="{StaticResource WatermarkField}"
                         Margin="0,0,0,7" Tag="e.g. LTM 1200-5.1"
                         TextChanged="TxtModel_TextChanged"/>

                    <TextBlock Text="Manufacturer" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtManufacturer" Style="{StaticResource WatermarkField}"
                         Margin="0,0,0,2" Tag="e.g. Liebherr"/>
                    <TextBlock x:Name="TxtAutoDetect" Foreground="#2A7A4A" FontSize="9"
                               Margin="0,0,0,7" Visibility="Collapsed"/>

                    <TextBlock Text="Chart Type" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="CboChartType" Style="{StaticResource DarkCombo}"
                          Margin="0,0,0,7" SelectedIndex="0">
                        <ComboBoxItem Content="360°"/>
                        <ComboBoxItem Content="Over-rear"/>
                        <ComboBoxItem Content="Over-side"/>
                        <ComboBoxItem Content="Over-front"/>
                    </ComboBox>

                    <TextBlock Text="Outrigger Config" Style="{StaticResource Lbl}"/>
                    <Border Background="#0C1020" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbOutrigger100" Content="100% (Full)"
                                         GroupName="OutriggerCfg" IsChecked="True"
                                         Foreground="#D0D4F0" FontSize="10"
                                         Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RbOutrigger75" Content="75%"
                                         GroupName="OutriggerCfg"
                                         Foreground="#D0D4F0" FontSize="10"
                                         Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RbOutrigger50" Content="50%"
                                         GroupName="OutriggerCfg"
                                         Foreground="#D0D4F0" FontSize="10"
                                         Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RbOutriggerRubber" Content="On Rubber"
                                         GroupName="OutriggerCfg"
                                         Foreground="#D0D4F0" FontSize="10"
                                         VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Border>

                    <!-- ── Counterweight ─────────────────────────────────────── -->
                    <TextBlock Text="Counterweight" Style="{StaticResource Lbl}"/>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCounterweight" Style="{StaticResource WatermarkField}"
                             Tag="e.g.  12 000"
                             TextChanged="CraneDetails_Changed"/>
                        <TextBlock Grid.Column="1" Text=" kg" Foreground="#4A4C70"
                               VerticalAlignment="Center" FontSize="10" Margin="4,0,0,0"/>
                    </Grid>

                    <!-- ── Max Capacity (user enters manually) ──────────────── -->
                    <TextBlock Text="Max Capacity (t) — enter manually" Style="{StaticResource Lbl}"/>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtMaxCapacity"
                             Style="{StaticResource DarkField}"
                             Foreground="#D0D4F0"
                             ToolTip="Enter the maximum rated lifting capacity from the crane datasheet (tonnes)."
                             Tag="e.g. 160"
                             Margin="0,0,0,0"/>
                        <TextBlock Grid.Column="1" Text=" t" Foreground="#4A4C70"
                               VerticalAlignment="Center" FontSize="10" Margin="4,0,0,0"/>
                    </Grid>

                    <!-- ── Max Radius (auto from CSV, editable) ──────────────── -->
                    <TextBlock Text="Max Radius (m) — auto from CSV, editable" Style="{StaticResource Lbl}"/>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtMaxRadius"
                             Style="{StaticResource DarkField}"
                             Foreground="#D0D4F0"
                             ToolTip="Auto-filled from CSV data — edit if needed."
                             Margin="0,0,0,0"/>
                        <TextBlock Grid.Column="1" Text=" m" Foreground="#4A4C70"
                               VerticalAlignment="Center" FontSize="10" Margin="4,0,0,0"/>
                    </Grid>

                    <!-- ── Crane Derating ─────────────────────────────────────── -->
                    <TextBlock Text="Crane Derating" Style="{StaticResource Lbl}"
                               ToolTip="Reduce if crane has test certificate restrictions. All capacity values are multiplied by this factor."/>
                    <Border Background="#0C1020" CornerRadius="5" Padding="10,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SldDerating"
                                    Minimum="25" Maximum="100" Value="100"
                                    SmallChange="5" LargeChange="10"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="SldDerating_ValueChanged"/>
                            <TextBlock x:Name="TxtDeratingVal"
                                       Grid.Column="1"
                                       Text="100%"
                                       Foreground="#3AAA5A"
                                       FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <!-- Hidden TextBox — drives existing calibration logic unchanged -->
                    <TextBox x:Name="TxtCalibration" Text="100" Visibility="Collapsed"
                             TextChanged="Calibration_Changed"/>

                    <!-- Unit selectors (Feature 07) -->
                    <TextBlock Text="Capacity Unit" Foreground="#6B6D9A" FontSize="10" Margin="0,6,0,2"/>
                    <ComboBox x:Name="CboCapacityUnit" Height="26" FontSize="10"
                              Background="#14152A" Foreground="#C0C4E8" BorderBrush="#2A2B48"
                              SelectionChanged="CboCapacityUnit_Changed">
                        <ComboBoxItem Content="Tonnes (t)" IsSelected="True" Tag="1.0"/>
                        <ComboBoxItem Content="Kilograms (kg)" Tag="0.001"/>
                        <ComboBoxItem Content="US Short Tons" Tag="0.907185"/>
                    </ComboBox>
                    <TextBlock Text="Distance Unit" Foreground="#6B6D9A" FontSize="10" Margin="0,6,0,2"/>
                    <ComboBox x:Name="CboDistanceUnit" Height="26" FontSize="10"
                              Background="#14152A" Foreground="#C0C4E8" BorderBrush="#2A2B48"
                              Margin="0,0,0,8"
                              SelectionChanged="CboDistanceUnit_Changed">
                        <ComboBoxItem Content="Metres (m)" IsSelected="True" Tag="1.0"/>
                        <ComboBoxItem Content="Feet (ft)" Tag="0.3048"/>
                    </ComboBox>

                    <!-- ── Crane Dimensions Button ───────────────────────────── -->
                    <Button x:Name="BtnCraneDimensions"
                        Style="{StaticResource SecBtn}"
                        Height="30" Margin="0,0,0,6"
                        Click="BtnCraneDimensions_Click"
                        ToolTip="Enter overall physical dimensions. Required for CG calculation.">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="[&#x25A6;]  " Foreground="#1A72B8" FontSize="10"
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="Enter Crane Dimensions" Foreground="#8082AC"
                                   FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Badge: shown once dimensions are entered -->
                    <Border x:Name="DimEnteredBadge" Visibility="Collapsed"
                        Background="#061806" BorderBrush="#1A4A1A" BorderThickness="1"
                        CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtDimSummary" Foreground="#2E8A2E"
                               FontSize="9" TextWrapping="Wrap" LineHeight="14"/>
                    </Border>

                    <!-- Save to Catalog option -->
                    <Border Background="#0A0C22" CornerRadius="5" Padding="10,9" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="ChkSaveToCatalog" IsChecked="True"
                                  Foreground="#8082AC" FontSize="10" Cursor="Hand">
                                <TextBlock Text="Add to Crane Catalog" Foreground="#8082AC" FontSize="10"/>
                            </CheckBox>
                            <TextBlock Text="Makes this crane selectable in any project."
                                   Foreground="#2A2C50" FontSize="9"
                                   TextWrapping="Wrap" Margin="20,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- CSV template box -->
                    <Border x:Name="CsvTemplatePanel"
                        Background="#0A150A" CornerRadius="5" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="📥  Need the format?"
                                   Foreground="#2E7A2E" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Download a filled template, edit the numbers in Excel or Notepad, save as CSV."
                                   Foreground="#1C4A1C" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Button Content="Download CSV Template"
                                Style="{StaticResource SecBtn}"
                                FontSize="10" Height="28"
                                Click="DownloadTemplate_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- PDF warning box -->
                    <Border x:Name="PdfWarningPanel" Visibility="Collapsed"
                        Background="#1A1006" CornerRadius="5" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="⚠  Always verify PDF results"
                                   Foreground="#C0A030" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Foreground="#7A6625" FontSize="10" TextWrapping="Wrap"
                                   Margin="0,5,0,0"
                                   Text="Column alignment can shift on unusual PDFs. Check every number in the grid. Wrong values could mean dangerous lifts."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Right Panel: Verification Grid ──────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Grid stats bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="VERIFY DATA  —  Click any cell to correct a value"
                                   Foreground="#303258" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtGridStats" Foreground="#2C3D50"
                                   FontSize="10" Text="No data yet — drop a file on the left."/>
                    </StackPanel>
                    <ToggleButton x:Name="TglHeatmap" Grid.Column="1" Content="🎨 Heatmap"
                                  Height="24" Padding="8,0" FontSize="10"
                                  Checked="TglHeatmap_Changed" Unchecked="TglHeatmap_Changed"
                                  ToolTip="Color-code cells by capacity value"/>
                    <Button Grid.Column="3" Content="Clear"
                            Style="{StaticResource SecBtn}"
                            FontSize="10" Height="26" Padding="12,0"
                            Click="ClearGrid_Click"/>
                </Grid>

                <!-- Empty state placeholder -->
                <Border x:Name="GridEmptyState" Grid.Row="1"
                        BorderBrush="#18193A" BorderThickness="1"
                        CornerRadius="6" Background="#0E0F20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="42" HorizontalAlignment="Center"
                                   Opacity="0.18"/>
                        <TextBlock Text="Extracted data will appear here"
                                   Foreground="#1E2040" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBlock Text="You can click any cell to edit before saving"
                                   Foreground="#181930" FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- The editable data grid -->
                <DataGrid x:Name="PreviewGrid"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          IsReadOnly="False"
                          Background="#0E0F20"
                          RowBackground="#12132A"
                          AlternatingRowBackground="#0F1025"
                          Foreground="#C0C4E0"
                          BorderBrush="#1E2040"
                          BorderThickness="1"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#1A1C38"
                          VerticalGridLinesBrush="#1A1C38"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          FontSize="11"
                          RowHeight="21"
                          CellStyle="{StaticResource EditCell}"
                          CellEditEnding="PreviewGrid_CellEditEnding">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0C0D20"/>
                            <Setter Property="Foreground" Value="#5A5C8A"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Padding" Value="5,3"/>
                            <Setter Property="BorderBrush" Value="#1E2040"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>

                <!-- Warnings panel -->
                <Border x:Name="WarningsPanel" Grid.Row="2"
                        Visibility="Collapsed"
                        Background="#14100A" CornerRadius="5"
                        Padding="10,8" Margin="0,8,0,0" MaxHeight="90">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Possible extraction issues — please check these cells:"
                                       Foreground="#A09030" FontSize="10"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="WarningsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#705820"
                                                   FontSize="10" Margin="0,1" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ── Chart Summary Panel (auto-computed stats) ───────── -->
                <Border x:Name="ChartSummaryPanel" Grid.Row="3"
                        Visibility="Collapsed"
                        Background="#080A1C" CornerRadius="6"
                        BorderBrush="#1A2040" BorderThickness="1"
                        Padding="12,10" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: chart data stats -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="CHART DATA RANGE" Foreground="#222450"
                                       FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Min Radius:" Foreground="#2A3C58" FontSize="9"/>
                                <TextBlock x:Name="TxtSummaryMinRadius" Grid.Column="1"
                                           Foreground="#4A8AB8" FontSize="9" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Max Radius:" Foreground="#2A3C58" FontSize="9"/>
                                <TextBlock x:Name="TxtSummaryMaxRadius" Grid.Column="1"
                                           Foreground="#4A8AB8" FontSize="9" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Min Boom:" Foreground="#2A3C58" FontSize="9"/>
                                <TextBlock x:Name="TxtSummaryMinBoom" Grid.Column="1"
                                           Foreground="#4A8AB8" FontSize="9" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Max Boom:" Foreground="#2A3C58" FontSize="9"/>
                                <TextBlock x:Name="TxtSummaryMaxBoom" Grid.Column="1"
                                           Foreground="#4A8AB8" FontSize="9" FontWeight="Bold"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Derating:" Foreground="#2A3C58" FontSize="9"/>
                                <TextBlock x:Name="TxtSummaryCalib" Grid.Column="1"
                                           Foreground="#4A8AB8" FontSize="9" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>

                        <!-- Divider -->
                        <Rectangle Grid.Column="1" Fill="#1A2040" Width="1" Margin="0,4"/>

                        <!-- Right: capacity + work area -->
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock Text="CAPACITY &amp; WORK AREA" Foreground="#222450"
                                       FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Max Capacity:" Foreground="#2A3C58" FontSize="9"/>
                                <TextBlock x:Name="TxtSummaryMaxCap" Grid.Column="1"
                                           Foreground="#4A8AB8" FontSize="9" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Counterweight:" Foreground="#2A3C58" FontSize="9"/>
                                <TextBlock x:Name="TxtSummaryCW" Grid.Column="1"
                                           Foreground="#9A7A3A" FontSize="9" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Work Area:" Foreground="#2A3C58" FontSize="9"/>
                                <TextBlock x:Name="TxtSummaryCG" Grid.Column="1"
                                           Foreground="#3AAA5A" FontSize="9" FontWeight="Bold"/>
                            </Grid>
                            <TextBlock x:Name="TxtSummaryCGNote"
                                       Foreground="#1A3A28" FontSize="8"
                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Enter Slew Radius in dimensions for work area."/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ══ Bottom Bar ════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0C0D1E" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Grid.Column="0"
                           Foreground="#2A3A4A" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Drop a file to begin."/>

                <CheckBox x:Name="ChkSaveCsv" Grid.Column="1"
                          IsChecked="True" VerticalAlignment="Center"
                          ToolTip="Automatically saves a CSV backup to My Documents\CraneCharts\">
                    <TextBlock Text="Save CSV backup" Foreground="#2A6A2A" FontSize="10"/>
                </CheckBox>

                <Button Grid.Column="3" x:Name="BtnCancel"
                        Content="Cancel" Style="{StaticResource SecBtn}"
                        Width="80" Click="BtnCancel_Click"/>

                <Button Grid.Column="5" x:Name="BtnSave"
                        Content="Save to Database"
                        Style="{StaticResource PrimaryBtn}"
                        Width="150" IsEnabled="False"
                        Click="BtnSave_Click"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- CRANE DIMENSIONS OVERLAY                                            -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="DimOverlay" Grid.Row="0" Grid.RowSpan="3"
              Visibility="Collapsed" Panel.ZIndex="100"
              Background="#D0000010">

            <Border Background="#10121E" CornerRadius="10"
                    Width="860" Height="620"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#2A3060" BorderThickness="1">
                <Grid Margin="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Header ────────────────────────────────────────────── -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="CRANE PHYSICAL DIMENSIONS"
                                   Foreground="#4A7CB8" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Foreground="#2A3050" FontSize="10" Margin="0,3,0,0"
                                   Text="Enter dimensions from the crane's specification sheet (all values in mm). Outrigger Span is required."/>
                    </StackPanel>

                    <!-- ── Main: Drawings (left) + Fields (right) ────────────── -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="270"/>
                        </Grid.ColumnDefinitions>

                        <!-- ══ Crane Dimension Image ══════════════════════════════ -->
                        <Border Grid.Column="0" Background="#070810" CornerRadius="6"
                                BorderBrush="#151830" BorderThickness="1">
                            <Image Source="/Assest/Crane_dimention.png"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="12"/>
                        </Border>

                        <!-- ══ Input Fields (right column) ═══════════════════════ -->
                        <ScrollViewer Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,4,0">

                                <!-- TRANSPORT section -->
                                <TextBlock Text="TRANSPORT DIMENSIONS" Foreground="#282A48"
                                           FontSize="8.5" FontWeight="Bold" Margin="0,0,0,8"/>

                                <TextBlock Style="{StaticResource Lbl}">
                                    <Run Text="L  " Foreground="#4A8AB8" FontWeight="Bold"/>
                                    <Run Text="Total Length"/>
                                </TextBlock>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDimTotalLength"
                                             Style="{StaticResource WatermarkField}"
                                             Tag="mm  (e.g. 14300)"
                                             TextChanged="DimField_Changed"/>
                                    <TextBlock Grid.Column="1" Text=" mm" Foreground="#3A3C60"
                                               VerticalAlignment="Center" FontSize="9" Margin="3,0,0,0"/>
                                </Grid>

                                <TextBlock Style="{StaticResource Lbl}">
                                    <Run Text="H  " Foreground="#4A8AB8" FontWeight="Bold"/>
                                    <Run Text="Transport Height"/>
                                </TextBlock>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDimHeight"
                                             Style="{StaticResource WatermarkField}"
                                             Tag="mm  (e.g. 3760)"
                                             TextChanged="DimField_Changed"/>
                                    <TextBlock Grid.Column="1" Text=" mm" Foreground="#3A3C60"
                                               VerticalAlignment="Center" FontSize="9" Margin="3,0,0,0"/>
                                </Grid>

                                <TextBlock Style="{StaticResource Lbl}">
                                    <Run Text="T  " Foreground="#4A8AB8" FontWeight="Bold"/>
                                    <Run Text="Travel Width (incl. tires)"/>
                                </TextBlock>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDimTransportWidth"
                                             Style="{StaticResource WatermarkField}"
                                             Tag="mm  (e.g. 3200)"
                                             TextChanged="DimField_Changed"
                                             ToolTip="Total carrier width including tires — sets the 3D model width"/>
                                    <TextBlock Grid.Column="1" Text=" mm" Foreground="#3A3C60"
                                               VerticalAlignment="Center" FontSize="9" Margin="3,0,0,0"/>
                                </Grid>

                                <!-- OUTRIGGER section -->
                                <TextBlock Text="OUTRIGGER CONFIGURATION" Foreground="#282A48"
                                           FontSize="8.5" FontWeight="Bold" Margin="0,0,0,8"/>

                                <TextBlock Style="{StaticResource Lbl}">
                                    <Run Text="W  " Foreground="#4A8AB8" FontWeight="Bold"/>
                                    <Run Text="Outrigger Span (pad to pad)"/>
                                    <Run Text=" *" Foreground="#CC4444"/>
                                </TextBlock>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDimOutriggerSpan"
                                             Style="{StaticResource WatermarkField}"
                                             Tag="mm  (e.g. 7200)"
                                             TextChanged="DimField_Changed"/>
                                    <TextBlock Grid.Column="1" Text=" mm" Foreground="#3A3C60"
                                               VerticalAlignment="Center" FontSize="9" Margin="3,0,0,0"/>
                                </Grid>

                                <TextBlock Style="{StaticResource Lbl}">
                                    <Run Text="B  " Foreground="#4A8AB8" FontWeight="Bold"/>
                                    <Run Text="Span to Span (front to rear)"/>
                                </TextBlock>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDimOutriggerBase"
                                             Style="{StaticResource WatermarkField}"
                                             Tag="mm  (e.g. 7200)"
                                             TextChanged="DimField_Changed"/>
                                    <TextBlock Grid.Column="1" Text=" mm" Foreground="#3A3C60"
                                               VerticalAlignment="Center" FontSize="9" Margin="3,0,0,0"/>
                                </Grid>

                                <!-- ── CRANE BOUNDING RADIUS ──────────────────────── -->
                                <TextBlock Text="CRANE BOUNDING RADIUS" Foreground="#282A48"
                                           FontSize="8.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Foreground="#2A3050" FontSize="9" TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Text="Minimum circle enclosing the crane. Auto-calculated from outrigger footprint. Adjustable up to +10 m."/>

                                <!-- Base radius (read-only, auto-calculated) -->
                                <TextBlock Style="{StaticResource Lbl}">
                                    <Run Text="Base radius" Foreground="#6B6D9A"/>
                                    <Run Text="  (auto)" Foreground="#303258" FontStyle="Italic"/>
                                </TextBlock>
                                <TextBlock x:Name="TxtCalcRadius"
                                           Foreground="#3AAA5A" FontSize="12" FontWeight="Bold"
                                           Margin="0,0,0,10" Text="—"/>

                                <!-- Adjustable radius with +/- buttons -->
                                <TextBlock Style="{StaticResource Lbl}">
                                    <Run Text="R  " Foreground="#4A8AB8" FontWeight="Bold"/>
                                    <Run Text="Adjusted Bounding Radius"/>
                                </TextBlock>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnRadiusMinus" Content="−"
                                            Style="{StaticResource SecBtn}"
                                            FontSize="14" Height="30"
                                            Click="RadiusMinus_Click"/>
                                    <TextBox x:Name="TxtBoundingRadius" Grid.Column="1"
                                             Style="{StaticResource DarkField}"
                                             HorizontalContentAlignment="Center"
                                             Foreground="#4AAAD8" FontWeight="Bold"
                                             IsReadOnly="True" Margin="4,0"
                                             Text="—"/>
                                    <Button x:Name="BtnRadiusPlus" Grid.Column="2" Content="+"
                                            Style="{StaticResource SecBtn}"
                                            FontSize="14" Height="30"
                                            Click="RadiusPlus_Click"/>
                                    <TextBlock Grid.Column="3" Text=" m" Foreground="#3A3C60"
                                               VerticalAlignment="Center" FontSize="9" Margin="3,0,0,0"/>
                                </Grid>

                                <!-- Radius info display -->
                                <Border Background="#06080E" CornerRadius="5" Padding="10,8"
                                        BorderBrush="#141830" BorderThickness="1" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="RADIUS DETAILS"
                                                   Foreground="#1A2840"
                                                   FontSize="8" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="TxtRadiusInfo"
                                                   Foreground="#2A7A4A" FontSize="9"
                                                   TextWrapping="Wrap" LineHeight="15"
                                                   Text="Enter Outrigger Span (W) to calculate."/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="* Required field"
                                           Foreground="#442222" FontSize="8"
                                           Margin="0,6,0,0"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ── Action Buttons ─────────────────────────────────────── -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecBtn}"
                                Width="80" Margin="0,0,10,0"
                                Click="DimOverlay_Cancel"/>
                        <Button Content="Apply Dimensions" Style="{StaticResource PrimaryBtn}"
                                Width="152" Click="DimOverlay_Apply"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
