<Window x:Class="WPF_IFC_test1.Dialogs.LoadChartCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare Load Chart Configurations"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#1A1B2D">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161728" Padding="18,12">
            <StackPanel>
                <TextBlock Text="⚖  Multi-Config Chart Comparison" Foreground="#D8DAF2"
                           FontSize="15" FontWeight="Bold"/>
                <TextBlock Foreground="#383A5E" FontSize="11" Margin="0,2,0,0"
                           Text="Select two charts to compare side-by-side. The delta panel shows capacity differences."/>
            </StackPanel>
        </Border>

        <!-- Main: 3 columns -->
        <Grid Grid.Row="1" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chart A -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ComboBox x:Name="CboChartA" Grid.Row="0" Height="30" FontSize="10"
                          Margin="0,0,0,6" Background="#14152A" Foreground="#C0C4E8"
                          BorderBrush="#2A2B48"
                          SelectionChanged="CboChartA_Changed">
                    <ComboBoxItem Content="— Select Chart A —" IsSelected="True"/>
                </ComboBox>
                <Border Grid.Row="1" Background="#080A1C" CornerRadius="4" BorderBrush="#1A2040" BorderThickness="1">
                    <DataGrid x:Name="GridA" IsReadOnly="True" AutoGenerateColumns="True"
                              CanUserAddRows="False" Background="Transparent" Foreground="#8082AC"
                              FontSize="9" RowHeight="18" HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#1A1B30" ResizeBehavior="PreviousAndNext"/>

            <!-- Chart B -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ComboBox x:Name="CboChartB" Grid.Row="0" Height="30" FontSize="10"
                          Margin="0,0,0,6" Background="#14152A" Foreground="#C0C4E8"
                          BorderBrush="#2A2B48"
                          SelectionChanged="CboChartB_Changed">
                    <ComboBoxItem Content="— Select Chart B —" IsSelected="True"/>
                </ComboBox>
                <Border Grid.Row="1" Background="#080A1C" CornerRadius="4" BorderBrush="#1A2040" BorderThickness="1">
                    <DataGrid x:Name="GridB" IsReadOnly="True" AutoGenerateColumns="True"
                              CanUserAddRows="False" Background="Transparent" Foreground="#8082AC"
                              FontSize="9" RowHeight="18" HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="#1A1B30" ResizeBehavior="PreviousAndNext"/>

            <!-- Delta -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Δ DIFFERENCE (A − B)"
                           Foreground="#4A4C78" FontSize="10" FontWeight="Bold"
                           Margin="0,6,0,6" HorizontalAlignment="Center"/>
                <Border Grid.Row="1" Background="#080A1C" CornerRadius="4" BorderBrush="#1A2040" BorderThickness="1">
                    <DataGrid x:Name="GridDelta" IsReadOnly="True" AutoGenerateColumns="True"
                              CanUserAddRows="False" Background="Transparent" Foreground="#8082AC"
                              FontSize="9" RowHeight="18" HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="#0C0D1E" Padding="16,10">
            <Grid>
                <TextBlock x:Name="TxtStatus" Foreground="#2A3A4A" FontSize="10"
                           VerticalAlignment="Center" Text="Select two charts to compare."/>
                <Button HorizontalAlignment="Right" Content="Close" Height="32" Width="80"
                        Background="#222340" Foreground="#8082AC" BorderBrush="#2E3058"
                        BorderThickness="1" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
