<UserControl x:Class="CraneOptimizer.UI.Shell.Views.ShellLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:CraneOptimizer.UI.Shared.Components">
    <!--
        ShellLayout is kept for compatibility but is no longer the primary shell.
        The full shell chrome (TitleBar + Ribbon + InfoBar + 3-col + StatusBar)
        lives directly in MainWindow.xaml.

        This UserControl can be used as an embedded sub-shell
        when needed (e.g. embedded in a tab or dialog scenario).
    -->
    <Border Background="{DynamicResource BackgroundBrush}">
        <components:SitePlannerView/>
    </Border>
</UserControl>
