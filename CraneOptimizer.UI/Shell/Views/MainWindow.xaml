<Window
    x:Class="CraneOptimizer.UI.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:f5="clr-namespace:CraneOptimizer.UI.Features.F5_ElementManagement.Views"
    xmlns:f1="clr-namespace:CraneOptimizer.UI.Features.F1_IfcViewerControl.Views"
    xmlns:f3="clr-namespace:CraneOptimizer.UI.Features.F3_CraneSetup.Views"
    xmlns:osnap="clr-namespace:CraneOptimizer.UI.Features.F15_ObjectSnap.Views"
    xmlns:aiCompanion="clr-namespace:CraneOptimizer.AI.Companion.Views;assembly=CraneOptimizer.AI"
    xmlns:nav="clr-namespace:CraneOptimizer.UI.Shared.Layouts"
    Title="IFC Building Analyzer — Crane Planner Edition"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
    Width="1600"
    Height="800"
    AllowsTransparency="True"
    Background="{DynamicResource BackgroundBrush}"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowState="Normal"
    WindowStyle="None">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding IfcViewer.CancelPlacementCommand}" />
    </Window.InputBindings>

    <!--
        ROOT GRID — compensates for WPF WindowStyle=None + AllowsTransparency=True
        maximized-overflow bug: adds 8px inset only when Maximized.
    -->
    <Grid Style="{StaticResource MaximizedWindowGridStyle}">

        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <!--  Row 0: Title bar + quick-access toolbar  -->
            <RowDefinition Height="Auto" />
            <!--  Row 1: Drawing options bar (collapsed)  -->
            <RowDefinition Height="Auto" />
            <!--  Row 2: Main ribbon  -->
            <RowDefinition Height="*" />
            <!--  Row 3: Main content area  -->
            <RowDefinition Height="22" />
            <!--  Row 4: Status bar  -->
        </Grid.RowDefinitions>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 0 — TITLE BAR + QUICK-ACCESS TOOLBAR
            ══════════════════════════════════════════════════════════════════
        -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <!--  Col 0:  App icon  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 1:  Home / welcome btn  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 2:  Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 3:  Save btn  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 4:  Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 5:  Undo / Redo btns  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 6:  Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 7:  History breadcrumb  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 8:  Clear history  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 9:  Dimension tool  -->
                    <ColumnDefinition Width="*" />
                    <!--  Col 10: Title (centred)  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 11: Window chrome  -->
                </Grid.ColumnDefinitions>

                <!--  Col 0: App icon  -->
                <Border
                    Grid.Column="0"
                    Width="28"
                    Height="28"
                    Background="{StaticResource PrimaryBrush}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSM}"
                        Text="🏗" />
                </Border>

                <!--  Col 1: Home / Back-to-Welcome button  -->
                <Button
                    Grid.Column="1"
                    Width="26"
                    Height="22"
                    Margin="4,0,0,0"
                    Click="BackToWelcome_Click"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Back to Welcome (Home)">
                    <TextBlock FontSize="{StaticResource FontSizeSM}" Text="🏠" />
                </Button>

                <!--  Col 2: Separator  -->
                <Rectangle
                    Grid.Column="2"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 3: Save  -->
                <Button
                    Grid.Column="3"
                    Width="26"
                    Height="22"
                    Click="SaveProject_Click"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Save Project (Ctrl+S)">
                    <TextBlock FontSize="{StaticResource FontSizeSM}" Text="💾" />
                </Button>

                <!--  Col 4: Separator  -->
                <Rectangle
                    Grid.Column="4"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 5: Undo / Redo  -->
                <StackPanel
                    Grid.Column="5"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="26"
                        Height="20"
                        Margin="0,0,1,0"
                        Click="UndoBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Undo (Ctrl+Z)">
                        <TextBlock
                            FontSize="{StaticResource FontSizeSM}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="↩" />
                    </Button>
                    <TextBlock
                        x:Name="TxtUndoLabel"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Undo" />
                    <Button
                        Width="26"
                        Height="20"
                        Margin="0,0,1,0"
                        Click="RedoBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Redo (Ctrl+Y)">
                        <TextBlock
                            FontSize="{StaticResource FontSizeSM}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="↪" />
                    </Button>
                    <TextBlock
                        x:Name="TxtRedoLabel"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Redo" />
                </StackPanel>

                <!--  Col 6: Separator  -->
                <Rectangle
                    Grid.Column="6"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 7: Last action breadcrumb — ✅ NOW BOUND TO VIEWMODEL  -->
                <TextBlock
                    x:Name="TxtHistoryBreadcrumb"
                    Grid.Column="7"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeXS}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{Binding HistoryBreadcrumb, FallbackValue='No recent action'}" />

                <!--  Col 8: Clear History  -->
                <Button
                    Grid.Column="8"
                    Margin="0,0,4,0"
                    Padding="6,3"
                    VerticalAlignment="Center"
                    Click="ClearHistory_Click"
                    Content="Clear History"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeXS}"
                    Style="{StaticResource ToolbarButton}" />

                <!--  Col 9: Dimension tool  -->
                <Button
                    x:Name="BtnDimensionTool"
                    Grid.Column="9"
                    Width="22"
                    Height="22"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnDimensionTool_Click"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Dimension Tool — measure distances (D)">
                    <TextBlock FontSize="{StaticResource FontSizeSM}" Text="📏" />
                </Button>

                <!--  Col 10: App title (centred)  -->
                <TextBlock
                    Grid.Column="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeXS}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="IFC Building Analyzer — Crane Planner Edition" />

                <!--  Col 11: Window chrome  -->
                <StackPanel Grid.Column="11" Orientation="Horizontal">
                    <Button
                        Width="40"
                        Height="28"
                        Click="MinimizeWindow_Click"
                        Content="🗕"
                        Style="{StaticResource TitleBarButton}" />
                    <Button
                        x:Name="MaximizeButton"
                        Width="40"
                        Height="28"
                        Click="MaximizeWindow_Click"
                        Content="☐"
                        Style="{StaticResource TitleBarButton}" />
                    <Button
                        Width="40"
                        Height="28"
                        Click="CloseWindow_Click"
                        Content="✕"
                        Style="{StaticResource CloseButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 1 — DRAWING OPTIONS BAR (collapsed by default)
            ══════════════════════════════════════════════════════════════════
        -->
        <!-- <zones:DrawingOptionsBar x:Name="DrawingOptionsBar" Grid.Row="1" Visibility="Collapsed"/> -->

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 2 — MAIN RIBBON
            ══════════════════════════════════════════════════════════════════
        -->
        <nav:TopNavigation Grid.Row="2" />

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 3 — MAIN CONTENT AREA
            ══════════════════════════════════════════════════════════════════
        -->
        <Grid Grid.Row="3" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250" />
                <!--  Col 0: Element Details  -->
                <ColumnDefinition Width="8" />
                <!--  Col 1: Splitter  -->
                <ColumnDefinition Width="*" MinWidth="400" />
                <!--  Col 2: 3D Viewport  -->
                <ColumnDefinition Width="8" />
                <!--  Col 3: Splitter  -->
                <ColumnDefinition x:Name="RightWorkspaceColumn" Width="360" MinWidth="330" MaxWidth="380" />
                <!--  Col 4: Crane + Zones / AI assist dock  -->
            </Grid.ColumnDefinitions>

            <!--  ── Col 0: Elements list + Properties (F5 module) ───────────  -->
            <f5:ElementManagementPanel Grid.Column="0" DataContext="{Binding ElementManagement}" />

            <!--  ── Col 1: Vertical splitter ────────────────────────────────  -->
            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Resize Element Properties panel"
                Background="Transparent"
                Cursor="SizeWE"
                Focusable="True"
                ShowsPreview="True"
                ToolTip="Resize the Element Properties panel">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border
                            Width="1"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource BorderBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=GridSplitter}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="1,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!--  ── Col 2: 3D Viewport ───────────────────────────────────────  -->
            <f1:IfcViewerControl x:Name="IfcViewerHost" Grid.Column="2" />

            <!--  ── Col 3: Vertical splitter ────────────────────────────────  -->
            <GridSplitter
                Grid.Column="3"
                Width="8"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Resize Crane Properties panel"
                Background="Transparent"
                Cursor="SizeWE"
                Focusable="True"
                ShowsPreview="True"
                ToolTip="Resize the Crane Properties panel">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border
                            Width="1"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource BorderBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=GridSplitter}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="1,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!--
                ── Col 4: Right dock workspace ─────────────────────────────
                Professional shell layout: AI assistance is docked as a tab beside
                the existing properties panel instead of floating over crane controls.
            -->
            <Border
                Grid.Column="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
                <TabControl
                    x:Name="RightWorkspaceTabs"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderThickness="0"
                    SelectedIndex="0"
                    SelectionChanged="RightWorkspaceTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
                            <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="12,7" />
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TabItem}">
                                        <Grid Margin="0,0,2,0" SnapsToDevicePixels="True">
                                            <Border
                                                x:Name="TabChrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1,1,1,0">
                                                <Grid>
                                                    <Border
                                                        x:Name="SelectedAccent"
                                                        Height="2"
                                                        VerticalAlignment="Top"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        Opacity="0" />

                                                    <ContentPresenter
                                                        x:Name="ContentSite"
                                                        Margin="{TemplateBinding Padding}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        ContentSource="Header"
                                                        RecognizesAccessKey="True" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="SelectedAccent" Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="CRANE PROPERTIES">
                        <f3:CraneManagerView DataContext="{Binding CraneManager}" />
                    </TabItem>

                    <TabItem x:Name="AiAssistTab" Visibility="Collapsed">
                        <TabItem.Header>
                            <DockPanel LastChildFill="False">
                                <TextBlock VerticalAlignment="Center" Text="AI ASSIST" />
                                <Button
                                    Width="16"
                                    Height="16"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="CloseAiAssistTab_Click"
                                    Content="×"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Style="{StaticResource ToolbarButton}"
                                    ToolTip="Close AI Assist tab" />
                            </DockPanel>
                        </TabItem.Header>
                        <aiCompanion:AiCompanionPanel x:Name="AiAssistPanel" CloseRequested="AiCompanionPanel_CloseRequested" />
                    </TabItem>
                </TabControl>
            </Border>

        </Grid>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 4 — STATUS BAR
            ══════════════════════════════════════════════════════════════════
        -->
        <Border
            Grid.Row="4"
            Padding="10,0"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390" />
                    <!--  Col 0: Fixed X / Y / Z coordinates  -->
                    <ColumnDefinition Width="*" />
                    <!--  Col 1: Centered viewport settings  -->
                    <ColumnDefinition Width="360" />
                    <!--  Col 2: AI companion notification  -->
                </Grid.ColumnDefinitions>

                <!--  Col 0: X / Y / Z coordinates  -->
                <Grid Grid.Column="0" Width="390" Margin="10,0" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,8,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,3,0"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Style="{StaticResource CoordLabel}"
                            Text="X:" />
                        <TextBlock
                            x:Name="TxtCoordX"
                            Grid.Column="1"
                            Style="{StaticResource CoordLabel}"
                            Text="{Binding CoordX, FallbackValue='0.00M'}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding CoordX}" />
                    </Grid>

                    <Grid Grid.Column="1" Margin="0,0,8,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,3,0"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Style="{StaticResource CoordLabel}"
                            Text="Y:" />
                        <TextBlock
                            x:Name="TxtCoordY"
                            Grid.Column="1"
                            Style="{StaticResource CoordLabel}"
                            Text="{Binding CoordY, FallbackValue='0.00M'}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding CoordY}" />
                    </Grid>

                    <Grid Grid.Column="2" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,3,0"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Style="{StaticResource CoordLabel}"
                            Text="Z:" />
                        <TextBlock
                            x:Name="TxtCoordZ"
                            Grid.Column="1"
                            Style="{StaticResource CoordLabel}"
                            Text="{Binding CoordZ, FallbackValue='0.00M'}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding CoordZ}" />
                    </Grid>
                </Grid>

                <!--  Col 1: Render Quality and Object Snap  -->
                <Grid
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Render Quality" />
                    <ComboBox
                        x:Name="ShellRenderQualityCombo"
                        Grid.Column="1"
                        Width="112"
                        Height="20"
                        VerticalAlignment="Center"
                        ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                        SelectedIndex="1"
                        SelectionChanged="RenderQualityCombo_SelectionChanged"
                        Style="{StaticResource DarkComboBox}"
                        ToolTip="High: detailed IFC meshes. Medium: simplified meshes. Low: batched boxes for large models.">
                        <ComboBoxItem Content="High" Tag="High" ToolTip="Full detailed IFC meshes with best visual quality." />
                        <ComboBoxItem Content="Medium" Tag="Medium" ToolTip="Simplified IFC meshes with reduced geometry complexity." />
                        <ComboBoxItem Content="Low" Tag="Low" ToolTip="Lightweight batched bounding boxes for maximum performance." />
                    </ComboBox>

                    <Rectangle
                        Grid.Column="2"
                        Width="1"
                        Height="12"
                        Margin="10,0"
                        Fill="{DynamicResource BorderBrush}" />

                    <osnap:OsnapStatusPanel
                        x:Name="ShellOsnapPanel"
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>

                <!--  Col 2: AI companion notification  -->
                <Grid
                    Grid.Column="2"
                    Width="360"
                    ClipToBounds="True">
                    <aiCompanion:AiCompanionStatusStrip
                        x:Name="AiCompanionStrip"
                        Width="360"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ClipToBounds="True"
                        AssistRequested="AiCompanionStatusStrip_AssistRequested"
                        HideRequested="AiCompanionStatusStrip_HideRequested" />

                    <Button
                        x:Name="ShowAiCompanionButton"
                        MinWidth="70"
                        Height="18"
                        Padding="7,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="ShowAiCompanionButton_Click"
                        Content="AI Assist"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Show AI Companion in the status bar"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
