<Window
    x:Class="CraneOptimizer.UI.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:f5="clr-namespace:CraneOptimizer.UI.Features.F5_ElementManagement.Views"
    xmlns:f7="clr-namespace:CraneOptimizer.UI.Features.F7_Zones.Views"
    xmlns:f1="clr-namespace:CraneOptimizer.UI.Features.F1_IfcViewerControl.Views"
    xmlns:f3="clr-namespace:CraneOptimizer.UI.Features.F3_CraneSetup.Views"
    xmlns:osnap="clr-namespace:CraneOptimizer.UI.Features.F15_ObjectSnap.Views"
    xmlns:aiCompanion="clr-namespace:CraneOptimizer.AI.Companion.Views;assembly=CraneOptimizer.AI"
    xmlns:nav="clr-namespace:CraneOptimizer.UI.Shared.Layouts"
    xmlns:shellVm="clr-namespace:CraneOptimizer.UI.Shell.ViewModels"
    Title="IFC Building Analyzer &#x2014; Crane Planner Edition"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
    Width="1600"
    Height="800"
    AllowsTransparency="True"
    Background="{DynamicResource BackgroundBrush}"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowState="Normal"
    WindowStyle="None">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding IfcViewer.CancelPlacementCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="QuickAccessIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <!--
        ROOT GRID أ¢â‚¬â€‌ compensates for WPF WindowStyle=None + AllowsTransparency=True
        maximized-overflow bug: adds 8px inset only when Maximized.
    -->
    <Grid Style="{StaticResource MaximizedWindowGridStyle}">

        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <!--  Row 0: Title bar + quick-access toolbar  -->
            <RowDefinition Height="Auto" />
            <!--  Row 1: Drawing options bar (collapsed)  -->
            <RowDefinition Height="Auto" />
            <!--  Row 2: Main ribbon (bottom border = orange accent line)  -->
            <RowDefinition Height="*" />
            <!--  Row 3: Main content area  -->
            <RowDefinition Height="26" />
            <!--  Row 4: Status bar  -->
        </Grid.RowDefinitions>

        <!--
            أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯
            ROW 0 أ¢â‚¬â€‌ TITLE BAR + QUICK-ACCESS TOOLBAR
            أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯
        -->
        <Border
            Grid.Row="0"
            Grid.IsSharedSizeScope="True"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TitleBarSide" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TitleBarSide" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <!--  Col 0: App icon  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Col 1: Home / welcome btn  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Col 2: Separator  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Col 3: Undo / Redo btns  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Col 4: Separator  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Col 5: Filter  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Col 6: Dimension tool  -->
                    </Grid.ColumnDefinitions>

                <!--  Col 0: App icon  -->
                <Border
                    Grid.Column="0"
                    Width="28"
                    Height="28"
                    Background="{StaticResource PrimaryBrush}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSM}"
                        Text="&#x1F3D7;" />
                </Border>

                <!--  Col 1: Home / Back-to-Welcome button  -->
                <Button
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Click="BackToWelcome_Click"
                    Style="{StaticResource QuickAccessIconButtonStyle}"
                    ToolTip="Back to Welcome (Home)">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Text="&#x1F3E0;" />
                </Button>

                <!--  Col 2: Separator  -->
                <Rectangle
                    Grid.Column="2"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 3: Undo / Redo  -->
                <StackPanel
                    Grid.Column="3"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,1,0"
                        x:Name="UndoButton"
                        Click="UndoBtn_Click"
                        Style="{StaticResource QuickAccessIconButtonStyle}"
                        ToolTip="Undo (Ctrl+Z)">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Text="&#x21A9;" />
                    </Button>
                    <Button
                        Margin="0,0,1,0"
                        x:Name="RedoButton"
                        Click="RedoBtn_Click"
                        Style="{StaticResource QuickAccessIconButtonStyle}"
                        ToolTip="Redo (Ctrl+Y)">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Text="&#x21AA;" />
                    </Button>
                </StackPanel>

                <!--  Col 4: Separator  -->
                <Rectangle
                    Grid.Column="4"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 5: Filter  -->
                <Button
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Filter"
                    Command="{Binding ElementManagement.ShowFilterDialogCommand}"
                    IsEnabled="{Binding IfcViewer.HasIfcModel}"
                    Style="{StaticResource QuickAccessIconButtonStyle}"
                    ToolTip="Choose which IFC elements are visible in the 3D view.">
                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path
                            Data="M 1,2 H 15 L 10,8 V 14 H 6 V 8 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Viewbox>
                </Button>

                <!--  Col 6: Measure tool  -->
                <Button
                    x:Name="BtnDimensionTool"
                    Grid.Column="6"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Measure"
                    Command="{Binding Drawing.StartMeasureCommand}"
                    ToolTip="Measure distances and points in the 3D view.">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource QuickAccessIconButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Drawing.IsMeasuring}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryMutedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Text="&#x1F4CF;" />
                </Button>

                </Grid>

                <!--  Centre: current project name  -->
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    ToolTip="{Binding CurrentProjectName}"
                    Text="{Binding CurrentProjectName, TargetNullValue='No Project Open', FallbackValue='No Project Open'}" />

                <!--  Right: window caption buttons  -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="40"
                        Height="28"
                        Click="MinimizeWindow_Click"
                        Content="&#x1F5D5;"
                        Style="{StaticResource TitleBarButton}" />
                    <Button
                        x:Name="MaximizeButton"
                        Width="40"
                        Height="28"
                        Click="MaximizeWindow_Click"
                        Content="&#x2610;"
                        Style="{StaticResource TitleBarButton}" />
                    <Button
                        Width="40"
                        Height="28"
                        Click="CloseWindow_Click"
                        Content="&#x2715;"
                        Style="{StaticResource CloseButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯
            ROW 1 أ¢â‚¬â€‌ DRAWING OPTIONS BAR (collapsed by default)
            أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯
        -->
        <!-- <zones:DrawingOptionsBar x:Name="DrawingOptionsBar" Grid.Row="1" Visibility="Collapsed"/> -->

        <!--
            أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯
            ROW 2 أ¢â‚¬â€‌ MAIN RIBBON
            أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯
        -->
        <nav:TopNavigation Grid.Row="2" />

        <!--
            أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯
            ROW 4 أ¢â‚¬â€‌ MAIN CONTENT AREA
            أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯
        -->
        <Grid Grid.Row="3" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250" />
                <!--  Col 0: Element Details  -->
                <ColumnDefinition Width="1" />
                <!--  Col 1: Splitter  -->
                <ColumnDefinition Width="*" MinWidth="400" />
                <!--  Col 2: 3D Viewport  -->
                <ColumnDefinition Width="1" />
                <!--  Col 3: Splitter  -->
                <ColumnDefinition x:Name="RightWorkspaceColumn" Width="360" MinWidth="360" MaxWidth="380" />
                <!--  Col 4: Permanent Crane Manager / AI Assistant workspace  -->
            </Grid.ColumnDefinitions>

            <!--  Col 0: Existing left workspace, shared by element and zone inspectors.  -->
            <Border Grid.Column="0" Style="{StaticResource MainWorkspacePanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource RightWorkspaceTabHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton
                                Grid.Column="0"
                                AutomationProperties.Name="Element Properties workspace tab"
                                Command="{Binding SelectLeftWorkspaceTabCommand}"
                                CommandParameter="{x:Static shellVm:LeftWorkspaceTab.ElementProperties}"
                                Content="ELEMENT PROPERTIES"
                                GroupName="LeftWorkspaceTabs"
                                IsChecked="{Binding IsElementPropertiesWorkspaceTabSelected, Mode=OneWay}"
                                Style="{StaticResource RightWorkspaceTabStyle}" />

                            <RadioButton
                                Grid.Column="1"
                                AutomationProperties.Name="Zone Manager workspace tab"
                                Command="{Binding SelectLeftWorkspaceTabCommand}"
                                CommandParameter="{x:Static shellVm:LeftWorkspaceTab.ZoneManager}"
                                Content="ZONE MANAGER"
                                GroupName="LeftWorkspaceTabs"
                                IsChecked="{Binding IsZoneManagerWorkspaceTabSelected, Mode=OneWay}"
                                Style="{StaticResource RightWorkspaceTabStyle}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource MainWorkspacePanelBodyStyle}">
                        <Grid>
                            <f5:ElementManagementPanel DataContext="{Binding ElementManagement}">
                                <f5:ElementManagementPanel.Style>
                                    <Style TargetType="{x:Type f5:ElementManagementPanel}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding DataContext.SelectedLeftWorkspaceTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                Value="{x:Static shellVm:LeftWorkspaceTab.ZoneManager}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </f5:ElementManagementPanel.Style>
                            </f5:ElementManagementPanel>

                            <f7:ZoneListView DataContext="{Binding Drawing.ZoneList}">
                                <f7:ZoneListView.Style>
                                    <Style TargetType="{x:Type f7:ZoneListView}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding DataContext.SelectedLeftWorkspaceTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                Value="{x:Static shellVm:LeftWorkspaceTab.ZoneManager}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </f7:ZoneListView.Style>
                            </f7:ZoneListView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  أ¢â€‌â‚¬أ¢â€‌â‚¬ Col 1: Vertical splitter أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬  -->
            <GridSplitter
                Grid.Column="1"
                AutomationProperties.Name="Resize Element Properties panel"
                Panel.ZIndex="1"
                Style="{StaticResource WorkspaceVerticalSplitterStyle}"
                ToolTip="Resize the Element Properties panel">
            </GridSplitter>

            <!--  أ¢â€‌â‚¬أ¢â€‌â‚¬ Col 2: 3D Viewport أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬  -->
            <f1:IfcViewerControl x:Name="IfcViewerHost" Grid.Column="2" />

            <!--  أ¢â€‌â‚¬أ¢â€‌â‚¬ Col 3: Vertical splitter أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬أ¢â€‌â‚¬  -->
            <GridSplitter
                Grid.Column="3"
                AutomationProperties.Name="Resize right workspace panel"
                Panel.ZIndex="1"
                Style="{StaticResource WorkspaceVerticalSplitterStyle}"
                ToolTip="Resize the right workspace panel">
            </GridSplitter>

            <!--
                Col 4: Permanent right workspace
                The GridSplitter in Col 3 owns the single panel divider.
                Both tabs reuse one bounded column and one flat panel shell.
            -->
            <Border
                Grid.Column="4"
                Style="{StaticResource RightWorkspacePanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- One flat tab header; the active tab owns the only orange underline. -->
                    <Border Grid.Row="0" Style="{StaticResource RightWorkspaceTabHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton
                                Grid.Column="0"
                                AutomationProperties.Name="Crane Manager workspace tab"
                                Command="{Binding SelectRightWorkspaceTabCommand}"
                                CommandParameter="{x:Static shellVm:RightWorkspaceTab.CraneManager}"
                                Content="CRANE MANAGER"
                                GroupName="RightWorkspaceTabs"
                                IsChecked="{Binding IsCraneManagerWorkspaceTabSelected, Mode=OneWay}"
                                Style="{StaticResource RightWorkspaceTabStyle}" />

                            <RadioButton
                                Grid.Column="1"
                                AutomationProperties.Name="AI Assistant workspace tab"
                                Command="{Binding SelectRightWorkspaceTabCommand}"
                                CommandParameter="{x:Static shellVm:RightWorkspaceTab.AiAssistant}"
                                Content="AI ASSISTANT"
                                GroupName="RightWorkspaceTabs"
                                IsChecked="{Binding IsAiAssistantWorkspaceTabSelected, Mode=OneWay}"
                                Style="{StaticResource RightWorkspaceTabStyle}" />
                        </Grid>
                    </Border>

                    <!-- Both existing views stay mounted; selection only changes visibility. -->
                    <Border Grid.Row="1" Style="{StaticResource RightWorkspacePanelBodyStyle}">
                        <Grid>
                            <f3:CraneManagerView
                                DataContext="{Binding CraneManager}">
                                <f3:CraneManagerView.Style>
                                    <Style TargetType="{x:Type f3:CraneManagerView}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding DataContext.SelectedRightWorkspaceTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                Value="{x:Static shellVm:RightWorkspaceTab.AiAssistant}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </f3:CraneManagerView.Style>
                            </f3:CraneManagerView>

                            <aiCompanion:AiCompanionPanel
                                x:Name="AiAssistPanel"
                                ShowHeader="False">
                                <aiCompanion:AiCompanionPanel.Style>
                                    <Style TargetType="{x:Type aiCompanion:AiCompanionPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding DataContext.SelectedRightWorkspaceTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                Value="{x:Static shellVm:RightWorkspaceTab.AiAssistant}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </aiCompanion:AiCompanionPanel.Style>
                            </aiCompanion:AiCompanionPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--
            أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯
            ROW 4 أ¢â‚¬â€‌ STATUS BAR
            أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯أ¢â€¢ع¯
        -->
        <Border
            Grid.Row="4"
            Padding="10,0"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500" />
                    <!--  Col 0: Fixed X / Y / Z coordinates  -->
                    <ColumnDefinition Width="*" />
                    <!--  Col 1: Viewport settings, right-aligned  -->
                </Grid.ColumnDefinitions>

                <!--  Col 0: X / Y / Z coordinates  -->
                <Grid Grid.Column="0" Width="500" Margin="10,0" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="240" />
                        <!--  Z is wider: it also carries the "[Default Local Z]" suffix  -->
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,8,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,3,0"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            FontSize="11" Style="{StaticResource CoordLabel}"
                            Text="X:" />
                        <TextBlock
                            x:Name="TxtCoordX"
                            Grid.Column="1"
                            FontSize="11" Style="{StaticResource CoordLabel}"
                            Text="{Binding CoordX, FallbackValue='0.00M'}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding CoordX}" />
                    </Grid>

                    <Grid Grid.Column="1" Margin="0,0,8,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,3,0"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            FontSize="11" Style="{StaticResource CoordLabel}"
                            Text="Y:" />
                        <TextBlock
                            x:Name="TxtCoordY"
                            Grid.Column="1"
                            FontSize="11" Style="{StaticResource CoordLabel}"
                            Text="{Binding CoordY, FallbackValue='0.00M'}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding CoordY}" />
                    </Grid>

                    <Grid Grid.Column="2" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,3,0"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            FontSize="11" Style="{StaticResource CoordLabel}"
                            Text="Z:" />
                        <TextBlock
                            x:Name="TxtCoordZ"
                            Grid.Column="1"
                            FontSize="11" Style="{StaticResource CoordLabel}"
                            Text="{Binding CoordZ, FallbackValue='0.00M'}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding CoordZ}" />
                    </Grid>
                </Grid>

                <!--  Col 1: Render Quality and Object Snap  -->
                <Grid
                    Grid.Column="1"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Render Quality" />
                    <ComboBox
                        x:Name="ShellRenderQualityCombo"
                        Grid.Column="1"
                        Width="112"
                        Height="22"
                        FontSize="11"
                        VerticalAlignment="Center"
                        ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                        SelectedIndex="1"
                        SelectionChanged="RenderQualityCombo_SelectionChanged"
                        Style="{StaticResource DarkComboBox}"
                        ToolTip="High: detailed IFC meshes. Medium: simplified meshes. Low: batched boxes for large models.">
                        <ComboBoxItem Content="High" Tag="High" ToolTip="Full detailed IFC meshes with best visual quality." />
                        <ComboBoxItem Content="Medium" Tag="Medium" ToolTip="Simplified IFC meshes with reduced geometry complexity." />
                        <ComboBoxItem Content="Low" Tag="Low" ToolTip="Lightweight batched bounding boxes for maximum performance." />
                    </ComboBox>

                    <Rectangle
                        Grid.Column="2"
                        Width="1"
                        Height="12"
                        Margin="10,0"
                        Fill="{DynamicResource BorderBrush}" />

                    <osnap:OsnapStatusPanel
                        x:Name="ShellOsnapPanel"
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
