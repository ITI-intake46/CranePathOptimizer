<Window
    x:Class="CraneOptimizer.UI.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helix="http://helix-toolkit.org/wpf"
    xmlns:nav="clr-namespace:CraneOptimizer.UI.Shared.Layouts"
    Title="IFC Building Analyzer — Crane Planner Edition"
    Width="1600"
    Height="800"
    AllowsTransparency="True"
    Background="{DynamicResource BackgroundBrush}"
    ResizeMode="CanResize"
    WindowState="Maximized"
    WindowStyle="None">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <!--  ================= TITLE BAR =================  -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource SurfaceElevatedBrush}"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Left  -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="🏠" />
                    <Button Content="💾" />
                </StackPanel>

                <!--  Center  -->
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="IFC Building Analyzer — Crane Planner Edition" />

                <!--  Right  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="MinimizeWindow_Click" Content="🗕" />
                    <Button Click="MaximizeWindow_Click" Content="☐" />
                    <Button Click="CloseWindow_Click" Content="✕" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ================= RIBBON =================  -->
        <nav:TopNavigation Grid.Row="2" />

        <!--  ================= MAIN =================  -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  LEFT PANEL  -->
            <StackPanel Grid.Column="0">

                <!--  Elements  -->
                <ItemsControl ItemsSource="{Binding FilteredElements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="5"
                                MouseLeftButtonDown="ElementItem_Click"
                                Tag="{Binding}">
                                <TextBlock Text="{Binding DisplayName}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Selected Element  -->
                <TextBlock Margin="5" Text="{Binding SelectedElementName, FallbackValue='No element selected'}" />
            </StackPanel>

            <!--  3D VIEW  -->
            <Grid Grid.Column="1">
                <helix:HelixViewport3D x:Name="IfcViewer" />

                <!--  Overlay  -->
                <Border Background="#66000000">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="NO IFC MODEL" />
                </Border>
            </Grid>
        </Grid>

        <!--  ================= STATUS BAR =================  -->
        <Border Grid.Row="5" Background="{DynamicResource SurfaceElevatedBrush}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Status  -->
                <TextBlock Margin="5" Text="{Binding StatusText, FallbackValue=IDLE}" />

                <!--  Coordinates  -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding CoordX}" />
                    <TextBlock Margin="10,0,0,0" Text="{Binding CoordY}" />
                </StackPanel>

                <!--  Right  -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

                    <TextBlock Margin="5" Text="{Binding RenderQualityLabel}" />

                    <TextBlock Margin="10,0,0,0" Text="{Binding HistoryBreadcrumb}" />

                    <TextBlock Margin="10,0,0,0" Text="{Binding Elements.Count}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>