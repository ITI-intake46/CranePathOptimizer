<Window
    x:Class="CraneOptimizer.UI.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helix="http://helix-toolkit.org/wpf"
    xmlns:osnap="clr-namespace:CraneOptimizer.UI.Features.F15_ObjectSnap.Views"
    xmlns:nav="clr-namespace:CraneOptimizer.UI.Shared.Layouts"
    Title="IFC Building Analyzer — Crane Planner Edition"
    Width="1600"
    Height="800"
    AllowsTransparency="True"
    Background="{DynamicResource BackgroundBrush}"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowState="Maximized"
    WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding IfcViewer.CancelPlacementCommand}" />
    </Window.InputBindings>

    <!--
        ROOT GRID — compensates for WPF WindowStyle=None + AllowsTransparency=True
        maximized-overflow bug: adds 8px inset only when Maximized.
    -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                        <Setter Property="Margin" Value="8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <!--  Row 0: Title bar + quick-access toolbar  -->
            <RowDefinition Height="Auto" />
            <!--  Row 1: Drawing options bar (collapsed)  -->
            <RowDefinition Height="Auto" />
            <!--  Row 2: Main ribbon  -->
            <RowDefinition Height="Auto" />
            <!--  Row 3: Building info bar  -->
            <RowDefinition Height="*" />
            <!--  Row 4: Main content area  -->
            <RowDefinition Height="22" />
            <!--  Row 5: Status bar  -->
        </Grid.RowDefinitions>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 0 — TITLE BAR + QUICK-ACCESS TOOLBAR
            ══════════════════════════════════════════════════════════════════
        -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <!--  Col 0:  App icon  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 1:  Home / welcome btn  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 2:  Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 3:  Save btn  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 4:  Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 5:  Undo / Redo btns  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 6:  Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 7:  History breadcrumb  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 8:  Clear history  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 9:  Dimension tool  -->
                    <ColumnDefinition Width="*" />
                    <!--  Col 10: Title (centred)  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 11: Window chrome  -->
                </Grid.ColumnDefinitions>

                <!--  Col 0: App icon  -->
                <Border
                    Grid.Column="0"
                    Width="28"
                    Height="28"
                    Background="{StaticResource PrimaryBrush}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="🏗" />
                </Border>

                <!--  Col 1: Home / Back-to-Welcome button  -->
                <Button
                    Grid.Column="1"
                    Width="26"
                    Height="22"
                    Margin="4,0,0,0"
                    Click="BackToWelcome_Click"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Back to Welcome (Home)">
                    <TextBlock FontSize="{StaticResource FontSizeSM}" Text="🏠" />
                </Button>

                <!--  Col 2: Separator  -->
                <Rectangle
                    Grid.Column="2"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 3: Save  -->
                <Button
                    Grid.Column="3"
                    Width="26"
                    Height="22"
                    Click="SaveProject_Click"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Save Project (Ctrl+S)">
                    <TextBlock FontSize="{StaticResource FontSizeSM}" Text="💾" />
                </Button>

                <!--  Col 4: Separator  -->
                <Rectangle
                    Grid.Column="4"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 5: Undo / Redo  -->
                <StackPanel
                    Grid.Column="5"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="26"
                        Height="20"
                        Margin="0,0,1,0"
                        Click="UndoBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Undo (Ctrl+Z)">
                        <TextBlock
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="↩" />
                    </Button>
                    <TextBlock
                        x:Name="TxtUndoLabel"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Undo" />
                    <Button
                        Width="26"
                        Height="20"
                        Margin="0,0,1,0"
                        Click="RedoBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Redo (Ctrl+Y)">
                        <TextBlock
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="↪" />
                    </Button>
                    <TextBlock
                        x:Name="TxtRedoLabel"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Redo" />
                </StackPanel>

                <!--  Col 6: Separator  -->
                <Rectangle
                    Grid.Column="6"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 7: Last action breadcrumb — ✅ NOW BOUND TO VIEWMODEL  -->
                <TextBlock
                    x:Name="TxtHistoryBreadcrumb"
                    Grid.Column="7"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeXS}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding HistoryBreadcrumb, FallbackValue='No recent action'}" />

                <!--  Col 8: Clear History  -->
                <Button
                    Grid.Column="8"
                    Margin="0,0,4,0"
                    Padding="6,3"
                    VerticalAlignment="Center"
                    Click="ClearHistory_Click"
                    Content="Clear History"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeXS}"
                    Style="{StaticResource ToolbarButton}" />

                <!--  Col 9: Dimension tool  -->
                <Button
                    x:Name="BtnDimensionTool"
                    Grid.Column="9"
                    Width="22"
                    Height="22"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnDimensionTool_Click"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Dimension Tool — measure distances (D)">
                    <TextBlock FontSize="{StaticResource FontSizeSM}" Text="📏" />
                </Button>

                <!--  Col 10: App title (centred)  -->
                <TextBlock
                    Grid.Column="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeXS}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="IFC Building Analyzer — Crane Planner Edition" />

                <!--  Col 11: Window chrome  -->
                <StackPanel Grid.Column="11" Orientation="Horizontal">
                    <Button
                        Width="40"
                        Height="28"
                        Click="MinimizeWindow_Click"
                        Content="🗕"
                        Style="{StaticResource TitleBarButton}" />
                    <Button
                        x:Name="MaximizeButton"
                        Width="40"
                        Height="28"
                        Click="MaximizeWindow_Click"
                        Content="☐"
                        Style="{StaticResource TitleBarButton}" />
                    <Button
                        Width="40"
                        Height="28"
                        Click="CloseWindow_Click"
                        Content="✕"
                        Style="{StaticResource CloseButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 1 — DRAWING OPTIONS BAR (collapsed by default)
            ══════════════════════════════════════════════════════════════════
        -->
        <!-- <zones:DrawingOptionsBar x:Name="DrawingOptionsBar" Grid.Row="1" Visibility="Collapsed"/> -->

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 2 — MAIN RIBBON
            ══════════════════════════════════════════════════════════════════
        -->
        <nav:TopNavigation Grid.Row="2" />

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 3 — BUILDING INFO BAR
            ══════════════════════════════════════════════════════════════════
        -->
        <Border
            Grid.Row="3"
            Padding="12,0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Storeys  -->
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Style="{StaticResource PropertyLabel}"
                    Text="Storeys:" />
                <TextBlock
                    x:Name="txtNumberOfStoreys"
                    Grid.Column="1"
                    Margin="0,0,20,0"
                    Foreground="{StaticResource PrimaryBrush}"
                    Style="{StaticResource PropertyValue}"
                    Text="{Binding NumberOfStoreys, FallbackValue='0'}" />

                <!--  Area  -->
                <TextBlock
                    Grid.Column="2"
                    Margin="0,0,4,0"
                    Style="{StaticResource PropertyLabel}"
                    Text="Area:" />
                <TextBlock
                    Grid.Column="3"
                    Margin="0,0,20,0"
                    Style="{StaticResource PropertyValue}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F2} {1}">
                            <Binding FallbackValue="0.00" Path="BuildingArea" />
                            <Binding FallbackValue="m²" Path="AreaUnit" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!--  Height  -->
                <TextBlock
                    Grid.Column="4"
                    Margin="0,0,4,0"
                    Style="{StaticResource PropertyLabel}"
                    Text="Height:" />
                <TextBlock
                    Grid.Column="5"
                    Margin="0,0,20,0"
                    Style="{StaticResource PropertyValue}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F2} {1}">
                            <Binding FallbackValue="0.00" Path="BuildingHeight" />
                            <Binding FallbackValue="m" Path="SelectedUnit" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!--  Unit selector  -->
                <TextBlock
                    Grid.Column="6"
                    Margin="0,0,6,0"
                    Style="{StaticResource PropertyLabel}"
                    Text="Unit:" />
                <ComboBox
                    x:Name="UnitSelector"
                    Grid.Column="7"
                    Width="60"
                    Height="20"
                    Margin="0,0,20,0"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeSM}"
                    FontWeight="SemiBold"
                    ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                    ItemsSource="{Binding AvailableUnits}"
                    SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                    Style="{StaticResource DarkComboBox}" />

                <!--  Building name  -->
                <Rectangle
                    Grid.Column="8"
                    Width="1"
                    Height="14"
                    Margin="0,0,12,0"
                    Fill="{DynamicResource BorderBrush}" />
                <TextBlock
                    x:Name="txtBuildingName"
                    Grid.Column="9"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeSM}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding BuildingName, FallbackValue='No Building Loaded'}" />
            </Grid>
        </Border>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 4 — MAIN CONTENT AREA
            ══════════════════════════════════════════════════════════════════
        -->
        <Grid Grid.Row="4" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200" />
                <!--  Col 0: Elements + Props  -->
                <ColumnDefinition Width="4" />
                <!--  Col 1: Splitter  -->
                <ColumnDefinition Width="*" MinWidth="400" />
                <!--  Col 2: 3D Viewport  -->
                <ColumnDefinition Width="4" />
                <!--  Col 3: Splitter  -->
                <ColumnDefinition Width="280" MinWidth="220" />
                <!--  Col 4: Crane + Zones  -->
            </Grid.ColumnDefinitions>

            <!--  ── Col 0: Elements list + Properties ───────────────────────  -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  Elements header  -->
                        <RowDefinition Height="*" />
                        <!--  Elements list  -->
                        <RowDefinition Height="4" />
                        <!--  H-splitter  -->
                        <RowDefinition Height="200" MinHeight="130" />
                        <!--  Properties  -->
                    </Grid.RowDefinitions>

                    <!--  Elements header  -->
                    <Border
                        Grid.Row="0"
                        Height="30"
                        Padding="10,0"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <!--  Active filter indicator stripe  -->
                                <Border
                                    Width="3"
                                    Height="12"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource PrimaryBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Style="{StaticResource PanelSectionHeader}" Text="BUILDING ELEMENTS" />
                            </StackPanel>

                            <!--  Count badge  -->
                            <Border
                                Grid.Column="1"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeXS}"
                                    FontWeight="SemiBold"
                                    Text="{Binding CountLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                                    <Setter Property="Foreground" Value="#1A1A1A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  Elements list  -->
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredElements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="ElementBorder"
                                        MouseLeftButtonDown="ElementItem_Click"
                                        Style="{StaticResource ElementListItem}"
                                        Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse
                                                Grid.Column="0"
                                                Width="7"
                                                Height="7"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock
                                                    FontFamily="{StaticResource FontPrimary}"
                                                    FontSize="{StaticResource FontSizeSM}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <Run Text="{Binding DisplayName}" />
                                                </TextBlock>
                                                <TextBlock
                                                    Margin="0,1,0,0"
                                                    FontFamily="{StaticResource FontPrimary}"
                                                    FontSize="{StaticResource FontSizeXS}"
                                                    Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Type}" />
                                                    <Run Foreground="{DynamicResource BorderBrush}" Text=" | " />
                                                    <Run Text="{Binding Mark, FallbackValue='—'}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                <Condition Binding="{Binding ElementColor}" Value="#E74C3C" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource HeavySelectedBrush}" />
                                            <Setter TargetName="ElementBorder" Property="BorderBrush" Value="{StaticResource DestructiveBrush}" />
                                            <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                <Condition Binding="{Binding ElementColor}" Value="#F39C12" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource MediumSelectedBrush}" />
                                            <Setter TargetName="ElementBorder" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                            <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                <Condition Binding="{Binding ElementColor}" Value="#FFFFFF" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource NormalSelectedBrush}" />
                                            <Setter TargetName="ElementBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--  Horizontal splitter (Elements / Properties)  -->
                    <GridSplitter
                        Grid.Row="2"
                        Height="4"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource BorderBrush}"
                        Cursor="SizeNS"
                        ShowsPreview="True" />

                    <!--  Properties panel  -->
                    <Border
                        Grid.Row="3"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Properties header  -->
                            <Border
                                Grid.Row="0"
                                Height="26"
                                Padding="10,0"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                                <TextBlock Style="{StaticResource PanelSectionHeader}" Text="PROPERTIES" />
                            </Border>

                            <!--  Selected element display — ✅ NOW BOUND TO VIEWMODEL  -->
                            <Border
                                Grid.Row="1"
                                Padding="6,5"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                                <Border
                                    Padding="6,4"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource PrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            Foreground="{StaticResource PrimaryBrush}"
                                            Text="🔍" />
                                        <TextBlock
                                            x:Name="TxtSelectedElementName"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource FontPrimary}"
                                            FontSize="{StaticResource FontSizeSM}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource PrimaryBrush}"
                                            Text="{Binding SelectedElementName, FallbackValue='No element selected'}" />
                                    </StackPanel>
                                </Border>
                            </Border>

                            <!--  Properties rows  -->
                            <ScrollViewer
                                Grid.Row="2"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PropertiesPanel" Margin="0,0,0,0">
                                    <Border Style="{StaticResource PropertyRow}">
                                        <TextBlock
                                            Margin="0,12"
                                            FontStyle="Italic"
                                            Style="{StaticResource PropertyLabel}"
                                            Text="Select an element to view properties"
                                            TextAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  ── Col 1: Vertical splitter ────────────────────────────────  -->
            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource BorderBrush}"
                Cursor="SizeWE"
                ShowsPreview="True" />

            <!--  ── Col 2: 3D Viewport ───────────────────────────────────────  -->
            <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Viewport header  -->
                    <Border
                        Grid.Row="0"
                        Height="30"
                        Padding="12,0"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <StackPanel
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,22,0"
                                    Style="{StaticResource PanelSectionHeader}"
                                    Text="3D MODEL VIEWER" />
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource DestructiveBrush}" />
                                <TextBlock
                                    Margin="3,0,14,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSM}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DestructiveBrush}"
                                    Text=" &gt; 5000 kg" />
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource WarningBrush}" />
                                <TextBlock
                                    Margin="3,0,14,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSM}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource WarningBrush}"
                                    Text=" &gt; 3000 kg" />
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock
                                    Margin="3,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSM}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text=" Normal" />
                            </StackPanel>
                            <Button
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Click="ResetCamera_Click"
                                Content="⊙ Reset View"
                                DockPanel.Dock="Right"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeSM}"
                                FontWeight="SemiBold"
                                Style="{StaticResource ButtonSecondary}" />
                        </DockPanel>
                    </Border>

                    <!--  Viewport stack  -->
                    <Grid Grid.Row="1" ClipToBounds="True">

                        <!--  3D VIEW  -->
                        <helix:HelixViewport3D
                            x:Name="IfcViewer"
                            MouseDown="IfcViewer_MouseDown"
                            MouseMove="IfcViewer_MouseMove"
                            Background="{DynamicResource BackgroundBrush}"
                            CameraRotationMode="Turntable"
                            InfiniteSpin="False"
                            IsPanEnabled="True"
                            IsRotationEnabled="True"
                            IsZoomEnabled="True"
                            PreviewMouseWheel="IfcViewer_PreviewMouseWheel"
                            RotateAroundMouseDownPoint="True"
                            RotationSensitivity="1"
                            ShowCoordinateSystem="True"
                            ShowViewCube="True"
                            ZoomAroundMouseDownPoint="True"
                            ZoomSensitivity="2">

                            <helix:HelixViewport3D.Style>
                                <Style TargetType="{x:Type helix:HelixViewport3D}">
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IfcViewer.IsPlacementMode}" Value="True">
                                            <Setter Property="Cursor" Value="Cross" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </helix:HelixViewport3D.Style>

                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup>
                                        <AmbientLight Color="#3A3A3A" />
                                        <DirectionalLight Direction="-1,-2,-1.5" Color="#FFFFFF" />
                                        <DirectionalLight Direction="1,1,0.5" Color="#557799" />
                                        <DirectionalLight Direction="0.3,1,-2" Color="#334466" />
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                        </helix:HelixViewport3D>

                        <!--  ── OSNAP INDICATOR OVERLAY ──────────────────────
                              Transparent Canvas floats above the 3D viewport.
                              IsHitTestVisible=False means ALL mouse events still
                              reach the HelixViewport3D below it.                   -->
                        <Canvas x:Name="OsnapOverlayCanvas"
                                IsHitTestVisible="False"
                                Background="Transparent"
                                ClipToBounds="True"/>

                        <!--  🔥 IFC LOADING OVERLAY  -->
                        <Border Background="#AA000000" Visibility="{Binding IfcViewer.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding IfcViewer.Status}" />

                                <ProgressBar
                                    Width="220"
                                    Height="8"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding IfcViewer.Progress}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,24,0,0"
                            Padding="16,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Visibility="{Binding IfcViewer.IsPlacementMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="Click to place IFC. Press Esc to cancel." />
                        </Border>

                    </Grid>
                </Grid>
            </Border>

            <!--  ── Col 3: Vertical splitter ────────────────────────────────  -->
            <GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource BorderBrush}"
                Cursor="SizeWE"
                ShowsPreview="True" />

            <!--  ── Col 4: Site Planner (placeholder) ───────────────────────  -->
            <Border
                Grid.Column="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
                <!--  TODO: SitePlannerPanel goes here  -->
            </Border>

        </Grid>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 5 — STATUS BAR
            ══════════════════════════════════════════════════════════════════
        -->
        <Border
            Grid.Row="5"
            Padding="10,0"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 0: Ready / crane status  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 1: Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 2: X / Y coordinates  -->
                    <ColumnDefinition Width="*" />
                    <!--  Col 3: Spacer  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 4: Render Quality btn  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 5: Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 6: OSnap button  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 7: Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 8: Elements count  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 9: Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 10: Command / Logs btns  -->
                </Grid.ColumnDefinitions>

                <!--  Col 0: Status indicator — ✅ NOW BOUND TO VIEWMODEL  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="6"
                        Height="6"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource SuccessBrush}" />
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding StatusText, FallbackValue='IDLE'}" />
                </StackPanel>

                <!--  Col 1: Separator  -->
                <Rectangle
                    Grid.Column="1"
                    Width="1"
                    Height="12"
                    Margin="10,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 2: X / Y coordinates — ✅ NOW BOUND TO VIEWMODEL  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,3,0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Style="{StaticResource CoordLabel}"
                        Text="X:" />
                    <TextBlock
                        x:Name="TxtCoordX"
                        Margin="0,0,12,0"
                        Style="{StaticResource CoordLabel}"
                        Text="{Binding CoordX, FallbackValue='0.00M'}" />
                    <TextBlock
                        Margin="0,0,3,0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Style="{StaticResource CoordLabel}"
                        Text="Y:" />
                    <TextBlock
                        x:Name="TxtCoordY"
                        Style="{StaticResource CoordLabel}"
                        Text="{Binding CoordY, FallbackValue='0.00M'}" />
                </StackPanel>

                <!--  Col 4: Render Quality badge — ✅ NOW BOUND TO VIEWMODEL  -->
                <Button
                    x:Name="RenderQualityDropBtn"
                    Grid.Column="4"
                                            Padding="0,0,0,0"
                    VerticalAlignment="Center"
                    Click="RenderQualityDropBtn_Click"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Click to change Render Quality">
                    <Border
                        x:Name="RenderQualityBadge"
                        Margin="2,0"
                        Padding="7,1"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="TxtRenderQuality"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeXS}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding RenderQualityLabel, FallbackValue='● STD'}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeXS}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text=" ▾" />
                        </StackPanel>
                    </Border>
                </Button>

                <!--  Render Quality Popup  -->
                <Popup
                    x:Name="RenderQualityPopup"
                    AllowsTransparency="True"
                    Placement="Top"
                    PlacementTarget="{Binding ElementName=RenderQualityDropBtn}"
                    StaysOpen="False"
                    VerticalOffset="-4">
                    <Border
                        MinWidth="190"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <Border
                                Padding="10,7"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="4,4,0,0">
                                <TextBlock
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeXS}"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="RENDER QUALITY" />
                            </Border>
                            <Border
                                Padding="10,8"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <RadioButton
                                        x:Name="rbRenderStandard"
                                        Checked="RenderQuality_Changed"
                                        Content="Standard"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeSM}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        GroupName="RenderQualityGroup"
                                        IsChecked="True"
                                        ToolTip="Standard WPF rendering" />
                                    <TextBlock
                                        Margin="18,3,0,0"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeXS}"
                                        Foreground="{DynamicResource TextDisabledBrush}"
                                        Text="Fast loading · normal smoothness" />
                                </StackPanel>
                            </Border>
                            <Border Padding="10,8,10,10">
                                <StackPanel>
                                    <RadioButton
                                        x:Name="rbRenderHigh"
                                        Checked="RenderQuality_Changed"
                                        Content="⬆ High Quality"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeSM}"
                                        FontWeight="SemiBold"
                                        Foreground="#4FC3F7"
                                        GroupName="RenderQualityGroup"
                                        ToolTip="High Quality — smoother curves" />
                                    <TextBlock
                                        Margin="18,3,0,0"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeXS}"
                                        Foreground="{DynamicResource TextDisabledBrush}"
                                        Text="Smoother curves &amp; pipes · reloads model" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <!--  Col 5: Separator  -->
                <Rectangle
                    Grid.Column="5"
                    Width="1"
                    Height="12"
                    Margin="8,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 6: OSnap panel (bound to OsnapPanelViewModel via code-behind)  -->
                <osnap:OsnapStatusPanel x:Name="OsnapPanel"
                                        Grid.Column="6"
                                        VerticalAlignment="Center"/>

                <!--  Col 7: Separator  -->
                <Rectangle
                    Grid.Column="7"
                    Width="1"
                    Height="12"
                    Margin="8,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 8: Element count — already bound via Elements.Count  -->
                <StackPanel
                    Grid.Column="8"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="ELEMENTS: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding Elements.Count, FallbackValue='0'}" />
                </StackPanel>

                <!--  Col 9: Separator  -->
                <Rectangle
                    Grid.Column="9"
                    Width="1"
                    Height="12"
                    Margin="8,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 10: Command / Logs buttons  -->
                <StackPanel
                    Grid.Column="10"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,3,0"
                        Padding="6,2"
                        Click="ShowCommandPanel_Click"
                        Content="Command"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Style="{StaticResource ToolbarButton}" />
                    <Button
                        Padding="6,2"
                        Click="ShowLogsPanel_Click"
                        Content="Logs"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Style="{StaticResource ToolbarButton}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
