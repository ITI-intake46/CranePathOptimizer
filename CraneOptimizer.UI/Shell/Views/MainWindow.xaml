<Window
    x:Class="CraneOptimizer.UI.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:f5="clr-namespace:CraneOptimizer.UI.Features.F5_ElementManagement.Views"
    xmlns:f1="clr-namespace:CraneOptimizer.UI.Features.F1_IfcViewerControl.Views"
    xmlns:f3="clr-namespace:CraneOptimizer.UI.Features.F3_CraneSetup.Views"
    xmlns:aiCompanion="clr-namespace:CraneOptimizer.UI.Features.F13_AiAdvisor.Companion.Views"
    xmlns:nav="clr-namespace:CraneOptimizer.UI.Shared.Layouts"
    Title="IFC Building Analyzer — Crane Planner Edition"
    Width="1600"
    Height="800"
    AllowsTransparency="True"
    Background="{DynamicResource BackgroundBrush}"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowState="Maximized"
    WindowStyle="None">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding IfcViewer.CancelPlacementCommand}" />
    </Window.InputBindings>

    <!--
        ROOT GRID — compensates for WPF WindowStyle=None + AllowsTransparency=True
        maximized-overflow bug: adds 8px inset only when Maximized.
    -->
    <Grid Style="{StaticResource MaximizedWindowGridStyle}">

        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <!--  Row 0: Title bar + quick-access toolbar  -->
            <RowDefinition Height="Auto" />
            <!--  Row 1: Drawing options bar (collapsed)  -->
            <RowDefinition Height="Auto" />
            <!--  Row 2: Main ribbon  -->
            <RowDefinition Height="Auto" />
            <!--  Row 3: Building info bar  -->
            <RowDefinition Height="*" />
            <!--  Row 4: Main content area  -->
            <RowDefinition Height="22" />
            <!--  Row 5: Status bar  -->
        </Grid.RowDefinitions>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 0 — TITLE BAR + QUICK-ACCESS TOOLBAR
            ══════════════════════════════════════════════════════════════════
        -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <!--  Col 0:  App icon  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 1:  Home / welcome btn  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 2:  Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 3:  Save btn  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 4:  Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 5:  Undo / Redo btns  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 6:  Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 7:  History breadcrumb  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 8:  Clear history  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 9:  Dimension tool  -->
                    <ColumnDefinition Width="*" />
                    <!--  Col 10: Title (centred)  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 11: Window chrome  -->
                </Grid.ColumnDefinitions>

                <!--  Col 0: App icon  -->
                <Border
                    Grid.Column="0"
                    Width="28"
                    Height="28"
                    Background="{StaticResource PrimaryBrush}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSM}"
                        Text="🏗" />
                </Border>

                <!--  Col 1: Home / Back-to-Welcome button  -->
                <Button
                    Grid.Column="1"
                    Width="26"
                    Height="22"
                    Margin="4,0,0,0"
                    Click="BackToWelcome_Click"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Back to Welcome (Home)">
                    <TextBlock FontSize="{StaticResource FontSizeSM}" Text="🏠" />
                </Button>

                <!--  Col 2: Separator  -->
                <Rectangle
                    Grid.Column="2"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 3: Save  -->
                <Button
                    Grid.Column="3"
                    Width="26"
                    Height="22"
                    Click="SaveProject_Click"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Save Project (Ctrl+S)">
                    <TextBlock FontSize="{StaticResource FontSizeSM}" Text="💾" />
                </Button>

                <!--  Col 4: Separator  -->
                <Rectangle
                    Grid.Column="4"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 5: Undo / Redo  -->
                <StackPanel
                    Grid.Column="5"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="26"
                        Height="20"
                        Margin="0,0,1,0"
                        Click="UndoBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Undo (Ctrl+Z)">
                        <TextBlock
                            FontSize="{StaticResource FontSizeSM}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="↩" />
                    </Button>
                    <TextBlock
                        x:Name="TxtUndoLabel"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Undo" />
                    <Button
                        Width="26"
                        Height="20"
                        Margin="0,0,1,0"
                        Click="RedoBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Redo (Ctrl+Y)">
                        <TextBlock
                            FontSize="{StaticResource FontSizeSM}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="↪" />
                    </Button>
                    <TextBlock
                        x:Name="TxtRedoLabel"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Redo" />
                </StackPanel>

                <!--  Col 6: Separator  -->
                <Rectangle
                    Grid.Column="6"
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 7: Last action breadcrumb — ✅ NOW BOUND TO VIEWMODEL  -->
                <TextBlock
                    x:Name="TxtHistoryBreadcrumb"
                    Grid.Column="7"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeXS}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding HistoryBreadcrumb, FallbackValue='No recent action'}" />

                <!--  Col 8: Clear History  -->
                <Button
                    Grid.Column="8"
                    Margin="0,0,4,0"
                    Padding="6,3"
                    VerticalAlignment="Center"
                    Click="ClearHistory_Click"
                    Content="Clear History"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeXS}"
                    Style="{StaticResource ToolbarButton}" />

                <!--  Col 9: Dimension tool  -->
                <Button
                    x:Name="BtnDimensionTool"
                    Grid.Column="9"
                    Width="22"
                    Height="22"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnDimensionTool_Click"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Dimension Tool — measure distances (D)">
                    <TextBlock FontSize="{StaticResource FontSizeSM}" Text="📏" />
                </Button>

                <!--  Col 10: App title (centred)  -->
                <TextBlock
                    Grid.Column="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeXS}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="IFC Building Analyzer — Crane Planner Edition" />

                <!--  Col 11: Window chrome  -->
                <StackPanel Grid.Column="11" Orientation="Horizontal">
                    <Button
                        Width="40"
                        Height="28"
                        Click="MinimizeWindow_Click"
                        Content="🗕"
                        Style="{StaticResource TitleBarButton}" />
                    <Button
                        x:Name="MaximizeButton"
                        Width="40"
                        Height="28"
                        Click="MaximizeWindow_Click"
                        Content="☐"
                        Style="{StaticResource TitleBarButton}" />
                    <Button
                        Width="40"
                        Height="28"
                        Click="CloseWindow_Click"
                        Content="✕"
                        Style="{StaticResource CloseButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 1 — DRAWING OPTIONS BAR (collapsed by default)
            ══════════════════════════════════════════════════════════════════
        -->
        <!-- <zones:DrawingOptionsBar x:Name="DrawingOptionsBar" Grid.Row="1" Visibility="Collapsed"/> -->

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 2 — MAIN RIBBON
            ══════════════════════════════════════════════════════════════════
        -->
        <nav:TopNavigation Grid.Row="2" />

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 3 — BUILDING INFO BAR
            ══════════════════════════════════════════════════════════════════
        -->
        <Border
            Grid.Row="3"
            Padding="12,0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Storeys  -->
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Style="{StaticResource PropertyLabel}"
                    Text="Storeys:" />
                <TextBlock
                    x:Name="txtNumberOfStoreys"
                    Grid.Column="1"
                    Margin="0,0,20,0"
                    Foreground="{StaticResource PrimaryBrush}"
                    Style="{StaticResource PropertyValue}"
                    Text="{Binding NumberOfStoreys, FallbackValue='0'}" />

                <!--  Area  -->
                <TextBlock
                    Grid.Column="2"
                    Margin="0,0,4,0"
                    Style="{StaticResource PropertyLabel}"
                    Text="Area:" />
                <TextBlock
                    Grid.Column="3"
                    Margin="0,0,20,0"
                    Style="{StaticResource PropertyValue}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F2} {1}">
                            <Binding FallbackValue="0.00" Path="BuildingArea" />
                            <Binding FallbackValue="m²" Path="AreaUnit" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!--  Height  -->
                <TextBlock
                    Grid.Column="4"
                    Margin="0,0,4,0"
                    Style="{StaticResource PropertyLabel}"
                    Text="Height:" />
                <TextBlock
                    Grid.Column="5"
                    Margin="0,0,20,0"
                    Style="{StaticResource PropertyValue}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F2} {1}">
                            <Binding FallbackValue="0.00" Path="BuildingHeight" />
                            <Binding FallbackValue="m" Path="SelectedUnit" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!--  Unit selector  -->
                <TextBlock
                    Grid.Column="6"
                    Margin="0,0,6,0"
                    Style="{StaticResource PropertyLabel}"
                    Text="Unit:" />
                <ComboBox
                    x:Name="UnitSelector"
                    Grid.Column="7"
                    Width="60"
                    Height="20"
                    Margin="0,0,20,0"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeSM}"
                    FontWeight="SemiBold"
                    ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                    ItemsSource="{Binding AvailableUnits}"
                    SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                    Style="{StaticResource DarkComboBox}" />

                <!--  Building name  -->
                <Rectangle
                    Grid.Column="8"
                    Width="1"
                    Height="14"
                    Margin="0,0,12,0"
                    Fill="{DynamicResource BorderBrush}" />
                <TextBlock
                    x:Name="txtBuildingName"
                    Grid.Column="9"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeSM}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding BuildingName, FallbackValue='No Building Loaded'}" />
            </Grid>
        </Border>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 4 — MAIN CONTENT AREA
            ══════════════════════════════════════════════════════════════════
        -->
        <Grid Grid.Row="4" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250" />
                <!--  Col 0: Element Details  -->
                <ColumnDefinition Width="4" />
                <!--  Col 1: Splitter  -->
                <ColumnDefinition Width="*" MinWidth="400" />
                <!--  Col 2: 3D Viewport  -->
                <ColumnDefinition Width="4" />
                <!--  Col 3: Splitter  -->
                <ColumnDefinition Width="400" MinWidth="360" MaxWidth="560" />
                <!--  Col 4: Crane + Zones / AI assist dock  -->
            </Grid.ColumnDefinitions>

            <!--  ── Col 0: Elements list + Properties (F5 module) ───────────  -->
            <f5:ElementManagementPanel Grid.Column="0" DataContext="{Binding ElementManagement}" />

            <!--  ── Col 1: Vertical splitter ────────────────────────────────  -->
            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource BorderBrush}"
                Cursor="SizeWE"
                ShowsPreview="True" />

            <!--  ── Col 2: 3D Viewport ───────────────────────────────────────  -->
            <f1:IfcViewerControl Grid.Column="2" />

            <!--  ── Col 3: Vertical splitter ────────────────────────────────  -->
            <GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource BorderBrush}"
                Cursor="SizeWE"
                ShowsPreview="True" />

            <!--
                ── Col 4: Right dock workspace ─────────────────────────────
                Professional shell layout: AI assistance is docked as a tab beside
                the existing properties panel instead of floating over crane controls.
            -->
            <Border
                Grid.Column="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
                <TabControl
                    x:Name="RightWorkspaceTabs"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderThickness="0"
                    SelectedIndex="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
                            <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,6" />
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="PROPERTIES">
                        <f3:CraneManagerView DataContext="{Binding CraneManager}" />
                    </TabItem>

                    <TabItem x:Name="AiAssistTab" Visibility="Collapsed">
                        <TabItem.Header>
                            <DockPanel LastChildFill="False">
                                <TextBlock VerticalAlignment="Center" Text="AI ASSIST" />
                                <Button
                                    Width="16"
                                    Height="16"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="CloseAiAssistTab_Click"
                                    Content="×"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Style="{StaticResource ToolbarButton}"
                                    ToolTip="Close AI Assist tab" />
                            </DockPanel>
                        </TabItem.Header>
                        <aiCompanion:AiCompanionPanel CloseRequested="AiCompanionPanel_CloseRequested" />
                    </TabItem>
                </TabControl>
            </Border>

        </Grid>

        <!--
            ══════════════════════════════════════════════════════════════════
            ROW 5 — STATUS BAR
            ══════════════════════════════════════════════════════════════════
        -->
        <Border
            Grid.Row="5"
            Padding="10,0"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 0: Ready / crane status  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 1: Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 2: X / Y coordinates  -->
                    <ColumnDefinition Width="*" />
                    <!--  Col 3: Spacer  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 4: Render Quality btn  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 5: Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 6: OSnap button  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 7: Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 8: Elements count  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 9: Separator  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Col 10: Command / Logs btns  -->
                </Grid.ColumnDefinitions>

                <!--  Col 0: Status indicator — ✅ NOW BOUND TO VIEWMODEL  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="6"
                        Height="6"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource SuccessBrush}" />
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding StatusText, FallbackValue='IDLE'}" />
                </StackPanel>

                <!--  Col 1: Separator  -->
                <Rectangle
                    Grid.Column="1"
                    Width="1"
                    Height="12"
                    Margin="10,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 2: X / Y coordinates — ✅ NOW BOUND TO VIEWMODEL  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,3,0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Style="{StaticResource CoordLabel}"
                        Text="X:" />
                    <TextBlock
                        x:Name="TxtCoordX"
                        Margin="0,0,12,0"
                        Style="{StaticResource CoordLabel}"
                        Text="{Binding CoordX, FallbackValue='0.00M'}" />
                    <TextBlock
                        Margin="0,0,3,0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Style="{StaticResource CoordLabel}"
                        Text="Y:" />
                    <TextBlock
                        x:Name="TxtCoordY"
                        Style="{StaticResource CoordLabel}"
                        Text="{Binding CoordY, FallbackValue='0.00M'}" />
                </StackPanel>

                <!--  Col 8: Element count — already bound via Elements.Count  -->
                <StackPanel
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding Selection.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding Selection.StatusText}" />
                </StackPanel>

                <Rectangle
                    Grid.Column="5"
                    Width="1"
                    Height="12"
                    Margin="8,0"
                    Fill="{DynamicResource BorderBrush}"
                    Visibility="{Binding Selection.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Col 3: AI companion status strip. Sits inside the shell instead of overlaying the workspace.  -->
                <aiCompanion:AiCompanionStatusStrip
                    x:Name="AiCompanionStrip"
                    Grid.Column="3"
                    Margin="12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AssistRequested="AiCompanionStatusStrip_AssistRequested"
                    HideRequested="AiCompanionStatusStrip_HideRequested" />

                <Button
                    x:Name="ShowAiCompanionButton"
                    Grid.Column="3"
                    MinWidth="70"
                    Height="18"
                    Margin="12,0"
                    Padding="7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="ShowAiCompanionButton_Click"
                    Content="AI Assist"
                    FontSize="{StaticResource FontSizeXS}"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Show AI Companion in the status bar"
                    Visibility="Collapsed" />

                <StackPanel
                    Grid.Column="8"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="ELEMENTS: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding Elements.Count, FallbackValue='0'}" />
                </StackPanel>

                <!--  Col 9: Separator  -->
                <Rectangle
                    Grid.Column="9"
                    Width="1"
                    Height="12"
                    Margin="8,0"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  Col 10: Command / Logs buttons  -->
                <StackPanel
                    Grid.Column="10"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,3,0"
                        Padding="6,2"
                        Click="ShowCommandPanel_Click"
                        Content="Command"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Style="{StaticResource ToolbarButton}" />
                    <Button
                        Padding="6,2"
                        Click="ShowLogsPanel_Click"
                        Content="Logs"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Style="{StaticResource ToolbarButton}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
