<Window x:Class="CraneOptimizer.UI.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:shell="clr-namespace:CraneOptimizer.UI.Shell.Views"
        xmlns:layouts="clr-namespace:CraneOptimizer.UI.Shared.Layouts"
        xmlns:components="clr-namespace:CraneOptimizer.UI.Shared.Components"
        Title="CraneOptimizer"
        Height="800" Width="1600"
        WindowState="Maximized"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ── OSnap toggle button ─────────────────────────────────────── -->
        <Style x:Key="StatusOsnapBtn" TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height"          Value="16"/>
            <Setter Property="Padding"         Value="4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"        Value="{StaticResource FontSizeXS}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="Foreground"                  Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground"                   Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Section header label (Left panels) ────────────────────── -->
        <Style x:Key="PanelSectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <!-- ── Coordinate display label ──────────────────────────────── -->
        <Style x:Key="CoordLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource FontSizeXS}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Element list item row ─────────────────────────────────── -->
        <Style x:Key="ElementListItem" TargetType="Border">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Property row ──────────────────────────────────────────── -->
        <Style x:Key="PropertyRow" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="10,5"/>
        </Style>

    </Window.Resources>

    <!--
        ROOT GRID — compensates for WindowStyle=None + AllowsTransparency=True
        maximized-overflow bug (8px inset when Maximized).
    -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger
                        Binding="{Binding WindowState,
                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Value="Maximized">
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <!-- Row 0: Title bar + quick-access  -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main ribbon               -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Building info bar         -->
            <RowDefinition Height="*"/>
            <!-- Row 3: Main content area         -->
            <RowDefinition Height="22"/>
            <!-- Row 4: Status bar                -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 0 — TITLE BAR + QUICK-ACCESS TOOLBAR
        ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <!-- Col 0: App icon           -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 1: Save btn           -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 2: Separator          -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 3: Undo/Redo          -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 4: Separator          -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 5: History breadcrumb -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 6: Clear History btn  -->
                    <ColumnDefinition Width="*"/>
                    <!-- Col 7: Title (centered)   -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 8: Window chrome      -->
                </Grid.ColumnDefinitions>

                <!-- Col 0: App icon -->
                <Border Grid.Column="0" Width="28" Height="28"
                        Background="{StaticResource PrimaryBrush}">
                    <TextBlock Text="🏗" FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Col 1: Save -->
                <Button Grid.Column="1"
                        ToolTip="Save Project (Ctrl+S)"
                        Width="26" Height="22" Margin="4,0,0,0"
                        Click="SaveProject_Click"
                        Style="{StaticResource ToolbarButton}">
                    <TextBlock Text="💾" FontSize="{StaticResource FontSizeSM}"/>
                </Button>

                <!-- Col 2: Separator -->
                <Rectangle Grid.Column="2" Width="1" Height="14"
                           Fill="{DynamicResource BorderBrush}" Margin="6,0"/>

                <!-- Col 3: Undo / Redo -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="2,0">
                    <Button Width="26" Height="20" Margin="0,0,1,0"
                            ToolTip="Undo (Ctrl+Z)"
                            Style="{StaticResource ToolbarButton}"
                            Click="UndoBtn_Click">
                        <TextBlock Text="↩" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <TextBlock x:Name="TxtUndoLabel" Text="Undo"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Width="26" Height="20" Margin="0,0,1,0"
                            ToolTip="Redo (Ctrl+Y)"
                            Style="{StaticResource ToolbarButton}"
                            Click="RedoBtn_Click">
                        <TextBlock Text="↪" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <TextBlock x:Name="TxtRedoLabel" Text="Redo"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Col 4: Separator -->
                <Rectangle Grid.Column="4" Width="1" Height="14"
                           Fill="{DynamicResource BorderBrush}" Margin="6,0"/>

                <!-- Col 5: History breadcrumb -->
                <TextBlock Grid.Column="5" x:Name="TxtHistoryBreadcrumb"
                           Text="No recent action"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="{StaticResource FontSizeXS}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <!-- Col 6: Clear History -->
                <Button Grid.Column="6" Content="Clear History"
                        Style="{StaticResource ToolbarButton}"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Padding="6,3" Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Click="ClearHistory_Click"/>

                <!-- Col 7: App title (centered) -->
                <TextBlock Grid.Column="7"
                           Text="CraneOptimizer — IFC Building Crane Planner"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="{StaticResource FontSizeXS}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <!-- Col 8: Window chrome -->
                <StackPanel Grid.Column="8" Orientation="Horizontal">
                    <Button Content="🗕" Width="40" Height="28"
                            Style="{StaticResource TitleBarButton}"
                            Click="MinimizeWindow_Click"/>
                    <Button x:Name="MaximizeButton" Content="☐" Width="40" Height="28"
                            Style="{StaticResource TitleBarButton}"
                            Click="MaximizeWindow_Click"/>
                    <Button Content="✕" Width="40" Height="28"
                            Style="{StaticResource CloseButton}"
                            Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 1 — MAIN RIBBON (TopNavigation layout component)
        ══════════════════════════════════════════════════════════════════ -->
        <layouts:TopNavigation Grid.Row="1"
                               DataContext="{Binding}"/>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 2 — BUILDING INFO BAR
        ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Storeys -->
                <TextBlock Grid.Column="0" Text="Storeys:"
                           Style="{StaticResource PropertyLabel}"
                           Margin="0,0,4,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Scene.NumberOfStoreys, FallbackValue='0'}"
                           Style="{StaticResource PropertyValue}"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,20,0"/>

                <!-- Area -->
                <TextBlock Grid.Column="2" Text="Area:"
                           Style="{StaticResource PropertyLabel}"
                           Margin="0,0,4,0"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding Scene.BuildingArea, StringFormat='{}{0:F2} m²', FallbackValue='0.00 m²'}"
                           Style="{StaticResource PropertyValue}"
                           Margin="0,0,20,0"/>

                <!-- Height -->
                <TextBlock Grid.Column="4" Text="Height:"
                           Style="{StaticResource PropertyLabel}"
                           Margin="0,0,4,0"/>
                <TextBlock Grid.Column="5"
                           Text="{Binding Scene.BuildingHeight, StringFormat='{}{0:F2} m', FallbackValue='0.00 m'}"
                           Style="{StaticResource PropertyValue}"
                           Margin="0,0,20,0"/>

                <!-- Spacer -->
                <Rectangle Grid.Column="6"/>

                <!-- Separator -->
                <Rectangle Grid.Column="7" Width="1" Height="14"
                           Fill="{DynamicResource BorderBrush}" Margin="0,0,12,0"/>

                <!-- Elements count -->
                <TextBlock Grid.Column="8" Text="Elements:"
                           Style="{StaticResource PropertyLabel}"
                           Margin="0,0,4,0"/>
                <TextBlock Grid.Column="9"
                           Text="{Binding Elements.Count, FallbackValue='0'}"
                           Style="{StaticResource PropertyValue}"
                           Foreground="{StaticResource PrimaryBrush}"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 3 — MAIN CONTENT AREA (3-column: Elements | Viewport | Cranes)
        ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200"/>
                <!-- Col 0: Elements + Properties -->
                <ColumnDefinition Width="4"/>
                <!-- Col 1: Splitter              -->
                <ColumnDefinition Width="*"   MinWidth="400"/>
                <!-- Col 2: 3D Viewport           -->
                <ColumnDefinition Width="4"/>
                <!-- Col 3: Splitter              -->
                <ColumnDefinition Width="280" MinWidth="220"/>
                <!-- Col 4: Crane + Zone panels   -->
            </Grid.ColumnDefinitions>

            <!-- ── Col 0: Elements list + Properties ──────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Elements header -->
                        <RowDefinition Height="*"/>
                        <!-- Elements list   -->
                        <RowDefinition Height="4"/>
                        <!-- H-splitter      -->
                        <RowDefinition Height="200" MinHeight="130"/>
                        <!-- Properties      -->
                    </Grid.RowDefinitions>

                    <!-- Elements header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            Padding="10,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Height="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BUILDING ELEMENTS"
                                       Style="{StaticResource PanelSectionHeader}"/>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BackgroundBrush}"
                                    CornerRadius="3" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Elements.Count, FallbackValue='0'}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeXS}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Elements list -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Elements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ElementListItem}">
                                        <StackPanel>
                                            <TextBlock FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="{StaticResource FontSizeSM}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Name, FallbackValue='Element'}"/>
                                            <TextBlock FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="{StaticResource FontSizeXS}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding TypeName, FallbackValue='—'}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Horizontal splitter -->
                    <GridSplitter Grid.Row="2" Height="4"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BorderBrush}"
                                  ShowsPreview="True" Cursor="SizeNS"/>

                    <!-- Properties panel -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    Padding="10,0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Height="26">
                                <TextBlock Text="PROPERTIES"
                                           Style="{StaticResource PanelSectionHeader}"/>
                            </Border>

                            <!-- Properties rows -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PropertiesPanel" Margin="0">
                                    <Border Style="{StaticResource PropertyRow}">
                                        <TextBlock Text="Select an element to view properties"
                                                   Style="{StaticResource PropertyLabel}"
                                                   FontStyle="Italic"
                                                   TextAlignment="Center"
                                                   Margin="0,12"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Col 1: Vertical splitter ───────────────────────────────── -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          ShowsPreview="True" Cursor="SizeWE"/>

            <!-- ── Col 2: 3D Viewport ─────────────────────────────────────── -->
            <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Viewport header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            Padding="12,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Height="30">
                        <DockPanel LastChildFill="False">
                            <!-- Left: title + legend -->
                            <StackPanel Orientation="Horizontal"
                                        DockPanel.Dock="Left"
                                        VerticalAlignment="Center">
                                <TextBlock Text="3D MODEL VIEWER"
                                           Style="{StaticResource PanelSectionHeader}"
                                           Margin="0,0,22,0"/>
                                <Ellipse Width="8" Height="8"
                                         Fill="{StaticResource DestructiveBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text=" &gt; 5000 kg"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeSM}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DestructiveBrush}"
                                           VerticalAlignment="Center"
                                           Margin="3,0,14,0"/>
                                <Ellipse Width="8" Height="8"
                                         Fill="{StaticResource WarningBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text=" &gt; 3000 kg"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeSM}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"
                                           VerticalAlignment="Center"
                                           Margin="3,0,14,0"/>
                                <Ellipse Width="8" Height="8"
                                         Fill="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text=" Normal"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeSM}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="3,0,0,0"/>
                            </StackPanel>

                            <!-- Right: Reset View -->
                            <Button DockPanel.Dock="Right"
                                    Content="⊙ Reset View"
                                    Click="ResetCamera_Click"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSM}"
                                    FontWeight="SemiBold"
                                    Padding="8,4"
                                    Style="{StaticResource ButtonSecondary}"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Viewport -->
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <helix:HelixViewport3D x:Name="IfcViewer"
                               Background="{DynamicResource BackgroundBrush}"
                               ShowViewCube="True"
                               ShowCoordinateSystem="True"
                               CameraRotationMode="Turntable"
                               ZoomSensitivity="2"
                               IsZoomEnabled="True"
                               IsPanEnabled="True"
                               IsRotationEnabled="True"
                               ZoomAroundMouseDownPoint="True"
                               RotateAroundMouseDownPoint="True"
                               InfiniteSpin="False">
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup>
                                        <AmbientLight Color="#3A3A3A"/>
                                        <DirectionalLight Color="#FFFFFF" Direction="-1,-2,-1.5"/>
                                        <DirectionalLight Color="#557799" Direction="1,1,0.5"/>
                                        <DirectionalLight Color="#334466" Direction="0.3,1,-2"/>
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                        </helix:HelixViewport3D>

                        <!-- No-model placeholder -->
                        <Border x:Name="NoModelOverlay"
                                Background="{DynamicResource SurfaceBrush}"
                                Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="52"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,14" Opacity="0.25"/>
                                <TextBlock Text="NO IFC MODEL LOADED"
                                           FontFamily="{StaticResource FontPrimary}"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource FontSizeXL}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Use the IFC tab in the ribbon to load a file"
                                           FontFamily="{StaticResource FontPrimary}"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource FontSizeSM}"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Col 3: Vertical splitter ───────────────────────────────── -->
            <GridSplitter Grid.Column="3" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          ShowsPreview="True" Cursor="SizeWE"/>

            <!-- ── Col 4: Cranes + Zones panel ────────────────────────────── -->
            <Border Grid.Column="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            Padding="10,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Height="30">
                        <TextBlock Text="SITE PLANNER"
                                   Style="{StaticResource PanelSectionHeader}"/>
                    </Border>

                    <!-- SitePlannerView: Cranes tab + Zones tab -->
                    <components:SitePlannerView Grid.Row="1"
                                                DataContext="{Binding}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 4 — STATUS BAR
        ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 0: Status indicator  -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 1: Separator         -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 2: X/Y coordinates   -->
                    <ColumnDefinition Width="*"/>
                    <!-- Col 3: Spacer            -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 4: Render quality    -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 5: Separator         -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 6: OSN toggle        -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 7: Separator         -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 8: Elements count    -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 9: Separator         -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Col 10: Cranes count     -->
                </Grid.ColumnDefinitions>

                <!-- Col 0: Ready indicator -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6"
                             Fill="{StaticResource SuccessBrush}"
                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="IDLE"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Col 1: Separator -->
                <Rectangle Grid.Column="1" Width="1" Height="12"
                           Fill="{DynamicResource BorderBrush}" Margin="10,0"/>

                <!-- Col 2: X/Y coordinates -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="X:" Style="{StaticResource CoordLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,3,0"/>
                    <TextBlock x:Name="TxtCoordX" Text="0.00m"
                               Style="{StaticResource CoordLabel}"
                               Margin="0,0,12,0"/>
                    <TextBlock Text="Y:" Style="{StaticResource CoordLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,3,0"/>
                    <TextBlock x:Name="TxtCoordY" Text="0.00m"
                               Style="{StaticResource CoordLabel}"/>
                </StackPanel>

                <!-- Col 4: Render quality badge -->
                <Border Grid.Column="4"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="7,1"
                        Margin="2,0">
                    <TextBlock Text="● STD"
                               FontFamily="{StaticResource FontPrimary}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeXS}"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Col 5: Separator -->
                <Rectangle Grid.Column="5" Width="1" Height="12"
                           Fill="{DynamicResource BorderBrush}" Margin="8,0"/>

                <!-- Col 6: OSN toggle -->
                <ToggleButton Grid.Column="6"
                              x:Name="OsnapToggle"
                              Style="{StaticResource StatusOsnapBtn}"
                              Padding="5,0"
                              Height="16"
                              VerticalAlignment="Center"
                              ToolTip="Object Snap (F3)">
                    <TextBlock Text="OSN"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               FontWeight="SemiBold"/>
                </ToggleButton>

                <!-- Col 7: Separator -->
                <Rectangle Grid.Column="7" Width="1" Height="12"
                           Fill="{DynamicResource BorderBrush}" Margin="8,0"/>

                <!-- Col 8: Elements count -->
                <StackPanel Grid.Column="8" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Elements: "
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Elements.Count, FallbackValue='0'}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Col 9: Separator -->
                <Rectangle Grid.Column="9" Width="1" Height="12"
                           Fill="{DynamicResource BorderBrush}" Margin="8,0"/>

                <!-- Col 10: Cranes count -->
                <StackPanel Grid.Column="10" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Cranes: "
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Cranes.Count, FallbackValue='0'}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
