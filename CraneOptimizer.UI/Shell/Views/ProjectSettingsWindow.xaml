<Window x:Class="CraneOptimizer.UI.Shell.Views.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Settings"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
        Width="430"
        Height="390"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontPrimary}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeLG}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Text="⚙" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeSM}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Project Settings" />
                    </StackPanel>
                    <Button Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            Click="Close_Click"
                            Content="✕"
                            FontSize="{StaticResource FontSizeXS}"
                            Style="{StaticResource TitleBarButton}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TextTitle}" Text="Project Settings" />

        <StackPanel Grid.Row="1" Margin="0,14,0,14">
            <Border Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,10"
                               Style="{StaticResource PanelSectionHeader}"
                               Text="UNITS" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource PropertyLabel}"
                                   Text="Display Length Unit" />
                        <ComboBox x:Name="UnitSelector"
                                  Grid.Column="1"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                  ItemsSource="{Binding AvailableUnits}"
                                  SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                  SelectionChanged="UnitSelector_SelectionChanged"
                                  Style="{StaticResource DarkComboBox}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,10"
                               Style="{StaticResource PanelSectionHeader}"
                               Text="VIEWER GRID" />

                    <CheckBox x:Name="ShowGridCheckBox"
                              Margin="0,0,0,12"
                              Checked="ShowGridCheckBox_Changed"
                              Content="Show Grid"
                              Unchecked="ShowGridCheckBox_Changed" />

                    <TextBlock Margin="0,0,0,6"
                               Style="{StaticResource PropertyLabel}"
                               Text="Grid Size" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource PropertyLabel}"
                                   Text="X:" />
                        <TextBox x:Name="GridSizeXTextBox"
                                 Grid.Column="1"
                                 VerticalContentAlignment="Center" />
                        <TextBlock x:Name="GridUnitXLabel"
                                   Grid.Column="2"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource PropertyLabel}" />

                        <TextBlock Grid.Column="4"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource PropertyLabel}"
                                   Text="Y:" />
                        <TextBox x:Name="GridSizeYTextBox"
                                 Grid.Column="5"
                                 VerticalContentAlignment="Center" />
                        <TextBlock x:Name="GridUnitYLabel"
                                   Grid.Column="6"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource PropertyLabel}" />
                    </Grid>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Padding="12,6"
                                Click="ApplyGridSize_Click"
                                Content="Apply Grid Size"
                                Style="{StaticResource ButtonPrimary}" />
                        <Button Margin="8,0,0,0"
                                Padding="12,6"
                                Click="AutoGridSize_Click"
                                Content="Auto Size"
                                Style="{StaticResource ButtonSecondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Button Grid.Row="2"
                MinWidth="78"
                Padding="12,6"
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="Close"
                IsCancel="True"
                Style="{StaticResource ButtonSecondary}" />
            </Grid>
        </Grid>
    </Border>
</Window>
