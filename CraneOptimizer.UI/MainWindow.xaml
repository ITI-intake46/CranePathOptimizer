<Window x:Class="CraneOptimizer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:local="clr-namespace:CraneOptimizer.UI"
        xmlns:uc="clr-namespace:CraneOptimizer.UI.Controls"
        xmlns:zoneUI="clr-namespace:CraneOptimizer.UI.ZoneModule.UI"
        xmlns:conv="clr-namespace:CraneOptimizer.UI.Converters"
        Title="IFC Viewer &amp; Analyzer - Crane Planner Edition"
        Height="800" Width="1600"
        WindowState="Maximized"
        Background="#1E1E1E"
        Icon="/Assets/CraneIcon.png"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converts ElementColor (hex string) → System.Windows.Media.Color for SolidColorBrush binding -->
            <conv:HexStringToColorConverter x:Key="HexToColorConverter"/>

            <!-- Status bar OSnap toggle button style -->
            <Style x:Key="StatusOsnapBtn" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#888888"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#3F3F46"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1A3A52"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                    <Setter Property="Foreground" Value="#5BB8F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <!-- Row 0: Title bar -->
            <RowDefinition Height="40"/>
            <!-- Row 1: QAT (Undo/Redo toolbar) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Drawing Options Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Main Ribbon -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Info bar -->
            <RowDefinition Height="*"/>
            <!-- Row 5: Main content -->
            <RowDefinition Height="28"/>
            <!-- Row 6: Status bar -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 — TITLE BAR ══ -->
        <Border Grid.Row="0" Background="#2D2D30"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="🏗️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="IFC Building Analyzer — Crane Planner Edition"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="🗕" Width="45" Height="35" Click="MinimizeWindow_Click" 
                            Cursor="Hand" Style="{StaticResource TitleBarButton}"/>
                    <Button x:Name="MaximizeButton" Content="☐" Width="45" Height="35"
                            Click="MaximizeWindow_Click" Cursor="Hand" Style="{StaticResource TitleBarButton}"/>
                    <Button Content="✕" Width="45" Height="35" Click="CloseWindow_Click" 
                            Cursor="Hand" Style="{StaticResource CloseButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 1 — QUICK ACCESS TOOLBAR ══ -->
        <Border Grid.Row="1" Background="#2D2D30"
                BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button ToolTip="Save Project (Ctrl+S)" Width="28" Height="28"
                            Margin="0,0,2,0" Click="SaveProject_Click" Style="{StaticResource ToolbarButton}">
                        <TextBlock Text="💾" FontSize="14"/>
                    </Button>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="22" Fill="#444" Margin="6,0"/>

                <zoneUI:UndoRedoToolbar x:Name="UndoRedoToolbar" Grid.Column="2" VerticalAlignment="Center"/>

                <Button x:Name="BtnDimensionTool" Grid.Column="3" Width="28" Height="28"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Dimension Tool — measure distances (D)"
                        Click="BtnDimensionTool_Click" Style="{StaticResource ToolbarButton}">
                    <TextBlock Text="📏" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ ROW 2 — DRAWING OPTIONS BAR ══ -->
        <zoneUI:DrawingOptionsBar x:Name="DrawingOptionsBar" Grid.Row="2" Visibility="Collapsed"/>

        <!-- ══ ROW 3 — MAIN RIBBON CONTROL ══ -->
        <uc:MainRibbonControl x:Name="MainRibbon" Grid.Row="3"/>

        <!-- ══ ROW 4 — INFO BAR ══ -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🏢" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtBuildingName" Grid.Column="1"
                           Text="{Binding BuildingName, FallbackValue='No Building Loaded'}"
                           FontSize="13" FontWeight="Bold" Margin="0,0,30,0"
                           VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Grid.Column="2" Text="Storeys:" Style="{StaticResource PropertyLabel}" Margin="0,0,5,0"/>
                <TextBlock x:Name="txtNumberOfStoreys" Grid.Column="3"
                           Text="{Binding NumberOfStoreys, FallbackValue='0'}"
                           Style="{StaticResource PropertyValue}" Margin="0,0,25,0" MinWidth="30"/>
                <TextBlock Grid.Column="4" Text="Area:" Style="{StaticResource PropertyLabel}" Margin="0,0,5,0"/>
                <TextBlock Grid.Column="5" Style="{StaticResource PropertyValue}" Margin="0,0,25,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F2} {1}">
                            <Binding Path="BuildingArea" FallbackValue="0.00"/>
                            <Binding Path="AreaUnit" FallbackValue="m²"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Column="6" Text="Height:" Style="{StaticResource PropertyLabel}" Margin="0,0,5,0"/>
                <TextBlock Grid.Column="7" Style="{StaticResource PropertyValue}" Margin="0,0,25,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F2} {1}">
                            <Binding Path="BuildingHeight" FallbackValue="0.00"/>
                            <Binding Path="SelectedUnit" FallbackValue="m"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Column="8" Text="Unit:" Style="{StaticResource PropertyLabel}" Margin="0,0,8,0"/>
                <ComboBox x:Name="UnitSelector" Grid.Column="9" Width="70" Height="24"
                          ItemsSource="{Binding AvailableUnits}"
                          SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          FontSize="11" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- ══ ROW 5 — MAIN CONTENT ══ -->
        <Grid Grid.Row="5" Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="280"/>
                <!-- Col 0: Elements + Properties -->
                <ColumnDefinition Width="5"/>
                <!-- Col 1: Splitter -->
                <ColumnDefinition Width="*" MinWidth="400"/>
                <!-- Col 2: Viewport -->
                <ColumnDefinition Width="5"/>
                <!-- Col 3: Splitter -->
                <ColumnDefinition Width="260" MinWidth="200"/>
                <!-- Col 4: Zone list -->
            </Grid.ColumnDefinitions>

            <!-- ══ Col 0: Elements + Properties ══ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="250" MinHeight="150"/>
                    </Grid.RowDefinitions>

                    <!-- Elements header -->
                    <Border Grid.Row="0" Background="{StaticResource Surface2Brush}"
                            Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦 Building Elements" Foreground="{StaticResource TextBrush}"
                                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                <!-- Active filter indicator dot -->
                                <Ellipse Width="7" Height="7" Fill="#007ACC" Margin="6,0,0,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                            <!-- Count badge -->
                            <Border Grid.Column="1" CornerRadius="10" Padding="8,2"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#3E3E42"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                                <Setter Property="Background" Value="#094771"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CountLabel}" FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#AAAAAA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                                    <Setter Property="Foreground" Value="#4FC3F7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Elements list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredElements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ElementBorder" Style="{StaticResource ElementListItem}"
                                            Tag="{Binding}" MouseLeftButtonDown="ElementItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,10,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{Binding ElementColor, Converter={StaticResource HexToColorConverter}, FallbackValue='#A0A0AA'}"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}">
                                                    <Run Text="{Binding DisplayName}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                    <Run Text="{Binding Type}"/>
                                                    <Run Text=" | " Foreground="#666"/>
                                                    <Run Text="{Binding Mark, FallbackValue='No Mark'}"/>
                                                    <Run Text=" | " Foreground="#666"/>
                                                    <Run Text="{Binding DisplayWeight, StringFormat='{}{0:F0}'}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding WeightUnit, FallbackValue='kg'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding ElementColor}" Value="#E74C3C"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource HeavySelectedBrush}"/>
                                            <Setter TargetName="ElementBorder" Property="BorderBrush" Value="#E74C3C"/>
                                            <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding ElementColor}" Value="#F39C12"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource MediumSelectedBrush}"/>
                                            <Setter TargetName="ElementBorder" Property="BorderBrush" Value="#F39C12"/>
                                            <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding ElementColor}" Value="#FFFFFF"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource NormalSelectedBrush}"/>
                                            <Setter TargetName="ElementBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}" ShowsPreview="True" Cursor="SizeNS"/>

                    <!-- Properties panel -->
                    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource Surface2Brush}"
                                    Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="📋 Properties" Foreground="{StaticResource TextBrush}"
                                           FontWeight="Bold" FontSize="13"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PropertiesPanel" Margin="0">
                                    <Border Style="{StaticResource PropertyRow}">
                                        <TextBlock Text="Select an element to view properties"
                                                   Style="{StaticResource PropertyLabel}"
                                                   FontStyle="Italic" TextAlignment="Center" Margin="0,20"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ Col 1: Splitter ══ -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" ShowsPreview="True" Cursor="SizeWE"/>

            <!-- ══ Col 2: 3D Viewport + overlays ══ -->
            <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Viewport header / legend -->
                    <Border Grid.Row="0" Background="{StaticResource Surface2Brush}"
                            Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="🎨 3D Model Viewer" Foreground="{StaticResource TextBrush}"
                                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                <!-- Weight legend -->
                                <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#E74C3C"
                                            VerticalAlignment="Center" BorderBrush="#FF6B6B" BorderThickness="1"/>
                                    <TextBlock Text=" > 5000 kg" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#E74C3C" Margin="5,0,20,0" VerticalAlignment="Center"/>
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#F39C12"
                                            VerticalAlignment="Center" BorderBrush="#FFB84D" BorderThickness="1"/>
                                    <TextBlock Text=" > 3000 kg" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#F39C12" Margin="5,0,20,0" VerticalAlignment="Center"/>
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#FFFFFF"
                                            VerticalAlignment="Center" BorderBrush="#AAAAAA" BorderThickness="1"/>
                                    <TextBlock Text=" Normal" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#CCCCCC" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="⊙ Reset View" Click="ResetCamera_Click"
                                        Padding="8,3" Foreground="#AAAACC" Background="#2A2A35"
                                        BorderBrush="#444455" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Viewport + overlays stacked -->
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <helix:HelixViewport3D x:Name="IfcViewer"
                               Background="#111118"
                               ShowViewCube="True"
                               ShowCoordinateSystem="True"
                               CameraRotationMode="Turntable"
                               ZoomSensitivity="2"
                               RotationSensitivity="1"
                               IsZoomEnabled="True"
                               IsPanEnabled="True"
                               IsRotationEnabled="True"
                               ZoomAroundMouseDownPoint="True"
                               RotateAroundMouseDownPoint="True"
                               InfiniteSpin="False"
                               PreviewMouseWheel="IfcViewer_PreviewMouseWheel">
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup>
                                        <AmbientLight Color="#404040"/>
                                        <DirectionalLight Color="#FFFFFF" Direction="-1,-2,-1.5"/>
                                        <DirectionalLight Color="#557799" Direction="1,1,0.5"/>
                                        <DirectionalLight Color="#334466" Direction="0.3,1,-2"/>
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                        </helix:HelixViewport3D>

                        <!-- OSNAP snap indicator overlay -->
                        <Canvas x:Name="OsnapOverlayCanvas"
                                IsHitTestVisible="False" Background="Transparent"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <!-- Measure / Preview / Grid-label overlay -->
                        <zoneUI:ViewportOverlayCanvas x:Name="Overlay"
                                IsHitTestVisible="False" Background="Transparent"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <!-- Floating tools: CursorPickStrip -->
                        <Canvas x:Name="FloatingToolCanvas"
                                Background="{x:Null}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <zoneUI:CursorPickStrip x:Name="PickStrip"
                                    Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0"/>
                        </Canvas>

                        <!-- No-model placeholder -->
                        <Border x:Name="NoModelOverlay" Background="{StaticResource SurfaceBrush}" Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,15" Opacity="0.3"/>
                                <TextBlock Text="No IFC Model Loaded" HorizontalAlignment="Center" FontSize="18"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Use the IFC MODEL tab to load a file" HorizontalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- CommandLine Bar -->
                    <zoneUI:CommandLineBar x:Name="CmdLine" Grid.Row="2"/>
                </Grid>
            </Border>

            <!-- ══ Col 3: Splitter ══ -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" ShowsPreview="True" Cursor="SizeWE"/>

            <!-- ══ Col 4: Combined Cranes + Zones panel ══ -->
            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <uc:SitePlannerPanel
                    x:Name="SitePlanner"
                    AddTowerCraneRequested="AddTowerCrane_Click"
                    AddMobileCraneRequested="AddMobileCrane_Click"
                    RemoveSelectedRequested="RemoveSelectedCrane_Click"
                    RemoveAllRequested="RemoveAllCranes_Click"/>
            </Border>
        </Grid>

        <!-- ══ ROW 6 — STATUS BAR ══ -->
        <Border Grid.Row="6" Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="28" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Col 0: Status text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#27AE60" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="11"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Col 1: Crane indicator (centered, collapsible) -->
                <StackPanel x:Name="CraneStatusIndicator" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="🏗️" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="CraneStatusText" Text="Crane Active" FontSize="10"
                               Foreground="{StaticResource CraneAccentBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Col 2: OSnap toggles (always visible, like AutoCAD status bar) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,15,0"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="StatusOsnapMaster" Content="OSNAP"
                                  IsChecked="True" Margin="0,0,6,0"
                                  Click="StatusOsnapMaster_Click"
                                  ToolTip="Master OSnap toggle (enable/disable all snaps)"
                                  Style="{StaticResource StatusOsnapBtn}"
                                  Width="48"/>
                    <Rectangle Width="1" Height="14" Fill="#3F3F46" Margin="0,0,6,0"/>
                    <ToggleButton x:Name="StatusOsnapEnd" Content="END" IsChecked="True"
                                  Click="StatusOsnap_Click" Tag="Endpoint"
                                  ToolTip="Snap to Endpoint"
                                  Style="{StaticResource StatusOsnapBtn}" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="StatusOsnapMid" Content="MID" IsChecked="True"
                                  Click="StatusOsnap_Click" Tag="Midpoint"
                                  ToolTip="Snap to Midpoint"
                                  Style="{StaticResource StatusOsnapBtn}" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="StatusOsnapInt" Content="INT" IsChecked="False"
                                  Click="StatusOsnap_Click" Tag="Intersection"
                                  ToolTip="Snap to Intersection"
                                  Style="{StaticResource StatusOsnapBtn}" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="StatusOsnapPer" Content="PER" IsChecked="False"
                                  Click="StatusOsnap_Click" Tag="Perpendicular"
                                  ToolTip="Snap Perpendicular"
                                  Style="{StaticResource StatusOsnapBtn}" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="StatusOsnapGrid" Content="GRID" IsChecked="True"
                                  Click="StatusOsnap_Click" Tag="Grid"
                                  ToolTip="Snap to Grid"
                                  Style="{StaticResource StatusOsnapBtn}" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="StatusOsnapNea" Content="NEA" IsChecked="False"
                                  Click="StatusOsnap_Click" Tag="Nearest"
                                  ToolTip="Snap to Nearest point on edge"
                                  Style="{StaticResource StatusOsnapBtn}"/>
                </StackPanel>

                <!-- Col 3: Unit display -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,15,0">
                    <TextBlock Text="Unit: " FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SelectedUnit}" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Col 4: Elements count -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Elements: {0}">
                                <Binding Path="Elements.Count" FallbackValue="0"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
