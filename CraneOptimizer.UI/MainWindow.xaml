<Window
    x:Class="CraneOptimizer.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="http://helix-toolkit.org/wpf"
    xmlns:local="clr-namespace:CraneOptimizer.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Crane Optimizer"
    Width="900"
    Height="600"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <StackPanel Margin="5" Orientation="Horizontal">

            <Button
                x:Name="BtnLoadIfc"
                Width="120"
                Height="30"
                Margin="5"
                Click="BtnLoadIfc_Click"
                Content="Load IFC" />

            <Button
                x:Name="BtnDrawGreenArea"
                Width="120"
                Height="30"
                Margin="5"
                Click="BtnDrawGreenArea_Click"
                Content="Draw Area" />

        </StackPanel>

        <!--  3D View  -->
        <h:HelixViewport3D
            x:Name="MainViewport"
            Grid.Row="1"
            ZoomExtentsWhenLoaded="True">

            <h:SunLight />
            <h:GridLinesVisual3D
                Width="200"
                Length="200"
                MajorDistance="10"
                MinorDistance="1"
                Thickness="0.02" />
        </h:HelixViewport3D>

    </Grid>
</Window>
