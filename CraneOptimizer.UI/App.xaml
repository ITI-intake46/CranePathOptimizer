<Application
    x:Class="CraneOptimizer.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CraneOptimizer.UI.Core.Converters"
    xmlns:localDxf="clr-namespace:CraneOptimizer.UI.Core.Converters.DXF">
    <Application.Resources>
        <ResourceDictionary>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:LiftStatusToBrushConverter x:Key="LiftStatusToBrushConverter"/>
            <local:BoolToTextConverter x:Key="BoolToTextConverter"/>
            <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <local:LengthDisplayConverter x:Key="LengthDisplayConverter"/>
            <local:MassDisplayConverter x:Key="MassDisplayConverter"/>
            <local:ElementDisplayNameConverter x:Key="ElementDisplayNameConverter" />
            <local:ElementWeightDisplayConverter x:Key="ElementWeightDisplayConverter" />
            <localDxf:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>

            <ResourceDictionary.MergedDictionaries>

                <!--
                    LOAD ORDER IS CRITICAL.
                    [0] Color tokens           — raw Color values, never change
                    [1] Brush tokens           — SolidColorBrush keyed on Color tokens
                    [2] Typography             — FontFamily / FontSize tokens
                    [3] Spacing                — CornerRadius, ControlPadding, Space*
                    [4] Control templates      — reference brush + spacing tokens
                    [5] Shell chrome           — TitleBarButton, ToolbarButton, ElementListItem…
                    [6] Window chrome          — WindowStyles (WindowChrome, resize grips)
                -->

                <!-- [0] Color tokens -->
                <ResourceDictionary Source="Resources/Colors.xaml"/>

                <!-- [1] Brush tokens — ALL StaticResource brush refs must be defined here -->
                <ResourceDictionary Source="Resources/Brushes.xaml"/>

                <!-- [1b] Theme surface brushes — default: Dark. ThemeService swaps index [2] at runtime -->
                <ResourceDictionary Source="Resources/Theme/Dark.Brushes.xaml"/>

                <!-- [2] Typography -->
                <ResourceDictionary Source="Resources/Typography.xaml"/>

                <!-- [3] Spacing -->
                <ResourceDictionary Source="Resources/DesignSystem/Spacing.xaml"/>

                <!-- [3b] Elevation — shadow presets (Shadow1 / Shadow2 / Shadow3) -->
                <ResourceDictionary Source="Resources/DesignSystem/Elevation.xaml"/>

                <!-- [4] Control styles — ControlStyles.xaml is the single authoritative source. -->
                <!--     ButtonStyles / TextBoxStyles / ComboBoxStyles / ToolbarStyles removed   -->
                <!--     (all superseded by ControlStyles.xaml + ShellStyles.xaml)               -->
                <ResourceDictionary Source="Resources/DesignSystem/Controls/DataGridStyles.xaml"/>
                <ResourceDictionary Source="Resources/DesignSystem/Controls/RibbonStyles.xaml"/>
                <ResourceDictionary Source="Resources/DesignSystem/Controls/NavigationStyles.xaml"/>
                <ResourceDictionary Source="Resources/DesignSystem/Controls/ControlStyles.xaml"/>

                <!-- [5] Shell chrome -->
                <ResourceDictionary Source="Resources/Shell/ShellStyles.xaml"/>

                <!-- [6] Window chrome -->
                <ResourceDictionary Source="Resources/Shell/WindowStyles.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>