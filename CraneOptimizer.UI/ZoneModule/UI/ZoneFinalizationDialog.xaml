<Window x:Class="WPF_IFC_test1.ZoneModule.UI.ZoneFinalizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finalize Zone"
        Width="380" Height="340"
        Background="#1E1E1E" Foreground="#CCCCCC"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Zone Properties" FontSize="14" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="AreaLabel" Foreground="#888" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Zone Type Toggle — use RadioButton (has GroupName) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="RadioAllowed" Grid.Column="0"
                         Content="✅  Allowed (Green)"
                         GroupName="ZoneTypeGroup"
                         IsChecked="True"
                         Foreground="#27AE60" FontWeight="SemiBold"
                         VerticalContentAlignment="Center"
                         Margin="0,0,4,0" Padding="8,6"
                         Checked="ZoneType_Changed"/>
            <RadioButton x:Name="RadioForbidden" Grid.Column="1"
                         Content="❌  Forbidden (Red)"
                         GroupName="ZoneTypeGroup"
                         Foreground="#E74C3C" FontWeight="SemiBold"
                         VerticalContentAlignment="Center"
                         Margin="4,0,0,0" Padding="8,6"
                         Checked="ZoneType_Changed"/>
        </Grid>

        <!-- Zone Name — watermark via Grid overlay instead of PlaceholderText -->
        <Label Grid.Row="2" Content="Zone Name (optional):"/>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <TextBox x:Name="TxtZoneName"
                     Background="#2D2D30" Foreground="White"
                     BorderBrush="#555" Padding="4,2" Height="26"
                     GotFocus="TxtZoneName_GotFocus"
                     LostFocus="TxtZoneName_LostFocus"/>
            <TextBlock x:Name="ZoneNamePlaceholder"
                       Text="e.g. Pedestrian Area, Power Lines"
                       Foreground="#666" FontStyle="Italic" FontSize="11"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
        </Grid>

        <!-- Height Range -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="Min Height (m):"/>
                <TextBox x:Name="TxtMinHeight" Text="0.0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Max Height (m):"/>
                <TextBox x:Name="TxtMaxHeight" Text="999.0"/>
            </StackPanel>
        </Grid>

        <!-- Error label -->
        <TextBlock Grid.Row="5" x:Name="ErrorLabel"
                   Foreground="OrangeRed" FontSize="11"
                   VerticalAlignment="Bottom" Margin="0,0,0,4"/>

        <!-- Buttons -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Create Zone"
                    Click="Confirm_Click" Background="#007ACC"/>
            <Button Grid.Column="2" Content="Cancel"
                    Click="Cancel_Click" Background="#3E3E42"/>
        </Grid>
    </Grid>
</Window>
