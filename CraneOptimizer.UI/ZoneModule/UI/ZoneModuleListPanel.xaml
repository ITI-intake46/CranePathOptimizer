<UserControl x:Class="WPF_IFC_test1.ZoneModule.UI.ZoneModuleListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:WPF_IFC_test1.Utilities"
             Background="#252526"
             MinWidth="220">

    <UserControl.Resources>
        <util:UnitFormatConverter     x:Key="UnitFmt"/>
        <util:UnitFormatAreaConverter x:Key="UnitFmtArea"/>


        <Style x:Key="FilterRadio" TargetType="RadioButton">
            <Setter Property="GroupName"       Value="ZoneFilter"/>
            <Setter Property="Foreground"      Value="#888888"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D2E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <!-- Header -->
            <RowDefinition Height="26"/>
            <!-- Filter tabs -->
            <RowDefinition Height="*"/>
            <!-- Zone list -->
            <RowDefinition Height="Auto"/>
            <!-- Stats -->
            <RowDefinition Height="Auto"/>
            <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- ROW 0: Header -->
        <Border Grid.Row="0" Background="#2D2D30"
                BorderBrush="#111" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="🗺"
                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="ZONES"
                           Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotalCount" DockPanel.Dock="Left"
                           Text="(0)" Foreground="#888888" FontSize="11"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkShowAll"
                          DockPanel.Dock="Right"
                          Content="Show all" IsChecked="True"
                          Foreground="#888888" FontSize="10"
                          VerticalAlignment="Center"
                          Checked="ChkShowAll_Changed"
                          Unchecked="ChkShowAll_Changed"/>
            </DockPanel>
        </Border>

        <!-- ROW 1: Filter tabs -->
        <Border Grid.Row="1" Background="#252526"
                BorderBrush="#333333" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbAll"       Content="All"         Style="{StaticResource FilterRadio}" IsChecked="True" Checked="Filter_Checked"/>
                <RadioButton x:Name="RbBoundary"  Content="⬜ Boundary" Style="{StaticResource FilterRadio}" Checked="Filter_Checked"/>
                <RadioButton x:Name="RbAllowed"   Content="🟢 Allowed"  Style="{StaticResource FilterRadio}" Checked="Filter_Checked"/>
                <RadioButton x:Name="RbForbidden" Content="🔴 Forbidden" Style="{StaticResource FilterRadio}" Checked="Filter_Checked"/>
            </StackPanel>
        </Border>

        <!-- ROW 2: Zone list with drag-reorder and hover tooltips -->
        <ListView x:Name="LvZones"
                  Grid.Row="2"
                  Background="#1E1E1E"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="LvZones_SelectionChanged"
                  MouseDoubleClick="LvZones_DoubleClick"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="LvZones_PreviewMouseDown"
                  PreviewMouseMove="LvZones_PreviewMouseMove"
                  Drop="LvZones_Drop">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background"                 Value="Transparent"/>
                    <Setter Property="Foreground"                 Value="#CCCCCC"/>
                    <Setter Property="BorderThickness"            Value="0,0,0,1"/>
                    <Setter Property="BorderBrush"                Value="#2D2D30"/>
                    <Setter Property="Padding"                    Value="8,6"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="AllowDrop"                  Value="True"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2A2D2E"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#094771"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Hover tooltip: zone name, type, height range -->
                        <Grid.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding HeightRange}" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                                    <TextBlock Foreground="#888888" Margin="0,2,0,0">
                                        <Run Text="Area: "/>
                                        <Run Text="{Binding FootprintArea, Converter={StaticResource UnitFmtArea}}"/>
                                    </TextBlock>
                                </StackPanel>
                            </ToolTip>
                        </Grid.ToolTip>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <!-- drag handle -->
                            <ColumnDefinition Width="6"/>
                            <!-- colour stripe -->
                            <ColumnDefinition Width="10"/>
                            <!-- spacer -->
                            <ColumnDefinition Width="*"/>
                            <!-- label -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- visibility -->
                            <ColumnDefinition Width="22"/>
                            <!-- delete -->
                        </Grid.ColumnDefinitions>

                        <!-- Drag handle -->
                        <TextBlock Grid.Column="0" Text="⠿" Foreground="#444" FontSize="14"
                                   VerticalAlignment="Center" Cursor="SizeAll" Margin="0,0,4,0"
                                   ToolTip="Drag to reorder"/>

                        <!-- Zone type colour stripe -->
                        <Border Grid.Column="1" CornerRadius="2" Margin="0,2,0,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#27AE60"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ZoneType}" Value="Forbidden">
                                            <Setter Property="Background" Value="#E74C3C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSiteBoundary}" Value="True">
                                            <Setter Property="Background" Value="#007ACC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Rectangle Grid.Column="2"/>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayLabel}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding HeightRange}"
                                       FontSize="10" Foreground="#888888" Margin="0,2,0,0"/>
                        </StackPanel>

                        <CheckBox Grid.Column="4"
                                  IsChecked="{Binding IsVisible}"
                                  VerticalAlignment="Center"
                                  ToolTip="Toggle visibility"
                                  Margin="4,0"/>

                        <Button Grid.Column="5"
                                Content="✕" Width="20" Height="20" Padding="0"
                                Tag="{Binding}"
                                ToolTip="Delete this zone"
                                Click="BtnItemDelete_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground"      Value="#555555"/>
                                    <Setter Property="Cursor"          Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#C0392B"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ROW 3: Site statistics -->
        <Border Grid.Row="3" Background="#252526"
                BorderBrush="#1A1A1A" BorderThickness="0,1,0,0"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="SITE AREA" Foreground="#555" FontSize="9" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtSiteArea" Text="—" Foreground="#AAAAAA"
                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                               ToolTip="Total site boundary area"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="FORBIDDEN" Foreground="#555" FontSize="9" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtForbiddenPct" Text="—" Foreground="#E74C3C"
                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                               ToolTip="% of site covered by forbidden zones at ground level"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="ZONES" Foreground="#555" FontSize="9" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalCount2" Text="0" Foreground="#AAAAAA"
                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                               ToolTip="Total zone count"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 4: Type badges + footer buttons -->
        <Border Grid.Row="4" Background="#2D2D30"
                BorderBrush="#111111" BorderThickness="0,1,0,0"
                Padding="8,6">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Border Background="#1A3A52" CornerRadius="3" Padding="6,2" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬜ " Foreground="#007ACC" FontSize="10"/>
                            <TextBlock x:Name="TxtBoundaryCount" Text="0" Foreground="#AAAAAA" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A3A24" CornerRadius="3" Padding="6,2" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟢 " FontSize="10"/>
                            <TextBlock x:Name="TxtAllowedCount" Text="0" Foreground="#AAAAAA" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#3A1A1A" CornerRadius="3" Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔴 " FontSize="10"/>
                            <TextBlock x:Name="TxtForbiddenCount" Text="0" Foreground="#AAAAAA" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnDeleteSelected"
                            Content="✖ Delete"
                            Style="{StaticResource FooterBtn}"
                            BorderBrush="#E74C3C" Foreground="#E74C3C"
                            Margin="0,0,6,0"
                            Click="BtnDeleteSelected_Click"/>
                    <Button x:Name="BtnDeleteAll"
                            Content="🗑 Clear All"
                            Style="{StaticResource FooterBtn}"
                            BorderBrush="#666666" Foreground="#AAAAAA"
                            Margin="0,0,6,0"
                            Click="BtnDeleteAll_Click"/>
                    <Button x:Name="BtnExportJson"
                            Content="📤 JSON"
                            Style="{StaticResource FooterBtn}"
                            BorderBrush="#555555" Foreground="#AAAAAA"
                            Margin="0,0,4,0"
                            Click="BtnExportJson_Click"
                            ToolTip="Export zones to JSON"/>
                    <Button x:Name="BtnExportCsv"
                            Content="📋 CSV"
                            Style="{StaticResource FooterBtn}"
                            BorderBrush="#555555" Foreground="#AAAAAA"
                            Click="BtnExportCsv_Click"
                            ToolTip="Export zones to CSV"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
