<UserControl x:Class="WPF_IFC_test1.ZoneModule.UI.RevitDrawPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A1A"
             Focusable="True"
             KeyDown="UserControl_KeyDown"
             MouseEnter="UserControl_MouseEnter">

    <UserControl.Resources>
        <Style x:Key="MapBtn" TargetType="Button">
            <Setter Property="Background"      Value="#2D2D30"/>
            <Setter Property="Foreground"      Value="#AAAAAA"/>
            <Setter Property="BorderBrush"     Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ── DRAWING CANVAS ── -->
        <Border Grid.Row="0"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                ClipToBounds="True">

            <!--
                NOTE: Cursor="Cross" is the correct WPF value (not "Crosshair").
                MouseMiddleButtonDown/Up are NOT valid Canvas XAML events.
                Middle-button panning is handled in code-behind via MouseDown
                with e.ChangedButton == MouseButton.Middle.
            -->
            <Canvas x:Name="DrawCanvas"
                    Background="Transparent"
                    ClipToBounds="True"
                    Cursor="Cross"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseRightButtonDown="Canvas_MouseRightButtonDown"
                    MouseMove="Canvas_MouseMove"
                    MouseWheel="Canvas_MouseWheel"
                    MouseDown="Canvas_MouseDown"
                    MouseUp="Canvas_MouseUp">

                <!-- Layer 1: Grid lines -->
                <Canvas x:Name="GridCanvas"        IsHitTestVisible="False"/>

                <!-- Layer 2: Completed zones -->
                <Canvas x:Name="ZonesCanvas"       IsHitTestVisible="False"/>

                <!-- Layer 3: Crane swing radius circles -->
                <Canvas x:Name="CraneRadiusCanvas" IsHitTestVisible="False"/>

                <!-- Layer 4: Active drawing preview polygon -->
                <Canvas x:Name="PreviewCanvas"     IsHitTestVisible="False"/>

                <!-- Layer 5: Mouse cursor crosshair -->
                <Canvas x:Name="CursorCanvas"      IsHitTestVisible="False"/>

            </Canvas>
        </Border>

        <!-- ── STATUS BAR ── -->
        <Border Grid.Row="1" Background="#2D2D30" Padding="8,0">
            <DockPanel VerticalAlignment="Center">

                <!-- Left: Coordinates + point count -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📍" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCoords"
                               Text="X: 0.00    Y: 0.00"
                               Foreground="#AAAAAA" FontSize="10"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" Width="130"/>
                    <Rectangle Width="1" Height="14" Fill="#444444" Margin="8,0"/>
                    <TextBlock x:Name="TxtPointCount"
                               Text=""
                               Foreground="#888888" FontSize="10"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Zoom controls + toggles -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">

                    <Button x:Name="BtnZoomOut"
                            Content="−" Width="22" Height="20" Padding="0"
                            Style="{StaticResource MapBtn}"
                            ToolTip="Zoom out"
                            Click="BtnZoomOut_Click"/>
                    <TextBlock x:Name="TxtZoom"
                               Text="100%"
                               Foreground="#AAAAAA" FontSize="10"
                               Width="40" TextAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnZoomIn"
                            Content="＋" Width="22" Height="20" Padding="0"
                            Style="{StaticResource MapBtn}"
                            ToolTip="Zoom in"
                            Click="BtnZoomIn_Click"
                            Margin="0,0,4,0"/>
                    <Button x:Name="BtnZoomFit"
                            Content="⊡ Fit" Height="20" Padding="6,0"
                            Style="{StaticResource MapBtn}"
                            ToolTip="Fit all zones to view"
                            Click="BtnZoomFit_Click"
                            Margin="0,0,4,0"/>
                    <Button x:Name="BtnResetView"
                            Content="↺ Reset" Height="20" Padding="6,0"
                            Style="{StaticResource MapBtn}"
                            ToolTip="Reset zoom and pan to origin"
                            Click="BtnResetView_Click"/>

                    <Rectangle Width="1" Height="14" Fill="#444444" Margin="8,0"/>

                    <CheckBox x:Name="ChkShowGrid"
                              Content="Grid"
                              IsChecked="True"
                              Foreground="#888888" FontSize="10"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"
                              Checked="ChkGrid_Changed"
                              Unchecked="ChkGrid_Changed"/>

                    <CheckBox x:Name="ChkShowCraneRadius"
                              Content="Crane radii"
                              IsChecked="True"
                              Foreground="#888888" FontSize="10"
                              VerticalAlignment="Center"
                              Checked="ChkCraneRadius_Changed"
                              Unchecked="ChkCraneRadius_Changed"/>
                </StackPanel>

                <!-- Centre: hint text -->
                <TextBlock x:Name="TxtHint"
                           Text="L-click: add point  •  Dbl-click: finish  •  R-click: remove last  •  Scroll: zoom  •  Mid-drag: pan"
                           Foreground="#444444" FontSize="10" FontStyle="Italic"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
