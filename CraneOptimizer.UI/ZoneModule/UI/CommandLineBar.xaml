<UserControl x:Class="WPF_IFC_test1.ZoneModule.UI.CommandLineBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto"
             Visibility="Visible"
             Focusable="False"
             Background="#111118">
    <!--
        CommandLineBar — AutoCAD-style command input strip.
        Sits at the bottom of the viewport column (Row below the viewport Grid).
        Height is auto — typically 56px collapsed (prompt + input) or taller
        when history is visible.

        Three visual zones left → right:
          • Mode badge    — teal pill showing active mode  e.g. [MEASURE]
          • Prompt label  — grey italic text e.g. "Specify first point:"
          • Input box     — white text, accepts typed commands
          • Result area   — right-aligned, shows last computed value

        The control is COLLAPSED by default and becomes Visible when a tool
        activates it. Session 6 wires Visibility from MainWindow.
    -->
    <Border BorderBrush="#2A2A3A" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- history (collapsed by default) -->
                <RowDefinition Height="34"/>
                <!-- main input row -->
            </Grid.RowDefinitions>

            <!-- ── History panel (collapsed until user presses ↑) ── -->
            <Border x:Name="HistoryPanel"
                    Grid.Row="0"
                    Background="#0D0D14"
                    Visibility="Collapsed"
                    MaxHeight="120">
                <ScrollViewer x:Name="HistoryScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="8,4">
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="#666688"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Padding="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ── Main input row ── -->
            <Grid Grid.Row="1" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- mode badge -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- separator -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- prompt label -->
                    <ColumnDefinition Width="*"/>
                    <!-- text input -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- result -->
                </Grid.ColumnDefinitions>

                <!-- Mode badge pill -->
                <Border x:Name="ModeBadge"
                        Grid.Column="0"
                        Background="#1A3A3A"
                        BorderBrush="#1ABC9C"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtMode"
                               Text="COMMAND"
                               Foreground="#1ABC9C"
                               FontFamily="Consolas"
                               FontSize="10"
                               FontWeight="Bold"/>
                </Border>

                <!-- Separator dot -->
                <TextBlock Grid.Column="1"
                           Text="›"
                           Foreground="#444466"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <!-- Prompt label -->
                <TextBlock x:Name="TxtPrompt"
                           Grid.Column="2"
                           Text="Type a command or press ESC"
                           Foreground="#666688"
                           FontFamily="Consolas"
                           FontSize="11"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <!-- Command / value input -->
                <TextBox x:Name="TxtInput"
                         Grid.Column="3"
                         Background="Transparent"
                         Foreground="#E0E0FF"
                         CaretBrush="#1ABC9C"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         KeyDown="TxtInput_KeyDown"
                         TextChanged="TxtInput_TextChanged"
                         GotFocus="TxtInput_GotFocus"
                         LostFocus="TxtInput_LostFocus">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Result / status text (right side) -->
                <Border Grid.Column="4"
                        Background="#161622"
                        CornerRadius="3"
                        Padding="8,2"
                        Margin="8,4"
                        Visibility="{Binding ElementName=TxtResult, Path=Text, Converter={x:Null}}">
                    <TextBlock x:Name="TxtResult"
                               Foreground="#1ABC9C"
                               FontFamily="Consolas"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
