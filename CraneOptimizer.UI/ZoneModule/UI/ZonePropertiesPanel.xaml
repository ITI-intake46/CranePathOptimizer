<!-- FILE: ZoneModule/UI/ZonePropertiesPanel.xaml  (NEW FILE) -->
<!-- Companion XAML for ZonePropertiesPanel.xaml.cs                   -->
<!-- Spec §7.3: editable Min/Max Height, zone type toggle, name, notes -->
<UserControl x:Class="WPF_IFC_test1.ZoneModule.UI.ZonePropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF2B2B2B"
             Foreground="White"
             Width="260"
             Visibility="Collapsed">

    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background"  Value="#FF3A3A3A"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding"     Value="4,3"/>
            <Setter Property="Margin"      Value="0,2,0,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin"     Value="0,2,8,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin"     Value="0,4,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background"  Value="#FF444444"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#FF666666"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="Margin"      Value="0,2,4,2"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="10">

        <!-- Header -->
        <TextBlock Text="Zone Properties"
                   FontSize="13" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <!-- Zone info labels -->
        <Label x:Name="LblZoneId"   Content="ID: —"/>
        <Label x:Name="LblArea"     Content="Area: —"/>
        <Label x:Name="LblCreated"  Content="Created: —"/>

        <Separator Background="#FF444444" Margin="0,6,0,6"/>

        <!-- Name -->
        <TextBlock Text="Name" FontSize="11" Foreground="#FFAAAAAA"/>
        <TextBox x:Name="TxtName"
                 TextChanged="TxtName_TextChanged"/>

        <!-- Zone type toggle -->
        <TextBlock Text="Zone Type" FontSize="11" Foreground="#FFAAAAAA" Margin="0,4,0,2"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RadioAllowed"
                         Content="✅ Allowed (Green)"
                         Checked="ZoneType_Changed"/>
            <RadioButton x:Name="RadioForbidden"
                         Content="🚫 Forbidden (Red)"
                         Checked="ZoneType_Changed"/>
        </StackPanel>

        <Separator Background="#FF444444" Margin="0,6,0,6"/>

        <!-- Heights -->
        <TextBlock Text="Min Height (m)" FontSize="11" Foreground="#FFAAAAAA"/>
        <TextBox x:Name="TxtMinHeight"
                 LostFocus="TxtMinHeight_LostFocus"/>

        <TextBlock Text="Max Height (m)" FontSize="11" Foreground="#FFAAAAAA"/>
        <TextBox x:Name="TxtMaxHeight"
                 LostFocus="TxtMaxHeight_LostFocus"/>

        <!-- Height error -->
        <TextBlock x:Name="HeightError"
                   Text=""
                   Foreground="OrangeRed"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4"/>

        <Separator Background="#FF444444" Margin="0,6,0,6"/>

        <!-- Notes -->
        <TextBlock Text="Notes" FontSize="11" Foreground="#FFAAAAAA"/>
        <TextBox x:Name="TxtNotes"
                 Height="60"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="TxtNotes_TextChanged"/>

        <!-- Visibility -->
        <CheckBox x:Name="ChkVisible"
                  Content="Visible in viewport"
                  Checked="ChkVisible_Changed"
                  Unchecked="ChkVisible_Changed"/>

        <Separator Background="#FF444444" Margin="0,6,0,6"/>

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnApply"
                    Content="Apply"
                    Background="#FF2E7D32"
                    Click="BtnApply_Click"/>
            <Button x:Name="BtnDelete"
                    Content="Delete Zone"
                    Background="#FF8B0000"
                    Click="BtnDelete_Click"/>
        </StackPanel>

    </StackPanel>
</UserControl>
