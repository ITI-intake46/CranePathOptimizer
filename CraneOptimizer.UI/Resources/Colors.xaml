<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand -->
    <Color x:Key="Color.Primary">#F5A623</Color>

    <!-- Background -->
    <Color x:Key="Color.Background">#0F1115</Color>
    <Color x:Key="Color.Surface">#15181E</Color>
    <Color x:Key="Color.SurfaceElevated">#1C2128</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#9CA3AF</Color>
    <Color x:Key="Color.TextDisabled">#4B5563</Color>

    <!-- Borders -->
    <Color x:Key="Color.Border">#2A2F38</Color>

    <!-- Status -->
    <Color x:Key="Color.Success">#22C55E</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Error">#EF4444</Color>
    <Color x:Key="Color.Destructive">#EF4444</Color>

</ResourceDictionary>
