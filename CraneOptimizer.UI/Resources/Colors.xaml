<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        COLOR TOKENS  —  CraneOptimizer Design System
        Primary   : #D68A56  (warm terracotta/sienna)
        Secondary : #757575  (gray)
        Tertiary  : #CFD8DC  (blue-gray)
        Neutral   : #1A1A1A  (near black)
        Raw color values shared by both themes.
    -->

    <!-- ── Brand colors ────────────────────────────────────────────── -->
    <Color x:Key="Color.Primary">#D68A56</Color>
    <Color x:Key="Color.PrimaryHover">#E49B6A</Color>
    <Color x:Key="Color.PrimaryPressed">#BD7743</Color>
    <Color x:Key="Color.PrimaryMuted">#3FD68A56</Color>

    <Color x:Key="Color.Secondary">#757575</Color>
    <Color x:Key="Color.Tertiary">#CFD8DC</Color>

    <Color x:Key="Color.Destructive">#EF5350</Color>
    <Color x:Key="Color.DestructiveHover">#E53935</Color>
    <Color x:Key="Color.Error">#EF5350</Color>

    <Color x:Key="Color.Success">#66BB6A</Color>
    <Color x:Key="Color.Warning">#D68A56</Color>

    <!-- OnPrimary — dark text rendered ON the primary surface -->
    <Color x:Key="Color.OnPrimary">#1A1A1A</Color>

    <Color x:Key="Color.SelectedCranePoint">#3B82F6</Color>
    <Color x:Key="Color.BuildingDefault">#D68A56</Color>

</ResourceDictionary>
