<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Primary  -->
    <Color x:Key="Color.Primary">#2563EB</Color>
    <Color x:Key="Color.PrimaryHover">#1D4ED8</Color>
    <Color x:Key="Color.PrimaryPressed">#1E40AF</Color>

    <!--  Secondary  -->
    <Color x:Key="Color.Secondary">#64748B</Color>

    <!--  Backgrounds  -->
    <Color x:Key="Color.Background">#0F172A</Color>
    <Color x:Key="Color.Surface">#1E293B</Color>
    <Color x:Key="Color.SurfaceLight">#334155</Color>

    <!--  Text  -->
    <Color x:Key="Color.TextPrimary">#F8FAFC</Color>
    <Color x:Key="Color.TextSecondary">#CBD5F5</Color>

    <!--  Borders  -->
    <Color x:Key="Color.Border">#475569</Color>

    <!--  Status  -->
    <Color x:Key="Color.Success">#22C55E</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Error">#EF4444</Color>
</ResourceDictionary>