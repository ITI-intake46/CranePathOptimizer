<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        WindowStyles.xaml — CraneOptimizer Design System
        Base Window and root-level element defaults.
        All colours and fonts from active design tokens — no hardcoded values.
    -->

    <!-- ── Window base ────────────────────────────────────────────── -->
    <Style TargetType="Window">
        <Setter Property="Background"  Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily"  Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize"    Value="{StaticResource FontSizeBase}"/>
    </Style>

    <!-- ── Maximized window root grid ─────────────────────────────── -->
    <!-- Compensates for WPF WindowStyle=None + AllowsTransparency bug -->
    <Style x:Key="MaximizedWindowGridStyle" TargetType="Grid">
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                <Setter Property="Margin" Value="8" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>