<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--  ── Corner radii ────────────────────────────────────────────  -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>

    <!--  ── Control padding ─────────────────────────────────────────  -->
    <Thickness x:Key="ControlPadding">12,7,12,7</Thickness>
    <Thickness x:Key="InputPadding">8,4,8,4</Thickness>
    <sys:Double x:Key="InputHeight">32</sys:Double>

    <!--  ── Spacing scale ───────────────────────────────────────────  -->
    <Thickness x:Key="Space1">4,4,4,4</Thickness>
    <Thickness x:Key="Space2">8,8,8,8</Thickness>
    <Thickness x:Key="Space3">12,12,12,12</Thickness>
    <Thickness x:Key="Space4">16,16,16,16</Thickness>
    <Thickness x:Key="Space5">20,20,20,20</Thickness>
    <Thickness x:Key="Space6">24,24,24,24</Thickness>
    <Thickness x:Key="Space8">32,32,32,32</Thickness>
    <Thickness x:Key="Space10">40,40,40,40</Thickness>

</ResourceDictionary>
