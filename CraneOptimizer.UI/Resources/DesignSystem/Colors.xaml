<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        COLOR TOKENS — CraneOptimizer Design System
        Primary   : #D68A56  (warm terracotta/sienna)
        Secondary : #757575  (gray)
        Tertiary  : #CFD8DC  (blue-gray)
        Neutral   : #1A1A1A  (near black)
        Raw color values shared by both themes.
    -->

    <!--  ── Brand colors ────────────────────────────────────────────  -->
    <Color x:Key="ColorPrimary">#D68A56</Color>
    <Color x:Key="ColorPrimaryHover">#E49B6A</Color>
    <Color x:Key="ColorPrimaryPressed">#BD7743</Color>
    <Color x:Key="ColorPrimaryMuted">#3FD68A56</Color>

    <Color x:Key="ColorSecondary">#757575</Color>
    <Color x:Key="ColorTertiary">#CFD8DC</Color>

    <Color x:Key="ColorDestructive">#EF5350</Color>
    <Color x:Key="ColorDestructiveHover">#E53935</Color>

    <Color x:Key="ColorSuccess">#66BB6A</Color>
    <Color x:Key="ColorWarning">#D68A56</Color>

    <!--  OnPrimary — dark text rendered ON the primary surface  -->
    <Color x:Key="ColorOnPrimary">#1A1A1A</Color>

    <!--  BuildingDefault — IFC geometry tint matching brand accent  -->
    <Color x:Key="ColorBuildingDefault">#D68A56</Color>

    <!--  ── Static brushes (brand — never swapped by theme) ──────────  -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource ColorPrimaryPressed}" />
    <SolidColorBrush x:Key="PrimaryMutedBrush" Color="{StaticResource ColorPrimaryMuted}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource ColorSecondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource ColorTertiary}" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="{StaticResource ColorDestructive}" />
    <SolidColorBrush x:Key="DestructiveHoverBrush" Color="{StaticResource ColorDestructiveHover}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource ColorOnPrimary}" />
    <SolidColorBrush x:Key="BuildingDefaultBrush" Color="{StaticResource ColorBuildingDefault}" />

</ResourceDictionary>
