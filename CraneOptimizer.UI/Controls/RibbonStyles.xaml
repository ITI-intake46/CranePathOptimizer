<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         RibbonStyles.xaml
         Location: /Main_Application_UserControl/RibbonStyles.xaml
         Build Action: Resource  (NOT Page, NOT Content)

         HOW TO REFERENCE THIS FILE FROM OTHER XAML FILES:
         ─────────────────────────────────────────────────
         Use the full pack URI so WPF loads from the compiled assembly.
         Replace the broken relative path in every ribbon tab XAML:

             ❌  BROKEN  (site-of-origin — only works as a loose file next to .exe)
             <ResourceDictionary Source="/Main_Application_UserControl/RibbonStyles.xaml"/>

             ✅  CORRECT (assembly resource — always works)
             <ResourceDictionary Source="pack://application:,,,/WPF_IFC_test1;component/Main_Application_UserControl/RibbonStyles.xaml"/>

         Files that need this fix:
             • HomeRibbonTab.xaml
             • IFCRibbonTab.xaml
             • CraneRibbonTab.xaml
             • ZoneRibbonTab.xaml
             • ViewRibbonTab.xaml
             • AnalyzeRibbonTab.xaml
             • MainRibbonControl.xaml   (inside its MergedDictionaries block)
    ════════════════════════════════════════════════════════════════════════ -->


    <!-- ── Large ribbon button: big icon stacked above two-line label ──────── -->
    <Style x:Key="RibbonLargeBtn" TargetType="Button">
        <Setter Property="Background"                   Value="Transparent"/>
        <Setter Property="Foreground"                   Value="#CCCCCC"/>
        <Setter Property="BorderThickness"              Value="0"/>
        <Setter Property="Width"                        Value="58"/>
        <Setter Property="Height"                       Value="72"/>
        <Setter Property="Cursor"                       Value="Hand"/>
        <Setter Property="FontSize"                     Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Margin="1">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#555555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ── Small ribbon button: icon + label side by side ──────────────────── -->
    <Style x:Key="RibbonSmallBtn" TargetType="Button">
        <Setter Property="Background"                   Value="Transparent"/>
        <Setter Property="Foreground"                   Value="#CCCCCC"/>
        <Setter Property="BorderThickness"              Value="0"/>
        <Setter Property="Height"                       Value="22"/>
        <Setter Property="MinWidth"                     Value="80"/>
        <Setter Property="Padding"                      Value="4,0"/>
        <Setter Property="Cursor"                       Value="Hand"/>
        <Setter Property="FontSize"                     Value="11"/>
        <Setter Property="HorizontalContentAlignment"   Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#555555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ── Toggle button: OSNAP tiles, grid/DXF/axes toggles ───────────────── -->
    <Style x:Key="RibbonToggleBtn" TargetType="ToggleButton">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="#CCCCCC"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="BorderBrush"      Value="#3F3F46"/>
        <Setter Property="Height"           Value="22"/>
        <Setter Property="MinWidth"         Value="36"/>
        <Setter Property="Padding"          Value="4,0"/>
        <Setter Property="FontSize"         Value="10"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"   Value="#094771"/>
                            <Setter TargetName="Bd" Property="BorderBrush"  Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#555555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ── Mode RadioButton: Drawing / Select / Dimension (mutually exclusive) -->
    <!--   NOTE: ZoneRibbonTab currently uses plain Buttons + manual highlight  -->
    <!--   logic. Switching those Buttons to RadioButton + this style will give  -->
    <!--   free mutual-exclusion and remove the manual HighlightModeBtn helper.  -->
    <Style x:Key="RibbonModeBtn" TargetType="RadioButton">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="#CCCCCC"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="BorderBrush"      Value="#3F3F46"/>
        <Setter Property="Height"           Value="22"/>
        <Setter Property="MinWidth"         Value="60"/>
        <Setter Property="Padding"          Value="6,0"/>
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="#3E3E42"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="#094771"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#555555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ── Vertical separator line between ribbon groups ────────────────────── -->
    <Style x:Key="RibbonSep" TargetType="Rectangle">
        <Setter Property="Width"  Value="1"/>
        <Setter Property="Fill"   Value="#3F3F46"/>
        <Setter Property="Margin" Value="4,6,4,6"/>
    </Style>


    <!-- ── Group label at the bottom of each ribbon group ───────────────────── -->
    <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="Foreground"          Value="#777777"/>
        <Setter Property="FontSize"            Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin"              Value="0,2,0,0"/>
    </Style>

</ResourceDictionary>
