<UserControl x:Class="WPF_IFC_test1.Main_Application_UserControl.ZoneListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:WPF_IFC_test1.Utilities"
             Background="#252526" MinWidth="200">

    <UserControl.Resources>
        <util:UnitFormatAreaConverter x:Key="UnitFmtArea"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#111" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="🗺" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="ZONES" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtZoneCount" Foreground="#888" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Zone List -->
        <ListView x:Name="LvZones" Grid.Row="1"
                  Background="#1E1E1E"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="LvZones_SelectionChanged"
                  MouseDoubleClick="LvZones_DoubleClick">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background"       Value="Transparent"/>
                    <Setter Property="Foreground"       Value="#CCCCCC"/>
                    <Setter Property="BorderThickness"  Value="0,0,0,1"/>
                    <Setter Property="BorderBrush"      Value="#2D2D30"/>
                    <Setter Property="Padding"          Value="8,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2A2D2E"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#094771"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Zone type color indicator -->
                        <Border Grid.Column="0" Width="6" Margin="0,0,8,0" CornerRadius="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSiteBoundary}" Value="True">
                                            <Setter Property="Background" Value="#007ACC"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ZoneType}" Value="Allowed">
                                            <Setter Property="Background" Value="#2ECC71"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ZoneType}" Value="Forbidden">
                                            <Setter Property="Background" Value="#E74C3C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Zone info -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayLabel}" FontSize="12"
                                       Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding HeightRange}" FontSize="10"
                                       Foreground="#888" Margin="0,2,0,0"/>
                            <!-- Area display — Spec §5.4 ZoneListPanel -->
                            <TextBlock FontSize="10" Foreground="#66AACC" Margin="0,1,0,0">
                                <Run Text="Area: "/>
                                <Run Text="{Binding FootprintArea, Converter={StaticResource UnitFmtArea}}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Visibility toggle -->
                        <CheckBox Grid.Column="2" IsChecked="{Binding IsVisible}"
                                  VerticalAlignment="Center" ToolTip="Toggle zone visibility"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Stats footer -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="8,6"
                BorderBrush="#111" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="TxtStats" Foreground="#888" FontSize="10" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="BtnDeleteSelected" Content="✖ Delete" Foreground="#E74C3C"
                            FontSize="10" Padding="6,2" Background="Transparent"
                            BorderBrush="#E74C3C" BorderThickness="1" Cursor="Hand"
                            Click="BtnDelete_Click" Margin="0,0,6,0"/>
                    <Button x:Name="BtnExport" Content="📤 Export" Foreground="#CCCCCC"
                            FontSize="10" Padding="6,2" Background="Transparent"
                            BorderBrush="#555" BorderThickness="1" Cursor="Hand"
                            Click="BtnExport_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
 