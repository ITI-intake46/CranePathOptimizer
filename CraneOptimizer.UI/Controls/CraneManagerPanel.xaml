<UserControl x:Class="WPF_IFC_test1.Main_Application_UserControl.CraneManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:WPF_IFC_test1.Utilities">

    <UserControl.Resources>

        <!-- Unit format converters (Session 6) -->
        <util:UnitFormatConverter     x:Key="UnitFmt"/>
        <util:UnitFormatAreaConverter x:Key="UnitFmtArea"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush"  Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBrush"     Color="#252526"/>
        <SolidColorBrush x:Key="Surface2Brush"    Color="#2D2D30"/>
        <SolidColorBrush x:Key="Surface3Brush"    Color="#3E3E42"/>
        <SolidColorBrush x:Key="TextBrush"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecBrush"     Color="#CCCCCC"/>
        <SolidColorBrush x:Key="AccentBrush"      Color="#007ACC"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="HoverBrush"       Color="#2A2D2E"/>
        <SolidColorBrush x:Key="SelectedBrush"    Color="#094771"/>
        <SolidColorBrush x:Key="CraneBrush"       Color="#F39C12"/>
        <SolidColorBrush x:Key="MobileBrush"      Color="#27AE60"/>
        <SolidColorBrush x:Key="DangerBrush"      Color="#C0392B"/>

        <!-- Flat button template -->
        <ControlTemplate x:Key="FlatBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <!-- Base button style -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template"        Value="{StaticResource FlatBtn}"/>
        </Style>

        <Style x:Key="BtnCrane"  TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource CraneBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5B041"/>
                </Trigger>
                <Trigger Property="IsPressed"   Value="True">
                    <Setter Property="Background" Value="#D68910"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnMobile" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource MobileBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2ECC71"/>
                </Trigger>
                <Trigger Property="IsPressed"   Value="True">
                    <Setter Property="Background" Value="#1E8449"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E74C3C"/>
                </Trigger>
                <Trigger Property="IsPressed"   Value="True">
                    <Setter Property="Background" Value="#922B21"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnClose" TargetType="Button">
            <Setter Property="Width"           Value="24"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template"        Value="{StaticResource FlatBtn}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CC7700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnIconDelete" TargetType="Button">
            <Setter Property="Width"           Value="22"/>
            <Setter Property="Height"          Value="22"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecBrush}"/>
            <Setter Property="Visibility"      Value="Hidden"/>
            <Setter Property="Template"        Value="{StaticResource FlatBtn}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E74C3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CraneListItem" TargetType="Border">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecBrush}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource Surface3Brush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="CaretBrush"      Value="White"/>
            <Setter Property="SelectionBrush"  Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="CraneSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource CraneBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#F2252526"
            BorderBrush="{StaticResource CraneBrush}"
            BorderThickness="2"
            CornerRadius="8"
            Width="280">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Shared header -->
                <RowDefinition Height="Auto"/>
                <!-- View container — fills remaining space -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════
                 SHARED HEADER
                 ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource CraneBrush}"
                    Padding="12,9" CornerRadius="6,6,0,0">
                <DockPanel LastChildFill="False">

                    <!-- Back button (only visible on params view) -->
                    <Button x:Name="BackBtn"
                            DockPanel.Dock="Left"
                            Content="← Back"
                            Style="{StaticResource BtnClose}"
                            Width="Auto" Padding="6,4"
                            FontSize="10" FontWeight="Normal"
                            Visibility="Collapsed"
                            Click="BackBtn_Click"
                            Margin="0,0,6,0"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderIcon" Text="🏗️" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock x:Name="HeaderTitle" Text="Crane Manager"
                                   FontWeight="Bold" FontSize="14" Foreground="White"/>
                        <!-- Badge (list view only) -->
                        <Border x:Name="CountBadge"
                                Background="#CC7700" CornerRadius="8"
                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalCranes, FallbackValue='0'}"
                                       Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Button DockPanel.Dock="Right" x:Name="CloseBtn"
                            Content="✕" Style="{StaticResource BtnClose}"
                            Click="CloseBtn_Click"/>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 VIEW CONTAINER  (both views stacked, only one visible)
                 ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">

                <!-- ─────────────────────────────────────────────────
                     VIEW 1 — CRANE LIST
                     ───────────────────────────────────────────────── -->
                <Grid x:Name="ViewList">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Add buttons -->
                    <Grid Grid.Row="0" Background="{StaticResource Surface2Brush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="＋ Tower Crane"
                                Style="{StaticResource BtnCrane}"
                                Padding="8,8" FontSize="11"
                                Click="AddTower_Click"/>
                        <Button Grid.Column="1" Content="＋ Mobile Crane"
                                Style="{StaticResource BtnMobile}"
                                Padding="8,8" FontSize="11"
                                Click="AddMobile_Click"/>
                    </Grid>

                    <!-- Row 1: Section label -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Surface2Brush}"
                            Padding="10,6"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,1,0,1">
                        <TextBlock Text="📋 Active Cranes"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="Bold" FontSize="11"/>
                    </Border>

                    <!-- Row 2: Crane list -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl x:Name="CraneListControl"
                                          ItemsSource="{Binding Cranes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CraneItemBorder"
                                                Tag="{Binding}"
                                                MouseLeftButtonDown="CraneItem_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"      Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="BorderBrush"     Value="#3F3F46"/>
                                                    <Setter Property="Padding"         Value="10,8"/>
                                                    <Setter Property="Cursor"          Value="Hand"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2A2D2E"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background"      Value="#094771"/>
                                                            <Setter Property="BorderBrush"     Value="#007ACC"/>
                                                            <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Type colour strip -->
                                                <Border Grid.Column="0" CornerRadius="2,0,0,2" Margin="0,2,6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F39C12"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="MobileCrane">
                                                                    <Setter Property="Background" Value="#27AE60"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- Icon -->
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" FontSize="16">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🏗️"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="MobileCrane">
                                                                    <Setter Property="Text" Value="🚛"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Name + type label -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="White" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Foreground="#CCCCCC"
                                                               FontSize="9" Margin="0,1,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Tower Crane"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="MobileCrane">
                                                                        <Setter Property="Text" Value="Mobile Crane"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Delete button (appears on hover) -->
                                                <Button Grid.Column="3"
                                                        x:Name="DeleteBtn"
                                                        Content="✕"
                                                        ToolTip="Remove crane"
                                                        Tag="{Binding}"
                                                        Click="DeleteCraneBtn_Click"
                                                        Width="22" Height="22"
                                                        Padding="0" FontSize="10"
                                                        Cursor="Hand"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Foreground="#CCCCCC"
                                                        Visibility="Hidden">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>

                                            <!-- Hover triggers for delete button -->
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Border.MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames
                                                                Storyboard.TargetName="DeleteBtn"
                                                                Storyboard.TargetProperty="Visibility">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="Border.MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames
                                                                Storyboard.TargetName="DeleteBtn"
                                                                Storyboard.TargetProperty="Visibility">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state -->
                            <TextBlock Text="No cranes added yet.&#x0a;Click + above to add one."
                                       Foreground="{StaticResource TextSecBrush}"
                                       FontSize="10" FontStyle="Italic"
                                       TextAlignment="Center"
                                       Margin="0,24">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalCranes}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom hint -->
                    <Border Grid.Row="3" Background="{StaticResource Surface2Brush}"
                            Padding="10,8"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <TextBlock Foreground="{StaticResource TextSecBrush}" FontSize="10"
                                   TextWrapping="Wrap">
                            <Run Text="👆 "/>
                            <Run Text="Click a crane to edit its parameters"/>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- ─────────────────────────────────────────────────
                     VIEW 2 — PARAMETERS
                     ───────────────────────────────────────────────── -->
                <Grid x:Name="ViewParams" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Crane name subtitle bar -->
                    <Border Grid.Row="0" Background="{StaticResource Surface2Brush}"
                            Padding="10,8"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="⚙️ Parameters"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="Bold" FontSize="11"/>
                            <Border DockPanel.Dock="Right"
                                    Background="{StaticResource CraneBrush}"
                                    CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                    MaxWidth="110">
                                <TextBlock Text="{Binding SelectedCrane.Name, FallbackValue='—'}"
                                           Foreground="White" FontSize="9" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Scrollable parameters -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,10,12,12">

                            <!-- Rename -->
                            <TextBlock Text="Name" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="InlineRenameBox"
                                         Style="{StaticResource DarkTextBox}"
                                         Text="{Binding SelectedCrane.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="InlineRename_KeyDown"/>
                                <Button Grid.Column="1" Content="✔" Margin="4,0,0,0"
                                        Padding="8,4" Style="{StaticResource BtnCrane}"
                                        FontSize="11" Click="ApplyRename_Click"
                                        ToolTip="Apply rename"/>
                            </Grid>

                            <Separator Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,10"/>

                            <!-- ── TOWER CRANE PARAMS ── -->
                            <StackPanel x:Name="TowerCraneControls">
                                <TextBlock Text="🏗️ Tower Crane Parameters"
                                           Foreground="{StaticResource CraneBrush}"
                                           FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>

                                <!-- ── Load Chart selector ── -->
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Load Chart"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="CboTowerCraneChart"
                                              Background="#2D2D30" Foreground="White"
                                              BorderBrush="#3F3F46" BorderThickness="1"
                                              FontSize="10" Padding="4,4"
                                              SelectionChanged="CboTowerCraneChart_Changed">
                                        <ComboBoxItem Content="— Default (no chart)"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" x:Name="BtnEditTowerChart"
                                            Content="✏" Width="28" Height="28"
                                            IsEnabled="False"
                                            Background="#1A2A40" Foreground="#6A9ACA"
                                            BorderBrush="#2A3A6A" BorderThickness="1"
                                            FontSize="11" Cursor="Hand"
                                            ToolTip="Edit this load chart"
                                            Click="BtnEditTowerChart_Click"/>
                                    <Button Grid.Column="4" x:Name="BtnDeleteTowerChart"
                                            Content="🗑" Width="28" Height="28"
                                            IsEnabled="False"
                                            Background="#3A1215" Foreground="#E05A60"
                                            BorderBrush="#5A2025" BorderThickness="1"
                                            FontSize="11" Cursor="Hand"
                                            ToolTip="Delete this load chart permanently"
                                            Click="BtnDeleteTowerChart_Click"/>
                                </Grid>
                                <Border x:Name="TowerChartInfoBox" Visibility="Collapsed"
                                        Background="#1A1030" CornerRadius="4"
                                        Padding="8,6" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Row 0 -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="MAX CAP" Foreground="#4A4C78"
                                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTowerMaxCap" Foreground="#3AAA5A"
                                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="RADIUS RANGE" Foreground="#4A4C78"
                                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTowerRadiusRange" Foreground="{StaticResource CraneBrush}"
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="JIB RANGE" Foreground="#4A4C78"
                                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTowerBoomRange" Foreground="#D0B060"
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Row 1 -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                                            <TextBlock Text="CHART TYPE" Foreground="#4A4C78"
                                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTowerOutriggerCfg" Foreground="#A0C8E0"
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="DERATING" Foreground="#4A4C78"
                                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTowerDerating" Foreground="#F39C12"
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Feasibility Checker (Feature 01) ──────────────────────────── -->
                                <Border x:Name="TowerFeasibilityCard" Background="#0A1428"
                                        BorderBrush="#1A2A4A" BorderThickness="1" CornerRadius="5"
                                        Padding="10,8" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CHECK LIFT CAPACITY" Foreground="#1A3A5A"
                                                   FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Weight (t)" Foreground="#4A5A7A" FontSize="9" Margin="0,0,0,2"/>
                                                <TextBox x:Name="TxtTowerWeight" Height="26" FontSize="10"
                                                         Background="#14152A" Foreground="#C0C4E8"
                                                         BorderBrush="#2A2B48" BorderThickness="1"
                                                         Padding="4,2" Text="10.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Radius (m)" Foreground="#4A5A7A" FontSize="9" Margin="0,0,0,2"/>
                                                <TextBox x:Name="TxtTowerCheckRadius" Height="26" FontSize="10"
                                                         Background="#14152A" Foreground="#C0C4E8"
                                                         BorderBrush="#2A2B48" BorderThickness="1"
                                                         Padding="4,2" Text="20"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Boom (m)" Foreground="#4A5A7A" FontSize="9" Margin="0,0,0,2"/>
                                                <TextBox x:Name="TxtTowerCheckBoom" Height="26" FontSize="10"
                                                         Background="#14152A" Foreground="#C0C4E8"
                                                         BorderBrush="#2A2B48" BorderThickness="1"
                                                         Padding="4,2" Text="35"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button x:Name="BtnTowerCheck" Content="⚡ Check Capacity"
                                                Height="28" Margin="0,8,0,0" FontSize="10"
                                                Background="#1A2A4A" Foreground="#6A9ACA"
                                                BorderBrush="#2A3A6A" BorderThickness="1"
                                                Cursor="Hand" Click="BtnTowerCheck_Click"/>
                                        <Border x:Name="TowerFeasibilityResult" Visibility="Collapsed"
                                                CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtTowerFeasibilityStatus"
                                                           FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtTowerFeasibilityDetail"
                                                           Foreground="#8082AC" FontSize="9"
                                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Separator Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,10"/>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Jib Length"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="TowerBoomSlider" Grid.Column="0" Style="{StaticResource CraneSlider}"
                                            Minimum="20" Maximum="80" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.BoomLength, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.BoomLength, Converter={StaticResource UnitFmt}}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Mast Height"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource CraneSlider}"
                                            Minimum="10" Maximum="100" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.TowerHeight, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.TowerHeight, Converter={StaticResource UnitFmt}}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Counter Jib"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource CraneSlider}"
                                            Minimum="5" Maximum="30" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.CounterJibLength, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.CounterJibLength, Converter={StaticResource UnitFmt}}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Cable Length"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource CraneSlider}"
                                            Minimum="2" Maximum="80" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.CableLength, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.CableLength, Converter={StaticResource UnitFmt}}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Rotation"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource CraneSlider}"
                                            Minimum="0" Maximum="360" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.SlewAngle, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.SlewAngle, StringFormat='{}{0:F0}°'}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="⚠ Exclusion Zone"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="TowerExclusionSlider" Grid.Column="0"
                                            Style="{StaticResource CraneSlider}"
                                            Minimum="0" Maximum="30" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.ExclusionRadiusM, Mode=TwoWay}"
                                            ToolTip="Keep-clear zone around the crane from its CG. Shown as orange ring in the 3D view."/>
                                    <TextBlock Grid.Column="1" Foreground="#F39C12" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.ExclusionRadiusM, StringFormat='{}{0:F1} m'}"/>
                                </Grid>
                            </StackPanel>

                            <!-- ── MOBILE CRANE PARAMS ── -->
                            <StackPanel x:Name="MobileCraneControls" Visibility="Collapsed">
                                <TextBlock Text="🚛 Mobile Crane Parameters"
                                           Foreground="{StaticResource MobileBrush}"
                                           FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>

                                <!-- ── Load Chart selector ── -->
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Load Chart"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="CboMobileCraneChart"
                                              Background="#2D2D30" Foreground="White"
                                              BorderBrush="#3F3F46" BorderThickness="1"
                                              FontSize="10" Padding="4,4"
                                              SelectionChanged="CboMobileCraneChart_Changed">
                                        <ComboBoxItem Content="— Default (no chart)"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" x:Name="BtnEditMobileChart"
                                            Content="✏" Width="28" Height="28"
                                            IsEnabled="False"
                                            Background="#1A2A40" Foreground="#6A9ACA"
                                            BorderBrush="#2A3A6A" BorderThickness="1"
                                            FontSize="11" Cursor="Hand"
                                            ToolTip="Edit this load chart"
                                            Click="BtnEditMobileChart_Click"/>
                                    <Button Grid.Column="4" x:Name="BtnDeleteMobileChart"
                                            Content="🗑" Width="28" Height="28"
                                            IsEnabled="False"
                                            Background="#3A1215" Foreground="#E05A60"
                                            BorderBrush="#5A2025" BorderThickness="1"
                                            FontSize="11" Cursor="Hand"
                                            ToolTip="Delete this load chart permanently"
                                            Click="BtnDeleteMobileChart_Click"/>
                                </Grid>
                                <Border x:Name="MobileChartInfoBox" Visibility="Collapsed"
                                        Background="#102018" CornerRadius="4"
                                        Padding="8,6" Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Row 0 -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="MAX CAP" Foreground="#4A4C78"
                                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtMobileMaxCap" Foreground="#3AAA5A"
                                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="RADIUS RANGE" Foreground="#4A4C78"
                                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtMobileRadiusRange" Foreground="{StaticResource MobileBrush}"
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="BOOM RANGE" Foreground="#4A4C78"
                                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtMobileBoomRange" Foreground="#D0B060"
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Row 1 -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                                            <TextBlock Text="OUTRIGGER CONFIG" Foreground="#4A4C78"
                                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtMobileOutriggerCfg" Foreground="#A0C8E0"
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="DERATING" Foreground="#4A4C78"
                                                       FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtMobileDerating" Foreground="#F39C12"
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Feasibility Checker (Feature 01) ──────────────────────────── -->
                                <Border x:Name="MobileFeasibilityCard" Background="#0A1428"
                                        BorderBrush="#1A2A4A" BorderThickness="1" CornerRadius="5"
                                        Padding="10,8" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CHECK LIFT CAPACITY" Foreground="#1A3A5A"
                                                   FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Weight (t)" Foreground="#4A5A7A" FontSize="9" Margin="0,0,0,2"/>
                                                <TextBox x:Name="TxtMobileWeight" Height="26" FontSize="10"
                                                         Background="#14152A" Foreground="#C0C4E8"
                                                         BorderBrush="#2A2B48" BorderThickness="1"
                                                         Padding="4,2" Text="10.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Radius (m)" Foreground="#4A5A7A" FontSize="9" Margin="0,0,0,2"/>
                                                <TextBox x:Name="TxtMobileCheckRadius" Height="26" FontSize="10"
                                                         Background="#14152A" Foreground="#C0C4E8"
                                                         BorderBrush="#2A2B48" BorderThickness="1"
                                                         Padding="4,2" Text="20"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Boom (m)" Foreground="#4A5A7A" FontSize="9" Margin="0,0,0,2"/>
                                                <TextBox x:Name="TxtMobileCheckBoom" Height="26" FontSize="10"
                                                         Background="#14152A" Foreground="#C0C4E8"
                                                         BorderBrush="#2A2B48" BorderThickness="1"
                                                         Padding="4,2" Text="35"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button x:Name="BtnMobileCheck" Content="⚡ Check Capacity"
                                                Height="28" Margin="0,8,0,0" FontSize="10"
                                                Background="#1A2A4A" Foreground="#6A9ACA"
                                                BorderBrush="#2A3A6A" BorderThickness="1"
                                                Cursor="Hand" Click="BtnMobileCheck_Click"/>
                                        <Border x:Name="MobileFeasibilityResult" Visibility="Collapsed"
                                                CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtMobileFeasibilityStatus"
                                                           FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtMobileFeasibilityDetail"
                                                           Foreground="#8082AC" FontSize="9"
                                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Swap outrigger W ↔ L orientation -->
                                <Button x:Name="BtnSwapMobile" Visibility="Collapsed"
                                        Background="#1A2A20" Foreground="#80C0A0"
                                        BorderBrush="#305040" BorderThickness="1"
                                        FontSize="9" Padding="4,3" Margin="0,2,0,4"
                                        HorizontalAlignment="Stretch"
                                        Click="BtnSwapMobile_Click"
                                        ToolTip="Swap outrigger W↔L — same physical crane, different orientation (like rotating a column 90°)">
                                    🔄 Swap Outrigger W ↔ L
                                </Button>
                                <Separator Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,10"/>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Working Radius"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MobileRadiusSlider" Grid.Column="0" Style="{StaticResource CraneSlider}"
                                            Minimum="0" Maximum="100" Margin="0,0,6,0"
                                            ValueChanged="MobileRadiusSlider_Changed"/>
                                    <TextBlock x:Name="TxtMobileRadius" Grid.Column="1" Foreground="White" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="— m"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Boom Length"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MobileBoomSlider" Grid.Column="0" Style="{StaticResource CraneSlider}"
                                            Minimum="15" Maximum="100" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.BoomLength, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.BoomLength, Converter={StaticResource UnitFmt}}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Boom Angle"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource CraneSlider}"
                                            Minimum="0" Maximum="85" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.BoomAngle, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.BoomAngle, StringFormat='{}{0:F0}°'}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Cable Length"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource CraneSlider}"
                                            Minimum="2" Maximum="60" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.CableLength, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.CableLength, Converter={StaticResource UnitFmt}}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Rotation"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource CraneSlider}"
                                            Minimum="0" Maximum="360" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.SlewAngle, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Foreground="White" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.SlewAngle, StringFormat='{}{0:F0}°'}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="⚠ Exclusion Zone"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MobileExclusionSlider" Grid.Column="0"
                                            Style="{StaticResource CraneSlider}"
                                            Minimum="0" Maximum="30" Margin="0,0,6,0"
                                            Value="{Binding SelectedCraneParameters.ExclusionRadiusM, Mode=TwoWay}"
                                            ToolTip="Keep-clear zone around the crane from its CG. Shown as orange ring in the 3D view."/>
                                    <TextBlock Grid.Column="1" Foreground="#F39C12" FontSize="10"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SelectedCraneParameters.ExclusionRadiusM, StringFormat='{}{0:F1} m'}"/>
                                </Grid>
                            </StackPanel>

                            <!-- ── POSITION (shared) ── -->
                            <Separator Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="📍 Position" Foreground="White"
                                       FontWeight="SemiBold" FontSize="10" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X:" Foreground="{StaticResource TextSecBrush}" FontSize="10" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource CraneSlider}"
                                        Minimum="-500" Maximum="500" Margin="4,0,6,0"
                                        Value="{Binding SelectedCraneParameters.PositionX, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Foreground="White" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding SelectedCraneParameters.PositionX, Converter={StaticResource UnitFmt}}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Y:" Foreground="{StaticResource TextSecBrush}" FontSize="10" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource CraneSlider}"
                                        Minimum="-500" Maximum="500" Margin="4,0,6,0"
                                        Value="{Binding SelectedCraneParameters.PositionY, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Foreground="White" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding SelectedCraneParameters.PositionY, Converter={StaticResource UnitFmt}}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Z:" Foreground="{StaticResource TextSecBrush}" FontSize="10" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource CraneSlider}"
                                        Minimum="0" Maximum="50" Margin="4,0,6,0"
                                        Value="{Binding SelectedCraneParameters.PositionZ, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Foreground="White" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding SelectedCraneParameters.PositionZ, Converter={StaticResource UnitFmt}}"/>
                            </Grid>

                            <!-- Crane info box -->
                            <Border Background="#20FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="📏 Crane Info" Foreground="White"
                                               FontWeight="SemiBold" FontSize="10" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hook Reach" Foreground="{StaticResource TextSecBrush}" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource CraneBrush}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Text="{Binding SelectedCraneParameters.HookRadius, Converter={StaticResource UnitFmt}}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hook Height" Foreground="{StaticResource TextSecBrush}" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource CraneBrush}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Text="{Binding SelectedCraneParameters.HookHeight, Converter={StaticResource UnitFmt}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Swing radius toggle -->
                            <Border Background="#18FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="👁 Show Swing Radius"
                                               Foreground="{StaticResource TextSecBrush}" FontSize="10"
                                               VerticalAlignment="Center"/>
                                    <CheckBox DockPanel.Dock="Right"
                                              IsChecked="{Binding SelectedCraneParameters.ShowSwingRadius, Mode=TwoWay}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Foreground="White"/>
                                </DockPanel>
                            </Border>

                            <!-- Tip -->
                            <Border Background="#12FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                <TextBlock Foreground="{StaticResource TextSecBrush}" FontSize="10" TextWrapping="Wrap">
                                    <Run Text="💡 " FontWeight="SemiBold"/>
                                    <Run Text="Left-drag to move  •  Right-drag to rotate"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom action bar -->
                    <Border Grid.Row="2" Background="{StaticResource Surface2Brush}"
                            Padding="10,8"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Button Content="🗑️ Remove This Crane"
                                Style="{StaticResource BtnDanger}"
                                Click="RemoveSelected_Click"/>
                    </Border>
                </Grid>

            </Grid>
            <!-- end view container -->

        </Grid>
    </Border>
</UserControl>
