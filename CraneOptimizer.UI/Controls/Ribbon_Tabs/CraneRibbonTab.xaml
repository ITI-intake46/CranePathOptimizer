<UserControl x:Class="WPF_IFC_test1.Main_Application_UserControl.Ribbon_Tabs.CraneRibbonTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252526" Height="92">
    <UserControl.Resources>
        <Style x:Key="RLB" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RSB" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RTB" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Sep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Fill" Value="#3F3F46"/>
            <Setter Property="Margin" Value="4,6,4,6"/>
        </Style>
        <Style x:Key="GL"  TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Margin="4,0">
            <Border Padding="4,4,0,0">
                <DockPanel LastChildFill="False" Width="150">
                    <TextBlock DockPanel.Dock="Bottom" Text="Add Crane" Style="{StaticResource GL}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RLB}" Click="BtnAddTower_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🏗" FontSize="26" HorizontalAlignment="Center" Margin="0,8,0,2" Foreground="#F39C12"/>
                                <TextBlock Text="Tower" HorizontalAlignment="Center" Foreground="#F39C12" FontWeight="SemiBold"/>
                                <TextBlock Text="Crane"  HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RLB}" Click="BtnAddMobile_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🚚" FontSize="26" HorizontalAlignment="Center" Margin="0,8,0,2" Foreground="#27AE60"/>
                                <TextBlock Text="Mobile" HorizontalAlignment="Center" Foreground="#27AE60" FontWeight="SemiBold"/>
                                <TextBlock Text="Crane"  HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Rectangle Style="{StaticResource Sep}"/>
            <Border Padding="8,8,0,0">
                <DockPanel LastChildFill="False" Width="190">
                    <TextBlock DockPanel.Dock="Bottom" Text="Manage" Style="{StaticResource GL}"/>
                    <StackPanel VerticalAlignment="Top">
                        <Button Style="{StaticResource RSB}" Width="180" Margin="0,0,0,2" Click="BtnRemove_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✖" FontSize="12" Foreground="#E74C3C" Margin="0,0,6,0"/>
                                <TextBlock Text="Remove Selected Crane"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RSB}" Width="180" Margin="0,0,0,2" Click="BtnRemoveAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Remove All Cranes"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="TglSwingRadius" Style="{StaticResource RTB}" Width="180"
                            HorizontalContentAlignment="Left" Padding="6,0"
                            Checked="TglSwing_Changed" Unchecked="TglSwing_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◉" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Show Swing Radius"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Rectangle Style="{StaticResource Sep}"/>
            <Border Padding="4,4,0,0">
                <DockPanel LastChildFill="False" Width="80">
                    <TextBlock DockPanel.Dock="Bottom" Text="Optimize" Style="{StaticResource GL}"/>
                    <Button Style="{StaticResource RLB}" Width="72" Click="BtnOptimize_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" Margin="0,8,0,2" Foreground="#2ECC71"/>
                            <TextBlock Text="Run" HorizontalAlignment="Center" Foreground="#2ECC71" FontWeight="SemiBold"/>
                            <TextBlock Text="Optimizer" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource Sep}"/>

            <!-- ── Load Chart (NEW) ────────────────────────────────────── -->
            <Border Padding="8,8,0,0">
                <DockPanel LastChildFill="False" Width="200">
                    <TextBlock DockPanel.Dock="Bottom" Text="Load Chart" Style="{StaticResource GL}"/>
                    <StackPanel VerticalAlignment="Top">
                        <Button Style="{StaticResource RSB}" Width="180" Margin="0,0,0,2"
                                Click="BtnImportLoadChart_Click"
                                ToolTip="Import a crane load chart from CSV or PDF — data is saved to the database">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0" Foreground="#3498DB"/>
                                <TextBlock Text="Import Load Chart..." Foreground="#3498DB" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RSB}" Width="180" Margin="0,0,0,2"
                                Click="BtnViewLoadCharts_Click"
                                ToolTip="View all saved load charts in the database">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="View Saved Charts"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RSB}" Width="180" Margin="0,0,0,2"
                                Click="BtnCatalog_Click"
                                ToolTip="Open Crane Catalog Browser to search and assign load charts">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗂" FontSize="12" Margin="0,0,6,0" Foreground="#9B59B6"/>
                                <TextBlock Text="Crane Catalog..." Foreground="#9B59B6" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RSB}" Width="180" Margin="0,0,0,2"
                                Click="BtnCompare_Click"
                                ToolTip="Compare two load chart configurations side by side">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚖" FontSize="12" Margin="0,0,6,0" Foreground="#E67E22"/>
                                <TextBlock Text="Compare Charts..." Foreground="#E67E22"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="TglCapacityRings" Style="{StaticResource RTB}" Width="180"
                                      HorizontalContentAlignment="Left" Padding="6,0"
                                      Checked="TglCapacityRings_Changed" Unchecked="TglCapacityRings_Changed"
                                      ToolTip="Show capacity rings around the selected mobile crane (Feature 09)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬤" FontSize="12" Margin="0,0,6,0" Foreground="#3498DB"/>
                                <TextBlock Text="Capacity Rings"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
