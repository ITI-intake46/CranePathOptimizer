<UserControl x:Class="WPF_IFC_test1.Main_Application_UserControl.Ribbon_Tabs.ViewRibbonTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252526" Height="92">
    <UserControl.Resources>
        <Style x:Key="RLB" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RSB" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RTB" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Sep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Fill" Value="#3F3F46"/>
            <Setter Property="Margin" Value="4,6,4,6"/>
        </Style>
        <Style x:Key="GL"  TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Margin="4,0">
            <Border Padding="4,4,0,0">
                <DockPanel LastChildFill="False" Width="210">
                    <TextBlock DockPanel.Dock="Bottom" Text="Navigation" Style="{StaticResource GL}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RLB}" Click="BtnPerspective_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🏗" FontSize="26" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                                <TextBlock Text="3D View" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RLB}" Click="BtnPlanView_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🗺" FontSize="26" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                                <TextBlock Text="Plan View" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RLB}" Click="BtnFit_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⊞" FontSize="26" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                                <TextBlock Text="Fit All" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Rectangle Style="{StaticResource Sep}"/>
            <Border Padding="8,8,0,0">
                <DockPanel LastChildFill="False" Width="180">
                    <TextBlock DockPanel.Dock="Bottom" Text="Display" Style="{StaticResource GL}"/>
                    <StackPanel VerticalAlignment="Top">
                        <ToggleButton Style="{StaticResource RTB}" Width="170" IsChecked="True" Margin="0,0,0,2"
                            HorizontalContentAlignment="Left" Padding="6,0"
                            Checked="TglGrid_Changed" Unchecked="TglGrid_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔲" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Ground Grid"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="TglZones" Style="{StaticResource RTB}" Width="170" IsChecked="True"
                            HorizontalContentAlignment="Left" Padding="6,0"
                            Checked="TglZones_Changed" Unchecked="TglZones_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🟩" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Zone Volumes"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="TglFlatZones" Style="{StaticResource RTB}" Width="170" IsChecked="False"
                            HorizontalContentAlignment="Left" Padding="6,0" Margin="0,2,0,0"
                            Checked="TglFlatZones_Changed" Unchecked="TglFlatZones_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬜" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Flat Zones (2D)"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
