<UserControl x:Class="WPF_IFC_test1.Main_Application_UserControl.Ribbon_Tabs.AnalyzeRibbonTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252526" Height="92">
    <UserControl.Resources>
        <Style x:Key="RLB" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RSB" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RTB" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Sep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Fill" Value="#3F3F46"/>
            <Setter Property="Margin" Value="4,6,4,6"/>
        </Style>
        <Style x:Key="GL"  TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Margin="4,0">
            <Border Padding="4,4,0,0">
                <DockPanel LastChildFill="False" Width="90">
                    <TextBlock DockPanel.Dock="Bottom" Text="Optimize" Style="{StaticResource GL}"/>
                    <Button Style="{StaticResource RLB}" Width="80" Click="BtnRun_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" Margin="0,8,0,2" Foreground="#2ECC71"/>
                            <TextBlock Text="Run" HorizontalAlignment="Center" Foreground="#2ECC71" FontWeight="SemiBold"/>
                            <TextBlock Text="Optimizer" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>
            <Rectangle Style="{StaticResource Sep}"/>
            <Border Padding="8,8,0,0">
                <DockPanel LastChildFill="False" Width="160">
                    <TextBlock DockPanel.Dock="Bottom" Text="Reports" Style="{StaticResource GL}"/>
                    <StackPanel VerticalAlignment="Top">
                        <Button Style="{StaticResource RSB}" Width="150" Margin="0,0,0,2" Click="BtnReport_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Export Analysis"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RSB}" Width="150" Click="BtnExportZones_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Export Zones (JSON)"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Rectangle Style="{StaticResource Sep}"/>
            <Border Padding="8,8,0,0">
                <DockPanel LastChildFill="False" Width="160">
                    <TextBlock DockPanel.Dock="Bottom" Text="Lift Planning" Style="{StaticResource GL}"/>
                    <StackPanel VerticalAlignment="Top">
                        <Button Style="{StaticResource RSB}" Width="150" Click="BtnLiftPlan_Click"
                                ToolTip="Open the Lift Plan module to plan and validate individual lifts">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏋" FontSize="12" Margin="0,0,6,0" Foreground="#E74C3C"/>
                                <TextBlock Text="Lift Plan..." Foreground="#E74C3C" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
