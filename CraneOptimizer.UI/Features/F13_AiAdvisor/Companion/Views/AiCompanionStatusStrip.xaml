<UserControl
    x:Class="CraneOptimizer.UI.Features.F13_AiAdvisor.Companion.Views.AiCompanionStatusStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="360"
    MaxWidth="720"
    Height="22"
    Focusable="False">

    <Border
        Padding="8,0"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1,0,1,0"
        CornerRadius="0">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12" Text="🤖" />

            <TextBlock
                Grid.Column="1"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeXS}"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryBrush}"
                Text="AI Copilot" />

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeXS}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding CollapsedSubText}"
                TextTrimming="CharacterEllipsis" />

            <Button
                Grid.Column="3"
                MinWidth="52"
                Height="18"
                Margin="8,0,0,0"
                Padding="7,0"
                Click="AssistButton_Click"
                Content="Assist"
                FontSize="{StaticResource FontSizeXS}"
                Style="{StaticResource ToolbarButton}" />

            <Button
                Grid.Column="4"
                Width="18"
                Height="18"
                Margin="4,0,0,0"
                Padding="0"
                Click="HideButton_Click"
                Content="×"
                FontSize="11"
                FontWeight="Bold"
                Style="{StaticResource ToolbarButton}"
                ToolTip="Hide AI Companion from the status bar" />
        </Grid>
    </Border>
</UserControl>
