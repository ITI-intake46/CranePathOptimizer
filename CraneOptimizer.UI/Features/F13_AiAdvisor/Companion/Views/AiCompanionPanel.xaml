<UserControl
    x:Class="CraneOptimizer.UI.Features.F13_AiAdvisor.Companion.Views.AiCompanionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    MinWidth="360">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="AiAssistSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource PropertyLabel}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="AiAssistCard" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="AiAssistSubtleCard" TargetType="Border" BasedOn="{StaticResource AiAssistCard}">
            <Setter Property="Padding" Value="9" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="AiAssistMicroButton" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fixed compact header. -->
        <Border Grid.Row="0" Padding="12,9" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" Margin="0,0,9,0" Background="{StaticResource PrimaryBrush}" CornerRadius="15">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="White" Text="AI" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="AI Assist" />
                    <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="Live chat · workflow actions" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Width="24" Height="24" Padding="0" VerticalAlignment="Center" Click="CloseButton_Click" Content="×" FontSize="14" FontWeight="Bold" Style="{StaticResource ToolbarButton}" ToolTip="Close AI Assist and return to Properties" />
            </Grid>
        </Border>

        <!-- One predictable body scroll surface. -->
        <ScrollViewer x:Name="BodyScrollViewer"
                      Grid.Row="1"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      PreviewMouseWheel="BodyScrollViewer_PreviewMouseWheel"
                      VerticalScrollBarVisibility="Visible">
            <StackPanel Margin="12,10,12,10">

                <!-- Compact readiness + next safe navigation action. -->
                <Border Style="{StaticResource AiAssistCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AiAssistSectionLabel}" Text="READINESS" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding WorkflowProgressLabel}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ProgressBar Margin="0,6,0,8" Height="4" Maximum="100" Minimum="0" Value="{Binding WorkflowProgressValue, Mode=OneWay}" />

                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding WorkflowStage}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" MaxHeight="34" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="16" Text="{Binding CurrentHint}" TextWrapping="Wrap" />

                        <Border Margin="0,8,0,0" Style="{StaticResource AiAssistSubtleCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AiAssistSectionLabel}" Text="NEXT" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding NextAction}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="10,0,0,0" Padding="10,5" VerticalAlignment="Center" Command="{Binding ExecutePrimaryActionCommand}" Content="{Binding PrimaryActionLabel}" Style="{StaticResource ButtonPrimary}" Visibility="{Binding PrimaryActionVisibility}" ToolTip="Safe navigation only. This does not modify project data." />
                            </Grid>
                        </Border>

                        <WrapPanel Margin="0,8,0,0">
                            <Border Margin="0,0,6,6" Padding="6,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ActiveTabLabel}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Margin="0,0,6,6" Padding="6,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DataInsight}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Margin="0,0,0,6" Padding="6,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ResultInsight}" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Live chat transcript. This stays inside the single body scroll surface. -->
                <Border Margin="0,10,0,0" Padding="0" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <Border Padding="10,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AiAssistSectionLabel}" Text="LIVE CHAT" />
                                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="Streaming answers appear here while Ollama is generating." TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="10,0,0,0" Padding="8,4" Command="{Binding OpenFullCopilotCommand}" Content="Full" Style="{StaticResource ButtonSecondary}" ToolTip="Open the full AI Copilot window." />
                            </Grid>
                        </Border>

                        <ItemsControl Margin="10,10,10,0" ItemsSource="{Binding ConversationMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,9">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding Sender}" />
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TimestampLabel}" />
                                        </Grid>
                                        <Border Padding="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="17" Text="{Binding BodyPreview}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Expander Margin="0,10,0,0" Header="Confirmable action proposals" IsExpanded="False">
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ActionProposals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="16" Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Risk}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="8,4" VerticalAlignment="Center" Command="{Binding ConfirmCommand}" CommandParameter="{Binding}" Content="{Binding ConfirmLabel}" Style="{StaticResource ButtonSecondary}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander Margin="0,8,0,0" Header="Evidence and readiness details" IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding StructuredCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding Status}" />
                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Confidence}" />
                                            </Grid>
                                            <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding Finding}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="16" Text="{Binding Evidence}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" Text="Recommendation" />
                                            <TextBlock Margin="0,3,0,0" FontSize="11" LineHeight="16" Text="{Binding Recommendation}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding NextClick}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="15" Text="{Binding Risk}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding WorkflowChecklist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="8" Background="{DynamicResource SurfaceBrush}" CornerRadius="7">
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="15" TextWrapping="Wrap">
                                            <Run Text="• " />
                                            <Run FontWeight="SemiBold" Text="{Binding Name}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Severity}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Evidence}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky compact composer with draggable resize grip. -->
        <Border Grid.Row="2" Padding="12,6,12,9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
            <StackPanel>
                <primitives:Thumb x:Name="ComposerResizeThumb"
                                  Height="6"
                                  Cursor="SizeNS"
                                  DragDelta="ComposerResizeThumb_DragDelta"
                                  ToolTip="Drag to resize the prompt box.">
                    <primitives:Thumb.Template>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <Border Background="Transparent">
                                <Border Width="38" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" CornerRadius="2" />
                            </Border>
                        </ControlTemplate>
                    </primitives:Thumb.Template>
                </primitives:Thumb>

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AiAssistSectionLabel}" Text="ASK AI" />
                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Advisor.SelectedModelLabel}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="Private context" />
                </Grid>

                <Border Margin="0,7,0,0" Padding="10,7" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuestionTextBox"
                                 Height="{Binding ComposerHeight, Mode=TwoWay}"
                                 MinHeight="32"
                                 MaxHeight="120"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 PreviewKeyDown="QuestionTextBox_PreviewKeyDown"
                                 Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Only this visible question is shown here. Live project context is sent privately." />
                        <Button Grid.Column="1" MinWidth="58" Margin="9,0,0,0" Padding="10,5" VerticalAlignment="Bottom" Command="{Binding AskToggleCommand}" Content="{Binding AskToggleLabel}" Style="{StaticResource ButtonPrimary}" ToolTip="{Binding AskToggleToolTip}" />
                    </Grid>
                </Border>

                <WrapPanel Margin="0,7,0,0">
                    <Button Margin="0,0,6,4" Style="{StaticResource AiAssistMicroButton}" Command="{Binding SetQuestionCommand}" CommandParameter="What should I do next from this screen?" Content="Next" />
                    <Button Margin="0,0,6,4" Style="{StaticResource AiAssistMicroButton}" Command="{Binding SetQuestionCommand}" CommandParameter="Explain this screen and its important buttons." Content="Explain" />
                    <Button Margin="0,0,6,4" Style="{StaticResource AiAssistMicroButton}" Command="{Binding SetQuestionCommand}" CommandParameter="Troubleshoot the current workflow state and tell me what to check." Content="Troubleshoot" />
                    <TextBlock Margin="2,3,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="Enter sends · Shift+Enter new line" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Padding="12,7" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Advisor.StatusText}" TextTrimming="CharacterEllipsis" />
                <WrapPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right">
                    <Button Margin="0,0,6,0" Style="{StaticResource AiAssistMicroButton}" Command="{Binding AnalyzeHereCommand}" Content="↻" ToolTip="Refresh readiness and deterministic analysis." />
                    <Button Margin="0,0,6,0" Style="{StaticResource AiAssistMicroButton}" Command="{Binding OpenFullCopilotCommand}" Content="Full" ToolTip="Open the full AI Copilot window." />
                    <Button Margin="0,0,6,0" Style="{StaticResource AiAssistMicroButton}" Command="{Binding CopyContextCommand}" Content="Ctx" ToolTip="Copy the AI context payload." />
                    <Button Margin="0,0,0,0" Style="{StaticResource AiAssistMicroButton}" Command="{Binding CopyAnswerCommand}" Content="Copy" ToolTip="Copy the latest AI answer." />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
