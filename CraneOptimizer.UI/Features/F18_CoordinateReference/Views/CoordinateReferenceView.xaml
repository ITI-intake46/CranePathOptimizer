<UserControl x:Class="CraneOptimizer.UI.Features.F18_CoordinateReference.Views.CoordinateReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="1200"
             Background="{DynamicResource SurfaceBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Margin="6,0" Orientation="Horizontal" VerticalAlignment="Center" Height="110">

                <!-- 1. SYSTEM -->
                <Border Padding="8,6,8,0" Width="180">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="SYSTEM" />
                        <StackPanel VerticalAlignment="Center" Margin="0,2,0,0">
                            <CheckBox IsChecked="{Binding IsEnabled}" Content="Enable Site Reference" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Height="22">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                    <Condition Binding="{Binding IsSuccess}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#152C1F"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                    <Condition Binding="{Binding IsSuccess}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#3D181A"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Text" Value="Disabled / Local Only"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                        <Condition Binding="{Binding IsSuccess}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="Applied Successfully"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                        <Condition Binding="{Binding IsSuccess}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="Invalid Input Parameters"/>
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

                <!-- 2. SITE ORIGIN -->
                <Border Padding="8,6,8,0" Width="260">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="SITE ORIGIN" />
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Easting (m)" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SurveyEasting, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" Height="22" Background="#1E1E1E" Foreground="White" BorderBrush="{DynamicResource BorderBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Northing (m)" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SurveyNorthing, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" Height="22" Background="#1E1E1E" Foreground="White" BorderBrush="{DynamicResource BorderBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Elevation (m)" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SurveyElevation, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" Height="22" Background="#1E1E1E" Foreground="White" BorderBrush="{DynamicResource BorderBrush}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Survey coordinates of model origin" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

                <!-- 3. ROTATION -->
                <Border Padding="8,6,8,0" Width="255">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="ROTATION" />
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,3">
                                <TextBlock Text="Rotation to North (°)" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding RotationToNorthDegrees, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" Height="22" Background="#1E1E1E" Foreground="White" BorderBrush="{DynamicResource BorderBrush}"
                                         ToolTip="Angle in degrees from local Y to site North."/>
                            </StackPanel>
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Use 0° if axes match site grid" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="Wrap" Width="135"/>

                            <!-- Site North Compass Indicator -->
                            <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Site North" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <Grid Width="42" Height="42">
                                    <Ellipse Stroke="#444444" StrokeThickness="1.5" Fill="#151515"/>
                                    <Ellipse Stroke="#222222" StrokeThickness="1" Margin="3"/>
                                    <TextBlock Text="N" FontSize="7" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Text="S" FontSize="6" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                    <TextBlock Text="W" FontSize="6" Foreground="#555555" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    <TextBlock Text="E" FontSize="6" Foreground="#555555" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    
                                    <Grid Width="20" Height="26" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="{Binding RotationToNorthDegrees}"/>
                                        </Grid.RenderTransform>
                                        <Polygon Points="10,0 20,13 10,10" Fill="#E74C3C"/>
                                        <Polygon Points="10,0 0,13 10,10" Fill="#C0392B"/>
                                        <Polygon Points="10,26 20,13 10,10" Fill="#ECF0F1"/>
                                        <Polygon Points="10,26 0,13 10,10" Fill="#BDC3C7"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

                <!-- 4. REFERENCE CHECK -->
                <Border Padding="8,6,8,0" Width="360">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="REFERENCE CHECK" />
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Enabled state summary -->
                            <Grid Grid.Row="0" Margin="0,0,0,2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Model Origin (0,0,0) ➜ Site:" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="E:" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding AppliedSurveyEasting, StringFormat={}{0:F3}}" FontSize="9.5" FontWeight="SemiBold" Foreground="White" Margin="2,0,8,0"/>
                                        <TextBlock Text="N:" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding AppliedSurveyNorthing, StringFormat={}{0:F3}}" FontSize="9.5" FontWeight="SemiBold" Foreground="White" Margin="2,0,8,0"/>
                                        <TextBlock Text="H:" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding AppliedSurveyElevation, StringFormat={}{0:F3}}" FontSize="9.5" FontWeight="SemiBold" Foreground="White" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Disabled state summary -->
                            <TextBlock Grid.Row="0" Text="Site reference disabled — using model coordinates only." FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,2,0,6" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            
                            <!-- Test Point row -->
                            <Grid Grid.Row="1" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Test Model Point (X, Y, Z)" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,1"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding PreviewLocalX, UpdateSourceTrigger=PropertyChanged}" FontSize="9" Padding="1" Height="18" Background="#252525" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" ToolTip="Model X"/>
                                        <TextBox Grid.Column="2" Text="{Binding PreviewLocalY, UpdateSourceTrigger=PropertyChanged}" FontSize="9" Padding="1" Height="18" Background="#252525" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" ToolTip="Model Y"/>
                                        <TextBox Grid.Column="4" Text="{Binding PreviewLocalZ, UpdateSourceTrigger=PropertyChanged}" FontSize="9" Padding="1" Height="18" Background="#252525" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" ToolTip="Model Z"/>
                                    </Grid>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" Margin="0,0,0,0">
                                    <TextBlock Text="Result Site Coordinate" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,1"/>
                                    <Border Background="#152C1F" CornerRadius="3" Padding="4,2" BorderThickness="1" BorderBrush="{StaticResource SuccessBrush}" Height="18" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PreviewSurveyResult}" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Helper text -->
                            <TextBlock Grid.Row="2" Text="Preview only. Does not move the model." FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

                <!-- 5. ACTIONS -->
                <Border Padding="8,6,8,0" Width="150">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="ACTIONS" />
                        <StackPanel VerticalAlignment="Center">
                            <Button Command="{Binding ApplyCommand}" Height="22" Margin="0,0,0,4" Style="{StaticResource RibbonSmallBtn}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="✔ Apply" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ResetCommand}" Height="22" Style="{StaticResource RibbonSmallBtn}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="✕ Reset" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
