<Window x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#111827"
        ShowInTaskbar="False">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Crane Optimizer"
                       Foreground="#F9FAFB"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Status}"
                       Foreground="#CBD5E1"
                       Margin="0,16,0,0"
                       FontSize="13"
                       HorizontalAlignment="Center" />
            <ProgressBar Width="220"
                         Height="4"
                         Margin="0,22,0,0"
                         IsIndeterminate="True"
                         Foreground="#38BDF8" />
        </StackPanel>
    </Grid>
</Window>
