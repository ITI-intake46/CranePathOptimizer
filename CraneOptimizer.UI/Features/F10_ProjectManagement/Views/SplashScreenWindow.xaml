<Window x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource FontPrimary}"
        ShowInTaskbar="False">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Crane Optimizer"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="{StaticResource FontSizeXL}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Status}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,16,0,0"
                       FontSize="{StaticResource FontSizeBase}"
                       HorizontalAlignment="Center" />
            <ProgressBar Width="220"
                         Height="4"
                         Margin="0,22,0,0"
                         IsIndeterminate="True"
                         Foreground="{StaticResource PrimaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
