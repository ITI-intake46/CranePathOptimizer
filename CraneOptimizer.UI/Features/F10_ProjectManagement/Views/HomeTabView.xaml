<UserControl
    x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.HomeTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0" Orientation="Horizontal">

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="PROJECT">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding NewProjectCommand}"
                        Content="New"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="🆕" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding OpenProjectCommand}"
                        Content="Open"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorMiddleCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="📂" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding SaveProjectCommand}"
                        Content="Save"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="💾" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="SETTINGS">
                <StackPanel Orientation="Horizontal">
                    <Button ContentTemplate="{x:Null}" FontSize="{StaticResource FontSizeXS}" Style="{StaticResource RibbonMajorLeadingCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="⚙️" />
                        </Button.Tag>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Text="Project" />
                            <TextBlock HorizontalAlignment="Center" Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button
                        Content="Units"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="📐" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="QUICK ACCESS">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding IfcViewer.LoadIfcCommand}"
                        Content="Load IFC Model"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}"
                        ToolTip="Load IFC Model">
                        <Button.Tag>
                            <TextBlock Text="📦" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Content="Add Crane"
                        Style="{StaticResource RibbonMajorMiddleCommandTile}">
                        <Button.Tag>
                            <TextBlock Text="🏗" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding StartDrawingCommand}"
                        Content="Draw Zones"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}">
                        <Button.Tag>
                            <TextBlock Text="🗺" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
