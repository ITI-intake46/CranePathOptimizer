<UserControl
    x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.HomeTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0" Orientation="Horizontal">

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="PROJECT">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding NewProjectCommand}"
                        Content="New"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="🆕" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding OpenProjectCommand}"
                        Content="Open"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorMiddleCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="📂" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding SaveProjectCommand}"
                        Content="Save"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="💾" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="SETTINGS">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Click="ProjectSettings_Click"
                        ContentTemplate="{x:Null}"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="⚙️" />
                        </Button.Tag>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Text="Project" />
                            <TextBlock HorizontalAlignment="Center" Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="VIEW">
                <Button
                    Command="{Binding ElementManagement.ShowFilterDialogCommand}"
                    Content="Filter"
                    FontSize="{StaticResource FontSizeXS}"
                    IsEnabled="{Binding IfcViewer.HasIfcModel}"
                    Style="{StaticResource RibbonMajorCommandTile}"
                    ToolTip="Filter">
                    <Button.Tag>
                        <Viewbox
                            Width="26"
                            Height="26">
                            <Canvas Width="24" Height="24">
                                <Polygon Fill="{StaticResource PrimaryBrush}" Points="2,3 22,3 14,13 14,21 10,21 10,13" />
                                <Ellipse
                                    Canvas.Left="15"
                                    Canvas.Top="1"
                                    Width="8"
                                    Height="8"
                                    Fill="{StaticResource DestructiveBrush}"
                                    Visibility="Collapsed" />
                            </Canvas>
                        </Viewbox>
                    </Button.Tag>
                </Button>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="QUICK ACCESS">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding IfcViewer.LoadIfcCommand}"
                        Content="Load IFC Model"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}"
                        ToolTip="Load IFC Model">
                        <Button.Tag>
                            <TextBlock Text="📦" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Content="Add Crane"
                        Style="{StaticResource RibbonMajorMiddleCommandTile}">
                        <Button.Tag>
                            <TextBlock Text="🏗" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding StartDrawingCommand}"
                        Content="Draw Zones"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}">
                        <Button.Tag>
                            <TextBlock Text="🗺" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
