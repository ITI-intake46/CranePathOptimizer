<Window x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.CreateProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Project"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource FontPrimary}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title  -->
        <TextBlock Text="Create Project"
                   FontSize="{StaticResource FontSizeLG}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <!--  Project Name  -->
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Project Name"
                       Style="{StaticResource PropertyLabel}" />
            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,6,0,0"
                     Height="34"
                     Padding="8,4" />
        </StackPanel>

        <!--  Separator  -->
        <Rectangle Grid.Row="2"
                   Height="1"
                   Margin="0,18,0,0"
                   Fill="{DynamicResource BorderBrush}" />

        <!--  Default Units  -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="DEFAULT UNITS"
                       Style="{StaticResource PanelSectionHeader}" />

            <!--  Length  -->
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource PropertyLabel}" Width="120" Text="Length:" />
                <ComboBox Width="200"
                          SelectedIndex="{Binding SelectedLengthIndex, Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          Style="{StaticResource DarkComboBox}">
                    <ComboBoxItem Content="Millimetres (mm)" />
                    <ComboBoxItem Content="Metres (m)" />
                </ComboBox>
            </StackPanel>

            <!--  Area  -->
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource PropertyLabel}" Width="120" Text="Area:" />
                <ComboBox Width="200"
                          SelectedIndex="{Binding SelectedAreaIndex, Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          Style="{StaticResource DarkComboBox}">
                    <ComboBoxItem Content="m²" />
                    <ComboBoxItem Content="ft²" />
                </ComboBox>
            </StackPanel>

            <!--  Weight  -->
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource PropertyLabel}" Width="120" Text="Weight:" />
                <ComboBox Width="200"
                          SelectedIndex="{Binding SelectedMassIndex, Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          Style="{StaticResource DarkComboBox}">
                    <ComboBoxItem Content="Kilograms (kg)" />
                    <ComboBoxItem Content="Tons (t)" />
                </ComboBox>
            </StackPanel>

            <!--  Precision  -->
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource PropertyLabel}" Width="120" Text="Decimals:" />
                <ComboBox Width="100"
                          SelectedIndex="{Binding SelectedPrecisionIndex, Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          Style="{StaticResource DarkComboBox}">
                    <ComboBoxItem Content="0" />
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!--  Buttons  -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90"
                    Height="34"
                    Margin="0,0,8,0"
                    Style="{StaticResource ButtonSecondary}"
                    Command="{Binding CancelCommand}" />
            <Button Content="Create"
                    Width="110"
                    Height="34"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding CreateCommand}" />
        </StackPanel>
    </Grid>
</Window>
