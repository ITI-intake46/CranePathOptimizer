<Window x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.CreateProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Project"
        Width="520"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource FontPrimary}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Create Project"
                   FontSize="{StaticResource FontSizeLG}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Project Name"
                       Style="{StaticResource PropertyLabel}" />
            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,6,0,0"
                     Height="34"
                     Padding="8,4" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90"
                    Height="34"
                    Margin="0,0,8,0"
                    Style="{StaticResource ButtonSecondary}"
                    Command="{Binding CancelCommand}" />
            <Button Content="Create"
                    Width="110"
                    Height="34"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding CreateCommand}" />
        </StackPanel>
    </Grid>
</Window>
