<Window x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.CreateProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Project"
        Width="520"
        Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Create Project"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#111827" />

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Project Name" Foreground="#374151" />
            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,6,0,16"
                     Height="34"
                     Padding="8,4" />

            <TextBlock Text="IFC File" Foreground="#374151" />
            <DockPanel Margin="0,6,0,0">
                <Button Content="Browse"
                        DockPanel.Dock="Right"
                        Width="90"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseIfcCommand}" />
                <TextBox Text="{Binding IfcFilePath, UpdateSourceTrigger=PropertyChanged}"
                         Height="34"
                         Padding="8,4" />
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90"
                    Height="34"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}" />
            <Button Content="Create"
                    Width="110"
                    Height="34"
                    Background="#2563EB"
                    Foreground="White"
                    Command="{Binding CreateCommand}" />
        </StackPanel>
    </Grid>
</Window>
