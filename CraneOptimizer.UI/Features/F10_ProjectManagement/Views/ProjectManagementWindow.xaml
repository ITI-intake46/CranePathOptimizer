<Window x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.ProjectManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projects"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Window.Resources>
        <Style x:Key="ProjectCardStyle" TargetType="Border">
            <Setter Property="Width" Value="300" />
            <Setter Property="MinHeight" Value="176" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Content="Create New Project"
                    Width="170"
                    Height="38"
                    Background="#2563EB"
                    Foreground="White"
                    Command="{Binding CreateProjectCommand}" />
            <StackPanel>
                <TextBlock Text="Projects"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#111827" />
                <TextBlock Text="Choose a project to enter the workspace"
                           Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="#6B7280" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,26,0,20">
            <CheckBox DockPanel.Dock="Right"
                      Content="Favorites"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0"
                      IsChecked="{Binding FavoritesOnly, Mode=TwoWay}" />
            <TextBox Height="38"
                     Padding="12,6"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProjectCardStyle}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           TextTrimming="CharacterEllipsis" />

                                <CheckBox Grid.Column="1"
                                          Content="Star"
                                          IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                          Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}" />

                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding IfcFileName}"
                                           Margin="0,12,0,0"
                                           Foreground="#4B5563"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0">
                                    <TextBlock Text="{Binding LastOpenedDate, StringFormat=Last opened: {0:g}}"
                                               Foreground="#6B7280"
                                               FontSize="12" />
                                    <TextBlock Text="IFC path missing"
                                               Foreground="#B45309"
                                               FontSize="12"
                                               Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIfcMissing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Row="3"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Folder"
                                            Width="70"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Delete"
                                            Width="70"
                                            Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <ProgressBar DockPanel.Dock="Right"
                         Width="160"
                         Height="4"
                         IsIndeterminate="{Binding IsBusy}" />
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#6B7280"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
