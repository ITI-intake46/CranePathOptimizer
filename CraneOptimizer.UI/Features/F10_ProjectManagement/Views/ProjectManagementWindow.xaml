<Window x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.ProjectManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CraneOptimizer.UI.F10_ProjectManagement.Views"
        Title="Crane Optimization — Startup"
        Height="700" Width="1200"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource FontPrimary}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ── Sidebar nav button ──────────────────────────────────────── -->
        <Style x:Key="SideNavBtn" TargetType="Button">
            <Setter Property="Background"                  Value="Transparent"/>
            <Setter Property="Foreground"                  Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness"             Value="0"/>
            <Setter Property="Padding"                     Value="16,11"/>
            <Setter Property="HorizontalContentAlignment"  Value="Left"/>
            <Setter Property="FontSize"                    Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontFamily"                  Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontWeight"                  Value="SemiBold"/>
            <Setter Property="Cursor"                      Value="Hand"/>
            <Setter Property="FocusVisualStyle"            Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="Foreground"                  Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Active sidebar nav button ─────────────────────────────── -->
        <Style x:Key="SideNavBtnActive" TargetType="Button" BasedOn="{StaticResource SideNavBtn}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Top tab button ─────────────────────────────────────────── -->
        <Style x:Key="TopTabBtn" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"      Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontFamily"    Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Padding"       Value="16,0"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Active top tab button ──────────────────────────────────── -->
        <Style x:Key="TopTabBtnActive" TargetType="Button" BasedOn="{StaticResource TopTabBtn}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,3"
                                BorderBrush="{StaticResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer grid — compensates for the 8px bleed when maximized -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger
                        Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Value="Maximized">
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>   <!-- Working area -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             ROW 0 — FULL-WIDTH TITLE BAR
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App icon + title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="18" Height="18" CornerRadius="3"
                            Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0">
                        <TextBlock Text="⚙" FontSize="10" Foreground="#1A1A1A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CRANE OPTIMIZATION"
                               FontSize="{StaticResource FontSizeSM}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Chrome buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🗕" Width="45" Height="35"
                            Style="{StaticResource TitleBarButton}"
                            Click="MinimizeWindow_Click"/>
                    <Button x:Name="MaximizeButton"
                            Content="☐" Width="45" Height="35"
                            Style="{StaticResource TitleBarButton}"
                            Click="MaximizeWindow_Click"/>
                    <Button Content="✕" Width="45" Height="35"
                            Style="{StaticResource CloseButton}"
                            Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             ROW 1 — TWO-COLUMN WORKING AREA
        ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════════════════════════════
                 LEFT SIDEBAR
            ════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Logo -->
                        <RowDefinition Height="Auto"/>  <!-- User card -->
                        <RowDefinition Height="*"/>     <!-- Nav items -->
                        <RowDefinition Height="Auto"/>  <!-- Bottom -->
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <Border Grid.Row="0" Padding="16,18,16,14"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="4"
                                    Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                                <TextBlock Text="⚙" FontSize="14" Foreground="#1A1A1A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CRANE OPTIMIZER"
                                           FontSize="{StaticResource FontSizeSM}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="v1.0"
                                           FontSize="{StaticResource FontSizeXS}"
                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- User card -->
                    <Border Grid.Row="1" Padding="12,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="4"
                                    Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                                <TextBlock Text="👤" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="USER"
                                           FontSize="{StaticResource FontSizeSM}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="SYSTEM ADMIN"
                                           FontSize="{StaticResource FontSizeXS}"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nav items -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">

                        <Button x:Name="BtnNavHome" Style="{StaticResource SideNavBtnActive}"
                                Click="NavHome_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="HOME" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavCreate" Style="{StaticResource SideNavBtn}"
                                Click="NavCreate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CREATE PROJECT" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavProjectList" Style="{StaticResource SideNavBtn}"
                                Click="NavProjectList_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PROJECT LIST" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavOpen" Style="{StaticResource SideNavBtn}"
                                Click="NavOpen_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="OPEN FOLDER" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Divider before settings group -->
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="16,10,16,6"/>

                        <Button x:Name="BtnNavAppSettings" Style="{StaticResource SideNavBtn}"
                                Click="NavAppSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="APP SETTINGS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Bottom items: HELP, ABOUT, copyright -->
                    <StackPanel Grid.Row="3">
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="12,0"/>

                        <Button x:Name="BtnNavHelp" Style="{StaticResource SideNavBtn}"
                                Padding="16,9"
                                FontSize="{StaticResource FontSizeXS}"
                                Click="NavHelp_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❓" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="HELP" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavAbout" Style="{StaticResource SideNavBtn}"
                                Padding="16,9"
                                FontSize="{StaticResource FontSizeXS}"
                                Click="NavAbout_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ABOUT" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Padding="16,10">
                            <TextBlock Text="© 2026 Crane Optimization"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 RIGHT CONTENT AREA
            ════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>  <!-- Top tab bar -->
                    <RowDefinition Height="*"/>   <!-- Content -->
                </Grid.RowDefinitions>

                <!-- Top tab bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="10,0,0,0">
                        <Button x:Name="TabOverview"
                                Content="PROJECT OVERVIEW"
                                Style="{StaticResource TopTabBtnActive}"
                                Height="44"
                                Click="TabOverview_Click"/>
                        <Button x:Name="TabGuide"
                                Content="APPLICATION GUIDE"
                                Style="{StaticResource TopTabBtn}"
                                Height="44"
                                Click="TabGuide_Click"/>
                    </StackPanel>
                </Border>

                <!-- Content swap zone -->
                <Grid Grid.Row="1">

                    <!-- ════ HOME / PROJECT OVERVIEW ════ -->
                    <Grid x:Name="ContentHome" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── Return-to-project banner (shown only when a project is open in background) ── -->
                        <Border Grid.Row="0" Grid.ColumnSpan="2"
                                Background="#1A7C4DFF"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="20,10"
                                Visibility="{Binding HasActiveSession, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡" FontSize="18"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="{StaticResource FontSizeXS}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="PROJECT OPEN IN BACKGROUND"/>
                                    <TextBlock FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="Currently working on:"/>
                                        <Run Text="{Binding ActiveProjectName, Mode=OneWay}" FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="↩  RETURN TO PROJECT"
                                        Command="{Binding ReturnToProjectCommand}"
                                        Style="{StaticResource ButtonPrimary}"
                                        Padding="16,8"
                                        FontSize="{StaticResource FontSizeXS}"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Hero panel -->
                        <Grid Grid.Row="1" Grid.Column="0" Background="{DynamicResource BackgroundBrush}" ClipToBounds="True">
                            <Border VerticalAlignment="Bottom" Height="220">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#CC000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,30">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="3" Height="16"
                                            Background="{StaticResource PrimaryBrush}"
                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="CRANE OPTIMIZATION PLATFORM"
                                               FontSize="{StaticResource FontSizeXS}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="SMART LIFT OPTIMIZER"
                                           FontSize="{StaticResource FontSize3XL}"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,16"/>
                                <TextBlock Text="Create or open a project to begin crane path optimization and payload analysis."
                                           FontSize="{StaticResource FontSizeSM}"
                                           Foreground="#AAFFFFFF"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- Right panel: quick actions -->
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="20,22,20,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="4" Height="14"
                                                Background="{StaticResource PrimaryBrush}"
                                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="QUICK START"
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Create a new workspace or load an existing project folder."
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextDisabledBrush}"
                                               TextWrapping="Wrap"
                                               Margin="14,0,0,0"/>
                                </StackPanel>

                                <!-- Project cards list -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0">
                                    <StackPanel>
                                        <!-- Loading indicator -->
                                        <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Background="Transparent" Margin="8,4"/>

                                        <!-- Project card items -->
                                        <ItemsControl ItemsSource="{Binding Projects}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="14,12"
                                                            CornerRadius="6" Cursor="Hand"
                                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1">
                                                        <Border.InputBindings>
                                                            <MouseBinding
                                                                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                MouseAction="LeftDoubleClick"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="{StaticResource FontSizeSM}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding LastOpenedDate, StringFormat='Last opened: {0:MM/dd/yyyy}'}"
                                                                           FontSize="{StaticResource FontSizeXS}"
                                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Content="Open"
                                                                    Width="56" Height="26"
                                                                    Style="{StaticResource ButtonSecondary}"
                                                                    Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Empty state -->
                                        <Border Padding="16,24"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="⊞" FontSize="32"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           Margin="0,0,0,12"/>
                                                <TextBlock Text="NO RECENT PROJECTS"
                                                           FontSize="{StaticResource FontSizeSM}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,8"/>
                                                <TextBlock Text="Create a new project to get started."
                                                           FontSize="{StaticResource FontSizeXS}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Margin="0,0,0,20"/>
                                                <Button Content="CREATE PROJECT"
                                                        Style="{StaticResource ButtonPrimary}"
                                                        Height="38" Width="180"
                                                        HorizontalAlignment="Center"
                                                        Click="NavCreate_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Footer -->
                                <Border Grid.Row="2"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusText}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                                     Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="READY"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ════ CREATE PROJECT ════ -->
                    <Grid x:Name="ContentCreate" Visibility="Collapsed">
                        <views:CreateProjectPanel x:Name="CreatePanelControl"/>
                    </Grid>

                    <!-- ════ PROJECT LIST ════ -->
                    <Grid x:Name="ContentProjectList" Visibility="Collapsed" Background="{DynamicResource BackgroundBrush}">
                        <Grid Margin="{StaticResource Space8}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Search + actions bar -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="{StaticResource Space4}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox MinWidth="240" VerticalContentAlignment="Center"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                              Content="Favorites" Foreground="{DynamicResource TextSecondaryBrush}"
                                              IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"/>
                                    <Button Grid.Column="2" Width="96" Height="34" Margin="16,0,0,0"
                                            Command="{Binding OpenProjectFolderCommand}"
                                            Content="Open Folder" Style="{StaticResource ButtonSecondary}"/>
                                    <Button Grid.Column="3" Width="160" Height="34" Margin="16,0,0,0"
                                            Command="{Binding CreateProjectCommand}"
                                            Content="Create Project" Style="{StaticResource ButtonPrimary}"/>
                                </Grid>
                            </Border>

                            <!-- Cards grid -->
                            <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="300" MinHeight="160" Margin="0,0,16,16" Padding="16"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="{StaticResource CardCornerRadius}" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding
                                                        Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        MouseAction="LeftDoubleClick"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="{StaticResource FontSizeSM}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Name}"/>

                                                    <CheckBox Grid.Column="1" Margin="12,0,0,0"
                                                              Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"
                                                              IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                              Content="★" Cursor="Hand"/>

                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="{StaticResource FontSizeXS}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding IfcFileName}"/>

                                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="{StaticResource FontSizeXS}"
                                                                   Text="{Binding LastOpenedDate, StringFormat='Last opened: {0:g}'}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2"
                                                                Margin="0,14,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal">
                                                        <Button Width="60" Content="Open" Style="{StaticResource ButtonSecondary}"
                                                                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Margin="8,0,0,0" Content="×"
                                                                Foreground="{StaticResource DestructiveBrush}"
                                                                Width="32" Height="32"
                                                                Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Delete project"
                                                                Style="{StaticResource ButtonSecondary}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Status bar -->
                            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                                <ProgressBar Width="140" Height="4" DockPanel.Dock="Right"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             IsIndeterminate="{Binding IsBusy}"/>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding StatusText}"/>
                            </DockPanel>
                        </Grid>
                    </Grid>

                    <!-- ════ APPLICATION GUIDE ════ -->
                    <Grid x:Name="ContentGuide" Visibility="Collapsed" Background="{DynamicResource BackgroundBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,30">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="APPLICATION GUIDE"
                                           FontSize="{StaticResource FontSizeXL}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Learn how to use the Crane Optimizer application"
                                           FontSize="{StaticResource FontSizeMD}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,28"/>

                                <!-- Step 1 -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                        Padding="20,16" Margin="0,0,0,12"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="24" Height="24" CornerRadius="12"
                                                    Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#1A1A1A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="CREATE OR OPEN A PROJECT"
                                                       FontSize="{StaticResource FontSizeMD}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="36,0,0,0"
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Use 'Create Project' to start a new workspace, or 'Open Folder' to load an existing project. Each project is stored in its own folder with a dedicated database."/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 2 -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                        Padding="20,16" Margin="0,0,0,12"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="24" Height="24" CornerRadius="12"
                                                    Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#1A1A1A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="LOAD AN IFC MODEL"
                                                       FontSize="{StaticResource FontSizeMD}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="36,0,0,0"
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="In the main window, go to the IFC MODEL tab and click 'Load IFC'. The 3D viewer will render your building and automatically calculate element weights from the model data."/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 3 -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                        Padding="20,16" Margin="0,0,0,12"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="24" Height="24" CornerRadius="12"
                                                    Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#1A1A1A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="PLACE CRANES ON SITE"
                                                       FontSize="{StaticResource FontSizeMD}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="36,0,0,0"
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Switch to the CRANES tab and add Tower or Mobile cranes. Position them in the 3D view. Import load charts from the catalog to verify lifting capacity at each point."/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 4 -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                        Padding="20,16" Margin="0,0,0,12"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="24" Height="24" CornerRadius="12"
                                                    Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="4" FontSize="11" FontWeight="Bold" Foreground="#1A1A1A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="RUN OPTIMIZATION"
                                                       FontSize="{StaticResource FontSizeMD}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="36,0,0,0"
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Use the GA OPTIMIZER tab to run a genetic algorithm that automatically finds optimal crane positions to maximize site coverage and minimize clashes."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ════ APP SETTINGS ════ -->
                    <Grid x:Name="ContentSettings" Visibility="Collapsed" Background="{DynamicResource BackgroundBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,30">
                            <StackPanel MaxWidth="620" HorizontalAlignment="Left">

                                <!-- Header -->
                                <StackPanel Margin="0,0,0,28">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="4" Height="18" Background="{StaticResource PrimaryBrush}"
                                                Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="APPLICATION SETTINGS"
                                                   FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Configure appearance and workspace preferences."
                                               FontSize="{StaticResource FontSizeSM}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0"/>
                                </StackPanel>

                                <!-- ── APPEARANCE ── -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}" Padding="24,20"
                                        Margin="0,0,0,16">
                                    <StackPanel>

                                        <!-- Section label -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                            <Border Width="3" Height="14" Background="{StaticResource PrimaryBrush}"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="APPEARANCE"
                                                       FontSize="{StaticResource FontSizeSM}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Theme toggle row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="COLOR THEME"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Choose between Dark and Light interface."
                                                           FontSize="{StaticResource FontSizeXS}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- Dark / Light pill buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnThemeDark"
                                                        Content="🌙  DARK"
                                                        Width="90" Height="34"
                                                        Style="{StaticResource ButtonPrimary}"
                                                        Margin="0,0,8,0"
                                                        Click="BtnThemeDark_Click"/>
                                                <Button x:Name="BtnThemeLight"
                                                        Content="☀  LIGHT"
                                                        Width="90" Height="34"
                                                        Style="{StaticResource ButtonSecondary}"
                                                        Click="BtnThemeLight_Click"/>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <!-- ── INFORMATION card ── -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}" Padding="24,20">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Border Width="3" Height="14" Background="{StaticResource PrimaryBrush}"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SESSION INFORMATION"
                                                       FontSize="{StaticResource FontSizeSM}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Application Version"
                                                       FontSize="{StaticResource FontSizeXS}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtAppVersion"
                                                       FontSize="{StaticResource FontSizeXS}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Active Theme"
                                                       FontSize="{StaticResource FontSizeXS}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtCurrentTheme"
                                                       FontSize="{StaticResource FontSizeXS}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ════ HELP / ABOUT ════ -->
                    <Grid x:Name="ContentHelp" Visibility="Collapsed" Background="{DynamicResource BackgroundBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,30">
                            <StackPanel MaxWidth="700" HorizontalAlignment="Left">

                                <!-- Header -->
                                <StackPanel Margin="0,0,0,28">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="4" Height="18" Background="{StaticResource PrimaryBrush}"
                                                Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtHelpTitle" Text="HELP"
                                                   FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtHelpSubtitle" Text="Frequently asked questions and support resources."
                                               FontSize="{StaticResource FontSizeSM}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0"/>
                                </StackPanel>

                                <!-- FAQ card -->
                                <Border x:Name="CardHelp"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}" Padding="24,20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="3" Height="14" Background="{StaticResource PrimaryBrush}"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="FREQUENTLY ASKED QUESTIONS"
                                                       FontSize="{StaticResource FontSizeSM}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- FAQ item -->
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,0,0,14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="How do I create a new project?"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="{StaticResource FontSizeXS}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="Click 'CREATE PROJECT' in the sidebar. Fill in the project name and folder location, optionally add country, site location, and a project image. Click CREATE PROJECT to confirm."/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,0,0,14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="How do I load an existing project?"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="{StaticResource FontSizeXS}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="Double-click any project card on the Home screen, or use 'OPEN FOLDER' in the sidebar to browse to a project.db folder."/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel>
                                            <TextBlock Text="How do I switch between Dark and Light theme?"
                                                       FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <TextBlock TextWrapping="Wrap"
                                                       FontSize="{StaticResource FontSizeXS}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="Go to APP SETTINGS in the sidebar and click the DARK or LIGHT button under 'COLOR THEME'."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- About card (shown when ABOUT nav is clicked) -->
                                <Border x:Name="CardAbout" Visibility="Collapsed"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}" Padding="24,20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                            <Border Width="3" Height="14" Background="{StaticResource PrimaryBrush}"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ABOUT CRANE OPTIMIZER"
                                                       FontSize="{StaticResource FontSizeSM}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- Logo block -->
                                        <Border Width="64" Height="64" CornerRadius="12"
                                                Background="{StaticResource PrimaryBrush}"
                                                HorizontalAlignment="Left" Margin="0,0,0,20">
                                            <TextBlock Text="⚙" FontSize="30" Foreground="#1A1A1A"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="CRANE PATH OPTIMIZER"
                                                   FontSize="{StaticResource FontSizeLG}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtAboutVersion"
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                                        <TextBlock TextWrapping="Wrap" MaxWidth="520"
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="An advanced crane path planning and optimization tool for construction sites. Powered by Genetic Algorithm optimization and IFC model support."
                                                   Margin="0,0,0,24"/>

                                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                                        <TextBlock Text="© 2026 Crane Optimization — All rights reserved."
                                                   FontSize="{StaticResource FontSizeXS}"
                                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
