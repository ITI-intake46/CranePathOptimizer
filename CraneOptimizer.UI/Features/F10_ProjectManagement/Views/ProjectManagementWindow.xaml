<Window x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.ProjectManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:views="clr-namespace:CraneOptimizer.UI.F10_ProjectManagement.Views"
        Title="Crane Optimization — Startup"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
        Height="700" Width="1200"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource FontPrimary}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ── Startup-window font scale (shadows global tokens for this window only) ── -->
        <sys:Double x:Key="FontSizeXS">12</sys:Double>
        <sys:Double x:Key="FontSizeSM">13</sys:Double>
        <sys:Double x:Key="FontSizeMD">14</sys:Double>
        <sys:Double x:Key="FontSizeBase">14</sys:Double>
        <sys:Double x:Key="FontSizeLG">16</sys:Double>
        <sys:Double x:Key="FontSizeXL">18</sys:Double>
        <sys:Double x:Key="FontSize2XL">22</sys:Double>

        <!-- ── Startup sidebar nav button (larger than global SideNavBtn) ── -->
        <Style x:Key="SideNavBtn" TargetType="Button">
            <Setter Property="Background"                  Value="Transparent"/>
            <Setter Property="Foreground"                  Value="#FFFFFF"/>
            <Setter Property="BorderThickness"             Value="0"/>
            <Setter Property="Padding"                     Value="20,16"/>
            <Setter Property="HorizontalContentAlignment"  Value="Left"/>
            <Setter Property="FontSize"                    Value="{StaticResource FontSizeNavStartup}"/>
            <Setter Property="FontFamily"                  Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontWeight"                  Value="SemiBold"/>
            <Setter Property="Cursor"                      Value="Hand"/>
            <Setter Property="FocusVisualStyle"            Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="Foreground"                  Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Active startup sidebar nav button ─────────────────────── -->
        <Style x:Key="SideNavBtnActive" TargetType="Button" BasedOn="{StaticResource SideNavBtn}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Top tab button ─────────────────────────────────────────── -->
        <Style x:Key="TopTabBtn" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"      Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontFamily"    Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Padding"       Value="16,0"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Active top tab button ──────────────────────────────────── -->
        <Style x:Key="TopTabBtnActive" TargetType="Button" BasedOn="{StaticResource TopTabBtn}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,3"
                                BorderBrush="{StaticResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer grid — compensates for the 8px bleed when maximized -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger
                        Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Value="Maximized">
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>   <!-- Working area -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             ROW 0 — FULL-WIDTH TITLE BAR
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
                           Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Crane Optimization"
                               FontSize="{StaticResource FontSizeSM}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Chrome buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🗕" Width="45" Height="35"
                            Style="{StaticResource TitleBarButton}"
                            Click="MinimizeWindow_Click"/>
                    <Button x:Name="MaximizeButton"
                            Content="☐" Width="45" Height="35"
                            Style="{StaticResource TitleBarButton}"
                            Click="MaximizeWindow_Click"/>
                    <Button Content="✕" Width="45" Height="35"
                            Style="{StaticResource CloseButton}"
                            Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             ROW 1 — TWO-COLUMN WORKING AREA
        ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════════════════════════════
                 LEFT SIDEBAR
            ════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- User card -->
                        <RowDefinition Height="*"/>     <!-- Nav items -->
                        <RowDefinition Height="Auto"/>  <!-- Bottom -->
                    </Grid.RowDefinitions>

                    <!-- User card -->
                    <Border Grid.Row="0" Padding="12,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="4"
                                    Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                                <TextBlock Text="👤" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSidebarUser"
                                           FontSize="{StaticResource FontSizeMD}"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtSidebarRole"
                                           FontSize="{StaticResource FontSizeSM}"
                                           Foreground="#FFFFFF"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nav items -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">

                        <Button x:Name="BtnNavHome" Style="{StaticResource SideNavBtnActive}"
                                Click="NavHome_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="17" FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Home" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavCreate" Style="{StaticResource SideNavBtn}"
                                Click="NavCreate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" FontSize="17" FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Create Project" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavProjectList" Style="{StaticResource SideNavBtn}"
                                Click="NavProjectList_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="17" FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Project List" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavRecentProjects" Style="{StaticResource SideNavBtn}"
                                Click="NavRecentProjects_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F552;" FontSize="17" FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Recent Projects" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavOpen" Style="{StaticResource SideNavBtn}"
                                Click="NavOpen_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4C2;" FontSize="17" FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Divider before settings group -->
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="16,10,16,6"/>

                        <Button x:Name="BtnNavAppSettings" Style="{StaticResource SideNavBtn}"
                                Click="NavAppSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2699;" FontSize="17" FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="App Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavAppGuide" Style="{StaticResource SideNavBtn}"
                                Click="NavAppGuide_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4D6;" FontSize="17" FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Application Guide" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Bottom items: HELP, ABOUT, copyright -->
                    <StackPanel Grid.Row="2">
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="12,0"/>

                        <Button x:Name="BtnNavHelp" Style="{StaticResource SideNavBtn}"
                                Padding="20,13"
                                FontSize="{StaticResource FontSizeNavStartup}"
                                Click="NavHelp_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2753;" FontSize="17" FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Help" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavAbout" Style="{StaticResource SideNavBtn}"
                                Padding="20,13"
                                FontSize="{StaticResource FontSizeNavStartup}"
                                Click="NavAbout_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2139;" FontSize="17" FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="About" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Padding="16,10">
                            <TextBlock Text="© 2026 Crane Optimization"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 RIGHT CONTENT AREA
            ════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>  <!-- Legacy top tab bar hidden -->
                    <RowDefinition Height="*"/>   <!-- Content -->
                </Grid.RowDefinitions>

                <!-- Top tab bar -->
                <Border Grid.Row="0"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="10,0,0,0">
                        <Button x:Name="TabOverview"
                                Content="Project Overview"
                                Style="{StaticResource TopTabBtnActive}"
                                Height="44"
                                Click="TabOverview_Click"/>
                        <Button x:Name="TabGuide"
                                Content="Application Guide"
                                Style="{StaticResource TopTabBtn}"
                                Height="44"
                                Click="TabGuide_Click"/>
                    </StackPanel>
                </Border>

                <!-- Content swap zone -->
                <Grid Grid.Row="1">

                    <!-- ════ HOME — FULL-HEIGHT HERO ════ -->
                    <!-- HOME - FULL-HEIGHT HERO -->
                    <!-- HOME - FULL-HEIGHT HERO -->
                    <Grid x:Name="ContentHome" Visibility="Visible">
                        <Grid>
                            <Image Source="/CraneOptimizer.UI;component/Resources/Images/construction_home.png"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Dark gradient overlay -->
                            <Border VerticalAlignment="Bottom" Height="340">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#AA000000" Offset="0.25"/>
                                        <GradientStop Color="#F2000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Hero content — pinned bottom-left -->
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                        Margin="48,0,48,40" MaxWidth="580">

                                <!-- Hero labels -->
                                <TextBlock Text="Smart Lift Optimizer"
                                           FontSize="{StaticResource FontSizeHeroTitle}"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,24"
                                           TextWrapping="Wrap"/>

                                <!-- ── Latest project present ────────────────── -->
                                <Border CornerRadius="12"
                                        Background="#DD0C0C0C"
                                        BorderBrush="#44FFFFFF" BorderThickness="1"
                                        Padding="22,18"
                                        MinHeight="140">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLatestProject}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Latest Opened Project"
                                                   FontSize="{StaticResource FontSizeLG}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock FontSize="{StaticResource FontSizeProjectCardName}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding LatestProjectName, Mode=OneWay}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock FontSize="{StaticResource FontSizeMD}"
                                                   Foreground="White"
                                                   Text="{Binding LatestProjectLastOpenedText, Mode=OneWay}"
                                                   Margin="0,0,0,2"/>
                                        <!-- Path-missing warning (only when HasMissingLatestProject) -->
                                        <TextBlock FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding LatestProjectPathStatus, Mode=OneWay}"
                                                   Margin="0,0,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMissingLatestProject}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Action buttons INSIDE the card -->
                                        <WrapPanel Margin="0,14,0,0" ItemHeight="38">
                                            <!-- Continue Working — visible when any project exists, enabled only when path is valid -->
                                            <Button Content="Continue Working"
                                                    Command="{Binding ContinueWorkingCommand}"
                                                    IsEnabled="{Binding CanContinueWorking}"
                                                    Padding="20,0" Margin="0,0,10,6"
                                                    FontSize="{StaticResource FontSizeMD}"
                                                    FontWeight="Bold">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLatestProject}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Create New Project"
                                                    Style="{StaticResource ButtonSecondary}"
                                                    Padding="20,0" Margin="0,0,10,6"
                                                    FontSize="{StaticResource FontSizeMD}"
                                                    FontWeight="SemiBold"
                                                    Click="NavCreate_Click"/>
                                            <Button Content="Open Project"
                                                    Command="{Binding OpenProjectFolderCommand}"
                                                    Style="{StaticResource ButtonSecondary}"
                                                    Padding="20,0" Margin="0,0,0,6"
                                                    FontSize="{StaticResource FontSizeMD}"
                                                    FontWeight="SemiBold"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ── No project yet ────────────────────────── -->
                                <Border CornerRadius="12"
                                        Background="#CC080808"
                                        BorderBrush="#33FFFFFF" BorderThickness="1"
                                        Padding="22,18"
                                        MinHeight="140">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLatestProject}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="No recent project yet"
                                                   FontSize="{StaticResource FontSizeProjectCardName}"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="Create a new crane optimization project or open an existing one."
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="White"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,14"/>
                                        <WrapPanel ItemHeight="38">
                                            <Button Content="Create New Project"
                                                    Style="{StaticResource ButtonSecondary}"
                                                    Padding="20,0" Margin="0,0,10,6"
                                                    FontSize="{StaticResource FontSizeMD}"
                                                    FontWeight="SemiBold"
                                                    Click="NavCreate_Click"/>
                                            <Button Content="Open Project"
                                                    Command="{Binding OpenProjectFolderCommand}"
                                                    Style="{StaticResource ButtonSecondary}"
                                                    Padding="20,0" Margin="0,0,0,6"
                                                    FontSize="{StaticResource FontSizeMD}"
                                                    FontWeight="SemiBold"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ContentCreate" Visibility="Collapsed">
                        <views:CreateProjectPanel x:Name="CreatePanelControl"/>
                    </Grid>
                    <!-- RECENT PROJECTS  columns: Project Name | Last Opened | Location | Favorite -->
                    <Grid x:Name="ContentRecentProjects" Visibility="Collapsed"
                          Background="{DynamicResource BackgroundBrush}">
                        <Grid Margin="32,28,32,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Page header -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="4" Height="22" Background="{StaticResource PrimaryBrush}"
                                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Recent Projects"
                                               FontSize="{StaticResource FontSizeXL}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Recently opened projects sorted by last opened. Double-click to open."
                                           FontSize="{StaticResource FontSizeSM}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="16,0,0,0"/>
                            </StackPanel>

                            <!-- Table: header + rows share one container so scrollbar is inside -->
                            <Border Grid.Row="1"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Column headers — sized to the row ScrollViewer's viewport so the
                                         vertical scrollbar shrinks header and rows by the same amount. -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                            CornerRadius="6,6,0,0">
                                        <Border HorizontalAlignment="Left"
                                                Padding="14,10"
                                                Width="{Binding ViewportWidth, ElementName=RecentRowsScroll}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Project Name"
                                               FontSize="{StaticResource FontSizeTableHeader}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Last Opened"
                                               FontSize="{StaticResource FontSizeTableHeader}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Location"
                                               FontSize="{StaticResource FontSizeTableHeader}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Favorite"
                                               FontSize="{StaticResource FontSizeTableHeader}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                        </Border>
                                    </Border>

                                    <!-- Rows inside scrollviewer — same column widths as header -->
                                    <ScrollViewer x:Name="RecentRowsScroll"
                                                  Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"  Padding="14,12"
                                                    Cursor="Hand">
                                                <Border.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel Margin="6,4" MinWidth="300">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                       FontSize="13" Margin="0,0,0,6"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayCompanyName}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Country" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Country, TargetNullValue='—'}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Site Location" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SiteLocation, TargetNullValue='—'}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="IFC File" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IfcFileName}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Date Created" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CreatedDate, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Last Modified" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastModifiedDate, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="14" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Folder on Disk" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                                                <TextBlock Grid.Row="6" Grid.Column="1" FontSize="14">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding ProjectFolderPath}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding FolderExists}" Value="False">
                                                                                    <Setter Property="Text" Value="&#9888; Folder not found"/>
                                                                                    <Setter Property="Foreground" Value="Orange"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                        Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Project Name -->
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                               FontSize="{StaticResource FontSizeSM}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Name}"/>

                                                    <!-- Last Opened -->
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               FontSize="{StaticResource FontSizeSM}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding LastOpenedDate, StringFormat='{}{0:dd MMM yyyy}'}"/>

                                                    <!-- Location -->
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               FontSize="{StaticResource FontSizeXS}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding DisplayLocation}"
                                                               ToolTip="{Binding ProjectFolderPath}"/>

                                                    <!-- Favourite star: FILLED orange when active -->
                                                    <ToggleButton Grid.Column="3"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                                  Cursor="Hand"
                                                                  ToolTip="Toggle Favorite"
                                                                  Width="36" Height="36"
                                                                  BorderThickness="0"
                                                                  FocusVisualStyle="{x:Null}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    CornerRadius="4">
                                                                                <TextBlock x:Name="StarIcon"
                                                                                           Text="&#9734;"
                                                                                           FontSize="22"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <!-- Filled star + orange when checked -->
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="StarIcon" Property="Text" Value="&#9733;"/>
                                                                                    <Setter TargetName="StarIcon" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="StarIcon" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Status bar -->
                            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                <ProgressBar Width="140" Height="4" DockPanel.Dock="Right"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             IsIndeterminate="{Binding IsBusy}"/>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeSM}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding StatusText}"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                    <!-- PROJECT LIST  columns: Project Name | Last Modified | Status | Lock | Actions -->
                    <Grid x:Name="ContentProjectList" Visibility="Collapsed"
                          Background="{DynamicResource BackgroundBrush}">
                        <Grid Margin="32,28,32,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Page header -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="4" Height="22" Background="{StaticResource PrimaryBrush}"
                                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="All Projects"
                                               FontSize="{StaticResource FontSizeXL}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Manage your crane optimization projects. Double-click to open."
                                           FontSize="{StaticResource FontSizeSM}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="16,0,0,0"/>
                            </StackPanel>

                            <!-- Search + toolbar -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="12,8" Margin="0,0,0,14">
                                <DockPanel LastChildFill="True">
                                    <!-- Right-side button group -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Margin="0,0,12,0" VerticalAlignment="Center"
                                                  FontSize="{StaticResource FontSizeSM}"
                                                  Content="Favorites Only"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"/>
                                        <Button Height="32" Padding="12,0"
                                                FontSize="{StaticResource FontSizeSM}"
                                                Content="Sort by Created"
                                                Style="{StaticResource ButtonSecondary}"
                                                Margin="0,0,6,0"
                                                ToolTip="Sort by Date Created ascending / descending"/>
                                        <Button Height="32" Padding="12,0"
                                                FontSize="{StaticResource FontSizeSM}"
                                                Content="Open Folder"
                                                Style="{StaticResource ButtonSecondary}"
                                                Margin="0,0,6,0"
                                                Command="{Binding OpenProjectFolderCommand}"/>
                                        <Button Height="32" Padding="16,0"
                                                FontSize="{StaticResource FontSizeSM}"
                                                FontWeight="Bold"
                                                Content="+ Create Project"
                                                Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding CreateProjectCommand}"/>
                                    </StackPanel>
                                    <!-- Search field fills remaining space -->
                                    <TextBox Height="32" Margin="0,0,12,0"
                                             VerticalContentAlignment="Center"
                                             FontSize="{StaticResource FontSizeSM}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </Border>

                            <!-- Table: header + rows share one container so scrollbar is inside -->
                            <Border Grid.Row="3"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Column headers — same column widths as rows.
                                         Inner border is sized to the row ScrollViewer's viewport so the
                                         vertical scrollbar shrinks header and rows by the same amount. -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                            CornerRadius="6,6,0,0">
                                        <Border HorizontalAlignment="Left"
                                                Padding="14,11"
                                                Width="{Binding ViewportWidth, ElementName=ProjectRowsScroll}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Project Name"
                                                       FontSize="{StaticResource FontSizeTableHeader}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Last Modified"
                                                       FontSize="{StaticResource FontSizeTableHeader}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Status"
                                                       FontSize="{StaticResource FontSizeTableHeader}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="Lock"
                                                       FontSize="{StaticResource FontSizeTableHeader}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       ToolTip="Lock is UI-only"/>
                                            <TextBlock Grid.Column="4" Text="Actions"
                                                       FontSize="{StaticResource FontSizeTableHeader}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        </Border>
                                    </Border>

                                    <!-- Rows inside scrollviewer — same column widths as header -->
                                    <ScrollViewer x:Name="ProjectRowsScroll"
                                                  Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Projects}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            MinHeight="52"
                                                            Padding="14,10"
                                                            Cursor="Hand">
                                                        <Border.ToolTip>
                                                            <ToolTip>
                                                                <StackPanel Margin="6,4" MinWidth="300">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                               FontSize="13" Margin="0,0,0,6"/>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="120"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayCompanyName}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Country" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Country, TargetNullValue='—'}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Site Location" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SiteLocation, TargetNullValue='—'}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="IFC File" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IfcFileName}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Date Created" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CreatedDate, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Last Modified" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastModifiedDate, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="14" Margin="0,0,0,3"/>
                                                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Folder on Disk" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                                                        <TextBlock Grid.Row="6" Grid.Column="1" FontSize="14">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{Binding ProjectFolderPath}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding FolderExists}" Value="False">
                                                                                            <Setter Property="Text" Value="⚠ Folder not found"/>
                                                                                            <Setter Property="Foreground" Value="Orange"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="130"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Project Name + folder sub-label -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock FontSize="{StaticResource FontSizeSM}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Text="{Binding Name}"/>
                                                                <TextBlock FontSize="{StaticResource FontSizeXS}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Text="{Binding FolderName}"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- Last Modified -->
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="{StaticResource FontSizeSM}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding LastModifiedDate, StringFormat='{}{0:dd MMM yyyy}'}"/>

                                                            <!-- Status -->
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="{StaticResource FontSizeSM}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding DisplayStatus}"/>

                                                            <!-- Lock toggle -->
                                                            <ToggleButton Grid.Column="3"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                                                          Cursor="Hand"
                                                                          ToolTip="Locking will be implemented later."
                                                                          Width="32" Height="32"
                                                                          BorderThickness="0"
                                                                          FocusVisualStyle="{x:Null}">
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="ToggleButton">
                                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                                        <TextBlock x:Name="LockIcon"
                                                                                                   Text="&#x1F513;" FontSize="16"
                                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsChecked" Value="True">
                                                                                            <Setter TargetName="LockIcon" Property="Text" Value="&#x1F512;"/>
                                                                                            <Setter TargetName="LockIcon" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="LockIcon" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>

                                                            <!-- Actions: Open + ... -->
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                <Button Content="Open"
                                                                        Height="30" Width="58"
                                                                        FontSize="{StaticResource FontSizeSM}"
                                                                        Style="{StaticResource ButtonSecondary}"
                                                                        Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Content="..."
                                                                        Height="30" Width="34"
                                                                        Margin="6,0,0,0"
                                                                        FontSize="{StaticResource FontSizeMD}"
                                                                        Style="{StaticResource ButtonSecondary}"
                                                                        ToolTip="View / Edit project details"
                                                                        Tag="{Binding}"
                                                                        Click="ProjectDetails_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Status bar -->
                            <DockPanel Grid.Row="4" Margin="0,10,0,0">
                                <ProgressBar Width="140" Height="4" DockPanel.Dock="Right"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             IsIndeterminate="{Binding IsBusy}"/>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeSM}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding StatusText}"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                    <!-- APPLICATION GUIDE — stepper UserControl -->
                    <Grid x:Name="ContentGuide" Visibility="Collapsed"
                          Background="{DynamicResource BackgroundBrush}">
                        <Grid Margin="32,28,32,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Page header -->
                            <StackPanel Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="4" Height="22" Background="{StaticResource PrimaryBrush}"
                                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Application Guide"
                                               FontSize="{StaticResource FontSizeXL}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Click a step to learn what to do at each stage of the workflow."
                                           FontSize="{StaticResource FontSizeSM}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="16,0,0,0"/>
                            </StackPanel>

                            <!-- Stepper UserControl, data context from code-behind -->
                            <views:ApplicationGuideCarouselControl Grid.Row="1"
                                x:Name="GuideCarouselControl"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ContentSettings" Visibility="Collapsed" Background="{DynamicResource BackgroundBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="32,28,32,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Page header -->
                                <StackPanel Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Width="4" Height="22" Background="{StaticResource PrimaryBrush}"
                                                Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Application Settings"
                                                   FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Configure appearance and workspace preferences."
                                               FontSize="{StaticResource FontSizeSM}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" MaxWidth="760" HorizontalAlignment="Left">

                                    <!-- ── APPEARANCE card ── -->
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource CardCornerRadius}" Padding="24,20"
                                            Margin="0,0,0,16">
                                        <StackPanel>

                                            <!-- Section label -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                                <Border Width="3" Height="14" Background="{StaticResource PrimaryBrush}"
                                                        Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Appearance"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Theme toggle row -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                            Margin="0,0,24,0">
                                                    <TextBlock Text="Color Theme"
                                                               FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="Choose between a dark or light interface."
                                                               FontSize="{StaticResource FontSizeXS}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Dark / Light pill buttons -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="BtnThemeDark"
                                                            Content="Dark"
                                                            MinWidth="96" Height="34" Padding="20,0"
                                                            FontSize="{StaticResource FontSizeSM}"
                                                            FontWeight="Bold"
                                                            Style="{StaticResource ButtonPrimary}"
                                                            Margin="0,0,8,0"
                                                            Click="BtnThemeDark_Click"/>
                                                    <Button x:Name="BtnThemeLight"
                                                            Content="Light"
                                                            MinWidth="96" Height="34" Padding="20,0"
                                                            FontSize="{StaticResource FontSizeSM}"
                                                            FontWeight="Bold"
                                                            Style="{StaticResource ButtonSecondary}"
                                                            Click="BtnThemeLight_Click"/>
                                                </StackPanel>
                                            </Grid>

                                        </StackPanel>
                                    </Border>

                                    <!-- ── SESSION INFORMATION card ── -->
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource CardCornerRadius}" Padding="24,20">
                                        <StackPanel>

                                            <!-- Section label -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                                <Border Width="3" Height="14" Background="{StaticResource PrimaryBrush}"
                                                        Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Session Information"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Signed-in account -->
                                            <Grid Margin="0,0,0,18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="👤" FontSize="22"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtSessionUser"
                                                               FontSize="{StaticResource FontSizeMD}" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="TxtSessionEmail"
                                                               FontSize="{StaticResource FontSizeSM}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Button Grid.Column="2" x:Name="BtnSignOut"
                                                        Content="Sign Out"
                                                        Height="34" Padding="20,0" Margin="16,0,0,0"
                                                        FontSize="{StaticResource FontSizeSM}"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource ButtonSecondary}"
                                                        ToolTip="End the current session and close the application"
                                                        Click="BtnSignOut_Click"/>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                                            <!-- Detail rows -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Role"
                                                           FontSize="{StaticResource FontSizeSM}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSessionRole"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,0,10"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Logged In"
                                                           FontSize="{StaticResource FontSizeSM}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtSessionLogin"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,0,10"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Active Theme"
                                                           FontSize="{StaticResource FontSizeSM}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtCurrentTheme"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                        </StackPanel>
                                    </Border>

                                    <!-- ── APPLICATION card ── -->
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource CardCornerRadius}" Padding="24,20"
                                            Margin="0,16,0,0">
                                        <StackPanel>

                                            <!-- Section label -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                                <Border Width="3" Height="14" Background="{StaticResource PrimaryBrush}"
                                                        Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Application"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Application Version"
                                                           FontSize="{StaticResource FontSizeSM}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" x:Name="TxtAppVersion"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ════ HELP / ABOUT ════ -->
                    <Grid x:Name="ContentHelp" Visibility="Collapsed" Background="{DynamicResource BackgroundBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,30">
                            <StackPanel MaxWidth="700" HorizontalAlignment="Left">

                                <!-- Header -->
                                <StackPanel Margin="0,0,0,28">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="4" Height="18" Background="{StaticResource PrimaryBrush}"
                                                Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtHelpTitle" Text="Help"
                                                   FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtHelpSubtitle" Text="Frequently asked questions and support resources."
                                               FontSize="{StaticResource FontSizeSM}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0"/>
                                </StackPanel>

                                <!-- FAQ card -->
                                <Border x:Name="CardHelp"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}" Padding="24,20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="3" Height="14" Background="{StaticResource PrimaryBrush}"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Frequently Asked Questions"
                                                       FontSize="{StaticResource FontSizeSM}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- FAQ item -->
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,0,0,14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="How do I create a new project?"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="{StaticResource FontSizeXS}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="Click 'Create Project' in the sidebar. Fill in the project name and folder location, optionally add country, site location, and a project image. Click Create Project to confirm."/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,0,0,14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="How do I load an existing project?"
                                                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="{StaticResource FontSizeXS}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="Double-click any project card on the Home screen, or use 'Open Folder' in the sidebar to browse to a project.db folder."/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel>
                                            <TextBlock Text="How do I switch between Dark and Light theme?"
                                                       FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <TextBlock TextWrapping="Wrap"
                                                       FontSize="{StaticResource FontSizeXS}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="Go to App Settings in the sidebar and click the Dark or Light button under 'Color Theme'."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- About card (shown when ABOUT nav is clicked) -->
                                <Border x:Name="CardAbout" Visibility="Collapsed"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}" Padding="24,20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                            <Border Width="3" Height="14" Background="{StaticResource PrimaryBrush}"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="About Crane Optimizer"
                                                       FontSize="{StaticResource FontSizeSM}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- Logo block -->
                                        <Border Width="64" Height="64" CornerRadius="12"
                                                Background="{StaticResource PrimaryBrush}"
                                                HorizontalAlignment="Left" Margin="0,0,0,20">
                                            <TextBlock Text="⚙" FontSize="30" Foreground="#1A1A1A"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="Crane Path Optimizer"
                                                   FontSize="{StaticResource FontSizeLG}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtAboutVersion"
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                                        <TextBlock TextWrapping="Wrap" MaxWidth="520"
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="An advanced crane path planning and optimization tool for construction sites. Powered by Genetic Algorithm optimization and IFC model support."
                                                   Margin="0,0,0,24"/>

                                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                                        <TextBlock Text="© 2026 Crane Optimization — All rights reserved."
                                                   FontSize="{StaticResource FontSizeXS}"
                                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
