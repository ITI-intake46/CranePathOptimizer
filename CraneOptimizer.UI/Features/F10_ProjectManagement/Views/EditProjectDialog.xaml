<Window x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.EditProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CraneOptimizer.UI.Features.F10_ProjectManagement.ViewModels"
        Title="Edit Project Details"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
        Width="600" SizeToContent="Height"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource FontPrimary}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,22">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="4" Height="20" Background="{StaticResource PrimaryBrush}"
                        Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="EDIT PROJECT DETAILS"
                           FontSize="{StaticResource FontSizeLG}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── Editable Fields ─────────────────────────────────────────── -->

            <!-- Name -->
            <TextBlock Text="Project Name *" FontSize="{StaticResource FontSizeSM}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Height="30" Padding="8,0"
                     VerticalContentAlignment="Center"
                     FontSize="{StaticResource FontSizeMD}"
                     Margin="0,0,0,10"/>

            <!-- Company Name -->
            <TextBlock Text="Company Name (optional)" FontSize="{StaticResource FontSizeSM}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                     Height="30" Padding="8,0"
                     VerticalContentAlignment="Center"
                     FontSize="{StaticResource FontSizeMD}"
                     Margin="0,0,0,10"/>

            <!-- Country + Site Location (side by side) -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Country (optional)" FontSize="{StaticResource FontSizeSM}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Padding="8,0" VerticalContentAlignment="Center"
                             FontSize="{StaticResource FontSizeMD}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Site Location (optional)" FontSize="{StaticResource FontSizeSM}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SiteLocation, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Padding="8,0" VerticalContentAlignment="Center"
                             FontSize="{StaticResource FontSizeMD}"/>
                </StackPanel>
            </Grid>

            <!-- Project Image -->
            <TextBlock Text="Project Image (optional)" FontSize="{StaticResource FontSizeSM}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Padding="8,0" VerticalContentAlignment="Center"
                         FontSize="{StaticResource FontSizeSM}"
                         IsReadOnly="True"/>
                <Button Grid.Column="2"
                        Content="Browse…"
                        Height="30" Padding="12,0"
                        FontSize="{StaticResource FontSizeSM}"
                        Style="{StaticResource ButtonSecondary}"
                        Command="{Binding BrowseImageCommand}"/>
            </Grid>

            <!-- Status (UI-only) -->
            <TextBlock Text="Status (UI display only)" FontSize="{StaticResource FontSizeSM}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AllStatuses}"
                      SelectedItem="{Binding Status}"
                      Height="30" Padding="8,0"
                      FontSize="{StaticResource FontSizeSM}"
                      Margin="0,0,0,12"/>

            <!-- Separator -->
            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

            <!-- Read-only metadata -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Date Created"
                           FontSize="{StaticResource FontSizeSM}"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayCreatedDate}"
                           FontSize="{StaticResource FontSizeSM}" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Modified"
                           FontSize="{StaticResource FontSizeSM}"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayModifiedDate}"
                           FontSize="{StaticResource FontSizeSM}" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Folder Name"
                           FontSize="{StaticResource FontSizeSM}"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayFolderName}"
                           FontSize="{StaticResource FontSizeSM}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DisplayFolderName}" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Project Path"
                           FontSize="{StaticResource FontSizeSM}"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayFolderPath}"
                           FontSize="{StaticResource FontSizeSM}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DisplayFolderPath}" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Folder on Disk"
                           FontSize="{StaticResource FontSizeSM}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DisplayFolderExists}"
                           FontSize="{StaticResource FontSizeSM}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FolderExistsOnDisk}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- ── Rename Folder Checkbox ──────────────────────────────────── -->
            <Border Padding="10,8" CornerRadius="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox x:Name="RenameFolderCheckBox"
                              IsChecked="{Binding RenameFolder}"
                              FontSize="{StaticResource FontSizeSM}"
                              FontWeight="SemiBold"
                              Content="Rename project folder to match project name"/>
                    <TextBlock Margin="22,4,0,0"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="When checked, the Windows folder on disk will be renamed using Directory.Move. The project ID and all files inside are preserved."/>
                </StackPanel>
            </Border>

            <!-- ── Rename Preview Panel (visible only when ShowRenamePreview=True) ── -->
            <Border x:Name="RenamePreviewPanel"
                    Padding="10,8" CornerRadius="4"
                    BorderThickness="1"
                    Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"   Value="Collapsed"/>
                        <Setter Property="Background"   Value="#1400A8FF"/>
                        <Setter Property="BorderBrush"  Value="#4400A8FF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRenamePreview}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- Conflict state overrides to orange -->
                            <DataTrigger Binding="{Binding TargetFolderConflict}" Value="True">
                                <Setter Property="Visibility"  Value="Visible"/>
                                <Setter Property="Background"  Value="#22FF8800"/>
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="{StaticResource FontSizeXS}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4"
                               Text="FOLDER RENAME PREVIEW"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Current:"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding DisplayFolderPath}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayFolderPath}"
                                   Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="New:"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding NewFolderPreviewPath}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding NewFolderPreviewPath}"/>
                    </Grid>
                    <!-- Conflict warning -->
                    <TextBlock Margin="0,6,0,0"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource WarningBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="⚠ A folder with this name already exists. Choose a different project name or uncheck the rename option.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetFolderConflict}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Info tip when rename is NOT checked and names differ -->
            <Border Padding="8,6" CornerRadius="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- Show when folder name and display name are different AND rename is not checked -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FolderNameDiffersFromDisplayName}" Value="True"/>
                                    <Condition Binding="{Binding RenameFolder}"                    Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="{StaticResource FontSizeXS}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="ℹ The project display name differs from the folder name on disk. The folder will NOT be renamed unless the checkbox above is checked."/>
            </Border>

            <!-- Error display -->
            <Border x:Name="ErrorBorder" Padding="8,6" CornerRadius="4"
                    Background="#22FF8800" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="{Binding ErrorText}"
                           FontSize="{StaticResource FontSizeSM}"
                           Foreground="{StaticResource WarningBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Margin="0,0,10,0"
                        Padding="18,0" Height="30"
                        FontSize="{StaticResource FontSizeSM}"
                        Style="{StaticResource ButtonSecondary}"
                        Command="{Binding CancelCommand}"/>
                <Button Content="Save Changes"
                        Padding="18,0" Height="30"
                        FontSize="{StaticResource FontSizeSM}"
                        FontWeight="Bold"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
