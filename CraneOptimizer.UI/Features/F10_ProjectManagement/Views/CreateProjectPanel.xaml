<UserControl x:Class="CraneOptimizer.UI.F10_ProjectManagement.Views.CreateProjectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             FontFamily="{StaticResource FontPrimary}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28,32,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Form ─────────────────────────────────────────────── -->
            <StackPanel Grid.Column="0">

                <!-- Header -->
                <StackPanel Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="4" Height="16" Background="{StaticResource PrimaryBrush}"
                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CREATE NEW PROJECT"
                                   FontSize="{StaticResource FontSizeSM}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Fill in the details below to create a new project workspace."
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="14,0,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Project Name -->
                <TextBlock Text="PROJECT NAME *" Style="{StaticResource PropertyLabel}"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                         x:Name="txtProjectName"
                         Height="36" Padding="10,4"
                         Margin="0,0,0,16"/>

                <!-- Country -->
                <TextBlock Text="COUNTRY" Style="{StaticResource PropertyLabel}"
                           Margin="0,0,0,6"/>
                <ComboBox SelectedValue="{Binding Country, Mode=TwoWay}"
                          SelectedValuePath="Content"
                          Height="36"
                          Margin="0,0,0,16"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                    <ComboBoxItem Content="Egypt"/>
                    <ComboBoxItem Content="UAE"/>
                    <ComboBoxItem Content="Saudi Arabia"/>
                    <ComboBoxItem Content="Kuwait"/>
                    <ComboBoxItem Content="Qatar"/>
                    <ComboBoxItem Content="Jordan"/>
                    <ComboBoxItem Content="Libya"/>
                    <ComboBoxItem Content="Morocco"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <!-- Site Location -->
                <TextBlock Text="SITE LOCATION" Style="{StaticResource PropertyLabel}"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding SiteLocation, UpdateSourceTrigger=PropertyChanged}"
                         Height="36" Padding="10,4"
                         Margin="0,0,0,16"/>

                <!-- Project Location (folder) -->
                <TextBlock Text="PROJECT FOLDER *" Style="{StaticResource PropertyLabel}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ParentFolderPath, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Padding="10,4"/>
                    <Button Grid.Column="2" Content="Browse" Height="36"
                            Style="{StaticResource ButtonSecondary}"
                            Command="{Binding BrowseLocationCommand}"/>
                </Grid>

                <!-- Separator -->
                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,4,0,16"/>

                <!-- Units -->
                <TextBlock Text="DEFAULT UNITS" Style="{StaticResource PanelSectionHeader}"
                           Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Length:" Style="{StaticResource PropertyLabel}" Width="100" VerticalAlignment="Center"/>
                    <ComboBox Width="180" SelectedIndex="{Binding SelectedLengthIndex, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                        <ComboBoxItem Content="Millimetres (mm)"/>
                        <ComboBoxItem Content="Metres (m)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Area:" Style="{StaticResource PropertyLabel}" Width="100" VerticalAlignment="Center"/>
                    <ComboBox Width="180" SelectedIndex="{Binding SelectedAreaIndex, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                        <ComboBoxItem Content="m²"/>
                        <ComboBoxItem Content="ft²"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Weight:" Style="{StaticResource PropertyLabel}" Width="100" VerticalAlignment="Center"/>
                    <ComboBox Width="180" SelectedIndex="{Binding SelectedMassIndex, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                        <ComboBoxItem Content="Kilograms (kg)"/>
                        <ComboBoxItem Content="Tons (t)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <TextBlock Text="Decimals:" Style="{StaticResource PropertyLabel}" Width="100" VerticalAlignment="Center"/>
                    <ComboBox Width="100" SelectedIndex="{Binding SelectedPrecisionIndex, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                        <ComboBoxItem Content="0"/>
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                    </ComboBox>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="CREATE PROJECT"
                            Width="180" Height="40"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding CreateCommand}"
                            Margin="0,0,12,0"/>
                    <Button Content="Cancel"
                            Width="90" Height="40"
                            Style="{StaticResource ButtonSecondary}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>

            </StackPanel>

            <!-- ── RIGHT: Image preview ───────────────────────────────────── -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top">

                <TextBlock Text="PROJECT IMAGE" Style="{StaticResource PropertyLabel}"
                           Margin="0,0,0,10"/>

                <!-- Thumbnail / placeholder -->
                <Border Width="220" Height="160" CornerRadius="6"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,12" ClipToBounds="True">
                    <Grid>
                        <!-- No-image placeholder -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="🖼" FontSize="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="No image selected"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Preview image -->
                        <Image Source="{Binding ProjectImagePreview}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                </Border>

                <Button Content="Browse Image"
                        Height="34" Width="220"
                        Style="{StaticResource ButtonSecondary}"
                        Command="{Binding BrowseImageCommand}"
                        Margin="0,0,0,8"/>

                <Button Content="Clear Image"
                        Height="34" Width="220"
                        Style="{StaticResource ButtonSecondary}"
                        Command="{Binding ClearImageCommand}"/>

                <!-- Info card -->
                <Border Margin="0,24,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="3" Height="12" Background="{StaticResource PrimaryBrush}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PROJECT STRUCTURE"
                                       FontSize="{StaticResource FontSizeXS}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="A project folder will be created with sub-folders: Models/IFC, Models/DXF, Reports, Exports, Logs."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
