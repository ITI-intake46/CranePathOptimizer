<UserControl
    x:Class="CraneOptimizer.UI.Features.F1_ProjectManagment.Views.HomeTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

        <StackPanel Margin="6,0" Orientation="Horizontal">

            <!--  ── PROJECT ─────────────────────────  -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="220">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="PROJECT" />

                    <StackPanel Orientation="Horizontal">

                        <!--  New  -->
                        <Button Command="{Binding NewProjectCommand}" Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,6,0,4"
                                    FontSize="26"
                                    Text="🆕" />
                                <TextBlock Text="New" />
                            </StackPanel>
                        </Button>

                        <!--  Open  -->
                        <Button
                            Margin="4,0,0,0"
                            Command="{Binding OpenProjectCommand}"
                            Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,6,0,4"
                                    FontSize="26"
                                    Text="📂" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>

                        <!--  Save  -->
                        <Button
                            Margin="4,0,0,0"
                            Command="{Binding SaveProjectCommand}"
                            Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,6,0,4"
                                    FontSize="26"
                                    Text="💾" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <!--  ── SETTINGS ─────────────────────────  -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="150">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="SETTINGS" />

                    <StackPanel Orientation="Horizontal">

                        <!--  Project Settings  -->
                        <Button Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,6,0,2"
                                    FontSize="26"
                                    Text="⚙️" />
                                <TextBlock Text="Project" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </Button>

                        <!--  Units  -->
                        <Button Margin="4,0,0,0" Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,6,0,6"
                                    FontSize="26"
                                    Text="📐" />
                                <TextBlock Text="Units" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <!--  ── QUICK ACCESS ─────────────────────────  -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="160">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="QUICK ACCESS" />

                    <StackPanel Margin="0,2,0,0">

                        <!--  Load IFC  -->
                        <Button
                            Width="150"
                            Margin="0,0,0,3"
                            Command="{Binding IfcViewer.LoadIfcCommand}"
                            Style="{StaticResource RibbonSmallBtn}">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" Text="📦" />
                                <TextBlock Text="Load IFC Model" />
                            </StackPanel>

                        </Button>

                        <!--  Add Crane  -->
                        <Button
                            Width="150"
                            Margin="0,0,0,3"
                            Style="{StaticResource RibbonSmallBtn}">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" Text="🏗" />
                                <TextBlock Text="Add Crane" />
                            </StackPanel>

                        </Button>

                        <!--  Draw Zones  -->
                        <Button
                            Width="150"
                            Command="{Binding StartDrawingCommand}"
                            Style="{StaticResource RibbonSmallBtn}">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" Text="🗺" />
                                <TextBlock Text="Draw Zones" />
                            </StackPanel>

                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>