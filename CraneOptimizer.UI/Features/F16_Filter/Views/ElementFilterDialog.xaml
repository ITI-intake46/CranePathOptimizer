<Window
    x:Class="CraneOptimizer.UI.Features.F16_Filter.Views.ElementFilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="IFC Element Filter"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
    Width="760"
    MinWidth="680"
    Height="760"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{DynamicResource BackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    FontFamily="{StaticResource FontPrimary}"
    FontSize="{StaticResource FontSizeBase}">

    <Window.Resources>

        <!-- ── Dialog font scale (local to this window) ──────────────────
             The global tokens are the compact 9/11 engineering scale, which
             left this dialog noticeably smaller than the rest of the app.
             Shadowed here so every FontSize reference below lands on one
             readable scale without touching the global typography. -->
        <sys:Double x:Key="FontSizeXS">12</sys:Double>
        <sys:Double x:Key="FontSizeSM">12</sys:Double>
        <sys:Double x:Key="FontSizeBase">13</sys:Double>
        <sys:Double x:Key="FontSizeMD">13</sys:Double>

        <DataTemplate x:Key="CheckableItemTemplate">
            <CheckBox
                Margin="0,2"
                Checked="FilterOption_Changed"
                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                Unchecked="FilterOption_Changed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding DisplayName}"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding Count}" />
                    </Border>
                </Grid>
            </CheckBox>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="HierarchyNodeTemplate" ItemsSource="{Binding Children}">
            <Border
                x:Name="HierarchyRow"
                Margin="0,1"
                Padding="4,2"
                Background="Transparent"
                CornerRadius="4">
                <!--  Fixed trailing columns so count / weight / status line up on every
                      row. With Auto widths each chip sized to its own text and drifted
                      horizontally from row to row.  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="68" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        VerticalAlignment="Center"
                        Checked="HierarchyOption_Changed"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        Opacity="{Binding DisplayOpacity}"
                        Unchecked="HierarchyOption_Changed">
                        <StackPanel>
                            <TextBlock
                                FontSize="{StaticResource FontSizeXS}"
                                FontWeight="{Binding FontWeight}"
                                Foreground="{Binding Foreground}"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <!--  Material only: the weight already has its own aligned column  -->
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="{StaticResource FontSizeXS}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding MaterialLabel}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding MaterialVisibility}" />
                        </StackPanel>
                    </CheckBox>
                    <Border
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="5,1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding CountVisibility}">
                        <TextBlock
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding Count}" />
                    </Border>
                    <TextBlock
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding WeightText}"
                        TextAlignment="Right"
                        Visibility="{Binding WeightVisibility}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource ErrorBrush}"
                        Text="{Binding VisibilityStatus}"
                        TextAlignment="Right"
                        Visibility="{Binding VisibilityStatusVisibility}" />
                </Grid>
            </Border>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="HierarchyRow" Property="Background" Value="{DynamicResource PrimaryMutedBrush}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <Style x:Key="HierarchyTreeItemStyle" TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <!--
            Shared action-toggle style.
            Set Tag="True" from code-behind to switch the button to the
            active/engaged colour (#D68A56 = PrimaryBrush = terracotta).
            Set Tag="False" (or leave unset) to return to the secondary style.
        -->
        <Style
            x:Key="ActionToggleButtonStyle"
            BasedOn="{StaticResource ButtonSecondary}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WeightRangeThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Ellipse
                            Fill="{StaticResource PrimaryBrush}"
                            Stroke="{DynamicResource BackgroundBrush}"
                            StrokeThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16,12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Title lives in the window chrome; repeating it here just cost
                      vertical space. The weight/height chips duplicated the Weight
                      Range section below, so they are gone too.  -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                Background="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Element Filter"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBase}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" Margin="13,3,0,0" Style="{StaticResource TextCaption}" />
                    <!--  Model-wide 3D visibility, so hiding a few elements out of
                          thousands is legible instead of looking like a no-op.  -->
                    <TextBlock x:Name="TxtHiddenCount"
                               Margin="13,3,0,0"
                               FontSize="{StaticResource FontSizeXS}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtWeightChip" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtHeightChip" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Margin="0,0,10,0"
                        Padding="8,3"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            x:Name="TxtCheckedCount"
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <Border
                        Padding="8,3"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            x:Name="TxtPreviewCount"
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="3" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"
                            Background="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="Scope"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <Button
                        x:Name="BtnScopeAll"
                        Margin="0,0,6,0"
                        Padding="8,6"
                        Click="BtnScopeAll_Click"
                        Content="All Elements"
                        Style="{StaticResource ButtonSecondary}"
                        ToolTip="Filter the full model." />
                    <Button
                        x:Name="BtnScopeStructural"
                        Margin="0,0,6,0"
                        Padding="8,6"
                        Click="BtnScopeStructural_Click"
                        Content="Structural"
                        Style="{StaticResource ButtonSecondary}"
                        ToolTip="Filter structural IFC elements." />
                    <Button
                        x:Name="BtnScopeSelected"
                        Padding="8,6"
                        Click="BtnScopeSelected_Click"
                        Content="Selected"
                        Style="{StaticResource ButtonSecondary}"
                        ToolTip="Filter only the elements currently selected in the model." />
                </UniformGrid>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="3" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"
                            Background="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="Search"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <!-- Search box with placeholder + clear button -->
                <Grid Height="30" Margin="0,0,0,12">
                    <TextBox
                        x:Name="TxtSearch"
                        Height="30"
                        Padding="8,2,32,2"
                        VerticalContentAlignment="Center"
                        TextChanged="TxtSearch_TextChanged" />
                    <!-- Placeholder — hidden as soon as the user types anything -->
                    <TextBlock
                        IsHitTestVisible="False"
                        Margin="10,0,36,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeBase}"
                        Foreground="{DynamicResource TextDisabledBrush}"
                        Text="Search by type, name, material, level, or ID…">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Clear-search × button — only visible when text exists -->
                    <Button x:Name="BtnClearSearch"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="26" Height="26"
                            Margin="0,0,2,0"
                            Content="✕"
                            FontSize="{StaticResource FontSizeXS}"
                            Visibility="Collapsed"
                            Click="BtnClearSearch_Click"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="Clear search"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <!--  Header and available-range on one line  -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Weight Range (kg)"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TxtAvailableWeightRange"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>

                <!--  Labels sit inline with their inputs on a single baseline; the old
                      layout stacked a separate label row and a redundant "Selected:"
                      summary that just restated the two boxes.  -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Min" />
                    <TextBox Grid.Column="1"
                             x:Name="TxtWeightMin"
                             VerticalContentAlignment="Center"
                             TextChanged="WeightRange_Changed"
                             ToolTip="Minimum weight filter (kg). Elements lighter than this value are excluded."/>
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="–" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Max" />
                    <TextBox
                        x:Name="TxtWeightMax"
                        Grid.Column="4"
                        VerticalContentAlignment="Center"
                        TextChanged="WeightRange_Changed"
                        ToolTip="Maximum weight filter (kg). Elements heavier than this value are excluded."/>
                    <TextBlock x:Name="TxtWeightRangeSummary" Visibility="Collapsed" />
                </Grid>
                <Canvas
                    x:Name="WeightRangeSlider"
                    Height="28"
                    Margin="0,2,0,16"
                    MouseLeftButtonDown="WeightRangeSlider_MouseLeftButtonDown"
                    SizeChanged="WeightRangeSlider_SizeChanged">
                    <Border
                        x:Name="WeightRangeTrackBase"
                        Canvas.Top="12"
                        Height="4"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="2" />
                    <Border
                        x:Name="WeightRangeTrackSelection"
                        Canvas.Top="12"
                        Height="4"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="2" />
                    <Thumb
                        x:Name="ThumbWeightMin"
                        Canvas.Top="7"
                        DragDelta="ThumbWeightMin_DragDelta"
                        Style="{StaticResource WeightRangeThumbStyle}" />
                    <Thumb
                        x:Name="ThumbWeightMax"
                        Canvas.Top="7"
                        DragDelta="ThumbWeightMax_DragDelta"
                        Style="{StaticResource WeightRangeThumbStyle}" />
                    <Slider
                        x:Name="SliderWeightMin"
                        Minimum="0"
                        ValueChanged="SliderWeightMin_Changed"
                        Visibility="Collapsed" />
                    <Slider
                        x:Name="SliderWeightMax"
                        Minimum="0"
                        ValueChanged="SliderWeightMax_Changed"
                        Visibility="Collapsed" />
                </Canvas>
            </StackPanel>

            <Border
                Grid.Row="3"
                Padding="12"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeXS}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Hierarchy by:" />
                            <ComboBox
                                x:Name="CboHierarchyBy"
                                Grid.Column="1"
                                Height="26"
                                Margin="8,0,0,0"
                                SelectionChanged="HierarchyMode_Changed"
                                Style="{StaticResource DarkComboBox}">
                                <ComboBoxItem Content="Type - Element" IsSelected="True" />
                                <ComboBoxItem Content="Material - Element" />
                                <ComboBoxItem Content="Storey - Element" />
                            </ComboBox>
                            <Button
                                Grid.Column="3"
                                Margin="8,0,4,0"
                                Padding="10,4"
                                Click="BtnExpandHierarchy_Click"
                                Style="{StaticResource ButtonSecondary}">
                                Expand All
                            </Button>
                            <Button
                                Grid.Column="4"
                                Padding="10,4"
                                Click="BtnCollapseHierarchy_Click"
                                Style="{StaticResource ButtonSecondary}">
                                Collapse All
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeXS}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Order by:" />
                            <ComboBox
                                x:Name="CboSortBy"
                                Grid.Column="1"
                                Height="26"
                                Margin="8,0,0,0"
                                SelectionChanged="Sort_Changed"
                                Style="{StaticResource DarkComboBox}">
                                <ComboBoxItem Content="Name" IsSelected="True" />
                                <ComboBoxItem Content="Type" />
                                <ComboBoxItem Content="Weight" />
                                <ComboBoxItem Content="Height" />
                                <ComboBoxItem Content="Material" />
                                <ComboBoxItem Content="Storey / Level" />
                            </ComboBox>
                            <TextBlock
                                Grid.Column="2"
                                Margin="18,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeXS}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Direction:" />
                            <RadioButton
                                x:Name="RbSortAscending"
                                Grid.Column="4"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Checked="Sort_Changed"
                                Content="Ascending"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                GroupName="FilterSortDirection"
                                IsChecked="True" />
                            <RadioButton
                                x:Name="RbSortDescending"
                                Grid.Column="5"
                                VerticalAlignment="Center"
                                Checked="Sort_Changed"
                                Content="Descending"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                GroupName="FilterSortDirection" />
                        </Grid>

                        <!-- Tree area: Grid so the empty-state overlay can be stacked over the TreeView -->
                        <Grid Grid.Row="2">
                            <TreeView
                                x:Name="HierarchyTree"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                ItemContainerStyle="{StaticResource HierarchyTreeItemStyle}"
                                ItemTemplate="{StaticResource HierarchyNodeTemplate}"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.PanningMode="VerticalOnly"
                                VirtualizingStackPanel.IsVirtualizing="True"
                                VirtualizingStackPanel.VirtualizationMode="Recycling"
                                VirtualizingPanel.ScrollUnit="Pixel" />

                            <!-- No-match empty state — shown when the tree has no items -->
                            <Border x:Name="BdrEmptyState"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                    <TextBlock x:Name="TxtEmptyStateMessage"
                                               HorizontalAlignment="Center"
                                               FontSize="{StaticResource FontSizeBase}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="No IFC elements match the current search and filters."/>
                                    <Button x:Name="BtnEmptyClearSearch"
                                            Margin="0,10,0,0"
                                            Padding="12,5"
                                            HorizontalAlignment="Center"
                                            Content="Clear Search"
                                            Visibility="Collapsed"
                                            Style="{StaticResource ButtonSecondary}"
                                            Click="BtnClearSearch_Click"
                                            ToolTip="Clear the search text and show all elements."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="16,10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />   <!--  0: Reset Hierarchy Filters  -->
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />   <!--  2: Show All Elements  -->
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />   <!--  4: Hide / Show Checked (toggle)  -->
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />   <!--  6: Isolate / End Isolation (toggle)  -->
                    <ColumnDefinition Width="*" />      <!--  7: spacer  -->
                    <ColumnDefinition Width="Auto" />   <!--  8: Close  -->
                </Grid.ColumnDefinitions>

                <!--  Hierarchy-only reset — does NOT affect 3D visibility  -->
                <Button
                    Grid.Column="0"
                    Padding="10,6"
                    Click="BtnReset_Click"
                    Content="Reset Filters"
                    Style="{StaticResource ButtonSecondary}"
                    ToolTip="Reset scope, search, weight and type/material/storey filters. Does not change 3D visibility." />

                <!--  3D visibility commands  -->
                <Button
                    Grid.Column="2"
                    Padding="10,6"
                    Click="BtnShowAll_Click"
                    Content="Show All"
                    Style="{StaticResource ButtonSecondary}"
                    ToolTip="Restore visibility for every model element and exit any active isolation." />
                <Button
                    x:Name="BtnHideChecked"
                    Grid.Column="4"
                    MinWidth="130"
                    Padding="10,6"
                    Click="BtnHideChecked_Click"
                    Content="Hide Checked"
                    Style="{StaticResource ActionToggleButtonStyle}"
                    ToolTip="Hide all checked elements. When all checked elements are hidden, click again to show them." />
                <Button
                    x:Name="BtnIsolateChecked"
                    Grid.Column="6"
                    MinWidth="140"
                    Padding="10,6"
                    Click="BtnIsolateChecked_Click"
                    Content="Isolate Checked"
                    Style="{StaticResource ActionToggleButtonStyle}"
                    ToolTip="Show only the checked elements in the 3D view." />
                <Button
                    Grid.Column="8"
                    Padding="14,6"
                    Click="BtnApply_Click"
                    Content="Close"
                    Style="{StaticResource ButtonSecondary}"
                    ToolTip="Close the filter dialog. All visibility changes are already applied live."/>
            </Grid>
        </Border>
    </Grid>
</Window>
