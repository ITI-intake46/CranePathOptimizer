<Window
    x:Class="CraneOptimizer.UI.Features.F16_Filter.Views.ElementFilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IFC Element Filter"
    Width="680"
    MinWidth="560"
    Height="760"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{DynamicResource BackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    FontFamily="{StaticResource FontPrimary}"
    FontSize="{StaticResource FontSizeBase}">

    <Window.Resources>
        <DataTemplate x:Key="CheckableItemTemplate">
            <CheckBox
                Margin="0,2"
                Checked="FilterOption_Changed"
                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                Unchecked="FilterOption_Changed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding DisplayName}"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding Count}" />
                    </Border>
                </Grid>
            </CheckBox>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="HierarchyNodeTemplate" ItemsSource="{Binding Children}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    VerticalAlignment="Center"
                    Checked="HierarchyOption_Changed"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    Unchecked="HierarchyOption_Changed">
                    <StackPanel>
                        <TextBlock
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="{Binding FontWeight}"
                            Foreground="{Binding Foreground}"
                            Text="{Binding DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <WrapPanel Visibility="{Binding SubtitleRowVisibility}" Margin="0,1,0,0">
                            <TextBlock
                                FontSize="9"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Material: "
                                Visibility="{Binding MaterialVisibility}" />
                            <TextBlock
                                FontSize="9"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="{Binding MaterialLabel}"
                                Visibility="{Binding MaterialVisibility}"
                                Margin="0,0,8,0" />
                            <TextBlock
                                FontSize="9"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Weight: "
                                Visibility="{Binding WeightLabelVisibility}" />
                            <TextBlock
                                FontSize="9"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="{Binding WeightLabel}"
                                Visibility="{Binding WeightLabelVisibility}" />
                        </WrapPanel>
                    </StackPanel>
                </CheckBox>
                <Border
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="5,1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding CountVisibility}">
                    <TextBlock
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding Count}" />
                </Border>
                <Border
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="5,1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding WeightVisibility}">
                    <TextBlock
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding WeightText}" />
                </Border>
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="HierarchyTreeItemStyle" TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <Style x:Key="WeightRangeThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Ellipse
                            Fill="{StaticResource PrimaryBrush}"
                            Stroke="{DynamicResource BackgroundBrush}"
                            StrokeThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16,12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="IFC Element Filter" Style="{StaticResource TextTitle}" />
                    <TextBlock x:Name="TxtSubtitle" Margin="0,2,0,0" Style="{StaticResource TextCaption}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Border Margin="0,0,8,4" Padding="8,3" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <TextBlock x:Name="TxtWeightChip" FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                        <Border Margin="0,0,8,4" Padding="8,3" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <TextBlock x:Name="TxtHeightChip" FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <CheckBox
                        x:Name="ChkLiveApply"
                        Margin="0,0,10,0"
                        Checked="AnyFilter_Changed"
                        Content="Live apply"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        IsChecked="True"
                        Unchecked="AnyFilter_Changed" />
                    <Border
                        Padding="8,3"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            x:Name="TxtPreviewCount"
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="SCOPE" Style="{StaticResource PanelSectionHeader}" />
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button
                        x:Name="BtnScopeAll"
                        Margin="0,0,6,0"
                        Padding="8,6"
                        Click="BtnScopeAll_Click"
                        Content="All Elements"
                        Style="{StaticResource ButtonSecondary}"
                        ToolTip="Filter the full model." />
                    <Button
                        x:Name="BtnScopeSelected"
                        Padding="8,6"
                        Click="BtnScopeSelected_Click"
                        Content="Selected"
                        Style="{StaticResource ButtonSecondary}"
                        ToolTip="Filter only the elements selected before opening this dialog." />
                </UniformGrid>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="SEARCH" Style="{StaticResource PanelSectionHeader}" />
                <TextBox
                    x:Name="TxtSearch"
                    Height="30"
                    Margin="0,0,0,14"
                    Padding="8,2"
                    VerticalContentAlignment="Center"
                    TextChanged="TxtSearch_TextChanged" />
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="WEIGHT RANGE (kg)" Style="{StaticResource PanelSectionHeader}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TxtWeightRangeSummary"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock
                        x:Name="TxtAvailableWeightRange"
                        Grid.Column="1"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtWeightMin" TextChanged="WeightRange_Changed" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="-" />
                    <TextBox
                        x:Name="TxtWeightMax"
                        Grid.Column="2"
                        TextChanged="WeightRange_Changed" />
                </Grid>
                <Canvas
                    x:Name="WeightRangeSlider"
                    Height="28"
                    Margin="0,2,0,16"
                    MouseLeftButtonDown="WeightRangeSlider_MouseLeftButtonDown"
                    SizeChanged="WeightRangeSlider_SizeChanged">
                    <Border
                        x:Name="WeightRangeTrackBase"
                        Canvas.Top="12"
                        Height="4"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="2" />
                    <Border
                        x:Name="WeightRangeTrackSelection"
                        Canvas.Top="12"
                        Height="4"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="2" />
                    <Thumb
                        x:Name="ThumbWeightMin"
                        Canvas.Top="7"
                        DragDelta="ThumbWeightMin_DragDelta"
                        Style="{StaticResource WeightRangeThumbStyle}" />
                    <Thumb
                        x:Name="ThumbWeightMax"
                        Canvas.Top="7"
                        DragDelta="ThumbWeightMax_DragDelta"
                        Style="{StaticResource WeightRangeThumbStyle}" />
                    <Slider
                        x:Name="SliderWeightMin"
                        Minimum="0"
                        ValueChanged="SliderWeightMin_Changed"
                        Visibility="Collapsed" />
                    <Slider
                        x:Name="SliderWeightMax"
                        Minimum="0"
                        ValueChanged="SliderWeightMax_Changed"
                        Visibility="Collapsed" />
                </Canvas>
            </StackPanel>

                <Border
                    Grid.Row="3"
                    Margin="0"
                    Padding="12"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeXS}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Hierarchy by:" />
                            <ComboBox
                                x:Name="CboHierarchyBy"
                                Grid.Column="1"
                                Height="26"
                                Margin="8,0,0,0"
                                SelectionChanged="HierarchyMode_Changed"
                                Style="{StaticResource DarkComboBox}">
                                <ComboBoxItem Content="Type - Element" IsSelected="True" />
                                <ComboBoxItem Content="Material - Element" />
                                <ComboBoxItem Content="Storey - Element" />
                            </ComboBox>
                            <Button
                                Grid.Column="3"
                                Margin="8,0,4,0"
                                Padding="10,4"
                                Click="BtnExpandHierarchy_Click"
                                Style="{StaticResource ButtonSecondary}">
                                Expand All
                            </Button>
                            <Button
                                Grid.Column="4"
                                Padding="10,4"
                                Click="BtnCollapseHierarchy_Click"
                                Style="{StaticResource ButtonSecondary}">
                                Collapse All
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeXS}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Order by:" />
                            <ComboBox
                                x:Name="CboSortBy"
                                Grid.Column="1"
                                Height="26"
                                Margin="8,0,0,0"
                                SelectionChanged="Sort_Changed"
                                Style="{StaticResource DarkComboBox}">
                                <ComboBoxItem Content="Name" IsSelected="True" />
                                <ComboBoxItem Content="Type" />
                                <ComboBoxItem Content="Weight" />
                                <ComboBoxItem Content="Height" />
                                <ComboBoxItem Content="Material" />
                                <ComboBoxItem Content="Storey / Level" />
                            </ComboBox>
                            <TextBlock
                                Grid.Column="2"
                                Margin="18,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeXS}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Direction:" />
                            <RadioButton
                                x:Name="RbSortAscending"
                                Grid.Column="4"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Checked="Sort_Changed"
                                Content="Ascending"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                GroupName="FilterSortDirection"
                                IsChecked="True" />
                            <RadioButton
                                x:Name="RbSortDescending"
                                Grid.Column="5"
                                VerticalAlignment="Center"
                                Checked="Sort_Changed"
                                Content="Descending"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                GroupName="FilterSortDirection" />
                        </Grid>

                        <TreeView
                            x:Name="HierarchyTree"
                            Grid.Row="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            ItemContainerStyle="{StaticResource HierarchyTreeItemStyle}"
                            ItemTemplate="{StaticResource HierarchyNodeTemplate}"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.PanningMode="VerticalOnly"
                            VirtualizingStackPanel.IsVirtualizing="True"
                            VirtualizingStackPanel.VirtualizationMode="Recycling" />
                    </Grid>
                </Border>

        </Grid>

        <Border
            Grid.Row="2"
            Padding="16,10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Padding="14,6"
                    Click="BtnReset_Click"
                    Content="Reset All Filters"
                    Style="{StaticResource ButtonSecondary}" />
                <Button
                    x:Name="BtnShowSelectedOnly"
                    Grid.Column="2"
                    Padding="14,6"
                    Click="BtnIsolateSelected_Click"
                    Content="Show Selected Only"
                    Style="{StaticResource ButtonSecondary}"
                    ToolTip="Show only the currently selected elements in the 3D view." />
                <Button
                    x:Name="BtnHideSelected"
                    Grid.Column="4"
                    Padding="14,6"
                    Click="BtnHideSelected_Click"
                    Content="Hide Selected"
                    Style="{StaticResource ButtonSecondary}"
                    ToolTip="Hide the currently selected elements in the 3D view." />
                <Button
                    Grid.Column="6"
                    Padding="20,8"
                    Click="BtnApply_Click"
                    Content="Apply"
                    Style="{StaticResource ButtonPrimary}" />
                <Button
                    Grid.Column="8"
                    Padding="14,6"
                    Click="BtnCancel_Click"
                    Content="Cancel"
                    Style="{StaticResource ButtonSecondary}" />
            </Grid>
        </Border>
    </Grid>
</Window>
