<UserControl x:Class="CraneOptimizer.UI.Features.F3_CraneSetup.Views.CraneManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>
        <Style x:Key="CraneSummaryBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="CraneSummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXS}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CraneSummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXS}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CraneNumericTextBox"
               BasedOn="{StaticResource {x:Type TextBox}}"
               TargetType="TextBox">
            <Setter Property="Height" Value="{StaticResource InputHeight}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CraneSliderValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="CraneDisplayRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CraneDisplayCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Data="M 2 8 L 6 12 L 14 4"
                                  Stroke="{StaticResource PrimaryBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BackgroundBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&lt;"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <TextBlock Text="Mobile Crane 1"
                               FontSize="{StaticResource FontSizeSM}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ToolbarButton}"
                        Padding="6,2"
                        Command="{Binding RemoveSelectedCraneCommand}"
                        ToolTip="Remove crane">
                    <TextBlock Text="✕" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── NO CRANE PLACEHOLDER ──────────────────────────────────── -->
        <Border Grid.Row="1" Margin="20" VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveCrane}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🏗" FontSize="36" HorizontalAlignment="Center"/>
                <TextBlock Text="No crane placed"
                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="Click MOBILE CRANE to place"
                           FontSize="{StaticResource FontSizeXS}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── PROPERTIES PANEL ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveCrane}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="12,10,12,0" DataContext="{Binding ActiveParams}">

                <TextBlock Text="DATABASE CRANE"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <ComboBox Margin="0,0,0,10"
                          ItemsSource="{Binding DataContext.AvailableCranes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding DataContext.SelectedDatabaseCrane, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          TextSearch.TextPath="Name">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{StaticResource FontSizeSM}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Manufacturer}"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="  |  "
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CraneType}"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Border Margin="0,0,0,16" Style="{StaticResource CraneSummaryBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource CraneSummaryLabel}"
                                   Text="Carrier"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource CraneSummaryValue}">
                            <Run Text="{Binding CarrierLength, Converter={StaticResource LengthDisplayConverter}}"/>
                            <Run Text=" &#x00D7; "/>
                            <Run Text="{Binding CarrierWidth, Converter={StaticResource LengthDisplayConverter}}"/>
                            <Run Text=" &#x00D7; "/>
                            <Run Text="{Binding CarrierHeight, Converter={StaticResource LengthDisplayConverter}}"/>
                        </TextBlock>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource CraneSummaryLabel}"
                                       Text="Outrigger"/>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource CraneSummaryValue}">
                                <Run Text="{Binding OutriggerSpanM, Converter={StaticResource LengthDisplayConverter}}"/>
                                <Run Text=" &#x00D7; "/>
                                <Run Text="{Binding SpanToSpanM, Converter={StaticResource LengthDisplayConverter}}"/>
                            </TextBlock>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource CraneSummaryLabel}"
                                   Text="Boom"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource CraneSummaryValue}">
                            <Run Text="{Binding MinBoomLength, Converter={StaticResource LengthDisplayConverter}}"/>
                            <Run Text=" &#x2013; "/>
                            <Run Text="{Binding MaxBoomLength, Converter={StaticResource LengthDisplayConverter}}"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ── Z POSITION + SET XYZ ─────────────────────────── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X" FontWeight="Bold"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Margin="0,0,8,0"
                             Style="{StaticResource CraneNumericTextBox}"
                             Text="{Binding PositionX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource LengthDisplayConverter}}"/>
                    <TextBlock Grid.Column="2" Text="Y" FontWeight="Bold"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="3"
                             Margin="0,0,8,0"
                             Style="{StaticResource CraneNumericTextBox}"
                             Text="{Binding PositionY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource LengthDisplayConverter}}"/>
                    <TextBlock Grid.Column="4" Text="Z" FontWeight="Bold"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="5"
                             Style="{StaticResource CraneNumericTextBox}"
                             Text="{Binding PositionZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource LengthDisplayConverter}}"/>
                </Grid>

                <!-- ── BODY ANGLE ───────────────────────────────────── -->
                <TextBlock Text="BODY ANGLE"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="0" Maximum="360"
                            Value="{Binding BodyAngle, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBox x:Name="BodyAngleTextBox"
                                  Width="52"
                                  Style="{StaticResource CraneNumericTextBox}"
                                  TextAlignment="Center"
                                 Text="{Binding BodyAngle, Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus,
                                        StringFormat={}{0:F0}}"
                                 KeyDown="BodyAngleTextBox_KeyDown"/>
                        <TextBlock Text="°"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ── SLEW ANGLE ───────────────────────────────────── -->
                <TextBlock Text="SLEW ANGLE"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="0" Maximum="360"
                            Value="{Binding SlewAngle, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SlewAngle, StringFormat={}{0:F0}°}"
                               Style="{StaticResource CraneSliderValue}"/>
                </Grid>

                <!-- ── CABLE LENGTH ─────────────────────────────────── -->
                <TextBlock Text="CABLE LENGTH"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="1" Maximum="80"
                            Value="{Binding CableLength, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CableLength, Converter={StaticResource LengthDisplayConverter}}"
                               Style="{StaticResource CraneSliderValue}"/>
                </Grid>

                <!-- ── LOAD CHART ───────────────────────────────────── -->
                <TextBlock Text="LOAD CHART"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>

                <!-- Chart summary -->
                <Border Margin="0,0,0,4" Style="{StaticResource CraneSummaryBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!-- Maximum capacity -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource CraneSummaryLabel}"
                                   Text="Maximum Capacity"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding MaxCapacity, Converter={StaticResource MassDisplayConverter}}"
                                   Style="{StaticResource CraneSummaryValue}"/>
                        <!-- Radius range -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Radius"
                                   Style="{StaticResource CraneSummaryLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource CraneSummaryValue}">
                            <Run Text="{Binding MinReach, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                            <Run Text=" &#x2013; "/>
                            <Run Text="{Binding MaxReach, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- Boom range -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Boom"
                                   Style="{StaticResource CraneSummaryLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource CraneSummaryValue}">
                            <Run Text="{Binding MinBoomLength, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                            <Run Text=" &#x2013; "/>
                            <Run Text="{Binding MaxBoomLength, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- Outrigger -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Operating"
                                   Style="{StaticResource CraneSummaryLabel}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource CraneSummaryValue}" TargetType="TextBlock">
                                    <Setter Property="Text" Value="Outriggers"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                            <Setter Property="Text" Value="On Rubber"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Derating -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Derating"
                                   Style="{StaticResource CraneSummaryLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="100%"
                                   Style="{StaticResource CraneSummaryValue}"/>
                    </Grid>
                </Border>

                <!-- Swap outrigger button -->
                <Border Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="4" Padding="8,6" Margin="0,4,0,16"
                        Cursor="Hand" HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Swap Outrigger W / L"
                               FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <!-- ── BOOM LENGTH ──────────────────────────────────── -->
                <TextBlock Text="BOOM LENGTH"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="{Binding MinBoomLength}"
                            Maximum="{Binding MaxBoomLength}"
                            Value="{Binding BoomLength, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding BoomLength, Converter={StaticResource LengthDisplayConverter}}"
                               Style="{StaticResource CraneSliderValue}"/>
                </Grid>

                <!-- ── WORKING RADIUS ──────────────────────────────── -->
                <TextBlock Text="WORKING RADIUS"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="{Binding MinReach}"
                            Maximum="{Binding MaxReach}"
                            Value="{Binding WorkingRadius, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding WorkingRadius, Converter={StaticResource LengthDisplayConverter}}"
                               Style="{StaticResource CraneSliderValue}"/>
                </Grid>

                <!-- ── EXCLUSION RADIUS ────────────────────────────── -->
                <TextBlock Text="EXCLUSION RADIUS"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="0" Maximum="20"
                            Value="{Binding ExclusionRadiusM, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ExclusionRadiusM, Converter={StaticResource LengthDisplayConverter}}"
                               Style="{StaticResource CraneSliderValue}"/>
                </Grid>

                <!-- ── OUTRIGGER SPAN ──────────────────────────────── -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="OUTRIGGER SPAN"
                               FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="3" Maximum="20"
                                Value="{Binding OutriggerSpanM, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding OutriggerSpanM, Converter={StaticResource LengthDisplayConverter}}"
                                   Style="{StaticResource CraneSliderValue}"/>
                    </Grid>
                </StackPanel>

                <!-- ── DISPLAY TOGGLES ─────────────────────────────── -->
                <TextBlock Text="DISPLAY"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <StackPanel Margin="0,0,0,18">
                    <Grid Style="{StaticResource CraneDisplayRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Swing Radius"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource CraneDisplayCheckBox}"
                                  IsChecked="{Binding ShowSwingRadius, Mode=TwoWay}"/>
                    </Grid>
                    <Grid Style="{StaticResource CraneDisplayRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Dimension Guide"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource CraneDisplayCheckBox}"
                                  IsChecked="{Binding ShowDimensionGuide, Mode=TwoWay}"
                                  ToolTip="Show transport dimensions and operating footprint"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Style>
                            <Style BasedOn="{StaticResource CraneDisplayRow}" TargetType="Grid">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Grid.Column="0"
                                   Text="Outrigger Pads"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource CraneDisplayCheckBox}"
                                  IsChecked="{Binding ShowOutriggerPads, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
