<UserControl x:Class="CraneOptimizer.UI.Features.F3_CraneSetup.Views.CraneManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>
        <!-- Keep the dense engineering panel on one local, uniform type size. -->
        <sys:Double x:Key="CranePanelTextSize">12</sys:Double>

        <!-- Shared Inspector styles are locked to the compact global FontSizeXS,
             so they are re-based to the panel size here rather than globally. -->
        <Style x:Key="InspectorPropertyLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource InspectorPropertyLabelStyle}">
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}" />
        </Style>

        <Style x:Key="InspectorPropertyValueStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource InspectorPropertyValueStyle}">
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}" />
        </Style>

        <Style x:Key="InspectorNumericTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource InspectorNumericTextBoxStyle}">
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}" />
        </Style>

        <Style x:Key="InspectorSelectedItemTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource InspectorSelectedItemTitleStyle}">
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="CraneSummaryBorder"
               TargetType="Border"
               BasedOn="{StaticResource InspectorSummaryBorderStyle}">
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="CraneSummaryLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource InspectorPropertyLabelStyle}">
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="CraneSummaryValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource InspectorPropertyValueStyle}">
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="CraneNumericTextBox"
               BasedOn="{StaticResource InspectorNumericTextBoxStyle}"
               TargetType="TextBox"/>

        <Style x:Key="CraneSliderValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Section heading: orange accent bar + label, matching the rest of the app. -->
        <Style x:Key="CraneSectionHeading" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,20,0,10"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="13"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource PrimaryBrush}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CraneSliderLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CraneAxisLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CraneDatabaseComboBox"
               BasedOn="{StaticResource DarkComboBox}"
               TargetType="ComboBox">
            <Setter Property="Height" Value="{StaticResource InputHeight}"/>
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}"/>
        </Style>

        <Style x:Key="CraneDatabaseComboBoxItem"
               BasedOn="{StaticResource DarkComboBoxItem}"
               TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}"/>
        </Style>

        <Style x:Key="CraneDisplayRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CraneDisplayCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource CranePanelTextSize}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Data="M 2 8 L 6 12 L 14 4"
                                  Stroke="{StaticResource PrimaryBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid TextElement.FontSize="{StaticResource CranePanelTextSize}">
        <!-- ── NO CRANE PLACEHOLDER ──────────────────────────────────── -->
        <Border Margin="20" VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveCrane}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <Viewbox Width="30"
                         Height="30"
                         HorizontalAlignment="Center"
                         Stretch="Uniform">
                    <Path Data="M 3,21 H 21 M 7,21 V 4 M 7,4 H 20 M 10,7 L 17,4 M 18,4 V 14 M 16,16 C 16,18 20,18 20,16 M 5,8 H 9"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.5" />
                </Viewbox>
                <TextBlock Text="No crane placed"
                           FontSize="{StaticResource CranePanelTextSize}" FontWeight="Normal"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="Click Mobile Crane to place"
                           FontSize="{StaticResource CranePanelTextSize}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── PROPERTIES PANEL ──────────────────────────────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style BasedOn="{StaticResource SharedScrollViewerStyle}" TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveCrane}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <Border Padding="14,10,14,18">
                <StackPanel DataContext="{Binding ActiveParams}">

                <!--  First heading: no top margin, it sits against the panel padding  -->
                <ContentControl Margin="0,0,0,10"
                                Style="{StaticResource CraneSectionHeading}"
                                Content="Database Crane"/>
                <ComboBox Margin="0,0,0,10"
                          ItemsSource="{Binding DataContext.AvailableCranes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding DataContext.SelectedDatabaseCrane, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                          Style="{StaticResource CraneDatabaseComboBox}"
                          ItemContainerStyle="{StaticResource CraneDatabaseComboBoxItem}"
                          TextSearch.TextPath="Name">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding Name}">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{StaticResource CranePanelTextSize}"
                                           FontWeight="Normal"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Manufacturer}"
                                               FontSize="{StaticResource CranePanelTextSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="  |  "
                                               FontSize="{StaticResource CranePanelTextSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CraneType}"
                                               FontSize="{StaticResource CranePanelTextSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ContentControl Style="{StaticResource CraneSectionHeading}"
                                Content="Crane Overview"/>
                <Border Margin="0,0,0,12" Style="{StaticResource CraneSummaryBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="22"/>
                            <RowDefinition MinHeight="22"/>
                            <RowDefinition MinHeight="22"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource CraneSummaryLabel}"
                                   Text="Carrier"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource CraneSummaryValue}">
                            <Run Text="{Binding CarrierLength, Converter={StaticResource LengthDisplayConverter}}"/>
                            <Run Text=" &#x00D7; "/>
                            <Run Text="{Binding CarrierWidth, Converter={StaticResource LengthDisplayConverter}}"/>
                            <Run Text=" &#x00D7; "/>
                            <Run Text="{Binding CarrierHeight, Converter={StaticResource LengthDisplayConverter}}"/>
                        </TextBlock>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource CraneSummaryLabel}"
                                       Text="Outrigger"/>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource CraneSummaryValue}">
                                <Run Text="{Binding OutriggerSpanM, Converter={StaticResource LengthDisplayConverter}}"/>
                                <Run Text=" &#x00D7; "/>
                                <Run Text="{Binding SpanToSpanM, Converter={StaticResource LengthDisplayConverter}}"/>
                            </TextBlock>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource CraneSummaryLabel}"
                                   Text="Boom"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource CraneSummaryValue}">
                            <Run Text="{Binding MinBoomLength, Converter={StaticResource LengthDisplayConverter}}"/>
                            <Run Text=" &#x2013; "/>
                            <Run Text="{Binding MaxBoomLength, Converter={StaticResource LengthDisplayConverter}}"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ── Z POSITION + SET XYZ ─────────────────────────── -->
                <ContentControl Style="{StaticResource CraneSectionHeading}" Content="Position"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="X" Style="{StaticResource CraneAxisLabel}"/>
                        <TextBox Grid.Row="1"
                                 Style="{StaticResource CraneNumericTextBox}"
                                 Text="{Binding PositionX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource LengthDisplayConverter}}"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Y" Style="{StaticResource CraneAxisLabel}"/>
                        <TextBox Grid.Row="1"
                                 Style="{StaticResource CraneNumericTextBox}"
                                 Text="{Binding PositionY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource LengthDisplayConverter}}"/>
                    </Grid>
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Z" Style="{StaticResource CraneAxisLabel}"/>
                        <TextBox Grid.Row="1"
                                 Style="{StaticResource CraneNumericTextBox}"
                                 Text="{Binding PositionZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource LengthDisplayConverter}}"/>
                    </Grid>
                </Grid>

                <!-- ── SLEW ANGLE ───────────────────────────────────── -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource CraneSliderLabel}"
                               Text="Slew Angle"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding SlewAngle, StringFormat={}{0:F0}&#x00B0;}"
                               Style="{StaticResource CraneSliderValue}"/>
                    <Slider Grid.Row="1" Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            Minimum="0" Maximum="360"
                            Value="{Binding SlewAngle, Mode=TwoWay}"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            IsMoveToPointEnabled="True"
                            SmallChange="1" LargeChange="10"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- ── CABLE LENGTH ─────────────────────────────────── -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource CraneSliderLabel}"
                               Text="Cable Length"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding CableLength, Converter={StaticResource LengthDisplayConverter}}"
                               Style="{StaticResource CraneSliderValue}"/>
                    <Slider Grid.Row="1" Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            Minimum="1" Maximum="80"
                            Value="{Binding CableLength, Mode=TwoWay}"
                            IsSnapToTickEnabled="True" TickFrequency="0.1"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.1" LargeChange="1"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- ── LOAD CHART ───────────────────────────────────── -->
                <ContentControl Style="{StaticResource CraneSectionHeading}" Content="Load Chart"/>

                <!-- Chart summary -->
                <Border Style="{StaticResource CraneSummaryBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="22"/>
                            <RowDefinition MinHeight="22"/>
                            <RowDefinition MinHeight="22"/>
                            <RowDefinition MinHeight="22"/>
                            <RowDefinition MinHeight="22"/>
                        </Grid.RowDefinitions>
                        <!-- Maximum capacity -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource CraneSummaryLabel}"
                                   Text="Maximum Capacity"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding MaxCapacity, Converter={StaticResource MassDisplayConverter}}"
                                   Style="{StaticResource CraneSummaryValue}"/>
                        <!-- Radius range -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Radius Range"
                                   Style="{StaticResource CraneSummaryLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource CraneSummaryValue}">
                            <Run Text="{Binding MinReach, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                            <Run Text=" &#x2013; "/>
                            <Run Text="{Binding MaxReach, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- Boom range -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Boom Range"
                                   Style="{StaticResource CraneSummaryLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource CraneSummaryValue}">
                            <Run Text="{Binding MinBoomLength, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                            <Run Text=" &#x2013; "/>
                            <Run Text="{Binding MaxBoomLength, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- Outrigger -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Operating Mode"
                                   Style="{StaticResource CraneSummaryLabel}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource CraneSummaryValue}" TargetType="TextBlock">
                                    <Setter Property="Text" Value="Outriggers"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                            <Setter Property="Text" Value="On Rubber"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Derating -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Derating"
                                   Style="{StaticResource CraneSummaryLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="100%"
                                   Style="{StaticResource CraneSummaryValue}"/>
                    </Grid>
                </Border>

                <!-- ── BOOM LENGTH ──────────────────────────────────── -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource CraneSliderLabel}"
                               Text="Boom Length"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding BoomLength, Converter={StaticResource LengthDisplayConverter}}"
                               Style="{StaticResource CraneSliderValue}"/>
                    <Slider Grid.Row="1" Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            Minimum="{Binding MinBoomLength}"
                            Maximum="{Binding MaxBoomLength}"
                            Value="{Binding BoomLength, Mode=TwoWay}"
                            IsSnapToTickEnabled="True" TickFrequency="0.1"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.1" LargeChange="1"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- ── WORKING RADIUS ──────────────────────────────── -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource CraneSliderLabel}"
                               Text="Working Radius"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding WorkingRadius, Converter={StaticResource LengthDisplayConverter}}"
                               Style="{StaticResource CraneSliderValue}"/>
                    <Slider Grid.Row="1" Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            Minimum="{Binding MinReach}"
                            Maximum="{Binding MaxReach}"
                            Value="{Binding WorkingRadius, Mode=TwoWay}"
                            IsSnapToTickEnabled="True" TickFrequency="0.1"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.1" LargeChange="1"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- ── BOOM ANGLE — angle between the working radius and the boom ── -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource CraneSliderLabel}"
                               Text="Boom Angle"
                               ToolTip="Angle between the working radius (horizontal) and the boom. Working radius = boom length × cos(boom angle)."/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding BoomAngle, StringFormat={}{0:F0}&#x00B0;}"
                               Style="{StaticResource CraneSliderValue}"/>
                    <Slider Grid.Row="1" Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            Minimum="0" Maximum="85"
                            Value="{Binding BoomAngle, Mode=TwoWay}"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            IsMoveToPointEnabled="True"
                            SmallChange="1" LargeChange="10"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- ── DISPLAY TOGGLES ─────────────────────────────── -->
                <ContentControl Style="{StaticResource CraneSectionHeading}" Content="Display"/>
                <StackPanel>
                    <Grid Style="{StaticResource CraneDisplayRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Swing Radius"
                                   FontSize="{StaticResource CranePanelTextSize}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource CraneDisplayCheckBox}"
                                  IsChecked="{Binding ShowSwingRadius, Mode=TwoWay}"/>
                    </Grid>
                    <Grid Style="{StaticResource CraneDisplayRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Dimension Guide"
                                   FontSize="{StaticResource CranePanelTextSize}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource CraneDisplayCheckBox}"
                                  IsChecked="{Binding ShowDimensionGuide, Mode=TwoWay}"
                                  ToolTip="Show transport dimensions and operating footprint"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Style>
                            <Style BasedOn="{StaticResource CraneDisplayRow}" TargetType="Grid">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Grid.Column="0"
                                   Text="Outrigger Pads"
                                   FontSize="{StaticResource CranePanelTextSize}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource CraneDisplayCheckBox}"
                                  IsChecked="{Binding ShowOutriggerPads, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
