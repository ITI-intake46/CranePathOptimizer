<UserControl x:Class="CraneOptimizer.UI.Features.F3_CraneSetup.Views.CraneManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BackgroundBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&lt;"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <TextBlock Text="Mobile Crane 1"
                               FontSize="{StaticResource FontSizeSM}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ToolbarButton}"
                        Padding="6,2"
                        Command="{Binding RemoveSelectedCraneCommand}"
                        ToolTip="Remove crane">
                    <TextBlock Text="✕" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── NO CRANE PLACEHOLDER ──────────────────────────────────── -->
        <Border Grid.Row="1" Margin="20" VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveCrane}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🏗" FontSize="36" HorizontalAlignment="Center"/>
                <TextBlock Text="No crane placed"
                           FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="Click MOBILE CRANE to place"
                           FontSize="{StaticResource FontSizeXS}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── PROPERTIES PANEL ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveCrane}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="12,10,12,20" DataContext="{Binding ActiveParams}">

                <TextBlock Text="DATABASE CRANE"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <ComboBox Margin="0,0,0,10"
                          ItemsSource="{Binding DataContext.AvailableCranes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding DataContext.SelectedDatabaseCrane, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          TextSearch.TextPath="Name">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{StaticResource FontSizeSM}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Manufacturer}"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="  |  "
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CraneType}"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Border Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="4" Padding="10,8" Margin="0,0,0,16"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold">
                            <Run Text="Carrier "/>
                            <Run Text="{Binding CarrierLength, Converter={StaticResource LengthDisplayConverter}}"/>
                            <Run Text=" x "/>
                            <Run Text="{Binding CarrierWidth, Converter={StaticResource LengthDisplayConverter}}"/>
                            <Run Text=" x "/>
                            <Run Text="{Binding CarrierHeight, Converter={StaticResource LengthDisplayConverter}}"/>
                        </TextBlock>
                        <TextBlock FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Outrigger "/>
                            <Run Text="{Binding OutriggerSpanM, Converter={StaticResource LengthDisplayConverter}}"/>
                            <Run Text=" x "/>
                            <Run Text="{Binding SpanToSpanM, Converter={StaticResource LengthDisplayConverter}}"/>
                        </TextBlock>
                        <TextBlock FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold">
                            <Run Text="Boom "/>
                            <Run Text="{Binding MinBoomLength, Converter={StaticResource LengthDisplayConverter}}"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding MaxBoomLength, Converter={StaticResource LengthDisplayConverter}}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ── Z POSITION + SET XYZ ─────────────────────────── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X" FontWeight="Bold"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Margin="0,0,8,0"
                             Text="{Binding PositionX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource LengthDisplayConverter}}"/>
                    <TextBlock Grid.Column="2" Text="Y" FontWeight="Bold"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="3"
                             Margin="0,0,8,0"
                             Text="{Binding PositionY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource LengthDisplayConverter}}"/>
                    <TextBlock Grid.Column="4" Text="Z" FontWeight="Bold"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="5"
                             Text="{Binding PositionZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource LengthDisplayConverter}}"/>
                </Grid>

                <!-- ── BODY ANGLE ───────────────────────────────────── -->
                <TextBlock Text="BODY ANGLE"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="0" Maximum="360"
                            Value="{Binding BodyAngle, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBox x:Name="BodyAngleTextBox"
                                 Width="52"
                                 TextAlignment="Center"
                                 Text="{Binding BodyAngle, Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus,
                                        StringFormat={}{0:F0}}"
                                 KeyDown="BodyAngleTextBox_KeyDown"/>
                        <TextBlock Text="°"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ── SLEW ANGLE ───────────────────────────────────── -->
                <TextBlock Text="SLEW ANGLE"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="0" Maximum="360"
                            Value="{Binding SlewAngle, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SlewAngle, StringFormat={}{0:F0}°}"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- ── CABLE LENGTH ─────────────────────────────────── -->
                <TextBlock Text="CABLE LENGTH"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="1" Maximum="80"
                            Value="{Binding CableLength, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CableLength, Converter={StaticResource LengthDisplayConverter}}"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- ── LOAD CHART ───────────────────────────────────── -->
                <TextBlock Text="LOAD CHART"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>

                <!-- Chart info card -->
                <Border Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="4" Padding="10,8" Margin="0,0,0,4"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!-- Max Cap -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Cap."
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding MaxCapacity, Converter={StaticResource MassDisplayConverter}}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,1"/>
                        <!-- Radius range -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Radius"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,1">
                            <Run Text="{Binding MinReach, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                            <Run Text=" – "/>
                            <Run Text="{Binding MaxReach, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- Boom range -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Boom"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,1">
                            <Run Text="{Binding MinBoomLength, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                            <Run Text=" – "/>
                            <Run Text="{Binding MaxBoomLength, Converter={StaticResource LengthDisplayConverter}, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- Outrigger -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Operating"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Outriggers"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                            <Setter Property="Text" Value="On Rubber"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Derating -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Derating"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="100%"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,1"/>
                    </Grid>
                </Border>

                <!-- Swap outrigger button -->
                <Border Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="4" Padding="8,6" Margin="0,4,0,16"
                        Cursor="Hand" HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Swap Outrigger W / L"
                               FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <!-- ── BOOM LENGTH ──────────────────────────────────── -->
                <TextBlock Text="BOOM LENGTH"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="{Binding MinBoomLength}"
                            Maximum="{Binding MaxBoomLength}"
                            Value="{Binding BoomLength, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding BoomLength, Converter={StaticResource LengthDisplayConverter}}"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- ── WORKING RADIUS ──────────────────────────────── -->
                <TextBlock Text="WORKING RADIUS"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="{Binding MinReach}"
                            Maximum="{Binding MaxReach}"
                            Value="{Binding WorkingRadius, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding WorkingRadius, Converter={StaticResource LengthDisplayConverter}}"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- ── EXCLUSION RADIUS ────────────────────────────── -->
                <TextBlock Text="EXCLUSION RADIUS"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="0" Maximum="20"
                            Value="{Binding ExclusionRadiusM, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ExclusionRadiusM, Converter={StaticResource LengthDisplayConverter}}"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- ── OUTRIGGER SPAN ──────────────────────────────── -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="OUTRIGGER SPAN"
                               FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="3" Maximum="20"
                                Value="{Binding OutriggerSpanM, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding OutriggerSpanM, Converter={StaticResource LengthDisplayConverter}}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- ── DISPLAY TOGGLES ─────────────────────────────── -->
                <TextBlock Text="DISPLAY"
                           FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Swing Radius"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <CheckBox HorizontalAlignment="Right"
                              IsChecked="{Binding ShowSwingRadius, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Dimension Guide"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <CheckBox HorizontalAlignment="Right"
                              IsChecked="{Binding ShowDimensionGuide, Mode=TwoWay}"
                              ToolTip="Show transport dimensions and operating footprint"
                              VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnRubber}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="Outrigger Pads"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <CheckBox HorizontalAlignment="Right"
                              IsChecked="{Binding ShowOutriggerPads, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
