<UserControl
    x:Class="CraneOptimizer.UI.Features.F3_CraneSetup.Views.CranesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0" Orientation="Horizontal">

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="ADD CRANE">
                <Grid>
                    <Button
                        x:Name="BtnAddMobileCrane"
                        Command="{Binding AddMobileCraneCommand}"
                        ContentTemplate="{x:Null}"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorCommandTile}"
                        ToolTip="Place a mobile crane in the scene">
                        <Button.Tag>
                            <TextBlock
                                FontSize="26"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="🚚" />
                        </Button.Tag>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="MOBILE" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Margin="0,2,0,0"
                                FontSize="9"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="CRANE" />
                        </StackPanel>
                    </Button>
                </Grid>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="MANAGE">
                <UniformGrid Rows="1">
                    <Button
                        Command="{Binding RemoveSelectedCraneCommand}"
                        Content="Remove Selected Crane"
                        Style="{StaticResource RibbonMajorCommandTile}"
                        ToolTip="Remove Selected Crane">
                        <Button.Tag>
                            <TextBlock Foreground="{StaticResource DestructiveBrush}" Text="✖" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding RemoveAllCranesCommand}"
                        Content="Remove All Cranes"
                        Style="{StaticResource RibbonMajorCommandTile}"
                        ToolTip="Remove All Cranes">
                        <Button.Tag>
                            <TextBlock Text="🗑" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding CraneSetup.UnlockPositionCommand}"
                        Content="Unlock Position"
                        IsEnabled="{Binding CraneSetup.IsPositionLocked}"
                        Style="{StaticResource RibbonMajorCommandTile}"
                        ToolTip="Unlock Position">
                        <Button.Tag>
                            <TextBlock Text="🔓" />
                        </Button.Tag>
                    </Button>
                    <ToggleButton
                        Content="Show Swing Radius"
                        IsChecked="{Binding ShowCraneRadius}"
                        Style="{StaticResource RibbonMajorToggleTile}"
                        ToolTip="Show Swing Radius">
                        <ToggleButton.Tag>
                            <Ellipse
                                Width="8"
                                Height="8"
                                Stroke="{StaticResource PrimaryBrush}"
                                StrokeThickness="1.5" />
                        </ToggleButton.Tag>
                    </ToggleButton>
                </UniformGrid>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="OPTIMIZE">
                <Button Command="{Binding OptimizeCommand}" ContentTemplate="{x:Null}" FontSize="{StaticResource FontSizeXS}" Style="{StaticResource RibbonMajorCommandTile}">
                    <Button.Tag>
                        <TextBlock FontSize="26" Foreground="{StaticResource PrimaryBrush}" Text="⚡" />
                    </Button.Tag>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="Run" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Margin="0,2,0,0"
                            FontSize="9"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Optimizer" />
                    </StackPanel>
                </Button>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="LOAD CHART">
                <UniformGrid Rows="1">
                    <Button Click="ImportLoadChart_Click" Content="Import Load Chart..." Style="{StaticResource RibbonMajorCommandTile}" ToolTip="Import Load Chart..." />
                    <Button Click="ViewSavedCharts_Click" Content="View Saved Charts" Style="{StaticResource RibbonMajorCommandTile}" ToolTip="View Saved Charts" />
                    <Button Click="CraneCatalog_Click" Content="Crane Catalog..." Style="{StaticResource RibbonMajorCommandTile}" ToolTip="Crane Catalog..." />
                </UniformGrid>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
