<UserControl x:Class="CraneOptimizer.UI.Features.F3_CraneSetup.Views.CranesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">

        <StackPanel Orientation="Horizontal" Margin="6,0">

            <Border Padding="8,6,8,0">
                <DockPanel Width="90">
                    <TextBlock DockPanel.Dock="Bottom" Text="ADD CRANE" Style="{StaticResource GroupLabel}"/>
                    <StackPanel Orientation="Horizontal">

                        <!--
                            The button is wrapped in a Grid so the Popup can reference
                            it by x:Name as its PlacementTarget. A plain StackPanel child
                            cannot serve as a PlacementTarget reliably in WPF.
                        -->
                        <Grid>

                            <!--
                                Single click → AddMobileCraneCommand
                                If elements are loaded: crane is auto-positioned beside the model.
                                If no elements loaded: enters click-to-place mode.
                                CanExecute = Cranes list is non-empty (auto-selected on load).
                            -->
                            <Button x:Name="BtnAddMobileCrane"
                                    Style="{StaticResource RibbonLargeBtn}"
                                    Width="70"
                                    ToolTip="Place a mobile crane in the scene"
                                    Command="{Binding AddMobileCraneCommand}">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="🚚"
                                               FontSize="26"
                                               Margin="0,6,0,4"
                                               Foreground="{StaticResource PrimaryBrush}"/>

                                    <TextBlock Text="MOBILE"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Margin="0,0,0,1"
                                               Foreground="{StaticResource PrimaryBrush}"/>

                                    <TextBlock Text="CRANE"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                                </StackPanel>
                            </Button>

                        </Grid>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0"/>

            <Border Padding="8,6,8,0">
                <DockPanel Width="180">
                    <TextBlock DockPanel.Dock="Bottom" Text="MANAGE" Style="{StaticResource GroupLabel}"/>
                    <StackPanel Margin="0,2,0,0">
                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165"
                                Margin="0,0,0,3"
                                Command="{Binding RemoveSelectedCraneCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✖" Margin="0,0,6,0" Foreground="{StaticResource DestructiveBrush}"/>
                                <TextBlock Text="Remove Selected Crane"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165"
                                Margin="0,0,0,4"
                                Command="{Binding RemoveAllCranesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" Margin="0,0,6,0"/>
                                <TextBlock Text="Remove All Cranes"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165"
                                Margin="0,0,0,3"
                                Command="{Binding CraneSetup.UnlockPositionCommand}"
                                IsEnabled="{Binding CraneSetup.IsPositionLocked}">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔓" Margin="0,0,6,0"/>
                                <TextBlock Text="Unlock Position"/>
                            </StackPanel>
                        </Button>

                        <ToggleButton Style="{StaticResource RibbonToggleBtn}"
                                      Width="165"
                                      Margin="0,0,0,3"
                                      Padding="6,2"
                                      IsChecked="{Binding ShowCraneRadius}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.5" Margin="0,0,6,0"/>
                                <TextBlock Text="Show Swing Radius"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0"/>

            <Border Padding="8,6,8,0">
                <DockPanel Width="100">
                    <TextBlock DockPanel.Dock="Bottom" Text="OPTIMIZE" Style="{StaticResource GroupLabel}"/>
                    <Button Style="{StaticResource RibbonLargeBtn}" Width="80" Command="{Binding OptimizeCommand}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="26" Margin="0,6,0,4" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Run" FontSize="9" FontWeight="Bold" Margin="0,0,0,1" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Optimizer" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0"/>

            <!-- ── LOAD CHART ───────────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="180">

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="LOAD CHART"
                               Style="{StaticResource GroupLabel}"/>

                    <StackPanel Margin="0,2,0,0">

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165"
                                Margin="0,0,0,3"
                                Click="ImportLoadChart_Click">
                            <TextBlock Text="Import Load Chart..."/>
                        </Button>

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165"
                                Margin="0,0,0,3"
                                Click="ViewSavedCharts_Click">
                            <TextBlock Text="View Saved Charts"/>
                        </Button>

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165"
                                Click="CraneCatalog_Click">
                            <TextBlock Text="Crane Catalog..."/>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
