<UserControl x:Class="CraneOptimizer.UI.Features.F3_CraneSetup.Views.CranesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">

        <StackPanel Orientation="Horizontal" Margin="6,0">

            <!-- ── ADD CRANE ───────────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="90">

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="ADD CRANE"
                               Style="{StaticResource GroupLabel}"/>

                    <StackPanel Orientation="Horizontal">

                        <!-- Mobile ONLY -->
                        <Button Style="{StaticResource RibbonLargeBtn}"
                                Width="70"
                                ToolTip="Place Mobile Crane"
                                Command="{Binding StartCranePlacementCommand}">

                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="🚚"
                                           FontSize="26"
                                           Margin="0,6,0,4"
                                           Foreground="{StaticResource PrimaryBrush}"/>

                                <TextBlock Text="MOBILE"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="0,0,0,1"
                                           Foreground="{StaticResource PrimaryBrush}"/>

                                <TextBlock Text="CRANE"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0"/>

            <!-- ── MANAGE ───────────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="180">

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="MANAGE"
                               Style="{StaticResource GroupLabel}"/>

                    <StackPanel Margin="0,2,0,0">

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165"
                                Margin="0,0,0,3">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✖"
                                           Margin="0,0,6,0"
                                           Foreground="{StaticResource DestructiveBrush}"/>
                                <TextBlock Text="Remove Selected Crane"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165"
                                Margin="0,0,0,4">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" Margin="0,0,6,0"/>
                                <TextBlock Text="Remove All Cranes"/>
                            </StackPanel>
                        </Button>

                        <ToggleButton Style="{StaticResource RibbonToggleBtn}"
                                      Width="165"
                                      Margin="0,0,0,3"
                                      Padding="6,2">

                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8"
                                         Stroke="{StaticResource PrimaryBrush}"
                                         StrokeThickness="1.5"
                                         Margin="0,0,6,0"/>
                                <TextBlock Text="Show Swing Radius"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton Style="{StaticResource RibbonToggleBtn}"
                                      Width="165"
                                      Padding="6,2">

                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8"
                                         Stroke="{StaticResource PrimaryBrush}"
                                         StrokeThickness="1.5"
                                         Margin="0,0,6,0"/>
                                <TextBlock Text="Show Capacity Rings"/>
                            </StackPanel>
                        </ToggleButton>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0"/>

            <!-- ── OPTIMIZE ───────────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="100">

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="OPTIMIZE"
                               Style="{StaticResource GroupLabel}"/>

                    <Button Style="{StaticResource RibbonLargeBtn}"
                            Width="80"
                            Command="{Binding OptimizeCommand}">

                        <StackPanel HorizontalAlignment="Center">

                            <TextBlock Text="⚡"
                                       FontSize="26"
                                       Margin="0,6,0,4"
                                       Foreground="{StaticResource PrimaryBrush}"/>

                            <TextBlock Text="Run"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Margin="0,0,0,1"
                                       Foreground="{StaticResource PrimaryBrush}"/>

                            <TextBlock Text="Optimizer"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                        </StackPanel>

                    </Button>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0"/>

            <!-- ── LOAD CHART ───────────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="180">

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="LOAD CHART"
                               Style="{StaticResource GroupLabel}"/>

                    <StackPanel Margin="0,2,0,0">

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165"
                                Margin="0,0,0,3">
                            <TextBlock Text="Import Load Chart..."/>
                        </Button>

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165"
                                Margin="0,0,0,3">
                            <TextBlock Text="View Saved Charts"/>
                        </Button>

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="165">
                            <TextBlock Text="Crane Catalog..."/>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── PLACEMENT ───────────────────────── -->
            <Border Padding="8,6,8,0" Visibility="{Binding CranePlacement.IsPlacing, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel Width="120">

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="PLACEMENT"
                               Style="{StaticResource GroupLabel}"/>

                    <StackPanel Margin="0,2,0,0">

                        <TextBlock Text="Optimized Points:" 
                                   FontSize="9" 
                                   Margin="4,0,0,2"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding CranePlacement.CandidatePoints.Count, Converter={StaticResource IntToVisibilityConverter}}"/>
                        
                        <ComboBox ItemsSource="{Binding CranePlacement.CandidatePoints}"
                                  SelectedItem="{Binding CranePlacement.SelectedPoint, Mode=TwoWay}"
                                  Margin="0,0,0,6"
                                  Height="22"
                                  Width="110"
                                  FontSize="10"
                                  Visibility="{Binding CranePlacement.CandidatePoints.Count, Converter={StaticResource IntToVisibilityConverter}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='({0:F0}, {1:F0})'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="110"
                                Margin="0,0,0,3"
                                Command="{Binding CranePlacement.ConfirmPlacementCommand}">
                            <TextBlock Text="Confirm Placement"/>
                        </Button>

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="110"
                                Command="{Binding CranePlacement.CancelPlacementCommand}">
                            <TextBlock Text="Cancel"/>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>