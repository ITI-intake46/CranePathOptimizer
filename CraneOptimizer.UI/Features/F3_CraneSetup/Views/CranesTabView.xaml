<UserControl
    x:Class="CraneOptimizer.UI.Features.F3_CraneSetup.Views.CranesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0" Orientation="Horizontal">

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="ADD CRANE">
                <Grid>
                    <Button
                        x:Name="BtnAddMobileCrane"
                        Command="{Binding AddMobileCraneCommand}"
                        ContentTemplate="{x:Null}"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorCommandTile}"
                        ToolTip="Place a mobile crane in the scene">
                        <Button.Tag>
                            <TextBlock
                                FontSize="26"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="🚚" />
                        </Button.Tag>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="MOBILE" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="CRANE" />
                        </StackPanel>
                    </Button>
                </Grid>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="MANAGE">
                <Button
                    AutomationProperties.Name="Remove selected crane"
                    Command="{Binding RemoveSelectedCraneCommand}"
                    Content="Remove Selected Crane"
                    Style="{StaticResource RibbonMajorCommandTile}"
                    ToolTip="Removes the selected crane from the scene. Select a crane first. This action cannot be undone."
                    ToolTipService.ShowOnDisabled="True"
                    Width="{StaticResource RibbonMajorLongCommandWidth}">
                    <Button.Tag>
                        <Grid Width="24" Height="24">
                            <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                  Stroke="{StaticResource DestructiveBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.8" />
                        </Grid>
                    </Button.Tag>
                </Button>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="LOAD CHART">
                <StackPanel Orientation="Horizontal">
                    <Button Click="ImportLoadChart_Click" Content="Import Load Chart" Style="{StaticResource RibbonMajorLeadingCommandTile}" ToolTip="Import Load Chart">
                        <Button.Tag>
                            <Path
                                Data="M3,7 H9 L11,10 H21 V20 H3 Z M12,3 V14 M8,10 L12,14 L16,10"
                                Fill="Transparent"
                                Stroke="{DynamicResource TextSecondaryBrush}"
                                StrokeLineJoin="Round"
                                StrokeThickness="1.5" />
                        </Button.Tag>
                    </Button>
                    <Button Click="ViewSavedCharts_Click" Content="View Saved Charts" Style="{StaticResource RibbonMajorMiddleCommandTile}" ToolTip="View Saved Charts">
                        <Button.Tag>
                            <Path
                                Data="M4,2 H14 L20,8 V22 H4 Z M14,2 V8 H20 M8,18 V14 M12,18 V11 M16,18 V9"
                                Fill="Transparent"
                                Stroke="{DynamicResource TextSecondaryBrush}"
                                StrokeLineJoin="Round"
                                StrokeThickness="1.5" />
                        </Button.Tag>
                    </Button>
                    <Button Click="CraneCatalog_Click" Content="Crane Catalog" Style="{StaticResource RibbonMajorTrailingCommandTile}" ToolTip="Crane Catalog">
                        <Button.Tag>
                            <Path
                                Data="M3,4 C7,3 10,4 12,6 V21 C10,19 7,18 3,19 Z M21,4 C17,3 14,4 12,6 V21 C14,19 17,18 21,19 Z"
                                Fill="Transparent"
                                Stroke="{DynamicResource TextSecondaryBrush}"
                                StrokeLineJoin="Round"
                                StrokeThickness="1.5" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
