<Window
    x:Class="CraneOptimizer.UI.Features.F9_Settings.Views.UnitsSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Units Settings"
    Width="480"
    Height="420"
    Background="{DynamicResource BackgroundBrush}"
    FontFamily="{StaticResource FontPrimary}"
    FontSize="13"
    Foreground="{DynamicResource TextSecondaryBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="UnitSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="UnitRowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="130" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="HRule" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title  -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                FontSize="20"
                Text="📐" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="Units Settings" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Margin="0,6,0,0"
            FontSize="11"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="Changes apply immediately to all measurements, crane parameters, zone areas, and grid labels."
            TextWrapping="Wrap" />

        <Rectangle
            Grid.Row="2"
            Margin="0,14,0,0"
            Style="{StaticResource HRule}" />

        <!--  Settings  -->
        <StackPanel Grid.Row="3" Margin="0,4,0,0">

            <TextBlock Style="{StaticResource UnitSectionLabel}" Text="LENGTH" />
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource UnitRowLabel}" Text="Length unit:" />
                <ComboBox
                    x:Name="CboLength"
                    Width="280"
                    ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                    SelectionChanged="OnAnyComboChanged"
                    Style="{StaticResource DarkComboBox}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource UnitRowLabel}" Text="Area unit:" />
                <ComboBox
                    x:Name="CboArea"
                    Width="280"
                    ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                    SelectionChanged="OnAnyComboChanged"
                    Style="{StaticResource DarkComboBox}" />
            </StackPanel>

            <TextBlock Style="{StaticResource UnitSectionLabel}" Text="DISPLAY" />
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource UnitRowLabel}" Text="Decimal places:" />
                <ComboBox
                    x:Name="CboPrecision"
                    Width="120"
                    ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                    SelectionChanged="OnAnyComboChanged"
                    Style="{StaticResource DarkComboBox}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Style="{StaticResource UnitRowLabel}" Text="Display format:" />
                <ComboBox
                    x:Name="CboFormat"
                    Width="280"
                    ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                    SelectionChanged="OnAnyComboChanged"
                    Style="{StaticResource DarkComboBox}" />
            </StackPanel>

        </StackPanel>

        <!--  Live preview  -->
        <Border
            Grid.Row="4"
            Margin="0,8,0,16"
            Padding="12,10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="Preview: " />
                <TextBlock
                    x:Name="TxtPreview"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="14"
                    Foreground="{StaticResource SuccessBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextDisabledBrush}"
                    Text="   ·   " />
                <TextBlock
                    x:Name="TxtPreviewArea"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="14"
                    Foreground="{StaticResource WarningBrush}" />
            </StackPanel>
        </Border>

        <!--  Buttons  -->
        <StackPanel
            Grid.Row="5"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,10,0"
                Click="BtnCancel_Click"
                Content="Cancel"
                Style="{StaticResource ButtonSecondary}" />
            <Button
                x:Name="BtnSave"
                Width="120"
                Click="BtnSave_Click"
                Content="Save &amp; Apply"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</Window>
