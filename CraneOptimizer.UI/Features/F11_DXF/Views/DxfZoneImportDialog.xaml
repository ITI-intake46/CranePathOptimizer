<Window
    x:Class="CraneOptimizer.UI.Features.F11_DXF.Views.DxfZoneImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxfModels="clr-namespace:CraneOptimizer.UI.Features.F11_DXF.Models"
    Title="Draw Zones By Layer"
    Width="720"
    Height="430"
    MinWidth="640"
    MinHeight="360"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <Style x:Key="LayerChoiceButtonBase" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="AllowedLayerButton"
            BasedOn="{StaticResource LayerChoiceButtonBase}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <DataTrigger Binding="{Binding Assignment}" Value="{x:Static dxfModels:DxfLayerZoneAssignment.Allowed}">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ForbiddenLayerButton"
            BasedOn="{StaticResource LayerChoiceButtonBase}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DestructiveBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DestructiveBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <DataTrigger Binding="{Binding Assignment}" Value="{x:Static dxfModels:DxfLayerZoneAssignment.Forbidden}">
                    <Setter Property="Background" Value="{StaticResource DestructiveBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DestructiveBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LayerNameText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger
                    Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LayerDetailText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Value="True">
                    <Setter Property="Foreground" Value="#FFF2F2F2" />
                </DataTrigger>
                <DataTrigger
                    Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Value="True">
                    <Setter Property="Foreground" Value="#FFF2F2F2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontFamily="{StaticResource FontPrimary}"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="Draw zones by DXF layer" />

        <Border
            Grid.Row="1"
            Padding="8"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
            <ListBox
                ItemsSource="{Binding Layers}"
                SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="14"
                                Height="14"
                                Margin="0,8,8,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{Binding ColorBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2" />

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource LayerNameText}"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="12.5"
                                    Style="{StaticResource LayerDetailText}"
                                    Text="{Binding CountsText}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="12.5"
                                    Style="{StaticResource LayerDetailText}"
                                    Text="{Binding BusyText}" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                Command="{Binding DataContext.DrawAllowedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="Allowed"
                                Style="{StaticResource AllowedLayerButton}" />

                            <Button
                                Grid.Column="4"
                                Command="{Binding DataContext.DrawForbiddenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="Forbidden"
                                Style="{StaticResource ForbiddenLayerButton}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock
                DockPanel.Dock="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="12.5"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding StatusMessage}" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                      Width="186"
                      Margin="0,0,8,0"
                      FontSize="13.5"
                      Command="{Binding RemoveImportedZonesCommand}"
                      Content="Remove All Layer Zones"
                      Style="{StaticResource ButtonSecondary}" />
                <Button
                    Width="92"
                    FontSize="13.5"
                    Click="Close_Click"
                    Content="Close"
                    Style="{StaticResource ButtonSecondary}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
