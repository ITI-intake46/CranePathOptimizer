<Window x:Class="CraneOptimizer.UI.Features.F11_DXF.Views.DxfAlignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CraneOptimizer.UI.Core.Converters" xmlns:convdx="clr-namespace:CraneOptimizer.UI.Core.Converters.DXF"
        Title="DXF Alignment"
        Width="920" Height="660"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter"/>
        <convdx:NullToCollapsedConverter   x:Key="NullToCollapsedConverter"/>
        <convdx:HexStringToColorConverter  x:Key="HexStringToColorConverter"/>

        <Style x:Key="ThemedGroupBox" TargetType="GroupBox">
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="Padding"         Value="8,6,8,8"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="4,4,0,0"
                                    Padding="10,5,10,5">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextBlock.FontSize="11"
                                                  TextBlock.FontWeight="SemiBold"
                                                  TextBlock.Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,4,4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedTextBox" TargetType="TextBox">
            <Setter Property="Background"       Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"       Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="6,4"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="CaretBrush"       Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush"   Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused"    Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver"  Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed"   Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"   Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemedSlider"   TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Margin"     Value="0,4,0,4"/>
        </Style>

        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel"     TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,5,0,2"/>
        </Style>

        <Style x:Key="ValidationText" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource DestructiveBrush}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="📐" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="DXF Alignment" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Style="{StaticResource ChromeButton}" Content="—" FontSize="11"
                                Click="MinimizeButton_Click" ToolTip="Minimise"/>
                        <Button Style="{StaticResource CloseButton}"  Content="✕"
                                Click="CloseButton_Click"   ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}"/>

            <!-- Main content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="295"/>
                </Grid.ColumnDefinitions>

                <!-- Canvas preview -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True">
                    <Grid>
                        <Canvas x:Name="DxfCanvas" Background="Transparent" ClipToBounds="True"/>
                        <Border Background="#AA000000"
                                Visibility="{Binding IsDxfLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="⏳  Loading DXF…" Foreground="White" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding DxfFileName, Converter={StaticResource NullToCollapsedConverter}}">
                            <TextBlock Text="📂" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="No DXF loaded" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click 'Load DXF…' in the panel to begin."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="6,2" Margin="0,0,8,8">
                            <TextBlock Text="Scroll to zoom  ·  Drag to pan" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

                <!-- Controls panel -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource BackgroundBrush}" Padding="10,10,10,6">
                    <StackPanel>

                        <GroupBox Header="DXF FILE" Style="{StaticResource ThemedGroupBox}">
                            <StackPanel>
                                <Button Content="📂  Load DXF…" Command="{Binding LoadDxfCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding DxfFileName}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DxfInfo}" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="POINT MATCH" Style="{StaticResource ThemedGroupBox}">
                            <StackPanel>
                                <TextBlock Text="DXF reference point (world units):" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="X" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Column="1" Style="{StaticResource ThemedTextBox}" Text="{Binding DxfRefXText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="2" Text="Y" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Column="3" Style="{StaticResource ThemedTextBox}" Text="{Binding DxfRefYText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <TextBlock Text="IFC reference point (metres):" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="X" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Column="1" Style="{StaticResource ThemedTextBox}" Text="{Binding IfcRefXText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="2" Text="Y" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Column="3" Style="{StaticResource ThemedTextBox}" Text="{Binding IfcRefYText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Button Content="Apply Point Match" Command="{Binding ApplyPointMatchCommand}"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>
                                <TextBlock Style="{StaticResource ValidationText}" Text="{Binding ValidationError}"
                                           Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsedConverter}}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="MANUAL TRANSFORM" Style="{StaticResource ThemedGroupBox}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Offset X (m)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding OffsetXText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Offset Y (m)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding OffsetYText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Scale" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rotation (°, CW)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding RotationText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource ValidationText}" Text="{Binding ValidationError}"
                                           Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsedConverter}}"/>
                                <UniformGrid Columns="2" Rows="2" Margin="0,4,0,0">
                                    <Button Content="✔  Apply"    Style="{StaticResource PrimaryButton}"   Command="{Binding ApplyManualCommand}" Margin="0,0,3,3"/>
                                    <Button Content="⇱  Auto-Fit" Style="{StaticResource SecondaryButton}" Command="{Binding AutoFitCommand}"     Margin="3,0,0,3"/>
                                    <Button Content="↩  Undo"     Style="{StaticResource SecondaryButton}" Command="{Binding UndoCommand}"        Margin="0,3,3,0"/>
                                    <Button Content="⊗  Reset"    Style="{StaticResource SecondaryButton}" Command="{Binding ResetCommand}"       Margin="3,3,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="OVERLAY OPACITY" Style="{StaticResource ThemedGroupBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Style="{StaticResource ThemedSlider}"
                                        Minimum="0.1" Maximum="1.0" Value="{Binding Opacity}"
                                        VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Width="36" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="CURRENT TRANSFORM" Style="{StaticResource ThemedGroupBox}">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="3" Padding="8,6">
                                <TextBlock Text="{Binding TransformSummary}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </GroupBox>

                        <GroupBox Header="LAYERS" Style="{StaticResource ThemedGroupBox}"
                                  Visibility="{Binding Layers.Count, Converter={StaticResource NullToCollapsedConverter}}">
                            <ListBox ItemsSource="{Binding Layers}" MaxHeight="170"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="Padding"    Value="4,3"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected"  Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsVisible}" Style="{StaticResource ThemedCheckBox}" Margin="0,0,6,0"/>
                                            <Rectangle Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexStringToColorConverter}}"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EntityCount, StringFormat=' ({0})'}" FontSize="10"
                                                       Margin="2,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,6,6">
                <Grid Margin="12,7,12,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="●" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="✔  Apply"
                                Style="{StaticResource SecondaryButton}" Click="Apply_Click" Margin="0,0,6,0"
                                ToolTip="Apply the current transform and keep the dialog open"/>
                        <Button Content="✔  Apply &amp; Close" IsDefault="True"
                                Style="{StaticResource PrimaryButton}" Click="ApplyAndClose_Click" Margin="0,0,6,0"
                                ToolTip="Apply the current transform and close"/>
                        <Button Content="Close"
                                Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
