<Window x:Class="CraneOptimizer.UI.Features.F11_DXF.Views.DxfAlignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CraneOptimizer.UI.Core.Converters"
        xmlns:convdx="clr-namespace:CraneOptimizer.UI.Core.Converters.DXF"
        xmlns:behaviors="clr-namespace:CraneOptimizer.UI.Shared.Behaviors"
        Title="DXF Alignment"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
        Width="470" Height="880"
        MinWidth="430" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource SurfaceBrush}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter"/>
        <convdx:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>

        <!-- Section header spacing inside the scroll content (presentation only) -->
        <Style x:Key="DxfSectionHeader" TargetType="TextBlock"
               BasedOn="{StaticResource DialogSectionHeader}">
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <!-- Vertical rhythm between sections -->
        <Style x:Key="DxfSectionBlock" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Heading (native title bar supplies minimise / close) ─── -->
            <TextBlock Grid.Row="0"
                       Margin="16,14,16,10"
                       Text="DXF alignment"
                       Style="{StaticResource DialogWindowTitle}"/>

            <!-- ── Main controls panel ──────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          behaviors:SmoothScrollBehavior.IsEnabled="True"
                          Background="{DynamicResource SurfaceBrush}"
                          Padding="16,0,16,8">
                <StackPanel>

                    <!-- ── DXF FILE ─────────────────────────────────────── -->
                    <StackPanel Style="{StaticResource DxfSectionBlock}">
                        <TextBlock Text="DXF FILE" Style="{StaticResource DxfSectionHeader}"/>
                        <Border Style="{StaticResource DialogSectionBody}">
                            <StackPanel>
                                <Button Content="📂   Load DXF"
                                        Command="{Binding LoadDxfCommand}"
                                        Style="{StaticResource DialogButtonPrimaryLarge}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

                                <!-- Loading indicator -->
                                <TextBlock Text="⏳  Loading DXF…"
                                           Style="{StaticResource DialogCaption}"
                                           FontSize="{StaticResource FontSizeDialogBody}"
                                           Visibility="{Binding IsDxfLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding DxfFileName}"
                                           Style="{StaticResource DialogPrimaryLabel}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DxfFileName}"
                                           Visibility="{Binding DxfFileName, Converter={StaticResource NullToCollapsedConverter}}"/>
                                <TextBlock Text="{Binding DxfInfo}"
                                           Style="{StaticResource DialogCaption}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding DxfInfo, Converter={StaticResource NullToCollapsedConverter}}"/>

                                <CheckBox Content="Keep DXF text"
                                          IsChecked="{Binding KeepText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource DialogCheckBox}"
                                          Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── REFERENCE POINT ──────────────────────────────── -->
                    <StackPanel Style="{StaticResource DxfSectionBlock}">
                        <TextBlock Text="REFERENCE POINT" Style="{StaticResource DxfSectionHeader}"/>
                        <Border Style="{StaticResource DialogSectionBody}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="DXF unit"
                                               Style="{StaticResource DialogFieldLabel}"/>
                                    <Border Width="16"
                                            Height="16"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource TextSecondaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Border.ToolTip>
                                            <ToolTip MaxWidth="300">
                                                <TextBlock Text="Default uses the DXF file unit. Reference X/Y values are shown in the selected unit and convert when this unit changes. Scale multiplies after unit conversion."
                                                           TextWrapping="Wrap"/>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Text="i"
                                                   FontFamily="{StaticResource FontPrimary}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-1,0,0"/>
                                    </Border>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding DxfUnitOptions}"
                                          SelectedItem="{Binding SelectedDxfUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource DialogComboBox}"
                                          Margin="0,0,0,12"/>

                                <!-- DXF original reference -->
                                <CheckBox Content="Use DXF original reference point"
                                          IsChecked="{Binding UseDetectedDxfReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource DialogCheckBox}"
                                          Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding DxfOriginalReferenceSummary}"
                                           Style="{StaticResource DialogCaption}"
                                           Margin="26,0,0,3"/>
                                <TextBlock Text="{Binding DxfOriginalGeometryReferenceSummary}"
                                           Style="{StaticResource DialogCaption}"
                                           Margin="26,0,0,10"/>

                                <CheckBox Content="Use custom DXF reference point"
                                          IsChecked="{Binding UseCustomDxfReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource DialogCheckBox}"
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="Reference point"
                                           Style="{StaticResource DialogFieldLabel}"
                                           Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding DxfReferenceAnchorOptions}"
                                          SelectedItem="{Binding SelectedDxfReferenceAnchor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsCustomDxfReferenceEnabled}"
                                          Style="{StaticResource DialogComboBox}"
                                          Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DxfReferenceXLabel}"
                                                   Style="{StaticResource DialogFieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding DxfRefXText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsCustomDxfReferenceEnabled}"
                                                 Style="{StaticResource DialogNumericTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding DxfReferenceYLabel}"
                                                   Style="{StaticResource DialogFieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding DxfRefYText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsCustomDxfReferenceEnabled}"
                                                 Style="{StaticResource DialogNumericTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── TRANSFORM ────────────────────────────────────── -->
                    <StackPanel Style="{StaticResource DxfSectionBlock}">
                        <TextBlock Text="TRANSFORM" Style="{StaticResource DxfSectionHeader}"/>
                        <Border Style="{StaticResource DialogSectionBody}">
                            <StackPanel>
                                <!-- Scale / Rotation side by side -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Scale"
                                                   Style="{StaticResource DialogFieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DialogNumericTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rotation (°, CW)"
                                                   Style="{StaticResource DialogFieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding RotationText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DialogNumericTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Validation error -->
                                <TextBlock Foreground="{StaticResource DestructiveBrush}"
                                           Style="{StaticResource DialogCaption}"
                                           FontSize="{StaticResource FontSizeDialogBody}"
                                           Text="{Binding ValidationError}"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsedConverter}}"/>

                                <Button Content="⊗  Reset"
                                        Style="{StaticResource DialogButtonOutlined}"
                                        Visibility="Collapsed"
                                        Command="{Binding ResetCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── GLOBAL OFFSET ────────────────────────────────── -->
                    <StackPanel Style="{StaticResource DxfSectionBlock}">
                        <TextBlock Text="GLOBAL OFFSET" Style="{StaticResource DxfSectionHeader}"/>
                        <Border Style="{StaticResource DialogSectionBody}">
                            <StackPanel>
                                <TextBlock Text="Offset unit"
                                           Style="{StaticResource DialogFieldLabel}"
                                           Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding UnitOptions}"
                                          SelectedItem="{Binding SelectedGlobalOffsetUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource DialogComboBox}"
                                          Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X"
                                                   Style="{StaticResource DialogFieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding GlobalOffsetXText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DialogNumericTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y"
                                                   Style="{StaticResource DialogFieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding GlobalOffsetYText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DialogNumericTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── OVERLAY OPACITY ──────────────────────────────── -->
                    <StackPanel Style="{StaticResource DxfSectionBlock}">
                        <TextBlock Text="OVERLAY OPACITY" Style="{StaticResource DxfSectionHeader}"/>
                        <Border Style="{StaticResource DialogSectionBody}"
                                Padding="14,10,14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0"
                                        Minimum="0.1" Maximum="1.0"
                                        Value="{Binding Opacity}"
                                        Height="24"
                                        VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="10,5" Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeDialogLabel}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Width="44" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ── CURRENT TRANSFORM ────────────────────────────── -->
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="CURRENT TRANSFORM" Style="{StaticResource DxfSectionHeader}"/>
                        <Border Style="{StaticResource DialogInfoStrip}"
                                Padding="13,9,13,9">
                            <TextBlock Text="{Binding TransformSummary}"
                                       Style="{StaticResource DialogReadout}"/>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Status bar / footer ───────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,4,4">
                <Grid Margin="16,9,16,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="●"
                                   FontSize="{StaticResource FontSizeSM}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   ToolTip="{Binding StatusMessage}"
                                   Style="{StaticResource DialogCaption}"
                                   FontSize="{StaticResource FontSizeDialogBody}"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Reset"
                                Style="{StaticResource DialogButtonOutlined}"
                                Command="{Binding ResetCommand}"
                                Margin="0,0,10,0"
                                ToolTip="Reset the current transform"/>
                        <Button Content="✔  Apply" IsDefault="True"
                                Style="{StaticResource DialogButtonPrimary}"
                                Click="Apply_Click" Margin="0,0,10,0"
                                ToolTip="Apply the current transform"/>
                        <Button Content="Close"
                                Style="{StaticResource DialogButtonOutlined}"
                                Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
