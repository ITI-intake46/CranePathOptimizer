<Window x:Class="CraneOptimizer.UI.Features.F11_DXF.Views.DxfAlignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CraneOptimizer.UI.Core.Converters"
        xmlns:convdx="clr-namespace:CraneOptimizer.UI.Core.Converters.DXF"
        Title="DXF Alignment"
        Width="920" Height="660"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter"/>
        <convdx:NullToCollapsedConverter  x:Key="NullToCollapsedConverter"/>
        <convdx:HexStringToColorConverter x:Key="HexStringToColorConverter"/>
    </Window.Resources>

    <!--  Use Shadow3 from Elevation.xaml instead of inline DropShadowEffect  -->
    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Effect="{StaticResource Shadow3}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ─────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="📐"
                                   FontSize="{StaticResource FontSizeBase}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="DXF Alignment"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,6,0">
                        <!--  TitleBarButton and CloseButton from ShellStyles.xaml  -->
                        <Button Style="{StaticResource TitleBarButton}" Content="—"
                                FontSize="{StaticResource FontSizeXS}"
                                Click="MinimizeButton_Click" ToolTip="Minimise"/>
                        <Button Style="{StaticResource CloseButton}" Content="✕"
                                Click="CloseButton_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource BorderBrush}"/>

            <!-- ── Main content ──────────────────────────────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="295"/>
                </Grid.ColumnDefinitions>

                <!-- Canvas preview -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True">
                    <Grid>
                        <Canvas x:Name="DxfCanvas" Background="Transparent" ClipToBounds="True"/>

                        <!-- Loading overlay -->
                        <Border Background="#AA000000"
                                Visibility="{Binding IsDxfLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="⏳  Loading DXF…"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding DxfFileName, Converter={StaticResource NullToCollapsedConverter}}">
                            <TextBlock Text="📂"
                                       FontSize="36"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="No DXF loaded"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Click 'Load DXF…' in the panel to begin."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Zoom hint badge -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="6,2" Margin="0,0,8,8">
                            <TextBlock Text="Scroll to zoom  ·  Drag to pan"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

                <!-- Controls panel -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource BackgroundBrush}" Padding="10,10,10,6">
                    <StackPanel>

                        <!-- DXF FILE -->
                        <GroupBox Header="DXF FILE" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Content="📂  Load DXF…"
                                        Command="{Binding LoadDxfCommand}"
                                        Style="{StaticResource ButtonPrimary}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding DxfFileName}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeSM}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DxfInfo}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeXS}"
                                           Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- POINT MATCH -->
                        <GroupBox Header="POINT MATCH" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="DXF reference point (world units):"
                                           Style="{StaticResource PropertyLabel}" Margin="0,5,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="X"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeXS}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding DxfRefXText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="2" Text="Y"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeXS}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3"
                                             Text="{Binding DxfRefYText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <TextBlock Text="IFC reference point (metres):"
                                           Style="{StaticResource PropertyLabel}" Margin="0,5,0,2"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="X"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeXS}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding IfcRefXText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="2" Text="Y"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeXS}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3"
                                             Text="{Binding IfcRefYText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Button Content="Apply Point Match"
                                        Command="{Binding ApplyPointMatchCommand}"
                                        Style="{StaticResource ButtonOutlined}"
                                        HorizontalAlignment="Stretch"/>
                                <TextBlock Style="{StaticResource TextCaption}"
                                           Foreground="{StaticResource DestructiveBrush}"
                                           Text="{Binding ValidationError}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsedConverter}}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- MANUAL TRANSFORM -->
                        <GroupBox Header="MANUAL TRANSFORM" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Offset X (m)" Style="{StaticResource PropertyLabel}" Margin="0,5,0,2"/>
                                        <TextBox Text="{Binding OffsetXText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Offset Y (m)" Style="{StaticResource PropertyLabel}" Margin="0,5,0,2"/>
                                        <TextBox Text="{Binding OffsetYText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Scale" Style="{StaticResource PropertyLabel}" Margin="0,5,0,2"/>
                                        <TextBox Text="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rotation (°, CW)" Style="{StaticResource PropertyLabel}" Margin="0,5,0,2"/>
                                        <TextBox Text="{Binding RotationText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Foreground="{StaticResource DestructiveBrush}"
                                           Style="{StaticResource TextCaption}"
                                           Text="{Binding ValidationError}"
                                           TextWrapping="Wrap" Margin="0,2,0,4"
                                           Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsedConverter}}"/>
                                <UniformGrid Columns="2" Rows="2" Margin="0,4,0,0">
                                    <Button Content="✔  Apply"    Style="{StaticResource ButtonPrimary}"   Command="{Binding ApplyManualCommand}" Margin="0,0,3,3"/>
                                    <Button Content="⇱  Auto-Fit" Style="{StaticResource ButtonOutlined}"  Command="{Binding AutoFitCommand}"      Margin="3,0,0,3"/>
                                    <Button Content="↩  Undo"     Style="{StaticResource ButtonOutlined}"  Command="{Binding UndoCommand}"         Margin="0,3,3,0"/>
                                    <Button Content="⊗  Reset"    Style="{StaticResource ButtonOutlined}"  Command="{Binding ResetCommand}"        Margin="3,3,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <!-- OVERLAY OPACITY -->
                        <GroupBox Header="OVERLAY OPACITY" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0"
                                        Minimum="0.1" Maximum="1.0"
                                        Value="{Binding Opacity}"
                                        VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeXS}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Width="36" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <!-- CURRENT TRANSFORM -->
                        <GroupBox Header="CURRENT TRANSFORM" Margin="0,0,0,10">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="3" Padding="8,6">
                                <TextBlock Text="{Binding TransformSummary}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeXS}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </GroupBox>

                        <!-- LAYERS -->
                        <GroupBox Header="LAYERS" Margin="0,0,0,10"
                                  Visibility="{Binding Layers.Count, Converter={StaticResource NullToCollapsedConverter}}">
                            <ListBox ItemsSource="{Binding Layers}" MaxHeight="170"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsVisible}" Margin="0,0,6,0"/>
                                            <Rectangle Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexStringToColorConverter}}"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="{StaticResource FontSizeXS}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EntityCount, StringFormat=' ({0})'}"
                                                       FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="{StaticResource FontSizeXS}"
                                                       Margin="2,0,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── Status bar ────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,6,6">
                <Grid Margin="12,7,12,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="●"
                                   FontSize="{StaticResource FontSizeXS}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="✔  Apply"
                                Style="{StaticResource ButtonOutlined}"
                                Click="Apply_Click" Margin="0,0,6,0"
                                ToolTip="Apply the current transform and keep the dialog open"/>
                        <Button Content="✔  Apply &amp; Close" IsDefault="True"
                                Style="{StaticResource ButtonPrimary}"
                                Click="ApplyAndClose_Click" Margin="0,0,6,0"
                                ToolTip="Apply the current transform and close"/>
                        <Button Content="Close"
                                Style="{StaticResource ButtonOutlined}"
                                Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
