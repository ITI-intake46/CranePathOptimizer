<Window x:Class="CraneOptimizer.UI.Features.F11_DXF.Views.DxfAlignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CraneOptimizer.UI.Core.Converters"
        xmlns:convdx="clr-namespace:CraneOptimizer.UI.Core.Converters.DXF"
        Title="DXF Alignment"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
        Width="420" SizeToContent="Height"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter"/>
        <convdx:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <Style x:Key="DxfDialogGroupBox" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.35"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Margin="8,0,0,-1"
                                       Padding="4,0"
                                       Background="{DynamicResource BackgroundBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{TemplateBinding Header}"/>
                            <Border Grid.RowSpan="2"
                                    Margin="0,8,0,0"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,0"
            CornerRadius="4"
            Effect="{StaticResource Shadow3}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ─────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="4,4,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="📐"
                                   FontSize="{StaticResource FontSizeBase}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="DXF Alignment"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Style="{StaticResource TitleBarButton}" Content="—"
                                FontSize="{StaticResource FontSizeXS}"
                                Click="MinimizeButton_Click" ToolTip="Minimise"/>
                        <Button Style="{StaticResource CloseButton}" Content="✕"
                                Click="CloseButton_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource BorderBrush}"/>

            <!-- ── Main controls panel ──────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource BackgroundBrush}"
                          Padding="12,12,12,8">
                <StackPanel>

                    <!-- DXF FILE -->
                    <GroupBox Header="DXF FILE" Style="{StaticResource DxfDialogGroupBox}" Margin="0,0,0,10">
                        <StackPanel>
                            <Button Content="📂  Load DXF"
                                    Command="{Binding LoadDxfCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,6"/>

                            <!-- Loading indicator -->
                            <TextBlock Text="⏳  Loading DXF…"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding IsDxfLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding DxfFileName}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding DxfFileName, Converter={StaticResource NullToCollapsedConverter}}"/>
                            <TextBlock Text="{Binding DxfInfo}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding DxfInfo, Converter={StaticResource NullToCollapsedConverter}}"/>

                            <CheckBox Content="Keep DXF text"
                                      IsChecked="{Binding KeepText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- REFERENCE POINT -->
                    <GroupBox Header="REFERENCE POINT" Style="{StaticResource DxfDialogGroupBox}" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <TextBlock Text="DXF unit"
                                           Style="{StaticResource PropertyLabel}"/>
                                <Border Width="14"
                                        Height="14"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource TextSecondaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Border.ToolTip>
                                        <ToolTip MaxWidth="280">
                                            <TextBlock Text="Default uses the DXF file unit. Reference X/Y values are shown in the selected unit and convert when this unit changes. Scale multiplies after unit conversion."
                                                       TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Text="i"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-1,0,0"/>
                                </Border>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding DxfUnitOptions}"
                                      SelectedItem="{Binding SelectedDxfUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,6"/>

                            <!-- DXF original reference -->
                            <CheckBox Content="Use DXF original reference point"
                                      IsChecked="{Binding UseDetectedDxfReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding DxfOriginalReferenceSummary}"
                                       Style="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="30,0,0,4"/>
                            <TextBlock Text="{Binding DxfOriginalGeometryReferenceSummary}"
                                       Style="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="30,0,0,8"/>

                            <CheckBox Content="Use custom DXF reference point"
                                      IsChecked="{Binding UseCustomDxfReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,4"/>
                            <TextBlock Text="Reference point"
                                       Style="{StaticResource PropertyLabel}"
                                       Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding DxfReferenceAnchorOptions}"
                                      SelectedItem="{Binding SelectedDxfReferenceAnchor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsCustomDxfReferenceEnabled}"
                                      Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DxfReferenceXLabel}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeXS}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding DxfRefXText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsCustomDxfReferenceEnabled}"
                                         Margin="0,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding DxfReferenceYLabel}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeXS}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding DxfRefYText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsCustomDxfReferenceEnabled}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- TRANSFORM -->
                    <GroupBox Header="TRANSFORM" Style="{StaticResource DxfDialogGroupBox}" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Scale / Rotation side by side -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Scale" Style="{StaticResource PropertyLabel}" Margin="0,4,0,2"/>
                                    <TextBox Text="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rotation (°, CW)" Style="{StaticResource PropertyLabel}" Margin="0,4,0,2"/>
                                    <TextBox Text="{Binding RotationText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Validation error -->
                            <TextBlock Foreground="{StaticResource DestructiveBrush}"
                                       Style="{StaticResource TextCaption}"
                                       Text="{Binding ValidationError}"
                                       TextWrapping="Wrap" Margin="0,2,0,6"
                                       Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsedConverter}}"/>

                            <Button Content="⊗  Reset"
                                    Style="{StaticResource ButtonOutlined}"
                                    Visibility="Collapsed"
                                    Command="{Binding ResetCommand}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- GLOBAL OFFSET -->
                    <GroupBox Header="GLOBAL OFFSET" Style="{StaticResource DxfDialogGroupBox}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Offset unit"
                                       Style="{StaticResource PropertyLabel}" Margin="0,4,0,2"/>
                            <ComboBox ItemsSource="{Binding UnitOptions}"
                                      SelectedItem="{Binding SelectedGlobalOffsetUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeXS}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding GlobalOffsetXText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="3" Text="Y"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeXS}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding GlobalOffsetYText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- OVERLAY OPACITY -->
                    <GroupBox Header="OVERLAY OPACITY" Style="{StaticResource DxfDialogGroupBox}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="0.1" Maximum="1.0"
                                    Value="{Binding Opacity}"
                                    VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.5"
                                    CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeXS}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Width="36" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- CURRENT TRANSFORM -->
                    <GroupBox Header="CURRENT TRANSFORM" Style="{StaticResource DxfDialogGroupBox}" Margin="0,0,0,6">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0.5" CornerRadius="3" Padding="8,6">
                            <TextBlock Text="{Binding TransformSummary}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Status bar / footer ───────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,4,4">
                <Grid Margin="12,7,12,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="●"
                                   FontSize="{StaticResource FontSizeXS}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Reset"
                                Style="{StaticResource ButtonOutlined}"
                                Command="{Binding ResetCommand}"
                                Margin="0,0,6,0"
                                ToolTip="Reset the current transform"/>
                        <Button Content="✔  Apply" IsDefault="True"
                                Style="{StaticResource ButtonPrimary}"
                                Click="Apply_Click" Margin="0,0,6,0"
                                ToolTip="Apply the current transform"/>
                        <Button Content="Close"
                                Style="{StaticResource ButtonOutlined}"
                                Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
