<UserControl
    x:Class="CraneOptimizer.UI.Features.F11_DXF.Views.DXFTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0" Orientation="Horizontal">

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="DXF FILES">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding Dxf.UploadDxfCommand}"
                        Content="Upload DXF"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}"
                        ToolTip="Select a DXF file from disk">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="📂" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding Dxf.AddAnotherDxfCommand}"
                        Content="Add Another"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}"
                        ToolTip="Load another independent DXF overlay">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="➕" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="TRANSFORM">
                <Button
                    Command="{Binding Dxf.AlignCommand}"
                    Content="Align"
                    FontSize="{StaticResource FontSizeXS}"
                    IsEnabled="{Binding Dxf.HasDxfLoaded}"
                    Style="{StaticResource RibbonMajorCommandTile}"
                    ToolTip="Open the alignment dialog to position the DXF on the site">
                    <Button.Tag>
                        <TextBlock FontSize="26" Text="🎯" />
                    </Button.Tag>
                </Button>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="IMPORT">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Command="{Binding Dxf.DrawZonesByLayerCommand}"
                        Content="By Layer"
                        FontSize="{StaticResource FontSizeXS}"
                        IsEnabled="{Binding Dxf.HasDxfLoaded}"
                        Style="{StaticResource RibbonMajorCommandTile}"
                        ToolTip="Draw zones from closed DXF polylines on a selected layer">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="🗂" />
                        </Button.Tag>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox
                            Content="Use DXF Colors"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            IsChecked="{Binding Dxf.UseDxfColors, Mode=TwoWay}"
                            IsEnabled="{Binding Dxf.HasDxfLoaded}"
                            ToolTip="Render the DXF overlay with original entity and layer colors" />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="SELECTION">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="SelectDxfButton"
                        Command="{Binding Dxf.SelectCommand}"
                        Content="Select"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}"
                        ToolTip="Select complete DXF overlays">
                        <Button.Tag>
                            <TextBlock Text="⬚" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding Dxf.SelectAllCommand}"
                        Content="Select All"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}"
                        ToolTip="Select every loaded DXF overlay">
                        <Button.Tag>
                            <TextBlock Text="⬛" />
                        </Button.Tag>
                    </Button>
                    </StackPanel>
                    <Popup
                    Width="330"
                    AllowsTransparency="True"
                    IsOpen="{Binding Dxf.IsSelectionPanelOpen, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=SelectDxfButton}"
                    DataContext="{Binding DataContext, ElementName=SelectDxfButton}"
                    StaysOpen="False">
                    <Border
                        Margin="0,4,0,0"
                        Padding="12"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSM}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="Loaded DXFs" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="{Binding Dxf.SelectionSummary}" />
                            </Grid>
                            <ScrollViewer
                                Grid.Row="1"
                                MaxHeight="250"
                                Margin="0,8,0,8"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    ItemsSource="{Binding Dxf.LoadedDxfs}"
                                    Tag="{Binding Dxf.ToggleSourceSelectionCommand}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="7"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                CornerRadius="3"
                                                ToolTip="{Binding FilePath}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderThickness" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                        ToolTip="Toggle DXF selection" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock
                                                            MaxWidth="205"
                                                            FontFamily="{StaticResource FontPrimary}"
                                                            FontSize="{StaticResource FontSizeSM}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                                            Text="{Binding DisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontFamily="{StaticResource FontPrimary}"
                                                            FontSize="{StaticResource FontSizeXS}"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Text="{Binding AlignmentStatus}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource FontPrimary}"
                                                        FontSize="{StaticResource FontSizeXS}"
                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                        Text="Active">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock
                                Grid.Row="2"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeXS}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Click a DXF in the viewport or select it from this list."
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    </Popup>
                </Grid>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="EDIT">
                <Button
                    Command="{Binding Dxf.DeleteCommand}"
                    Content="Delete"
                    FontSize="{StaticResource FontSizeXS}"
                    Style="{StaticResource RibbonMajorCommandTile}"
                    ToolTip="Delete selected DXF overlays">
                    <Button.Tag>
                        <TextBlock FontSize="26" Text="🗑" />
                    </Button.Tag>
                </Button>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <Border
                Width="220"
                Height="{StaticResource RibbonCommandGroupHeight}"
                Padding="12,0"
                VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding Dxf.StatusMessage, FallbackValue='No DXF loaded'}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Dxf.StatusMessage}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding Dxf.LoadedFileName}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding Dxf.HasDxfLoaded, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
