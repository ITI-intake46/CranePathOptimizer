<UserControl
    x:Class="CraneOptimizer.UI.Features.F11_DXF.Views.DXFTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

        <StackPanel Margin="4,0" Orientation="Horizontal">

            <!--  ── DXF FILES ─────────────────────────────────────────────  -->
            <Border Padding="4,4,0,0">
                <DockPanel LastChildFill="False">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="DXF FILES" />

                    <StackPanel Orientation="Horizontal">

                        <!--  Upload DXF — functional  -->
                        <Button
                            Command="{Binding Dxf.UploadDxfCommand}"
                            Style="{StaticResource RibbonLargeBtn}"
                            ToolTip="Select a DXF file from disk">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,8,0,2"
                                    FontSize="26"
                                    Text="📂" />
                                <TextBlock Text="Upload DXF" />
                            </StackPanel>
                        </Button>

                        <!--  Add Another DXF — visual stub  -->
                        <Button
                            IsEnabled="False"
                            Style="{StaticResource RibbonLargeBtn}"
                            ToolTip="Add another DXF (coming soon)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,8,0,2"
                                    FontSize="26"
                                    Text="➕" />
                                <TextBlock Text="Add Another" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <!--  ── TRANSFORM ──────────────────────────────────────────────  -->
            <Border Padding="4,4,0,0">
                <DockPanel LastChildFill="False">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="TRANSFORM" />

                    <StackPanel Orientation="Horizontal">

                        <!--  Align — functional (enabled only when DXF is loaded)  -->
                        <Button
                            Command="{Binding Dxf.AlignCommand}"
                            IsEnabled="{Binding Dxf.HasDxfLoaded}"
                            Style="{StaticResource RibbonLargeBtn}"
                            ToolTip="Open the alignment dialog to position the DXF on the site">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,8,0,2"
                                    FontSize="26"
                                    Text="🎯" />
                                <TextBlock Text="Align" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <!--  ── IMPORT ─────────────────────────────────────────────────  -->
            <Border Padding="4,4,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="IMPORT" />
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Command="{Binding Dxf.DrawZonesByLayerCommand}"
                            IsEnabled="{Binding Dxf.HasDxfLoaded}"
                            Style="{StaticResource RibbonLargeBtn}"
                            ToolTip="Draw zones from closed DXF polylines on a selected layer">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,8,0,2"
                                    FontSize="26"
                                    Text="🗂" />
                                <TextBlock Text="By Layer" />
                            </StackPanel>
                        </Button>
                        <StackPanel
                            Width="122"
                            Margin="8,10,0,0">
                            <CheckBox
                                Content="Use DXF Colors"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                IsChecked="{Binding Dxf.UseDxfColors, Mode=TwoWay}"
                                IsEnabled="{Binding Dxf.HasDxfLoaded}"
                                ToolTip="Render the DXF overlay with original entity and layer colors" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <!--  ── SELECTION ────────────────────────────────────────────────  -->
            <Border Padding="8,8,0,0">
                <DockPanel>

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="SELECTION" />

                    <StackPanel>

                        <!--  Select — stub  -->
                        <Button
                            Width="130"
                            Margin="0,0,0,2"
                            IsEnabled="False"
                            Style="{StaticResource RibbonSmallBtn}"
                            ToolTip="Select DXF entities (coming soon)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" Text="⬚" />
                                <TextBlock Text="Select" />
                            </StackPanel>
                        </Button>

                        <!--  Select All — stub  -->
                        <Button
                            Width="130"
                            IsEnabled="False"
                            Style="{StaticResource RibbonSmallBtn}"
                            ToolTip="Select all DXF entities (coming soon)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" Text="⬛" />
                                <TextBlock Text="Select All" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <!--  ── EDIT ──────────────────────────────────────────────────────  -->
            <Border Padding="4,4,0,0">
                <DockPanel LastChildFill="False">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="EDIT" />

                    <!--  Delete — stub  -->
                    <Button
                        IsEnabled="False"
                        Style="{StaticResource RibbonLargeBtn}"
                        ToolTip="Delete selected DXF entities (coming soon)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                Margin="0,8,0,2"
                                FontSize="26"
                                Text="🗑" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>

                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <!--  ── STATUS STRIP ──────────────────────────────────────────────  -->
            <Border
                Padding="12,0"
                VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding Dxf.StatusMessage, FallbackValue='No DXF loaded'}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding Dxf.LoadedFileName}"
                        Visibility="{Binding Dxf.HasDxfLoaded, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
