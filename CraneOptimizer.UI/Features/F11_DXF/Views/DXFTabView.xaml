<UserControl
    x:Class="CraneOptimizer.UI.Features.F11_DXF.Views.DXFTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0" Orientation="Horizontal">

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="DXF FILES">
                <UniformGrid Rows="1">
                    <Button
                        Command="{Binding Dxf.UploadDxfCommand}"
                        Content="Upload DXF"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}"
                        ToolTip="Select a DXF file from disk">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="📂" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Content="Add Another"
                        FontSize="{StaticResource FontSizeXS}"
                        IsEnabled="False"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}"
                        ToolTip="Add another DXF (coming soon)">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="➕" />
                        </Button.Tag>
                    </Button>
                </UniformGrid>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="TRANSFORM">
                <Button
                    Command="{Binding Dxf.AlignCommand}"
                    Content="Align"
                    FontSize="{StaticResource FontSizeXS}"
                    IsEnabled="{Binding Dxf.HasDxfLoaded}"
                    Style="{StaticResource RibbonMajorCommandTile}"
                    ToolTip="Open the alignment dialog to position the DXF on the site">
                    <Button.Tag>
                        <TextBlock FontSize="26" Text="🎯" />
                    </Button.Tag>
                </Button>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Width="260" Style="{StaticResource RibbonCommandGroup}" Tag="IMPORT">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Command="{Binding Dxf.DrawZonesByLayerCommand}"
                        Content="By Layer"
                        FontSize="{StaticResource FontSizeXS}"
                        IsEnabled="{Binding Dxf.HasDxfLoaded}"
                        Style="{StaticResource RibbonMajorCommandTile}"
                        ToolTip="Draw zones from closed DXF polylines on a selected layer">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="🗂" />
                        </Button.Tag>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox
                            Content="Use DXF Colors"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            IsChecked="{Binding Dxf.UseDxfColors, Mode=TwoWay}"
                            IsEnabled="{Binding Dxf.HasDxfLoaded}"
                            ToolTip="Render the DXF overlay with original entity and layer colors" />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="SELECTION">
                <UniformGrid Rows="1">
                    <Button
                        Content="Select"
                        IsEnabled="False"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}"
                        ToolTip="Select DXF entities (coming soon)">
                        <Button.Tag>
                            <TextBlock Text="⬚" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Content="Select All"
                        IsEnabled="False"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}"
                        ToolTip="Select all DXF entities (coming soon)">
                        <Button.Tag>
                            <TextBlock Text="⬛" />
                        </Button.Tag>
                    </Button>
                </UniformGrid>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="EDIT">
                <Button
                    Content="Delete"
                    FontSize="{StaticResource FontSizeXS}"
                    IsEnabled="False"
                    Style="{StaticResource RibbonMajorCommandTile}"
                    ToolTip="Delete selected DXF entities (coming soon)">
                    <Button.Tag>
                        <TextBlock FontSize="26" Text="🗑" />
                    </Button.Tag>
                </Button>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <Border Padding="12,0" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding Dxf.StatusMessage, FallbackValue='No DXF loaded'}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding Dxf.LoadedFileName}"
                        Visibility="{Binding Dxf.HasDxfLoaded, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
