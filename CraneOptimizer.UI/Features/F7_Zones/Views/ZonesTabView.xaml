<UserControl
    x:Class="CraneOptimizer.UI.Features.F7_Zones.Views.ZonesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}"
    Cursor="{Binding ViewportCursor}"
    Focusable="True"
    PreviewKeyDown="ZonesTabView_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Margin="6,0" Orientation="Horizontal">

                <Border Padding="8,6,8,0" Width="190">
                    <DockPanel Width="220">
                        <TextBlock DockPanel.Dock="Bottom" 
                           Style="{StaticResource GroupLabel}" 
                           Text="DRAW MODE" Width="106" />

                        <StackPanel Orientation="Horizontal" Width="175">
                            <Border Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveDrawingMode}" Value="Allowed">
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                <Setter Property="BorderThickness" Value="4,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Command="{Binding StartAllowedCommand}" 
                                Style="{StaticResource RibbonLargeBtn}" Height="95">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Source="/CraneOptimizer.UI;component/Resources/Icons/map-pin-check (1)_white.png" 
                                               Width="32" Height="32" Margin="0,6,0,4"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Opacity="0.8"/>
                                        <TextBlock Text="Allowed" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSM}"/>
                                        <TextBlock Text="Zone" FontSize="{StaticResource FontSizeXS}" Opacity="0.85"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveDrawingMode}" Value="Forbidden">
                                                <Setter Property="BorderBrush" Value="{StaticResource DestructiveBrush}" />
                                                <Setter Property="BorderThickness" Value="4,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Command="{Binding StartForbiddenCommand}" 
                                Style="{StaticResource RibbonLargeBtn}" Height="95">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Source="/CraneOptimizer.UI;component/Resources/Icons/map-pin-x (1)_white.png" 
                                               Width="32" Height="32" Margin="0,6,0,4"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Opacity="0.8"/>
                                        <TextBlock Text="Forbidden" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSM}"/>
                                        <TextBlock Text="Zone" FontSize="{StaticResource FontSizeXS}" Opacity="0.85"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

                <Border Padding="8,6,8,0">
                    <DockPanel Width="90">
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="MEASURE" />
                        <Button Command="{Binding StartMeasureCommand}" Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Margin="0,8,0,2" FontSize="40" Text="📏" />
                                <TextBlock Text="Measure" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

                <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

                <Border Padding="8,6,8,0">
                    <DockPanel Width="160">
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupLabel}" Text="ACTIONS" />
                        <StackPanel Margin="0,2,0,0">
                            <Button Width="150" Margin="0,0,0,3"
                            Command="{Binding FinishCommand}"
                            Style="{StaticResource RibbonSmallBtn}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✔ Finish Zone" />
                                </StackPanel>
                            </Button>
                            <Button Width="150" Margin="0,0,0,3"
                            Command="{Binding UndoCommand}"
                            Style="{StaticResource RibbonSmallBtn}">
                                <TextBlock Text="↩ Undo Vertex" />
                            </Button>
                            <Button Width="150"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource RibbonSmallBtn}">
                                <TextBlock Text="✕ Cancel" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

                <Border Padding="8,6,8,0">
                    <DockPanel Width="165">
                        <TextBlock DockPanel.Dock="Bottom"
                           Style="{StaticResource GroupLabel}"
                           Text="{Binding ZoneList.ZoneCount, StringFormat=MANAGE ({0} zones)}" />
                        <StackPanel Margin="0,2,0,0">
                            <Button Width="150" Margin="0,0,0,3"
                            Command="{Binding DeleteZoneCommand}"
                            Style="{StaticResource RibbonSmallBtn}">
                                <TextBlock Text="🗑 Delete Selected" />
                            </Button>
                            <Button Width="150" Margin="0,0,0,3"
                            Command="{Binding DeleteAllCommand}"
                            Style="{StaticResource RibbonSmallBtn}">
                                <TextBlock Text="🗑 Delete All" />
                            </Button>
                            <Button Width="150"
                            Command="{Binding ZoneList.ExportZonesCommand}"
                            Style="{StaticResource RibbonSmallBtn}">
                                <TextBlock Text="📤 Export JSON" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="10,5"
                Background="{DynamicResource SurfaceElevatedBrush}"
                CornerRadius="12"
                Opacity="0.92"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Visibility="{Binding IsHintVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="{StaticResource FontSizeSM}"
                    Foreground="{StaticResource WarningBrush}"
                    Text="{Binding HintText}" />
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,6,0,0"
                Padding="10,5"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Left"
                Visibility="{Binding IsInlineWarningVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    FontSize="{StaticResource FontSizeSM}"
                    Foreground="{StaticResource WarningBrush}"
                    Text="{Binding InlineWarning}" />
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,6,0,0"
                Padding="10,5"
                Background="{DynamicResource SurfaceElevatedBrush}"
                CornerRadius="8"
                Opacity="0.92"
                HorizontalAlignment="Center"
                Visibility="{Binding IsMeasureOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="{StaticResource FontSizeSM}"
                    Foreground="{StaticResource WarningBrush}"
                    Text="{Binding MeasureText}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
