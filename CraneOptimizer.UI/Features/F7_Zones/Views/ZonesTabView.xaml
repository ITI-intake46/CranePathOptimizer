<UserControl
    x:Class="CraneOptimizer.UI.Features.F7_Zones.Views.ZonesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}"
    Cursor="{Binding ViewportCursor}"
    Focusable="True"
    PreviewKeyDown="ZonesTabView_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Margin="6,0" Orientation="Horizontal">

                <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="DRAW MODE">
                <StackPanel Orientation="Horizontal">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveDrawingMode}" Value="Allowed">
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                            <Setter Property="BorderThickness" Value="4,0,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Command="{Binding StartAllowedCommand}" ContentTemplate="{x:Null}" Style="{StaticResource RibbonMajorLeadingCommandTile}">
                                <Button.Tag>
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Opacity="0.8"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="/CraneOptimizer.UI;component/Resources/Icons/map-pin-check (1)_white.png" />
                                </Button.Tag>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{StaticResource FontSizeSM}"
                                        FontWeight="SemiBold"
                                        Text="Allowed" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Margin="0,2,0,0"
                                        FontSize="{StaticResource FontSizeXS}"
                                        Opacity="0.85"
                                        Text="Zone" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveDrawingMode}" Value="Forbidden">
                                            <Setter Property="BorderBrush" Value="{StaticResource DestructiveBrush}" />
                                            <Setter Property="BorderThickness" Value="4,0,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Command="{Binding StartForbiddenCommand}" ContentTemplate="{x:Null}" Style="{StaticResource RibbonMajorTrailingCommandTile}">
                                <Button.Tag>
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Opacity="0.8"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="/CraneOptimizer.UI;component/Resources/Icons/map-pin-x (1)_white.png" />
                                </Button.Tag>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{StaticResource FontSizeSM}"
                                        FontWeight="SemiBold"
                                        Text="Forbidden" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Margin="0,2,0,0"
                                        FontSize="{StaticResource FontSizeXS}"
                                        Opacity="0.85"
                                        Text="Zone" />
                                </StackPanel>
                            </Button>
                        </Border>
                </StackPanel>
                </ContentControl>

                <Rectangle Style="{StaticResource RibbonSep}" />

                <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="MEASURE">
                    <Button
                        Command="{Binding StartMeasureCommand}"
                        Content="Measure"
                        FontSize="{StaticResource FontSizeXS}"
                        Style="{StaticResource RibbonMajorCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="40" Text="📏" />
                        </Button.Tag>
                    </Button>
                </ContentControl>

                <Rectangle Style="{StaticResource RibbonSep}" />

                <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="ACTIONS">
                <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding FinishCommand}" Content="Finish Zone" Style="{StaticResource RibbonMajorLeadingCommandTile}">
                            <Button.Tag>
                                <TextBlock Text="✔" />
                            </Button.Tag>
                        </Button>
                        <Button Command="{Binding UndoCommand}" Content="Undo Vertex" Style="{StaticResource RibbonMajorMiddleCommandTile}">
                            <Button.Tag>
                                <TextBlock Text="↩" />
                            </Button.Tag>
                        </Button>
                        <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource RibbonMajorTrailingCommandTile}">
                            <Button.Tag>
                                <TextBlock Text="✕" />
                            </Button.Tag>
                        </Button>
                </StackPanel>
                </ContentControl>

                <Rectangle Style="{StaticResource RibbonSep}" />

                <ContentControl
                    Style="{StaticResource RibbonCommandGroup}"
                    Tag="{Binding ZoneList.ZoneCount, StringFormat=MANAGE ({0} zones)}">
                <StackPanel Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="Delete selected zone"
                            Command="{Binding DeleteZoneCommand}"
                            Content="Delete Selected"
                            Style="{StaticResource RibbonMajorLeadingCommandTile}"
                            ToolTip="Deletes the selected zone from the scene. Requires a selected zone and no active drawing or measurement. This action cannot be undone."
                            ToolTipService.ShowOnDisabled="True">
                            <Button.Tag>
                                <Grid Width="24" Height="24">
                                    <Path Data="M 7,7 H 17 L 16,20 H 8 Z M 9,7 V 4 H 15 V 7 M 5,7 H 19 M 10,10 V 17 M 14,10 V 17"
                                          Stroke="{StaticResource DestructiveBrush}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.6" />
                                </Grid>
                            </Button.Tag>
                        </Button>
                        <Button
                            AutomationProperties.Name="Delete all zones"
                            Command="{Binding DeleteAllCommand}"
                            Content="Delete All"
                            Style="{StaticResource RibbonMajorMiddleCommandTile}"
                            ToolTip="Deletes every zone from the scene. Requires at least one zone and no active drawing or measurement. Press Delete All again to confirm; this action cannot be undone."
                            ToolTipService.ShowOnDisabled="True">
                            <Button.Tag>
                                <Grid Width="24" Height="24">
                                    <Path Data="M 7,7 H 17 L 16,20 H 8 Z M 9,7 V 4 H 15 V 7 M 5,7 H 19 M 10,10 V 17 M 14,10 V 17"
                                          Stroke="{StaticResource DestructiveBrush}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.6" />
                                </Grid>
                            </Button.Tag>
                        </Button>
                        <Button Command="{Binding ZoneList.ExportZonesCommand}" Content="Export JSON" Style="{StaticResource RibbonMajorTrailingCommandTile}">
                            <Button.Tag>
                                <TextBlock Text="📤" />
                            </Button.Tag>
                        </Button>
                </StackPanel>
                </ContentControl>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,4,0,0"
                Padding="10,5"
                HorizontalAlignment="Center"
                Background="{DynamicResource SurfaceElevatedBrush}"
                CornerRadius="12"
                Opacity="0.92"
                Visibility="{Binding IsHintVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="{StaticResource FontSizeSM}"
                    Foreground="{StaticResource WarningBrush}"
                    Text="{Binding HintText}" />
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,6,0,0"
                Padding="10,5"
                HorizontalAlignment="Left"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsInlineWarningVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    FontSize="{StaticResource FontSizeSM}"
                    Foreground="{StaticResource WarningBrush}"
                    Text="{Binding InlineWarning}" />
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,6,0,0"
                Padding="10,5"
                HorizontalAlignment="Center"
                Background="{DynamicResource SurfaceElevatedBrush}"
                CornerRadius="8"
                Opacity="0.92"
                Visibility="{Binding IsMeasureOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="{StaticResource FontSizeSM}"
                    Foreground="{StaticResource WarningBrush}"
                    Text="{Binding MeasureText}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
