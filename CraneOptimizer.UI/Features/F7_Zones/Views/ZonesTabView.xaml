<UserControl
    x:Class="CraneOptimizer.UI.Features.F7_Zones.Views.ZonesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

        <StackPanel Margin="6,0" Orientation="Horizontal">

            <!--  ── DRAW MODE ─────────────────────────  -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="220">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="DRAW MODE" />

                    <StackPanel Orientation="Horizontal">

                        <!--  Site Boundary  -->
                        <Button Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,6,0,4"
                                    FontSize="26"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="⬡" />
                                <TextBlock Text="Site" />
                                <TextBlock Text="Boundary" />
                            </StackPanel>
                        </Button>

                        <!--  Allowed  -->
                        <Button Margin="14,0,0,0"
                                Style="{StaticResource RibbonLargeBtn}"
                                Command="{Binding StartAllowedCommand}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,6,0,4"
                                    FontSize="26"
                                    Text="✔" />
                                <TextBlock Text="Allowed" />
                                <TextBlock Text="Zone" />
                            </StackPanel>
                        </Button>

                        <!--  Forbidden  -->
                        <Button Margin="14,0,0,0"
                                Style="{StaticResource RibbonLargeBtn}"
                                Command="{Binding StartForbiddenCommand}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,6,0,4"
                                    FontSize="26"
                                    Text="✖" />
                                <TextBlock Text="Forbidden" />
                                <TextBlock Text="Zone" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <!--  ── MEASURE ─────────────────────────  -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="90">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="MEASURE" />

                    <Button Style="{StaticResource RibbonLargeBtn}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                Margin="0,6,0,4"
                                FontSize="26"
                                Text="📏" />
                            <TextBlock Text="Measure" />
                        </StackPanel>
                    </Button>

                </DockPanel>
            </Border>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <!--  ── ACTIONS ─────────────────────────  -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="160">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="ACTIONS" />

                    <StackPanel Margin="0,2,0,0">

                        <Button
                            Width="150"
                            Margin="0,0,0,3"
                            Style="{StaticResource RibbonSmallBtn}"
                            Command="{Binding FinishCommand}">
                            <TextBlock Text="Finish Zone" />
                        </Button>

                        <Button
                            Width="150"
                            Margin="0,0,0,3"
                            Style="{StaticResource RibbonSmallBtn}"
                            Command="{Binding UndoCommand}">
                            <TextBlock Text="Undo Vertex" />
                        </Button>

                        <Button Width="150"
                                Style="{StaticResource RibbonSmallBtn}"
                                Command="{Binding CancelCommand}">
                            <TextBlock Text="Cancel" />
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <!--  ── VIEW ─────────────────────────  -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="150">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="VIEW" />

                    <StackPanel Orientation="Horizontal">

                        <Button Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,6,0,4"
                                    FontSize="26"
                                    Text="🗺" />
                                <TextBlock Text="Plan" />
                            </StackPanel>
                        </Button>

                        <Button Margin="4,0,0,0" Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,6,0,4"
                                    FontSize="26"
                                    Text="🏗" />
                                <TextBlock Text="3D" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <!--  ── MANAGE ─────────────────────────  -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="150">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="MANAGE" />

                    <StackPanel Margin="0,2,0,0">

                        <Button
                            Width="140"
                            Margin="0,0,0,3"
                            Style="{StaticResource RibbonSmallBtn}">
                            <TextBlock Text="Delete Selected" />
                        </Button>

                        <Button
                            Width="140"
                            Margin="0,0,0,3"
                            Style="{StaticResource RibbonSmallBtn}">
                            <TextBlock Text="Delete All" />
                        </Button>

                        <Button Width="140" Style="{StaticResource RibbonSmallBtn}">
                            <TextBlock Text="Export JSON" />
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>