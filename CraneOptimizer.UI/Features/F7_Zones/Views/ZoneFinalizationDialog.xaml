<Window
    x:Class="CraneOptimizer.UI.Features.F7_Zones.Views.ZoneFinalizationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Finalize Zone"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
    Width="380"
    Height="280"
    Background="{DynamicResource BackgroundBrush}"
    FontFamily="{StaticResource FontPrimary}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20,20,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header  -->
            <RowDefinition Height="Auto" />
            <!--  Zone type  -->
            <RowDefinition Height="Auto" />
            <!--  Name label  -->
            <RowDefinition Height="Auto" />
            <!--  Name input  -->
            <RowDefinition Height="Auto" />
            <!--  Buttons  -->
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="{StaticResource FontSizeLG}"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="Zone Properties" />
            <TextBlock
                x:Name="AreaLabel"
                Margin="0,2,0,0"
                FontSize="{StaticResource FontSizeSM}"
                Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!--  Zone Type Toggle  -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <RadioButton
                x:Name="RadioAllowed"
                Grid.Column="0"
                Margin="0,0,4,0"
                Padding="8,6"
                VerticalContentAlignment="Center"
                Checked="ZoneType_Changed"
                Content="✅  Allowed (Green)"
                FontWeight="SemiBold"
                Foreground="{StaticResource SuccessBrush}"
                GroupName="ZoneTypeGroup"
                IsChecked="True" />
            <RadioButton
                x:Name="RadioForbidden"
                Grid.Column="1"
                Margin="4,0,0,0"
                Padding="8,6"
                VerticalContentAlignment="Center"
                Checked="ZoneType_Changed"
                Content="❌  Forbidden (Red)"
                FontWeight="SemiBold"
                Foreground="{StaticResource DestructiveBrush}"
                GroupName="ZoneTypeGroup" />
        </Grid>

        <!--  Zone Name label  -->
        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,4"
            FontSize="{StaticResource FontSizeSM}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="Zone Name (optional):" />

        <!--  Zone Name input  -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <TextBox
                x:Name="TxtZoneName"
                GotFocus="TxtZoneName_GotFocus"
                LostFocus="TxtZoneName_LostFocus" />
            <TextBlock
                x:Name="ZoneNamePlaceholder"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontStyle="Italic"
                Foreground="{DynamicResource TextDisabledBrush}"
                IsHitTestVisible="False"
                Text="e.g. Pedestrian Area, Power Lines" />
        </Grid>

        <!--  Action Buttons  -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Click="Confirm_Click"
                Content="Create Zone"
                Style="{StaticResource ButtonPrimary}" />
            <Button
                Grid.Column="2"
                Click="Cancel_Click"
                Content="Cancel"
                Style="{StaticResource ButtonSecondary}" />
        </Grid>
    </Grid>
</Window>
