<UserControl
    x:Class="CraneOptimizer.UI.Features.F12_Reports.Views.ReportsTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

        <StackPanel Orientation="Horizontal" Margin="6,0">

            <!-- ─────────────────  ELEMENTS  ───────────────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="155">
                    <TextBlock DockPanel.Dock="Bottom" Text="ELEMENTS" Style="{StaticResource GroupLabel}" />
                    <StackPanel Margin="0,2,0,0">
                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="142"
                                ToolTip="Full table: name, type, material, weight, dimensions, volume, storey, IsLiftable"
                                Click="AllElementsList_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Margin="0,0,6,0" />
                                <TextBlock Text="All Elements List" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0" />

            <!-- ─────────────────  LIFTING  ────────────────────────────── -->
            <!--  Covers: radius, hoist height, hook load, capacity lookup, lift status  -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="168">
                    <TextBlock DockPanel.Dock="Bottom" Text="LIFTING" Style="{StaticResource GroupLabel}" />
                    <StackPanel Margin="0,2,0,0">
                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="155"
                                ToolTip="Per-element: Radius, Hoist Height, Hook Load, Available Capacity, LiftStatus"
                                Click="LiftingSummary_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⛓" Margin="0,0,6,0" />
                                <TextBlock Text="Lifting Summary Report" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0" />

            <!-- ─────────────────  CRANE CATALOG  ───────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="155">
                    <TextBlock DockPanel.Dock="Bottom" Text="CRANE CATALOG" Style="{StaticResource GroupLabel}" />
                    <StackPanel Margin="0,2,0,0">
                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="142"
                                ToolTip="All cranes in the catalog — brand, model, capacity range, boom range, outrigger config"
                                Click="AllCranesInDatabase_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗂" Margin="0,0,6,0" />
                                <TextBlock Text="All Cranes in Database" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0" />

            <!-- ─────────────────  COMPARE  ──────────────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="100">
                    <TextBlock DockPanel.Dock="Bottom" Text="COMPARE" Style="{StaticResource GroupLabel}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource RibbonLargeBtn}"
                                Width="80"
                                ToolTip="Pick 2 cranes → side-by-side specs + coverage over this building"
                                Click="Compare2Cranes_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚖" FontSize="26" Margin="0,6,0,4"
                                           Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="Compare" FontSize="9" FontWeight="Bold"
                                           Margin="0,0,0,1"
                                           Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="2 Cranes" FontSize="9"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0" />

            <!-- ─────────────────  PROJECT  ──────────────────────────── -->
            <!--  Merged: Project Summary + IFC Files → Project Overview   -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="155">
                    <TextBlock DockPanel.Dock="Bottom" Text="PROJECT" Style="{StaticResource GroupLabel}" />
                    <StackPanel Margin="0,2,0,0">
                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="142" Margin="0,0,0,3"
                                ToolTip="Project meta + all imported IFC files (name, path, element count, schema, size)"
                                Click="ProjectOverview_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" Margin="0,0,6,0" />
                                <TextBlock Text="Project Overview" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="142" Margin="0,0,0,3"
                                ToolTip="All site zones: name, type, vertex coordinates"
                                Click="SiteZonesReport_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📌" Margin="0,0,6,0" />
                                <TextBlock Text="Site Zones Report" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="142"
                                ToolTip="Last GA run outcome: best placement, coverage %, fitness score"
                                Click="OptimizationResultSummary_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏆" Margin="0,0,6,0" />
                                <TextBlock Text="Optimization Results" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0" />

            <!-- ─────────────────  ANALYSIS  ─────────────────────────── -->
            <!--  Only the two wired commands remain; exports moved below  -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="145">
                    <TextBlock DockPanel.Dock="Bottom" Text="ANALYSIS" Style="{StaticResource GroupLabel}" />
                    <StackPanel Margin="0,2,0,0">
                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="132" Margin="0,0,0,3"
                                ToolTip="GA convergence graph and generation statistics"
                                Command="{Binding ShowDiagnosticsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" Margin="0,0,6,0" />
                                <TextBlock Text="GA Diagnostics" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="132"
                                ToolTip="Open the optimization results window"
                                Command="{Binding ShowResultsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,6,0" />
                                <TextBlock Text="View Results" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
