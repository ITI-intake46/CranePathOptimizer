<UserControl
    x:Class="CraneOptimizer.UI.Features.F12_Reports.Views.ReportsTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0" Orientation="Horizontal">

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="ELEMENTS">
                <Button
                    Command="{Binding OpenAllElementsReportCommand}"
                    Content="All Elements List"
                    Style="{StaticResource RibbonMajorCommandTile}"
                    ToolTip="Build an element list report">
                    <Button.Tag>
                        <TextBlock Text="📋" />
                    </Button.Tag>
                </Button>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="LIFTING">
                <Button
                    Command="{Binding OpenLiftingSummaryReportCommand}"
                    Content="Lifting Summary Report"
                    Width="{StaticResource RibbonMajorLongCommandWidth}"
                    Style="{StaticResource RibbonMajorCommandTile}"
                    ToolTip="Build a lifting summary report">
                    <Button.Tag>
                        <TextBlock Text="⛓" />
                    </Button.Tag>
                </Button>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="PROJECT">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Click="ProjectOverview_Click"
                        Content="Project Overview"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}"
                        ToolTip="Project meta + all imported IFC files (name, path, element count, schema, size)">
                        <Button.Tag>
                            <TextBlock Text="📁" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Click="SiteZonesReport_Click"
                        Content="Site Zones Report"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}"
                        ToolTip="All site zones: name, type, vertex coordinates">
                        <Button.Tag>
                            <TextBlock Text="📌" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="ANALYSIS">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding ShowDiagnosticsCommand}"
                        Content="GA Diagnostics"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}"
                        ToolTip="GA convergence graph and generation statistics">
                        <Button.Tag>
                            <TextBlock Text="📈" />
                        </Button.Tag>
                    </Button>
                    <Button
                        Command="{Binding ShowResultsCommand}"
                        Content="View Results"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}"
                        ToolTip="Open the optimization results window">
                        <Button.Tag>
                            <TextBlock Text="📊" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
