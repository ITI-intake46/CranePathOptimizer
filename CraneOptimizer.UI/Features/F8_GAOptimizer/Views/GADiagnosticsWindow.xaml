<Window
    x:Class="CraneOptimizer.UI.Features.F8_GAOptimizer.Views.GADiagnosticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GA Optimization Diagnostics &amp; Reports Viewer"
    Width="1250"
    Height="800"
    Background="{DynamicResource BackgroundBrush}"
    FontFamily="{StaticResource FontPrimary}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <!-- Custom converter for boolean visibility inside the file -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- Inverse boolean to visibility converter -->
        <Style x:Key="VisibleWhenTrue" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectedRunFilesMissing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Fallback/Local Brushes for extreme safety -->
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="CardBrush" Color="#1E293B" />
    </Window.Resources>

    <Grid Margin="{StaticResource Space4}">
        <Grid.RowDefinitions>
            <!-- Header Title -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <!-- Summary Cards -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ───────── HEADER TITLE ─────────  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryBrush}"
                    Text="📈 Genetic Algorithm Diagnostics Viewer" />
                <Border
                    Margin="12,0,0,0"
                    Padding="8,3,8,3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    CornerRadius="10">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="READ-ONLY REPORT VIEWER" />
                </Border>
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSizeSM}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="Active GA CSV Data sources under Reports/GA/" />
        </Grid>

        <!--  ───────── SUMMARY CARDS ─────────  -->
        <UniformGrid
            Grid.Row="2"
            Columns="5"
            Margin="0,4,0,4">

            <!-- Card 1: Latest Run Health -->
            <Border
                Margin="4"
                Padding="{StaticResource Space3}"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="SELECTED RUN HEALTH" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="{Binding SelectedRun.HealthLabel, TargetNullValue='N/A'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="Excellent">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="Good">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="Warning">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="Critical">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 2: Coverage -->
            <Border
                Margin="4"
                Padding="{StaticResource Space3}"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="GA COVERAGE RATIO" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding SelectedRun.CoverageRatio, TargetNullValue='0.00%'}" />
                </StackPanel>
            </Border>

            <!-- Card 3: Lifted / Failed Count -->
            <Border
                Margin="4"
                Padding="{StaticResource Space3}"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="LIFTED / FAILED ELEMENTS" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="{StaticResource SuccessBrush}"
                            Text="{Binding SelectedRun.LiftedElements, TargetNullValue='0'}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="18"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="/" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="{StaticResource DangerBrush}"
                            Text="{Binding SelectedRun.FailedElements, TargetNullValue='0'}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 4: Most Common Failure Reason -->
            <Border
                Margin="4"
                Padding="{StaticResource Space3}"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="MOST COMMON FAILURE" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource WarningBrush}"
                        Text="{Binding MostCommonFailureReason}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding MostCommonFailureReason}" />
                </StackPanel>
            </Border>

            <!-- Card 5: Last Run Timestamp -->
            <Border
                Margin="4"
                Padding="{StaticResource Space3}"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="TIMESTAMP" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedRun.Timestamp, TargetNullValue='N/A'}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding SelectedRun.Timestamp}" />
                </StackPanel>
            </Border>

        </UniformGrid>

        <!--  ───────── EMPTY STATE PANEL ─────────  -->
        <Border
            Grid.Row="4"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}"
            Padding="40"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="64"
                    Text="📈" />
                <TextBlock
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="No GA diagnostics reports found for this project yet." />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource FontSizeSM}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="Run the Crane Optimizer first to generate per-project failure breakdown logs." />
            </StackPanel>
        </Border>

        <!--  ───────── MAIN VIEWER INTERFACE ─────────  -->
        <Grid Grid.Row="4">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="3.8*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Run History DataGrid -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">

                <Grid Margin="{StaticResource Space2}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Style="{StaticResource PanelSectionHeader}"
                        Text="RUN HISTORY LOGS" />

                    <DataGrid
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        SelectionMode="Single"
                        ItemsSource="{Binding RunHistory}"
                        SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="1.2*"
                                Header="Timestamp"
                                Binding="{Binding Timestamp}" />
                            <DataGridTextColumn
                                Width="*"
                                Header="IFC File"
                                Binding="{Binding IfcFileName}" />
                            <DataGridTextColumn
                                Width="*"
                                Header="Crane"
                                Binding="{Binding CraneNameOrId}" />
                            <DataGridTextColumn
                                Width="0.6*"
                                Header="Lifted"
                                Binding="{Binding LiftedElements}" />
                            <DataGridTextColumn
                                Width="0.6*"
                                Header="Failed"
                                Binding="{Binding FailedElements}" />
                            <DataGridTextColumn
                                Width="0.7*"
                                Header="Cov"
                                Binding="{Binding CoverageRatio}" />
                            <DataGridTemplateColumn Width="0.8*" Header="Health">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="4,2,4,2"
                                            CornerRadius="4"
                                            HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HealthLabel}" Value="Excellent">
                                                            <Setter Property="Background" Value="#1A2ECC71" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HealthLabel}" Value="Good">
                                                            <Setter Property="Background" Value="#1A2ECC71" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HealthLabel}" Value="Warning">
                                                            <Setter Property="Background" Value="#1AF1C40F" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HealthLabel}" Value="Critical">
                                                            <Setter Property="Background" Value="#1AE74C3C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                FontWeight="Bold"
                                                FontSize="11"
                                                Text="{Binding HealthLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HealthLabel}" Value="Excellent">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HealthLabel}" Value="Good">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HealthLabel}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HealthLabel}" Value="Critical">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="{DynamicResource BorderBrush}" />

            <!-- RIGHT PANEL: Selection details & tabs -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Warning overlay for deleted files -->
                <Border
                    Panel.ZIndex="10"
                    Background="#D91A1A1A"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="20"
                    Margin="0,0,0,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectedRunFilesMissing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Text="⚠️" />
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource DangerBrush}"
                            Text="Diagnostics Files Deleted or Missing from Disk" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="The CSV data files for this history run are no longer available under:" />
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontFamily="Consolas"
                            Foreground="{StaticResource WarningBrush}"
                            Text="{Binding SelectedRun.DetailedDiagnosticsCsvPath}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Tabs Container -->
                <TabControl
                    Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                    
                    <!-- TAB 1: FAILURE BREAKDOWN -->
                    <TabItem Header="📊 FAILURE BREAKDOWN" Height="30" FontWeight="SemiBold">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Style="{StaticResource PanelSectionHeader}"
                                Text="FAILURE CATEGORY PERCENTAGES" />

                            <DataGrid
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding FailureBreakdown}"
                                Background="Transparent"
                                BorderThickness="0"
                                HeadersVisibility="Column"
                                GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="1.8*"
                                        Header="Category"
                                        Binding="{Binding FailureCategory}" />
                                    <DataGridTextColumn
                                        Width="0.6*"
                                        Header="Count"
                                        Binding="{Binding Count}" />
                                    <DataGridTextColumn
                                        Width="0.8*"
                                        Header="% Failed"
                                        Binding="{Binding PercentageOfFailedElements}" />
                                    <DataGridTextColumn
                                        Width="0.8*"
                                        Header="% Selected"
                                        Binding="{Binding PercentageOfSelectedElements}" />
                                    
                                    <!-- Progress Bar Column -->
                                    <DataGridTemplateColumn Width="2*" Header="Breakdown visualizer">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center" Margin="4,2,4,2">
                                                    <ProgressBar
                                                        Height="12"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="{Binding PctFailedValue, Mode=OneWay}"
                                                        Foreground="{StaticResource PrimaryBrush}"
                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                        BorderThickness="0" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="9"
                                                        FontWeight="Bold"
                                                        Foreground="#FFFFFFFF"
                                                        Text="{Binding PercentageOfFailedElements}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: DETAILED ELEMENT LOGS -->
                    <TabItem Header="📋 DETAILED ELEMENT LOGS" Height="30" FontWeight="SemiBold">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <!-- Filters panel -->
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <!-- Element grid -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Filters panel structure -->
                            <Border
                                Grid.Row="0"
                                Padding="8"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0: Search & Checkbox -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            FontSize="11"
                                            Text="Search:" />
                                        <TextBox
                                            Width="140"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            FontSize="11"
                                            Text="Category:" />
                                        <ComboBox
                                            Width="130"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding CategoryFilters}"
                                            SelectedItem="{Binding SelectedCategoryFilter}" />
                                    </StackPanel>

                                    <CheckBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding ShowFailedOnly}"
                                        Content="Show failed elements only" />

                                    <!-- Row 2: Health & Element Type -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            FontSize="11"
                                            Text="Lift Prio:" />
                                        <ComboBox
                                            Width="140"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding HealthFilters}"
                                            SelectedItem="{Binding SelectedHealthFilter}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            FontSize="11"
                                            Text="Elem Type:" />
                                        <ComboBox
                                            Width="130"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding ElementTypeFilters}"
                                            SelectedItem="{Binding SelectedElementTypeFilter}" />
                                    </StackPanel>
                                    
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Text="{Binding FilteredDiagnostics.Count, StringFormat=Filtered Elements: {0}}" />
                                </Grid>
                            </Border>

                            <!-- Detailed Elements DataGrid -->
                            <DataGrid
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding FilteredDiagnostics}"
                                Background="Transparent"
                                BorderThickness="0"
                                HeadersVisibility="Column"
                                GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Element ID" Binding="{Binding ElementId}" />
                                    <DataGridTextColumn Header="Mark" Binding="{Binding ElementName}" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding ElementType}" />
                                    <DataGridTextColumn Header="Storey/Elev" Binding="{Binding StoreyOrElevation}" />
                                    <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:F2}}" />
                                    <DataGridTextColumn Header="Setup Index" Binding="{Binding AssignedSetupIndex}" />
                                    <DataGridTextColumn Header="COG X" Binding="{Binding CogX, StringFormat={}{0:F2}}" />
                                    <DataGridTextColumn Header="COG Y" Binding="{Binding CogY, StringFormat={}{0:F2}}" />
                                    <DataGridTextColumn Header="Best Radius" Binding="{Binding BestRadius, StringFormat={}{0:F2}}" />
                                    <DataGridTextColumn Header="Req Boom" Binding="{Binding RequiredBoomLength, StringFormat={}{0:F2}}" />
                                    <DataGridTextColumn Header="Req Cap" Binding="{Binding RequiredCapacity, StringFormat={}{0:F2}}" />
                                    <DataGridTextColumn Header="Avail Cap" Binding="{Binding AvailableCapacity, StringFormat={}{0:F2}}" />
                                    
                                    <!-- Lift Status column with rich tooltip -->
                                    <DataGridTemplateColumn Header="Lift Status">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LiftStatus}" FontWeight="SemiBold"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                    <TextBlock.ToolTip>
                                                        <ToolTip Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                            <StackPanel Margin="4" MinWidth="260">
                                                                <!-- MODE 1: Final Assignment Tooltip -->
                                                                <StackPanel>
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Path=PlacementTarget.Tag.CurrentGAViewMode, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="FinalAssignment">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    
                                                                    <StackPanel>
                                                                        <!-- SECTION A: Assigned to Selected Point -->
                                                                        <StackPanel>
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsFinalAssignedToPoint}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            
                                                                            <TextBlock Text="🟢 Assigned to Selected Setup" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,6"/>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                
                                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Reach Status:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ReachStatus}" FontWeight="SemiBold"/>
                                                                                
                                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Chart Status:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ChartStatus}" FontWeight="SemiBold"/>
                                                                                
                                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Safety Margin:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SafetyMargin, StringFormat={}{0:F2}}" FontWeight="SemiBold"/>
                                                                                
                                                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Required Radius:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding RequiredRadius, StringFormat={}{0:F2} m}"/>
                                                                                
                                                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Required Boom:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding RequiredBoomLength, StringFormat={}{0:F2} m}"/>
                                                                                
                                                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Available Capacity:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding AvailableCapacity, StringFormat={}{0:F2} t}"/>
                                                                                
                                                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Assigned Setup:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding AssignedPointId}" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                                                                
                                                                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Assignment Reason:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding AssignmentReason}"/>
                                                                                
                                                                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Feasible Setup Points:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding FeasiblePointIds}" TextWrapping="Wrap" MaxWidth="180"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        
                                                                        <!-- SECTION B: Assigned to Another Point -->
                                                                        <StackPanel>
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding IsFinalAssigned}" Value="True" />
                                                                                                <Condition Binding="{Binding IsFinalAssignedToPoint}" Value="False" />
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            
                                                                            <TextBlock Text="🪙 Assigned to Another Setup" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                
                                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Owner Setup Point:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AssignedPointId}" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"/>
                                                                                
                                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Assignment Status:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Feasible &amp; Lifted" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                                                                
                                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Feasible Setup Points:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FeasiblePointIds}" TextWrapping="Wrap" MaxWidth="180"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        
                                                                        <!-- SECTION C: Unassigned Failed -->
                                                                        <StackPanel>
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsFinalAssigned}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            
                                                                            <TextBlock Text="🔴 Unassigned / Lift Failure" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6"/>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                
                                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Best Failed Setup:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding BestFailedPointId}" FontWeight="SemiBold"/>
                                                                                
                                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Failure Status:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BestFailedLiftStatus}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                                                
                                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Failure Reason:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BestFailureReason}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                                                                                
                                                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Best Safety Margin:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding BestFailedSafetyMargin, StringFormat={}{0:F2}}" FontWeight="SemiBold"/>
                                                                                
                                                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Best Failed Radius:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding BestFailedRequiredRadius, StringFormat={}{0:F2} m}"/>
                                                                                
                                                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Best Failed Boom:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding BestFailedRequiredBoomLength, StringFormat={}{0:F2} m}"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- MODE 2: Selected Point Feasibility Tooltip -->
                                                                <StackPanel>
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Path=PlacementTarget.Tag.CurrentGAViewMode, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="SelectedPointFeasibility">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="🎯 Selected Point Feasibility" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" Margin="0,0,0,6"/>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        
                                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Candidate Point ID:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CandidatePointId}" FontWeight="SemiBold"/>
                                                                        
                                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Point Lift Status:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LiftStatus}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                                        
                                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Required Radius:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RequiredRadius, StringFormat={}{0:F2} m}"/>
                                                                        
                                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Required Boom:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding RequiredBoomLength, StringFormat={}{0:F2} m}"/>
                                                                        
                                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Selected Chart Radius:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SelectedChartRadius, StringFormat={}{0:F2} m}"/>
                                                                        
                                                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Selected Chart Boom:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding SelectedChartBoomLength, StringFormat={}{0:F2} m}"/>
                                                                        
                                                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Available Capacity:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding AvailableCapacity, StringFormat={}{0:F2} t}"/>
                                                                        
                                                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Candidate Booms Checked:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding CandidateBoomsChecked}" TextWrapping="Wrap" MaxWidth="180"/>
                                                                        
                                                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Rejected Candidates:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding RejectedCandidates}" TextWrapping="Wrap" MaxWidth="180"/>
                                                                        
                                                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Final Owner Point:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="9" Grid.Column="2" Text="{Binding AssignedPointId, TargetNullValue='Unassigned'}" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- MODE 3: All Feasible Debug Tooltip -->
                                                                <StackPanel>
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Path=PlacementTarget.Tag.CurrentGAViewMode, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="AllFeasibleDebug">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="🛠️ All Feasible Debug Matrix" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,6"/>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        
                                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Feasible Setup Points:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding FeasiblePointIds, TargetNullValue='None'}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" MaxWidth="180"/>
                                                                        
                                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Final Owner Point ID:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AssignedPointId, TargetNullValue='Unassigned'}" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"/>
                                                                        
                                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Assignment Score:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding AssignmentScore, StringFormat={}{0:F4}}" FontWeight="SemiBold"/>
                                                                        
                                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Assignment Reason:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding AssignmentReason, TargetNullValue='N/A'}" TextWrapping="Wrap" MaxWidth="180"/>
                                                                        
                                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Best Failed Setup ID:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding BestFailedPointId, TargetNullValue='N/A'}"/>
                                                                        
                                                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Best Failure Reason:" Foreground="{StaticResource MutedTextBrush}"/>
                                                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding BestFailureReason, TargetNullValue='N/A'}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="180"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Rich diagnostic columns -->
                                    <DataGridTextColumn Header="Reach Status" Binding="{Binding ReachStatus}" />
                                    <DataGridTextColumn Header="Chart Status" Binding="{Binding ChartStatus}" />
                                    <DataGridTextColumn Header="Lookup Mode" Binding="{Binding LookupMode}" />
                                    <DataGridTextColumn Header="Req Radius" Binding="{Binding RequiredRadius, StringFormat={}{0:F2}}" />
                                    <DataGridTextColumn Header="Chart Radius" Binding="{Binding SelectedChartRadius, StringFormat={}{0:F2}}" />
                                    <DataGridTextColumn Header="Chart Boom" Binding="{Binding SelectedChartBoomLength, StringFormat={}{0:F2}}" />
                                    <DataGridTextColumn Header="Safety Margin" Binding="{Binding SafetyMargin, StringFormat={}{0:F2}}" />

                                    <!-- IsExactMatch Template Column -->
                                    <DataGridTemplateColumn Header="Exact Match">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExactMatch}" Value="True">
                                                                    <Setter Property="Text" Value="✔️" />
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExactMatch}" Value="False">
                                                                    <Setter Property="Text" Value="❌" />
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- IsSteppedRadius Template Column -->
                                    <DataGridTemplateColumn Header="Stepped Rad">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSteppedRadius}" Value="True">
                                                                    <Setter Property="Text" Value="✔️" />
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSteppedRadius}" Value="False">
                                                                    <Setter Property="Text" Value="-" />
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- IsBlankCell Template Column -->
                                    <DataGridTemplateColumn Header="Blank Cell">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBlankCell}" Value="True">
                                                                    <Setter Property="Text" Value="⚠️ Blank" />
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBlankCell}" Value="False">
                                                                    <Setter Property="Text" Value="-" />
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- IsZeroCell Template Column -->
                                    <DataGridTemplateColumn Header="Zero Cell">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsZeroCell}" Value="True">
                                                                    <Setter Property="Text" Value="🚫 Zero" />
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsZeroCell}" Value="False">
                                                                    <Setter Property="Text" Value="-" />
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <!-- Is Lifted CheckBox column -->
                                    <DataGridTemplateColumn Header="Lifted">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontWeight="Bold"
                                                    FontSize="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLifted}" Value="True">
                                                                    <Setter Property="Text" Value="✔️" />
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLifted}" Value="False">
                                                                    <Setter Property="Text" Value="❌" />
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Failure Reason" Binding="{Binding FailureReason}" />
                                    <DataGridTextColumn Header="Failure Category" Binding="{Binding FailureCategory}" />
                                    <DataGridTextColumn Header="Suggested Action" Binding="{Binding SuggestedAction}" Width="200" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Bottom panel: CSV open buttons -->
                <Border
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Padding="{StaticResource Space2}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding SelectedRun.DetailedDiagnosticsCsvPath, StringFormat=Source: {0}}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding SelectedRun.DetailedDiagnosticsCsvPath}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Padding="8,4,8,4"
                                Content="📄 Open Detailed CSV"
                                Command="{Binding OpenDiagnosticsCsvCommand}"
                                Style="{StaticResource ButtonSecondary}" />
                            <Button
                                Padding="8,4,8,4"
                                Content="📊 Open Breakdown CSV"
                                Command="{Binding OpenBreakdownCsvCommand}"
                                Style="{StaticResource ButtonSecondary}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
