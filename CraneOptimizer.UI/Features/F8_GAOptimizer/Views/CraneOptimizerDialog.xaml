    <Window
    x:Class="CraneOptimizer.UI.Features.F8_GAOptimizer.Views.CraneOptimizerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CraneOptimizer.UI.Core.Controls"
    Title="Crane Position Optimizer"
    Width="560"
    Height="690"
    MinWidth="560"
    MinHeight="650"
    Background="{DynamicResource BackgroundBrush}"
    FontFamily="{StaticResource FontPrimary}"
    FontSize="{StaticResource FontSizeBase}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="InfoIconBorder" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="!" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>




    <Grid Margin="{StaticResource Space4}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AdvancedColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        FontSize="{StaticResource FontSizeLG}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Crane Selection Optimization"
                        TextAlignment="Left"
                        VerticalAlignment="Center" />

                    <Button
                        x:Name="BtnAdvancedToggle"
                        Grid.Column="1"
                        Click="BtnAdvancedToggle_Click"
                        Content="Advanced Options"
                        Style="{StaticResource ButtonSecondary}" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Padding="{StaticResource Space3}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource PanelSectionHeader}" Text="CRANE SELECTION" />

                        <TextBlock
                            Grid.Row="2"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Crane to optimise" />

                        <ComboBox
                            x:Name="CboCrane"
                            Grid.Row="4"
                            DisplayMemberPath="Name"
                            ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                            Style="{StaticResource DarkComboBox}" />
                    </Grid>
                </Border>

                <Border
                    x:Name="PanelResults"
                    Grid.Row="4"
                    Padding="{StaticResource Space3}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource PanelSectionHeader}" Text="RESULTS" />

                        <ListBox
                            x:Name="PointsList"
                            Grid.Row="2"
                            DisplayMemberPath="DisplayText"
                            SelectionChanged="PointsList_SelectionChanged" />

                        <TextBlock
                            x:Name="TxtScore"
                            Grid.Row="4"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeLG}"
                            FontWeight="Bold"
                            Foreground="{StaticResource SuccessBrush}" />

                        <TextBlock
                            x:Name="TxtPosition"
                            Grid.Row="6"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                        <UniformGrid Grid.Row="8" Columns="3">
                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountL"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Liftable" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountNL"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource WarningBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Non-Liftable" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountUR"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DestructiveBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Unreachable" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock
                            x:Name="TxtCoverage"
                            Grid.Row="10"
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SuccessBrush}" />

                        <TextBlock
                            x:Name="TxtStopReason"
                            Grid.Row="12"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <Border
                x:Name="PanelAdvanced"
                Grid.Column="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
                <ScrollViewer
                    CanContentScroll="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource Space4}">
                        <TextBlock
                            Style="{StaticResource PanelSectionHeader}"
                            Text="ADVANCED OPTIONS" />

                        <TextBlock
                            Margin="{StaticResource Space1}"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Fine-tune optimization behavior, engineering conservatism, and search performance."
                            TextWrapping="Wrap" />

                        <!-- 1. Core Calibration -->
                        <Expander
                            Margin="{StaticResource Space1}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Header="1. Core Calibration"
                            IsExpanded="True">
                            <StackPanel Margin="{StaticResource Space2}">
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Population Size" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="PopulationSize" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtPopulationSize" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="30" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Max Generations" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MaxGenerations" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtMaxGenerations" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="30" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Mutation Rate" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MutationRate" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtDevMutationRate" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.10" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Mutation Sigma" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MutationSigma" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtDevMutationSigma" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.05" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Max Crane Positions" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MaxCranePositions" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtMaxCranePositions" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="3" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Early Stop Generations" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="EarlyStoppingGenerations" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtEarlyStopping" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="20" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Convergence Threshold (%)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="ConvergenceThresholdPercent" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtDevConvergence" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- 2. Fitness Strategy -->
                        <Expander
                            Margin="{StaticResource Space1}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Header="2. Fitness Strategy"
                            IsExpanded="True">
                            <StackPanel Margin="{StaticResource Space2}">
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Coverage Weight" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="CoverageWeight" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtCoverageWeight" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="10" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Relocation Weight" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="RelocationWeight" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtRelocationWeight" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="5" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Radius Penalty Weight" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="RadiusPenaltyWeight" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtRadiusPenaltyWeight" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="3" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Radius Quality Weight" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="RadiusQualityPenaltyWeight" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtRadiusQualityPenaltyWeight" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="1.0" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Balance Penalty Weight" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="BalancePenaltyWeight" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtBalancePenaltyWeight" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="2" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Radius StdDev Weight" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="RadiusStdDevPenaltyWeight" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtRadiusStdDevPenaltyWeight" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="2" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Similar Position Weight" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="SimilarPositionPenaltyWeight" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtSimilarPositionPenaltyWeight" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="8" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Relocation Dist Weight" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="RelocationDistancePenaltyWeight" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtRelocationDistancePenaltyWeight" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="1.5" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Overweight Weight" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="OverweightPenaltyWeight" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtOverweightPenaltyWeight" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="10" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Height Penalty Weight" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="HeightPenaltyWeight" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtHeightPenaltyWeight" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="5" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- 3. Layout Constraints -->
                        <Expander
                            Margin="{StaticResource Space1}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Header="3. Layout Constraints"
                            IsExpanded="True">
                            <StackPanel Margin="{StaticResource Space2}">
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Min Relocation Dist (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MinimumRelocationDistance" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtMinimumRelocationDistance" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="10" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Grid Step (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="GridStep" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtGridStep" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                    <TextBlock FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="TARGET ELEMENTS ALLOW-LIST" VerticalAlignment="Center" />
                                    <controls:ParameterHelpIcon ParameterKey="TargetElementTypes" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="TxtTargetElementSummary"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeXS}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        Grid.Column="1"
                                        MinHeight="22"
                                        Padding="6,2"
                                        Click="BtnIncludeAll_Click"
                                        Content="All"
                                        Style="{StaticResource ButtonSecondary}" />

                                    <Button
                                        Grid.Column="3"
                                        MinHeight="22"
                                        Padding="6,2"
                                        Click="BtnExcludeAll_Click"
                                        Content="None"
                                        Style="{StaticResource ButtonSecondary}" />
                                </Grid>

                                <Border
                                    Margin="{StaticResource Space1}"
                                    Padding="{StaticResource Space2}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Background="{DynamicResource SurfaceBrush}">
                                    <ScrollViewer
                                        MaxHeight="200"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="TargetElementTypesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox
                                                        Margin="0,3"
                                                        VerticalContentAlignment="Center"
                                                        Content="{Binding DisplayText}"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Checked="TargetElementType_Changed"
                                                        Unchecked="TargetElementType_Changed" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- 4. Engineering Model -->
                        <Expander
                            Margin="{StaticResource Space1}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Header="4. Engineering Model"
                            IsExpanded="False">
                            <StackPanel Margin="{StaticResource Space2}">
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Wire Length (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="WireLength" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtWireLength" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="2.0" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Hook Weight (t)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="AdditionalWt" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtAdditionalWt" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.0" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Derating" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="DeratingRatio" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtDeratingRatio" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.9" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Safety Factor" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="SafetyFactor" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtSafetyFactor" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.95" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- 5. Advanced GA -->
                        <Expander
                            Margin="{StaticResource Space1}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Header="5. Advanced GA"
                            IsExpanded="False">
                            <StackPanel Margin="{StaticResource Space2}">
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Random Seed" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="RandomSeed" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtDevRandomSeed" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="42" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Crossover Rate" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="CrossoverRate" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtDevCrossoverRate" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.80" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Mutation Explore Mult" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MutationExplorationMultiplier" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtMutationExplorationMultiplier" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="2.0" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Enable Adaptive Sigma" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="EnableAdaptiveSigma" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableAdaptiveSigma" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="False" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Sigma Cooling Exponent" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="SigmaCoolingExponent" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtSigmaCoolingExponent" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="1.5" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Min Mutation Sigma (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MinimumMutationSigma" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtMinimumMutationSigma" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.5" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Sampling Attempts" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="PositionSamplingAttempts" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtPositionSamplingAttempts" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="80" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Concurrent Opt" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="EnableConcurrentOptimization" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableConcurrentOptimization" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="True" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- 6. Diagnostics -->
                        <Expander
                            Margin="{StaticResource Space1}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Header="6. Diagnostics"
                            IsExpanded="False">
                            <StackPanel Margin="{StaticResource Space2}">
                                <TextBlock FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="SLEW CENTER OFFSETS" />
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Offset X (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="SlewOffsetX" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtSlewOffsetX" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.0" />
                                </Grid>
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Offset Y (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="SlewOffsetY" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtSlewOffsetY" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.0" />
                                </Grid>
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Offset Z (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="SlewOffsetZ" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtSlewOffsetZ" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.0" />
                                </Grid>

                                <TextBlock Margin="0,8,0,0" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="BOOM HINGE OFFSETS" />
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Offset X (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="BoomHingeOffsetX" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtBoomHingeOffsetX" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.0" />
                                </Grid>
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Offset Y (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="BoomHingeOffsetY" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtBoomHingeOffsetY" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.0" />
                                </Grid>
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Offset Z (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="BoomHingeOffsetZ" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtBoomHingeOffsetZ" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.0" />
                                </Grid>

                                <TextBlock Margin="0,8,0,0" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="NORMALIZATION &amp; SEPARATION" />
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Max Radius Norm (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MaxRadiusForNormalisation" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtMaxRadiusForNormalisation" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="50" />
                                </Grid>
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Duplicate Dist (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="DuplicatePositionDistance" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtDuplicatePositionDistance" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="3" />
                                </Grid>
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Footprint Radius (m)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="CraneFootprintRadius" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtCraneFootprintRadius" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.0" />
                                </Grid>

                                <TextBlock Margin="0,8,0,0" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="PROFILING" />
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Enable Profiling" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="EnableProfiling" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableProfiling" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="True" />
                                </Grid>
                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Profiling Log Directory" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="ProfilingLogDirectory" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="{StaticResource Space1}">
                                    <TextBox x:Name="TxtProfilingLogDirectory" MinHeight="{StaticResource InputHeight}" VerticalContentAlignment="Center" Padding="4" Text="" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="{StaticResource Space3}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BtnRun"
                    Grid.Column="0"
                    MinHeight="{StaticResource InputHeight}"
                    Click="BtnRun_Click"
                    Content="Run"
                    Style="{StaticResource ButtonPrimary}" />

                <Button
                    x:Name="BtnCancel"
                    Grid.Column="2"
                    MinHeight="{StaticResource InputHeight}"
                    Click="BtnCancelRun_Click"
                    Content="Cancel"
                    IsEnabled="False"
                    Style="{StaticResource ButtonSecondary}" />

                <Button
                    x:Name="BtnApply"
                    Grid.Column="4"
                    MinHeight="{StaticResource InputHeight}"
                    Click="BtnApply_Click"
                    Content="Apply"
                    IsEnabled="False"
                    Style="{StaticResource ButtonPrimary}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Padding="{StaticResource Space3}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar
                    x:Name="ProgBar"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0" />

                <TextBlock
                    x:Name="TxtStatus"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeSM}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="Ready" />
            </Grid>
        </Border>
    </Grid>
</Window>
