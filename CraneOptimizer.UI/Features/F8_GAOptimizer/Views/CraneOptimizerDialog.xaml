    <Window
    x:Class="CraneOptimizer.UI.Features.F8_GAOptimizer.Views.CraneOptimizerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CraneOptimizer.UI.Core.Controls"
    Title="Crane Position Optimizer"
    Width="560"
    Height="690"
    MinWidth="560"
    MinHeight="650"
    Background="{DynamicResource BackgroundBrush}"
    FontFamily="{StaticResource FontPrimary}"
    FontSize="{StaticResource FontSizeBase}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="InfoIconBorder" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoIconText" TargetType="TextBlock">
            <Setter Property="Text" Value="!" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>




    <Grid Margin="{StaticResource Space4}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AdvancedColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        FontSize="{StaticResource FontSizeLG}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Crane Selection Optimization"
                        TextAlignment="Left"
                        VerticalAlignment="Center" />

                    <Button
                        x:Name="BtnAdvancedToggle"
                        Grid.Column="1"
                        Click="BtnAdvancedToggle_Click"
                        Content="Advanced Options"
                        Style="{StaticResource ButtonSecondary}" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Padding="{StaticResource Space3}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource PanelSectionHeader}" Text="CRANE SELECTION" />

                        <TextBlock
                            Grid.Row="2"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Crane to optimise" />

                        <ComboBox
                            x:Name="CboCrane"
                            Grid.Row="4"
                            DisplayMemberPath="Name"
                            ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                            SelectionChanged="CboCrane_SelectionChanged"
                            Style="{StaticResource DarkComboBox}" />
                    </Grid>
                </Border>
                <Border
                    Grid.Row="4"
                    Padding="{StaticResource Space3}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelSectionHeader}" Text="LOAD CHART OPERATING SETUP" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Optional GA load-chart constraint. Leave collapsed to use the automatic default."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Padding="10,4"
                                VerticalAlignment="Top"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <TextBlock
                                    FontSize="{StaticResource FontSizeXS}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="{Binding OperatingSetupConstraintBadgeText}" />
                            </Border>

                            <ToggleButton
                                Grid.Column="3"
                                Padding="10,4"
                                VerticalAlignment="Top"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                IsChecked="{Binding IsLoadChartOperatingSetupExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border
                                            x:Name="ToggleChrome"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource CardCornerRadius}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeXS}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding LoadChartOperatingSetupDisclosureText}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontSize="{StaticResource FontSizeXS}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding LoadChartOperatingSetupDisclosureGlyph}" />
                                </StackPanel>
                            </ToggleButton>
                        </Grid>

                        <TextBlock
                            Grid.Row="2"
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding OperatingSetupCollapsedSummary}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="4"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding OperatingSetupCollapsedSubtext}"
                            TextWrapping="Wrap" />

                        <Grid
                            Grid.Row="6"
                            Visibility="{Binding LoadChartOperatingSetupDetailsVisibility}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Operating setup constraint" />

                            <Grid
                                Grid.Row="2"
                                IsEnabled="{Binding IsLoadChartOperatingSetupSelectorEnabled}"
                                ToolTip="{Binding LoadChartOperatingSetupStatus}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeXS}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{Binding OperatingSetupScaleStartLabel}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        FontSize="{StaticResource FontSizeXS}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{Binding OperatingSetupScaleEndLabel}" />
                                </Grid>

                                <Slider
                                    x:Name="SldLoadChartOperatingSetup"
                                    Grid.Row="2"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="1"
                                    Maximum="{Binding OperatingSetupSliderMaximum}"
                                    Minimum="0"
                                    SmallChange="1"
                                    TickFrequency="1"
                                    TickPlacement="BottomRight"
                                    Value="{Binding SelectedLoadChartOperatingSetupSliderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <ItemsControl
                                    Grid.Row="4"
                                    ItemsSource="{Binding OperatingSetupScaleStopLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="{StaticResource FontSizeXS}"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <TextBlock
                                Grid.Row="4"
                                FontSize="{StaticResource FontSizeXS}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding OperatingSetupChartCoverageSummary}"
                                TextWrapping="Wrap" />

                            <Border
                                Grid.Row="6"
                                Padding="{StaticResource Space2}"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="{StaticResource FontSizeXS}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Text="SELECTED SETUP INTUITION" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="{StaticResource FontSizeXS}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Text="{Binding OperatingSetupSelectedTitle}" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="2"
                                        FontSize="{StaticResource FontSizeXS}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{Binding OperatingSetupIntuitionSummary}"
                                        TextWrapping="Wrap" />

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Padding="{StaticResource Space2}"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CardCornerRadius}">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="{StaticResource FontSizeXS}"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    Text="Line-support index" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="{StaticResource FontSizeLG}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    Text="{Binding CapacityTendencyValue}" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="{StaticResource FontSizeXS}"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    Text="{Binding LineSupportIndexExplanation}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Column="2"
                                            Padding="{StaticResource Space2}"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CardCornerRadius}">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="{StaticResource FontSizeXS}"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    Text="Hook-speed intuition" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="{StaticResource FontSizeLG}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    Text="{Binding HookSpeedTendencyValue}" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="{StaticResource FontSizeXS}"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    Text="{Binding HookSpeedIndexExplanation}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock
                                Grid.Row="8"
                                FontSize="{StaticResource FontSizeXS}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding OperatingSetupSafetyNote}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    x:Name="PanelResults"
                    Grid.Row="6"
                    Padding="{StaticResource Space3}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource PanelSectionHeader}" Text="RESULTS" />

                        <ListBox
                            x:Name="PointsList"
                            Grid.Row="2"
                            DisplayMemberPath="DisplayText"
                            SelectionChanged="PointsList_SelectionChanged" />

                        <TextBlock
                            x:Name="TxtScore"
                            Grid.Row="4"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeLG}"
                            FontWeight="Bold"
                            Foreground="{StaticResource SuccessBrush}" />

                        <TextBlock
                            x:Name="TxtPosition"
                            Grid.Row="6"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                        <UniformGrid Grid.Row="8" Columns="3">
                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountL"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Selected Point Liftable" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountNL"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource WarningBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Selected Point Non-Liftable" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountUR"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DestructiveBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Selected Point Unreachable" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock
                            x:Name="TxtCoverage"
                            Grid.Row="10"
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SuccessBrush}" />

                        <TextBlock
                            x:Name="TxtStopReason"
                            Grid.Row="12"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <Border
                x:Name="PanelAdvanced"
                Grid.Column="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
                <ScrollViewer
                    CanContentScroll="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource Space4}">
                        <TextBlock
                            Style="{StaticResource PanelSectionHeader}"
                            Text="ADVANCED OPTIONS" />

                        <TextBlock
                            Margin="{StaticResource Space1}"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Fine-tune optimization behavior, engineering conservatism, and search performance."
                            TextWrapping="Wrap" />

                        <!-- Search Bar -->
                        <Grid Margin="{StaticResource Space1}">
                            <TextBox x:Name="TxtSearchParameters"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{StaticResource FontSizeSM}"
                                     MinHeight="{StaticResource InputHeight}"
                                     Padding="8,4"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource SurfaceBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Search parameters..."
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           FontStyle="Italic"
                                                                           Margin="8,0,0,0" />
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>

                        <!-- 1. Core Calibration -->
                        <Expander
                            Margin="{StaticResource Space1}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Header="1. Core Calibration"
                            Visibility="{Binding SectionCoreCalibration.Visibility}"
                            IsExpanded="True">
                            <StackPanel Margin="{StaticResource Space2}">
                                <Grid Margin="{StaticResource Space1}" Visibility="{Binding ParamPopulationSize.Visibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Population Size" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="PopulationSize" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtPopulationSize" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="30" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}" Visibility="{Binding ParamMaxGenerations.Visibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Max Generations" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MaxGenerations" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtMaxGenerations" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="30" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}" Visibility="{Binding ParamMutationRate.Visibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Mutation Rate" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MutationRate" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtDevMutationRate" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.10" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}" Visibility="{Binding ParamMutationSigma.Visibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Mutation Sigma" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MutationSigma" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtDevMutationSigma" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.05" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}" Visibility="{Binding ParamMaxCranePositions.Visibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Max Crane Positions" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="MaxCranePositions" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtMaxCranePositions" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="3" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}" Visibility="{Binding ParamEarlyStopGenerations.Visibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Early Stop Generations" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="EarlyStoppingGenerations" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtEarlyStopping" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="20" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}" Visibility="{Binding ParamConvergenceThreshold.Visibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Convergence Threshold (%)" VerticalAlignment="Center" />
                                        <controls:ParameterHelpIcon ParameterKey="ConvergenceThresholdPercent" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="TxtDevConvergence" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- 2. Fitness Strategy -->
                        <Expander
                            Margin="{StaticResource Space1}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Header="2. Fitness Strategy"
                            Visibility="{Binding SectionFitnessStrategy.Visibility}"
                            IsExpanded="True">
                            <StackPanel Margin="{StaticResource Space2}">
                                <Grid Margin="{StaticResource Space1}" Visibility="{Binding ParamCoverageWeight.Visibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
