<Window
    x:Class="CraneOptimizer.UI.Features.F8_GAOptimizer.Views.CraneOptimizerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Crane Position Optimizer"
    Width="300"
    Height="640"
    Background="{DynamicResource BackgroundBrush}"
    FontFamily="{StaticResource FontPrimary}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  Cards  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!--  Section Title  -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--  Labels  -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Inputs  -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  MAIN CONTENT  -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  Crane Selection  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="CRANE SELECTION" />

                        <TextBlock Style="{StaticResource Lbl}" Text="Crane to optimise:" />
                        <ComboBox
                            x:Name="CboCrane"
                            DisplayMemberPath="Name"
                            ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                            SelectionChanged="CboCrane_SelectionChanged"
                            Style="{StaticResource DarkComboBox}" />

                        <TextBlock
                            x:Name="TxtChartStatus"
                            Margin="0,6,0,0"
                            FontSize="10"
                            Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Expander
                        Background="Transparent"
                        BorderThickness="0"
                        Header="⚙ Advanced Options"
                        IsExpanded="False">

                        <StackPanel Margin="0,10,0,0">

                            <!--  Algorithm Settings  -->
                            <TextBlock Style="{StaticResource Section}" Text="ALGORITHM SETTINGS" />

                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource Lbl}"
                                    Text="Population Size" />
                                <TextBox
                                    x:Name="TxtPopulation"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="30" />

                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource Lbl}"
                                    Text="Max Generations" />
                                <TextBox
                                    x:Name="TxtGenerations"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="30" />

                                <TextBlock
                                    Grid.Row="4"
                                    Style="{StaticResource Lbl}"
                                    Text="Mutation Rate" />
                                <TextBox
                                    x:Name="TxtMutRate"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="0.10" />

                                <TextBlock
                                    Grid.Row="6"
                                    Style="{StaticResource Lbl}"
                                    Text="Mutation Sigma" />
                                <TextBox
                                    x:Name="TxtMutSigma"
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Text="0.05" />

                                <TextBlock
                                    Grid.Row="8"
                                    Style="{StaticResource Lbl}"
                                    Text="Grid Step (m)" />
                                <TextBox
                                    x:Name="TxtGridStep"
                                    Grid.Row="8"
                                    Grid.Column="1"
                                    Text="2.0" />

                                <TextBlock
                                    Grid.Row="10"
                                    Style="{StaticResource Lbl}"
                                    Text="Convergence (%)"
                                    ToolTip="0 = always run full generations" />
                                <TextBox
                                    x:Name="TxtConverge"
                                    Grid.Row="10"
                                    Grid.Column="1"
                                    Text="0" />
                            </Grid>

                            <!--  Penalty Weights  -->
                            <TextBlock Style="{StaticResource Section}" Text="PENALTY WEIGHTS" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource Lbl}"
                                    Text="Non-Liftable penalty" />
                                <TextBox
                                    x:Name="TxtPenNL"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="20" />

                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource Lbl}"
                                    Text="Unreachable penalty" />
                                <TextBox
                                    x:Name="TxtPenUR"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="100" />
                            </Grid>

                        </StackPanel>
                    </Expander>
                </Border>

                <!--  Results  -->
                <Border
                    x:Name="PanelResults"
                    Style="{StaticResource Card}"
                    Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Style="{StaticResource Section}" Text="RESULTS" />

                        <ListBox
                            x:Name="PointsList"
                            Height="140"
                            Margin="0,0,0,10"
                            DisplayMemberPath="DisplayText"
                            SelectionChanged="PointsList_SelectionChanged" />

                        <TextBlock
                            x:Name="TxtScore"
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{StaticResource SuccessBrush}" />

                        <TextBlock
                            x:Name="TxtPosition"
                            Margin="0,4"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!--  Stats  -->
                        <UniformGrid Margin="0,10,0,0" Columns="3">
                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountL"
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="9"
                                    Text="Liftable" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountNL"
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource WarningBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="9"
                                    Text="Non-Liftable" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountUR"
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DestructiveBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="9"
                                    Text="Unreachable" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock
                            x:Name="TxtCoverage"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource SuccessBrush}" />

                        <TextBlock
                            x:Name="TxtStopReason"
                            Margin="0,6,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  BUTTON BAR  -->
        <Border
            Grid.Row="1"
            Padding="10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="BtnRun"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="BtnRun_Click"
                    Content="Run"
                    Style="{StaticResource ButtonPrimary}" />

                <Button
                    x:Name="BtnCancel"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="BtnCancelRun_Click"
                    Content="Cancel"
                    IsEnabled="False"
                    Style="{StaticResource ButtonSecondary}" />

                <Button
                    x:Name="BtnApply"
                    Height="32"
                    Click="BtnApply_Click"
                    Content="Apply"
                    IsEnabled="False"
                    Style="{StaticResource ButtonPrimary}" />
            </StackPanel>
        </Border>

        <!--  STATUS BAR  -->
        <Border
            Grid.Row="2"
            Padding="10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">

            <DockPanel>
                <ProgressBar
                    x:Name="ProgBar"
                    Height="16"
                    Margin="0,0,10,0"
                    Foreground="{StaticResource PrimaryBrush}"
                    Maximum="100"
                    Minimum="0" />

                <TextBlock
                    x:Name="TxtStatus"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="Ready" />
            </DockPanel>
        </Border>

    </Grid>
</Window>