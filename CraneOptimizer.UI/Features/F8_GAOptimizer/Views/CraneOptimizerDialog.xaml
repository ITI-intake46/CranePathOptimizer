<Window
    x:Class="CraneOptimizer.UI.Features.F8_GAOptimizer.Views.CraneOptimizerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Crane Position Optimizer"
    Width="460"
    Height="650"
    MinWidth="460"
    MinHeight="620"
    Background="{DynamicResource BackgroundBrush}"
    FontFamily="{StaticResource FontPrimary}"
    FontSize="{StaticResource FontSizeBase}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="{StaticResource Space4}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AdvancedColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        FontSize="{StaticResource FontSizeLG}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Crane Selection Optimization"
                        TextAlignment="Center" />

                    <Button
                        x:Name="BtnAdvancedToggle"
                        Grid.Column="1"
                        Click="BtnAdvancedToggle_Click"
                        Content="Advanced Options"
                        Style="{StaticResource ButtonSecondary}" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Padding="{StaticResource Space3}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Style="{StaticResource PanelSectionHeader}"
                            Text="CRANE SELECTION" />

                        <TextBlock
                            Grid.Row="2"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Crane to optimise" />

                        <ComboBox
                            x:Name="CboCrane"
                            Grid.Row="4"
                            DisplayMemberPath="Name"
                            ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                            SelectionChanged="CboCrane_SelectionChanged"
                            Style="{StaticResource DarkComboBox}" />

                        <TextBlock
                            x:Name="TxtChartStatus"
                            Grid.Row="6"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{StaticResource SuccessBrush}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border
                    x:Name="PanelResults"
                    Grid.Row="4"
                    Padding="{StaticResource Space3}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Style="{StaticResource PanelSectionHeader}"
                            Text="RESULTS" />

                        <ListBox
                            x:Name="PointsList"
                            Grid.Row="2"
                            DisplayMemberPath="DisplayText"
                            SelectionChanged="PointsList_SelectionChanged" />

                        <TextBlock
                            x:Name="TxtScore"
                            Grid.Row="4"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeLG}"
                            FontWeight="Bold"
                            Foreground="{StaticResource SuccessBrush}" />

                        <TextBlock
                            x:Name="TxtPosition"
                            Grid.Row="6"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                        <UniformGrid
                            Grid.Row="8"
                            Columns="3">
                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountL"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Liftable" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountNL"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource WarningBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Non-Liftable" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountUR"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DestructiveBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Unreachable" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock
                            x:Name="TxtCoverage"
                            Grid.Row="10"
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SuccessBrush}" />

                        <TextBlock
                            x:Name="TxtStopReason"
                            Grid.Row="12"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <Border
                x:Name="PanelAdvanced"
                Grid.Column="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False"
                    VerticalScrollBarVisibility="Auto">
                    <Grid Margin="{StaticResource Space4}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource PanelSectionHeader}"
                            Text="ADVANCED OPTIONS" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="{StaticResource Space1}"
                            Style="{StaticResource PanelSectionHeader}"
                            Text="ALGORITHM SETTINGS" />

                        <Grid
                            Grid.Row="2"
                            Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Population Size" />
                            <TextBox
                                x:Name="TxtPopulation"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                HorizontalContentAlignment="Center"
                                Text="30"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center" />
                        </Grid>

                        <Grid
                            Grid.Row="3"
                            Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Max Generations" />
                            <TextBox
                                x:Name="TxtGenerations"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                HorizontalContentAlignment="Center"
                                Text="30"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center" />
                        </Grid>

                        <Grid
                            Grid.Row="4"
                            Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Mutation Rate" />
                            <TextBox
                                x:Name="TxtMutRate"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                HorizontalContentAlignment="Center"
                                Text="0.10"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center" />
                        </Grid>

                        <Grid
                            Grid.Row="5"
                            Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Mutation Sigma" />
                            <TextBox
                                x:Name="TxtMutSigma"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                HorizontalContentAlignment="Center"
                                Text="0.05"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center" />
                        </Grid>

                        <Grid
                            Grid.Row="6"
                            Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Grid Step (m)" />
                            <TextBox
                                x:Name="TxtGridStep"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                HorizontalContentAlignment="Center"
                                Text="2.0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center" />
                        </Grid>

                        <Grid
                            Grid.Row="7"
                            Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Convergence (%)"
                                ToolTip="0 = always run full generations" />
                            <TextBox
                                x:Name="TxtConverge"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                HorizontalContentAlignment="Center"
                                Text="0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center" />
                        </Grid>

                        <TextBlock
                            Grid.Row="8"
                            Margin="{StaticResource Space1}"
                            Style="{StaticResource PanelSectionHeader}"
                            Text="PENALTY WEIGHTS" />

                        <Grid
                            Grid.Row="9"
                            Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Non-Liftable penalty" />
                            <TextBox
                                x:Name="TxtPenNL"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                HorizontalContentAlignment="Center"
                                Text="20"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center" />
                        </Grid>

                        <Grid
                            Grid.Row="10"
                            Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Unreachable penalty" />
                            <TextBox
                                x:Name="TxtPenUR"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                HorizontalContentAlignment="Center"
                                Text="100"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="{StaticResource Space3}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BtnRun"
                    Grid.Column="1"
                    Click="BtnRun_Click"
                    Content="Run"
                    Style="{StaticResource ButtonPrimary}" />

                <Button
                    x:Name="BtnCancel"
                    Grid.Column="3"
                    Click="BtnCancelRun_Click"
                    Content="Cancel"
                    IsEnabled="False"
                    Style="{StaticResource ButtonSecondary}" />

                <Button
                    x:Name="BtnApply"
                    Grid.Column="5"
                    Click="BtnApply_Click"
                    Content="Apply"
                    IsEnabled="False"
                    Style="{StaticResource ButtonPrimary}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Padding="{StaticResource Space3}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar
                    x:Name="ProgBar"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0" />

                <TextBlock
                    x:Name="TxtStatus"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeSM}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="Ready" />
            </Grid>
        </Border>
    </Grid>
</Window>
