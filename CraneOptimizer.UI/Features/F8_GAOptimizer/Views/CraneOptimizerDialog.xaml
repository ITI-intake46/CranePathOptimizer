    <Window
    x:Class="CraneOptimizer.UI.Features.F8_GAOptimizer.Views.CraneOptimizerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Crane Position Optimizer"
    Width="460"
    Height="650"
    MinWidth="460"
    MinHeight="620"
    Background="{DynamicResource BackgroundBrush}"
    FontFamily="{StaticResource FontPrimary}"
    FontSize="{StaticResource FontSizeBase}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>




    <Grid Margin="{StaticResource Space4}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AdvancedColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        FontSize="{StaticResource FontSizeLG}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Crane Selection Optimization"
                        TextAlignment="Center" />

                    <Button
                        x:Name="BtnAdvancedToggle"
                        Grid.Column="1"
                        Click="BtnAdvancedToggle_Click"
                        Content="Advanced Options"
                        Style="{StaticResource ButtonSecondary}" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Padding="{StaticResource Space3}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource PanelSectionHeader}" Text="CRANE SELECTION" />

                        <TextBlock
                            Grid.Row="2"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Crane to optimise" />

                        <ComboBox
                            x:Name="CboCrane"
                            Grid.Row="4"
                            DisplayMemberPath="Name"
                            ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                            Style="{StaticResource DarkComboBox}" />

                        <TextBlock
                            x:Name="TxtChartStatus"
                            Grid.Row="6"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{StaticResource SuccessBrush}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border
                    x:Name="PanelResults"
                    Grid.Row="4"
                    Padding="{StaticResource Space3}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource PanelSectionHeader}" Text="RESULTS" />

                        <ListBox
                            x:Name="PointsList"
                            Grid.Row="2"
                            DisplayMemberPath="DisplayText"
                            SelectionChanged="PointsList_SelectionChanged" />

                        <TextBlock
                            x:Name="TxtScore"
                            Grid.Row="4"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeLG}"
                            FontWeight="Bold"
                            Foreground="{StaticResource SuccessBrush}" />

                        <TextBlock
                            x:Name="TxtPosition"
                            Grid.Row="6"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                        <UniformGrid Grid.Row="8" Columns="3">
                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountL"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Liftable" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountNL"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource WarningBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Non-Liftable" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtCountUR"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeLG}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DestructiveBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="Unreachable" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock
                            x:Name="TxtCoverage"
                            Grid.Row="10"
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SuccessBrush}" />

                        <TextBlock
                            x:Name="TxtStopReason"
                            Grid.Row="12"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <Border
                x:Name="PanelAdvanced"
                Grid.Column="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
                <ScrollViewer
                    CanContentScroll="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource Space4}">
                        <TextBlock
                            Style="{StaticResource PanelSectionHeader}"
                            Text="ADVANCED OPTIONS" />

                        <TextBlock
                            Margin="{StaticResource Space1}"
                            Style="{StaticResource PanelSectionHeader}"
                            Text="OPTIMIZATION GOAL" />

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Coverage Weight" />
                            <TextBox
                                x:Name="TxtCoverageWeight"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="10" />
                        </Grid>

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Relocation Weight" />
                            <TextBox
                                x:Name="TxtRelocationWeight"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="5" />
                        </Grid>

                        <TextBlock
                            Margin="{StaticResource Space1}"
                            Style="{StaticResource PanelSectionHeader}"
                            Text="CONSTRAINTS" />

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Safety Factor" />
                            <TextBox
                                x:Name="TxtSafetyFactor"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="0.90" />
                        </Grid>

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Rigging Length (m)" />
                            <TextBox
                                x:Name="TxtRiggingLength"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="2.0" />
                        </Grid>

                        <TextBlock
                            Margin="{StaticResource Space1}"
                            Style="{StaticResource PanelSectionHeader}"
                            Text="COMPLEXITY" />

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Max Crane Positions" />
                            <TextBox
                                x:Name="TxtMaxCranePositions"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="3" />
                        </Grid>

                        <TextBlock
                            Margin="{StaticResource Space1}"
                            Style="{StaticResource PanelSectionHeader}"
                            Text="PERFORMANCE" />

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Grid Step (m)" />
                            <TextBox
                                x:Name="TxtGridStep"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="0" />
                        </Grid>

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Early Stop Generations" />
                            <TextBox
                                x:Name="TxtEarlyStopping"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="20" />
                        </Grid>

                        <TextBlock
                            Margin="{StaticResource Space1}"
                            Style="{StaticResource PanelSectionHeader}"
                            Text="ADVANCED SETTINGS" />

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Radius Penalty Weight" />
                            <TextBox
                                x:Name="TxtRadiusPenaltyWeight"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="3" />
                        </Grid>

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Balance Penalty Weight" />
                            <TextBox
                                x:Name="TxtBalancePenaltyWeight"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="2" />
                        </Grid>

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Overweight Penalty Weight" />
                            <TextBox
                                x:Name="TxtOverweightPenaltyWeight"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="10" />
                        </Grid>

                        <Grid Margin="{StaticResource Space1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSM}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Height Penalty Weight" />
                            <TextBox
                                x:Name="TxtHeightPenaltyWeight"
                                Grid.Column="1"
                                MinHeight="{StaticResource InputHeight}"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="5" />
                        </Grid>

                        <!-- Developer options are isolated here so the full block can be removed later. -->
                        <Expander
                            Margin="{StaticResource Space1}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Header="Developer Options"
                            IsExpanded="False">
                            <StackPanel Margin="{StaticResource Space2}">
                                <TextBlock
                                    FontSize="{StaticResource FontSizeXS}"
                                    Foreground="{StaticResource WarningBrush}"
                                    Text="For testing only - not for production"
                                    TextWrapping="Wrap" />

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Mutation Rate" />
                                    <TextBox x:Name="TxtDevMutationRate" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.10" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Mutation Sigma" />
                                    <TextBox x:Name="TxtDevMutationSigma" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.05" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Crossover Rate" />
                                    <TextBox x:Name="TxtDevCrossoverRate" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0.80" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Random Seed" />
                                    <TextBox x:Name="TxtDevRandomSeed" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="42" />
                                </Grid>

                                <Grid Margin="{StaticResource Space1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Convergence (%)" ToolTip="0 = always run full generations" />
                                    <TextBox x:Name="TxtDevConvergence" Grid.Column="1" MinHeight="{StaticResource InputHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="{StaticResource Space3}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BtnRun"
                    Grid.Column="1"
                    Click="BtnRun_Click"
                    Content="Run"
                    Style="{StaticResource ButtonPrimary}" />

                <Button
                    x:Name="BtnCancel"
                    Grid.Column="3"
                    Click="BtnCancelRun_Click"
                    Content="Cancel"
                    IsEnabled="False"
                    Style="{StaticResource ButtonSecondary}" />

                <Button
                    x:Name="BtnApply"
                    Grid.Column="5"
                    Click="BtnApply_Click"
                    Content="Apply"
                    IsEnabled="False"
                    Style="{StaticResource ButtonPrimary}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Padding="{StaticResource Space3}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar
                    x:Name="ProgBar"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0" />

                <TextBlock
                    x:Name="TxtStatus"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeSM}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="Ready" />
            </Grid>
        </Border>
    </Grid>
</Window>
