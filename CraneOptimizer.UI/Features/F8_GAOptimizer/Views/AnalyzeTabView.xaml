<UserControl
    x:Class="CraneOptimizer.UI.Features.F8_GAOptimizer.Views.AnalyzeTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <Border Padding="8,8,8,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!--  ───────── OPTIMIZE ─────────  -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">

                <TextBlock
                    Margin="4,0,0,6"
                    Style="{StaticResource PropertyLabel}"
                    Text="OPTIMIZE" />

                <Button
                    Width="110"
                    Height="70"
                    Command="{Binding OptimizeCommand}"
                    Style="{StaticResource ButtonPrimary}">

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontSize="22" Text="⚡" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontWeight="SemiBold"
                            Text="Run Optimizer" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <!--  ───────── REPORTS ─────────  -->
            <StackPanel Grid.Column="1" Margin="0,0,16,0">

                <TextBlock
                    Margin="4,0,0,6"
                    Style="{StaticResource PropertyLabel}"
                    Text="REPORTS" />

                <Button
                    Margin="0,0,0,4"
                    Content="📄 Export Analysis"
                    Style="{StaticResource ButtonSecondary}" />

                <Button
                    Margin="0,0,0,4"
                    Content="📤 Export Zones (JSON)"
                    Style="{StaticResource ButtonSecondary}" />

                <Button
                    Command="{Binding ShowDiagnosticsCommand}"
                    Content="📈 GA Diagnostics"
                    FontWeight="SemiBold"
                    Style="{StaticResource ButtonSecondary}" />

            </StackPanel>

            <!--  ───────── RESULTS ─────────  -->
            <StackPanel Grid.Column="2">

                <TextBlock
                    Margin="4,0,0,6"
                    Style="{StaticResource PropertyLabel}"
                    Text="RESULTS" />

                <Button
                    Command="{Binding ShowResultsCommand}"
                    Content="📊 View Results"
                    FontWeight="SemiBold"
                    Style="{StaticResource ButtonSecondary}" />

            </StackPanel>

            <!--  SAVED RUNS  -->
            <StackPanel Grid.Column="3" Margin="16,0,0,0">

                <TextBlock
                    Margin="4,0,0,6"
                    Style="{StaticResource PropertyLabel}"
                    Text="SAVED GA RUNS" />

                <ComboBox
                    MinWidth="240"
                    ItemsSource="{Binding SavedRuns}"
                    SelectedItem="{Binding SelectedSavedRun, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding CompletedText}" />
                                <TextBlock FontSize="11" Text="{Binding SummaryText}" />
                                <TextBlock FontSize="11" Text="{Binding CraneModeText}" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SourceText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding SavedRunStatusText}" />

                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding SavedRunWarning}"
                    TextWrapping="Wrap" />
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
