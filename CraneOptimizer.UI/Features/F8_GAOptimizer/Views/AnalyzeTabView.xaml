<UserControl x:Class="CraneOptimizer.UI.Features.F8_GAOptimizer.Views.AnalyzeTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">

        <StackPanel Orientation="Horizontal" Margin="6,0">

            <!-- ── OPTIMIZE ───────────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="100">

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="OPTIMIZE"
                               Style="{StaticResource GroupLabel}"/>

                    <!-- ✔ Core command -->
                    <Button Style="{StaticResource RibbonLargeBtn}"
                            Width="85"
                            Command="{Binding OptimizeCommand}">

                        <StackPanel HorizontalAlignment="Center">

                            <TextBlock Text="⚡"
                                       FontSize="26"
                                       Margin="0,6,0,4"
                                       Foreground="{StaticResource PrimaryBrush}"/>

                            <TextBlock Text="Run"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>

                            <TextBlock Text="Optimizer"/>

                        </StackPanel>

                    </Button>

                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0"/>

            <!-- ── REPORTS ───────────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="170">

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="REPORTS"
                               Style="{StaticResource GroupLabel}"/>

                    <StackPanel Margin="0,2,0,0">

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="160"
                                Margin="0,0,0,3">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" Margin="0,0,6,0"/>
                                <TextBlock Text="Export Analysis"/>
                            </StackPanel>

                        </Button>

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="160">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" Margin="0,0,6,0"/>
                                <TextBlock Text="Export Zones (JSON)"/>
                            </StackPanel>

                        </Button>

                    </StackPanel>

                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" Margin="4,0"/>

            <!-- ── LIFT PLANNING ───────────────────────── -->
            <Border Padding="8,6,8,0">
                <DockPanel Width="170">

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="LIFT PLANNING"
                               Style="{StaticResource GroupLabel}"/>

                    <StackPanel Margin="0,2,0,0">

                        <Button Style="{StaticResource RibbonSmallBtn}"
                                Width="160">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="🏋"
                                           Margin="0,0,6,0"
                                           Foreground="{StaticResource DestructiveBrush}"/>

                                <TextBlock Text="Lift Plan..."
                                           Foreground="{StaticResource DestructiveBrush}"
                                           FontWeight="SemiBold"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>