<Window
    x:Class="CraneOptimizer.UI.Features.F8_GAOptimizer.Views.GAResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Optimization Results"
    Width="1100"
    Height="640"
    Background="{DynamicResource BackgroundBrush}"
    FontFamily="{StaticResource FontPrimary}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="LiftableRowBrush"    Color="#1A2E23" /><!-- dark green tint -->
        <SolidColorBrush x:Key="OverweightRowBrush"  Color="#2E1818" /><!-- dark red tint -->
        <SolidColorBrush x:Key="HeightFailRowBrush"  Color="#2E2316" /><!-- dark amber tint -->
        <SolidColorBrush x:Key="OutOfRadiusRowBrush" Color="#1C1D1F" /><!-- dark gray tint -->
        <SolidColorBrush x:Key="NeutralRowBrush"     Color="#1E1E1E" /><!-- dark neutral tint -->
    </Window.Resources>

    <Grid Margin="{StaticResource Space4}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Style="{StaticResource PanelSectionHeader}"
                VerticalAlignment="Center"
                Text="BEST CRANE POSITIONS" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="{StaticResource FontSizeSM}" Foreground="{DynamicResource TextSecondaryBrush}" Text="View Mode:" />
                <ComboBox Width="180" Height="26"
                           ItemsSource="{Binding ViewModes}"
                           SelectedValuePath="Key"
                           DisplayMemberPath="Value"
                           SelectedValue="{Binding CurrentGAViewMode, Mode=TwoWay}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Best Crane Positions List -->
            <Border
                Grid.Column="0"
                Padding="{StaticResource Space3}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">

                <ListBox
                    ItemsSource="{Binding Positions}"
                    SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="{StaticResource Space1}"
                                Padding="{StaticResource Space2}"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.RowSpan="3"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeSM}"
                                        FontWeight="SemiBold"
                                        Text="{Binding PositionDisplayText, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Grid.Row="0"
                                        Grid.RowSpan="3"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Text="{Binding LiftCountDisplayText, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Column 1: Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

            <!-- Column 2: Assigned Elements + Crane Metadata -->
            <Border Grid.Column="2"
                    Padding="{StaticResource Space3}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><!-- section header -->
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" /><!-- DataGrid -->
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" /><!-- crane metadata -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding RightPanelHeader}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{StaticResource PrimaryBrush}" />

                    <!-- Assigned Elements DataGrid -->
                    <DataGrid Grid.Row="2"
                              x:Name="AssignedElementsGrid"
                              ItemsSource="{Binding AssignedElements}"
                              SelectedItem="{Binding SelectedElement, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserReorderColumns="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderBrush}"
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{StaticResource NeutralRowBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source.Status}" Value="Liftable">
                                        <Setter Property="Background" Value="{StaticResource LiftableRowBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Source.Status}" Value="Overweight">
                                        <Setter Property="Background" Value="{StaticResource OverweightRowBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Source.Status}" Value="HeightFail">
                                        <Setter Property="Background" Value="{StaticResource HeightFailRowBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Source.Status}" Value="OutOfRadius">
                                        <Setter Property="Background" Value="{StaticResource OutOfRadiusRowBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Source.Status}" Value="SpecialCase">
                                        <Setter Property="Background" Value="{StaticResource NeutralRowBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Source.Status}" Value="NotCharted">
                                        <Setter Property="Background" Value="{StaticResource NeutralRowBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mark"
                                               Binding="{Binding Mark}"
                                               Width="*"
                                               MinWidth="70" />
                            <DataGridTextColumn Header="Radius"
                                               Binding="{Binding RadiusText}"
                                               Width="75" />
                            <DataGridTextColumn Header="Boom Length"
                                               Binding="{Binding BoomLengthText}"
                                               Width="90" />
                            <DataGridTextColumn Header="Weight"
                                               Binding="{Binding WeightText}"
                                               Width="80" />
                            <DataGridTextColumn Header="Chart Cap. (Raw)"
                                               Binding="{Binding RawChartCapacityText}"
                                               Width="110" />
                            <DataGridTextColumn Header="Status"
                                               Binding="{Binding StatusText}"
                                               Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Crane Metadata Panel -->
                    <Border Grid.Row="4"
                            Padding="10"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Crane Name -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Text="CRANE" HorizontalAlignment="Center" />
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                           Text="{Binding CraneNameDisplay, Mode=OneWay}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Wire Length -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Text="WIRE LENGTH" HorizontalAlignment="Center" />
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                           Text="{Binding WireLengthDisplay, Mode=OneWay}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Derating Ratio -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Text="DERATING" HorizontalAlignment="Center" />
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                           Text="{Binding DeratingRatioDisplay, Mode=OneWay}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Counterweight -->
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Text="COUNTERWEIGHT" HorizontalAlignment="Center" />
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                           Text="{Binding CounterWeightDisplay, Mode=OneWay}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="4"
            Padding="{StaticResource Space3}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">

            <UniformGrid Columns="3">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    Foreground="{StaticResource SuccessBrush}"
                    Text="{Binding TotalLiftedText, Mode=OneWay}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{Binding CoverageRatio, StringFormat=Coverage: {0:P2}}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{Binding FitnessScore, StringFormat=GA Score: {0:F2}}" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>
