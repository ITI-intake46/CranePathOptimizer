<Window
    x:Class="CraneOptimizer.UI.Features.F8_GAOptimizer.Views.GAResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CraneOptimizer.UI.Features.F8_GAOptimizer.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Optimization Results"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Border Padding="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource PanelSectionHeader}"
                Text="Best Points" />

            <ListBox Grid.Row="1" ItemsSource="{Binding Positions}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,4"
                            Padding="6"
                            Background="{DynamicResource SurfaceElevatedBrush}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock FontWeight="Bold" Text="X:" />
                                <TextBlock Margin="4,0" Text="{Binding X}" />

                                <TextBlock
                                    Margin="10,0,0,0"
                                    FontWeight="Bold"
                                    Text="Y:" />
                                <TextBlock Margin="4,0" Text="{Binding Y}" />

                                <TextBlock
                                    Margin="10,0,0,0"
                                    FontWeight="Bold"
                                    Text="Elements:" />
                                <TextBlock Margin="4,0" Text="{Binding ElementResults.Count}" />

                            </StackPanel>

                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>

    </Border>
</Window>
