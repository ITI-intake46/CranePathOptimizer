<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.LoadChartImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Crane Load Chart"
        Width="980" Height="720"
        MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!--
            DialogScrollThumbStyle / DialogScrollBarStyle are kept local because
            this dialog uses a custom slim scrollbar only for its dense data grid.
            All tokens inside still resolve from the design system.
        -->
        <Style x:Key="DialogScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource SecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DialogScrollThumbStyle}" MinHeight="28"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource DialogScrollThumbStyle}" MinWidth="28"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Apply slim scrollbar globally within this window -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DialogScrollBarStyle}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtHeader"
                           Text="Import Crane Load Chart"
                           Style="{StaticResource TextTitle}"/>
                <TextBlock Text="Import a CSV, verify the grid, then save it as one crane with one specification."
                           Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <ScrollViewer Grid.Column="0"
                          Margin="0,0,6,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Drop zone -->
                    <Border x:Name="DropZone"
                            AllowDrop="True"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="6" Padding="14"
                            Cursor="Hand"
                            MouseLeftButtonUp="DropZone_Click"
                            DragEnter="DropZone_DragEnter"
                            DragLeave="DropZone_DragLeave"
                            DragOver="DropZone_DragOver"
                            Drop="DropZone_Drop">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CSV"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXXL}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop CSV here or click to browse"
                                       Margin="0,8,0,0"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- File info badge -->
                    <Border x:Name="FileInfoPanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtFileName"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtFileSize"
                                       Margin="0,3,0,0"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Metadata form -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="6" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Model Name" Style="{StaticResource PropertyLabel}"/>
                            <TextBox x:Name="TxtModel" Margin="0,0,0,8"/>

                            <TextBlock Text="Manufacturer" Style="{StaticResource PropertyLabel}"/>
                            <TextBox x:Name="TxtMfg" Margin="0,0,0,8"/>

                            <TextBlock Text="Outrigger Config" Style="{StaticResource PropertyLabel}"/>
                            <ComboBox x:Name="CboOutriggerConfig"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      SelectedIndex="0" Height="30" Margin="0,0,0,8">
                                <ComboBoxItem Content="100%"/>
                                <ComboBoxItem Content="75%"/>
                                <ComboBoxItem Content="50%"/>
                                <ComboBoxItem Content="On Rubber"/>
                            </ComboBox>

                            <TextBlock Text="Counterweight (kg)" Style="{StaticResource PropertyLabel}"/>
                            <TextBox x:Name="TxtCounterweight" Margin="0,0,0,8"/>

                            <TextBlock Text="Max Capacity (t)" Style="{StaticResource PropertyLabel}"/>
                            <TextBox x:Name="TxtMaxCap" Margin="0,0,0,8"/>

                            <TextBlock Text="Max Radius (m)" Style="{StaticResource PropertyLabel}"/>
                            <TextBox x:Name="TxtMaxRadius" Margin="0,0,0,8"/>

                            <Button x:Name="BtnToggleDimensions"
                                    Content="Enter Crane Dimensions"
                                    Style="{StaticResource ButtonOutlined}"
                                    Height="32" Margin="0,0,0,8"
                                    Click="BtnToggleDimensions_Click"/>

                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtDimensionsSummary"
                                           Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap"
                                           Text="No crane dimensions entered yet."/>
                            </Border>

                            <Button x:Name="BtnTranspose"
                                    Content="Swap Radius / Boom"
                                    Style="{StaticResource ButtonOutlined}"
                                    Height="32"
                                    Click="BtnTranspose_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: data grid -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="6,6,0,0" Padding="12,8">
                    <DockPanel>
                        <TextBlock Text="LOAD CHART DATA"
                                   Style="{StaticResource PanelSectionHeader}"/>
                        <TextBlock x:Name="TxtGridStats"
                                   DockPanel.Dock="Right"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   Text="No data loaded"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="0,0,6,6">
                    <DataGrid x:Name="ChartGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderThickness="0"
                              RowBackground="{DynamicResource BackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource SurfaceBrush}"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Text="Load a CSV to begin."/>

                <Button Grid.Column="1" Width="150" Height="34"
                        Content="Save Crane"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnSave_Click"/>
                <Button Grid.Column="3" Width="90" Height="34"
                        Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
