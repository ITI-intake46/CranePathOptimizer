<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.LoadChartImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Crane Load Chart"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
        Width="1120" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="DialogScrollBarStyle"
               TargetType="ScrollBar"
               BasedOn="{StaticResource SharedScrollBarStyle}"/>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource DialogScrollBarStyle}"/>
    </Window.Resources>

    <Grid Margin="16" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtHeader"
                           Text="Import Crane Load Chart"
                           Style="{StaticResource TextTitle}"/>
                <TextBlock Text="Import a CSV or text-based PDF, verify the grid, then save it as one crane with one specification."
                           Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <ScrollViewer Grid.Column="0"
                          Margin="0,0,6,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,96">

                    <!-- Drop zone -->
                    <Border x:Name="DropZone"
                            AllowDrop="True"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="6" Padding="14"
                            Cursor="Hand"
                            MouseLeftButtonUp="DropZone_Click"
                            DragEnter="DropZone_DragEnter"
                            DragLeave="DropZone_DragLeave"
                            DragOver="DropZone_DragOver"
                            Drop="DropZone_Drop">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CSV / PDF"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSize3XL}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop CSV/PDF here or click to browse"
                                       Margin="0,8,0,0"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- File info badge -->
                    <Border x:Name="FileInfoPanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtFileName"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtFileSize"
                                       Margin="0,3,0,0"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Metadata form -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="6" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Model Name *" Style="{StaticResource PropertyLabel}"/>
                            <TextBox x:Name="TxtModel" Margin="0,0,0,8"/>

                            <TextBlock Text="Manufacturer *" Style="{StaticResource PropertyLabel}"/>
                            <TextBox x:Name="TxtMfg" Margin="0,0,0,8"/>

                            <TextBlock Text="Operating Config *" Style="{StaticResource PropertyLabel}"/>
                            <ComboBox x:Name="CboOutriggerConfig"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      SelectedIndex="0" Height="30" Margin="0,0,0,8"
                                      SelectionChanged="CboOutriggerConfig_SelectionChanged">
                                <ComboBoxItem Content="100%"/>
                                <ComboBoxItem Content="75%"/>
                                <ComboBoxItem Content="50%"/>
                                <ComboBoxItem Content="On Rubber"/>
                            </ComboBox>

                            <TextBlock x:Name="LblCounterweight" Text="Counterweight * (t)" Style="{StaticResource PropertyLabel}"/>
                            <TextBox x:Name="TxtCounterweight" Margin="0,0,0,8"/>

                            <TextBlock x:Name="LblMaxCapacity" Text="Imported Chart Max (t)" Style="{StaticResource PropertyLabel}" ToolTip="Maximum capacity found in the imported chart/table. This may differ from the crane model nominal rating."/>
                            <TextBox x:Name="TxtMaxCap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LblChartCapacityUnit" Text="Chart Capacity Unit" Style="{StaticResource PropertyLabel}"/>
                            <ComboBox x:Name="CboChartCapacityUnit"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      SelectedIndex="0"
                                      Height="30"
                                      Margin="0,0,0,8"
                                      SelectionChanged="CboChartCapacityUnit_SelectionChanged">
                                <ComboBoxItem Content="Auto (detect kg / t)" Tag="Auto"/>
                                <ComboBoxItem Content="t" Tag="Ton"/>
                                <ComboBoxItem Content="kg" Tag="Kilogram"/>
                            </ComboBox>

                            <TextBlock x:Name="LblMaxRadius" Text="Max Radius (m)" Style="{StaticResource PropertyLabel}"/>
                            <TextBox x:Name="TxtMaxRadius" Margin="0,0,0,8"/>

                            <Button x:Name="BtnToggleDimensions"
                                    Content="Enter Required Crane Dimensions"
                                    Style="{StaticResource ButtonOutlined}"
                                    Height="32" Margin="0,0,0,8"
                                    Click="BtnToggleDimensions_Click"/>

                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtDimensionsSummary"
                                           Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap"
                                           Text="No crane dimensions entered yet."/>
                            </Border>

                            <Border x:Name="MetadataEvidencePanel"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="PDF metadata"
                                                   FontFamily="{StaticResource FontPrimary}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <Button x:Name="BtnViewFullMetadataEvidence"
                                                Grid.Column="1"
                                                Content="View details"
                                                Width="104"
                                                Height="28"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource ButtonOutlined}"
                                                Click="BtnViewFullMetadataEvidence_Click"/>
                                    </Grid>

                                    <TextBlock x:Name="TxtMetadataEvidenceSummary"
                                               Style="{StaticResource TextCaption}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               Text="Metadata auto-filled."/>
                                    <TextBlock x:Name="TxtMetadataEvidence"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnTranspose"
                                    Content="Swap Radius / Boom"
                                    Style="{StaticResource ButtonOutlined}"
                                    Height="32"
                                    Click="BtnTranspose_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: data grid -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="6,6,0,0" Padding="12,8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="LOAD CHART DATA"
                                       Style="{StaticResource PanelSectionHeader}"/>
                            <TextBlock x:Name="TxtGridStats"
                                       DockPanel.Dock="Right"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       Text="No data loaded"/>
                        </DockPanel>

                        <Border x:Name="EnvelopePreviewPanel"
                                Visibility="Collapsed"
                                Margin="0,10,0,0"
                                Padding="10"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="TxtEnvelopePreviewTitle"
                                               Text="Exact PDF visual load chart"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock x:Name="TxtEnvelopePreviewDescription"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource TextCaption}"
                                               Text="Save Crane stores the exact PDF visual table. The envelope is only a reference view."/>
                                    <TextBlock x:Name="TxtPreviewMode"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource TextCaption}"
                                               Text="Viewing exact PDF visual chart."/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="14,0,0,0">
                                    <Button x:Name="BtnShowExactPdfPreview"
                                            Content="Exact PDF Chart"
                                            Width="150"
                                            Height="30"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource ButtonSecondary}"
                                            Click="BtnShowExactPdfPreview_Click"/>
                                    <Button x:Name="BtnShowImportableEnvelope"
                                            Content="Reference 2D Envelope"
                                            Width="180"
                                            Height="30"
                                            Style="{StaticResource ButtonOutlined}"
                                            Click="BtnShowImportableEnvelope_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="0,0,6,6">
                    <DataGrid x:Name="ChartGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              FrozenColumnCount="1"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderThickness="0"
                              RowBackground="{DynamicResource BackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource SurfaceBrush}"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              ClipToBounds="True">
                        <DataGrid.Resources>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="CanContentScroll" Value="True"/>
                                <Setter Property="HorizontalScrollBarVisibility" Value="Visible"/>
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Text="Load a CSV or text-based PDF to begin."/>

                <Button Grid.Column="1" Width="150" Height="34"
                        Content="Save Crane"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnSave_Click"/>
                <Button Grid.Column="3" Width="90" Height="34"
                        Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
