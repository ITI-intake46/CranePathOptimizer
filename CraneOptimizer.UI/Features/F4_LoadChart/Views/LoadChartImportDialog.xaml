<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.LoadChartImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Crane Load Chart"
        Width="860" Height="740"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="DarkField" TargetType="TextBox">
            <Setter Property="Background"               Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,5"/>
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>
        <Style x:Key="MethodTab" TargetType="RadioButton">
            <Setter Property="Padding"         Value="20,8"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🏗️  Import Crane Load Chart"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="15" FontWeight="Bold"/>
                    <TextBlock Foreground="{DynamicResource TextDisabledBrush}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="11" Margin="0,2,0,0"
                               Text="Drop a file — extracted numbers appear in the grid for you to verify before saving."/>
                </StackPanel>
                <!-- Method tabs -->
                <Border Grid.Column="1" CornerRadius="5"
                        Background="{DynamicResource BackgroundBrush}"
                        Padding="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RboCsv" Style="{StaticResource MethodTab}"
                                     IsChecked="True" GroupName="M"
                                     Checked="Method_Checked"
                                     Content="📄  CSV  (recommended)"/>
                        <RadioButton x:Name="RboPdf" Style="{StaticResource MethodTab}"
                                     GroupName="M" Checked="Method_Checked"
                                     Content="📑  PDF  (verify after)"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Main ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Panel ────────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,8">

                    <!-- Drop zone -->
                    <Border x:Name="DropZone"
                            AllowDrop="True"
                            Drop="DropZone_Drop"
                            DragEnter="DropZone_DragEnter"
                            DragLeave="DropZone_DragLeave"
                            DragOver="DropZone_DragOver"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="7"
                            Background="{DynamicResource SurfaceBrush}"
                            Padding="14,20" Cursor="Hand"
                            MouseLeftButtonUp="DropZone_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="DropIcon" Text="📄" FontSize="28"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DropTitle" Text="Drop CSV here"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,3"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="DropSub" Text="or click to browse"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress bar for PDF -->
                    <ProgressBar x:Name="ProgressBar"
                                 IsIndeterminate="True"
                                 Height="3" Margin="0,6,0,0"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Visibility="Collapsed"/>

                    <!-- Selected file info -->
                    <Border x:Name="FileInfoPanel" Visibility="Collapsed"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="5" Padding="10,8" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtFileName"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="10" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtFileSize"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- PDF page panel -->
                    <StackPanel x:Name="PdfPagePanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="PDF Page Number" Style="{StaticResource Lbl}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPageNumber" Style="{StaticResource DarkField}"
                                     Text="0"
                                     ToolTip="0 = auto-detect the page with the most numbers"/>
                            <Button Grid.Column="2" Content="Re-read"
                                    Style="{StaticResource ButtonSecondary}"
                                    Width="68" FontSize="10" Height="30"
                                    Click="ReExtract_Click"/>
                        </Grid>
                        <TextBlock Text="0 = auto-detect"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Axis orientation panel -->
                    <Border x:Name="AxisPanel" Visibility="Collapsed"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="5" Padding="10,9" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="TABLE ORIENTATION"
                                       Style="{StaticResource SectionLbl}"/>
                            <RadioButton x:Name="RboRowsRadius"
                                         GroupName="Axis" IsChecked="True"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         FontFamily="{StaticResource FontPrimary}"
                                         FontSize="10" Margin="0,0,0,5" Cursor="Hand"
                                         Checked="AxisOrientation_Changed">
                                <TextBlock TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Rows = Radius  /  Cols = Boom"/>
                            </RadioButton>
                            <RadioButton x:Name="RboRowsBoom"
                                         GroupName="Axis"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         FontFamily="{StaticResource FontPrimary}"
                                         FontSize="10" Cursor="Hand"
                                         Checked="AxisOrientation_Changed">
                                <TextBlock TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Rows = Boom  /  Cols = Radius"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Crane details section -->
                    <TextBlock Text="CRANE DETAILS"
                               Style="{StaticResource SectionLbl}"
                               Margin="0,14,0,6"/>

                    <!-- Crane Type -->
                    <TextBlock Text="Crane Type" Style="{StaticResource Lbl}"/>
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RboCraneTypeMobile"
                                         GroupName="CraneTypeGrp" IsChecked="True"
                                         Foreground="{StaticResource SuccessBrush}"
                                         FontFamily="{StaticResource FontPrimary}"
                                         FontSize="10" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚛 " FontSize="10"/>
                                    <TextBlock Text="Mobile"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RboCraneTypeTower"
                                         Grid.Column="1"
                                         GroupName="CraneTypeGrp"
                                         Foreground="{StaticResource PrimaryBrush}"
                                         FontFamily="{StaticResource FontPrimary}"
                                         FontSize="10" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏗 " FontSize="10"/>
                                    <TextBlock Text="Tower"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <!-- Model name -->
                    <TextBlock Text="Model Name" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtModel" Style="{StaticResource DarkField}"
                             Margin="0,0,0,8"/>

                    <!-- Manufacturer -->
                    <TextBlock Text="Manufacturer" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtMfg" Style="{StaticResource DarkField}"
                             Margin="0,0,0,8"/>

                    <!-- Max capacity -->
                    <TextBlock Text="Max Capacity (t)" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtMaxCap" Style="{StaticResource DarkField}"
                             Margin="0,0,0,8"/>

                    <!-- Notes -->
                    <TextBlock Text="Notes" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtNotes"
                             Background="{DynamicResource SurfaceElevatedBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="8,5"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Right Panel: data grid ────────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Grid header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="5,5,0,0"
                        Padding="12,8">
                    <DockPanel>
                        <TextBlock Text="LOAD CHART DATA"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="9" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtGridStats"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Text="No data loaded"/>
                    </DockPanel>
                </Border>

                <!-- Editable data grid -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0,0,5,5">
                    <DataGrid x:Name="ChartGrid"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderThickness="0"
                              RowBackground="{DynamicResource BackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource SurfaceBrush}"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                              RowHeight="24"
                              AutoGenerateColumns="True"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ══ Footer ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="11" VerticalAlignment="Center"
                           Text="Drop a CSV or PDF file to begin."/>

                <Button Grid.Column="1"
                        Content="💾  Save to Database"
                        Style="{StaticResource ButtonPrimary}"
                        Width="160" Height="34"
                        Click="BtnSave_Click"/>

                <Button Grid.Column="3"
                        Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Width="90" Height="34"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
