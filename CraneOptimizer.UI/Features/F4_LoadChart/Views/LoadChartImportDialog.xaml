<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.LoadChartImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Crane Load Chart"
        Width="980"
        Height="720"
        MinWidth="840"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="DialogScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource SecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DialogScrollThumbStyle}" MinHeight="28"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource DialogScrollThumbStyle}" MinWidth="28"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DialogScrollBarStyle}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6"
                Padding="18,14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtHeader"
                           Text="Import Crane Load Chart"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="16"
                           FontWeight="Bold"/>
                <TextBlock Text="Import a CSV, verify the grid, then save it as one crane with one specification."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="11"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          Margin="0,0,6,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border x:Name="DropZone"
                            AllowDrop="True"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            Padding="14"
                            Cursor="Hand"
                            MouseLeftButtonUp="DropZone_Click"
                            DragEnter="DropZone_DragEnter"
                            DragLeave="DropZone_DragLeave"
                            DragOver="DropZone_DragOver"
                            Drop="DropZone_Drop">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CSV"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop CSV here or click to browse"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FileInfoPanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtFileName"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtFileSize"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Model Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtModel" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtMfg" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Outrigger Config" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CboOutriggerConfig"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      SelectedIndex="0"
                                      Height="30"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="100%"/>
                                <ComboBoxItem Content="75%"/>
                                <ComboBoxItem Content="50%"/>
                                <ComboBoxItem Content="On Rubber"/>
                            </ComboBox>

                            <TextBlock Text="Counterweight (kg)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCounterweight" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Max Capacity (t)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtMaxCap"
                                     Style="{StaticResource FieldTextBoxStyle}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="Max Radius (m)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtMaxRadius" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,8"/>

                            <Button x:Name="BtnToggleDimensions"
                                    Content="Enter Crane Dimensions"
                                    Style="{StaticResource ButtonSecondary}"
                                    Height="32"
                                    Margin="0,0,0,8"
                                    Click="BtnToggleDimensions_Click"/>

                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,10">
                                <TextBlock x:Name="TxtDimensionsSummary"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="No crane dimensions entered yet."/>
                            </Border>

                            <Button x:Name="BtnTranspose"
                                    Content="Swap Radius / Boom"
                                    Style="{StaticResource ButtonSecondary}"
                                    Height="32"
                                    Click="BtnTranspose_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="6,6,0,0"
                        Padding="12,8">
                    <DockPanel>
                        <TextBlock Text="LOAD CHART DATA"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="TxtGridStats"
                                   DockPanel.Dock="Right"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="10"
                                   Text="No data loaded"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0,0,6,6">
                    <DataGrid x:Name="ChartGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderThickness="0"
                              RowBackground="{DynamicResource BackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource SurfaceBrush}"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="11"
                           Text="Load a CSV to begin."/>

                <Button Grid.Column="1"
                        Width="150"
                        Height="34"
                        Content="Save Crane"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnSave_Click"/>

                <Button Grid.Column="3"
                        Width="90"
                        Height="34"
                        Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
