<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.PdfLoadChartImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Load Chart Import"
        Width="1500"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource FontPrimary}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Local slim scrollbars matching Import Crane Load Chart. -->
        <Style x:Key="DialogScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource SecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DialogScrollThumbStyle}" MinHeight="28"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource DialogScrollThumbStyle}" MinWidth="28"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource DialogScrollBarStyle}"/>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextTitle}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="GridSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ShowsPreview" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Border x:Name="Grip"
                                    Background="{DynamicResource BorderBrush}"
                                    Opacity="0.35"
                                    CornerRadius="2"
                                    Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource SecondaryBrush}"/>
                                <Setter TargetName="Grip" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource SecondaryBrush}"/>
                                <Setter TargetName="Grip" Property="Opacity" Value="0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalGridSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource GridSplitterStyle}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        </Style>

        <Style x:Key="HorizontalGridSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource GridSplitterStyle}">
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="ResizeDirection" Value="Rows"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        </Style>

        <Style x:Key="CandidateListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="CandidateListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="3,1,1,1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PageCandidateTemplate">
            <Grid MinHeight="68">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="52"
                        MinWidth="52"
                        Height="52"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PAGE"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PageNumber}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSize2XL}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding ConfidenceLabel}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       FontWeight="Bold"/>
                        </Border>

                        <TextBlock Text="PDF page candidate"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeLG}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding DisplayDetails}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeMD}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TableCandidateTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Border DockPanel.Dock="Right"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding ConfidenceLabel}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="{Binding DisplayTitle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeLG}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding Summary}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeMD}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           FontSize="{StaticResource FontSizeXS}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Cells: "/>
                    <Run Text="{Binding NonEmptyCapacityCellCount}"/>
                    <Run Text=", Score: "/>
                    <Run Text="{Binding Score, StringFormat={}{0:0.0}}"/>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="Cell"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PDF Load Chart Import"
                               Style="{StaticResource TextTitle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSize2XL}"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TxtDocumentSummary"
                               Margin="0,6,0,0"
                               Style="{StaticResource TextCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        Margin="18,0,0,0"
                        MinWidth="410"
                        MaxWidth="560">
                    <StackPanel>
                        <TextBlock Text="Current Selection"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSelectionSummary"
                                   Text="Select a page and table candidate."
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeLG}"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" MinWidth="280" MaxWidth="620"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="620"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="160"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*" MinHeight="140"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Pages"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="Sorted by PDF page order. Choose the page that contains the correct crane load chart."
                                       Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>

                        <ListBox x:Name="PagesList"
                                 Style="{StaticResource CandidateListBoxStyle}"
                                 ItemContainerStyle="{StaticResource CandidateListBoxItemStyle}"
                                 ItemTemplate="{StaticResource PageCandidateTemplate}"
                                 SelectionChanged="PagesList_SelectionChanged"/>
                    </DockPanel>

                    <GridSplitter Grid.Row="1"
                                  Style="{StaticResource HorizontalGridSplitterStyle}"
                                  ToolTip="Drag to resize Pages and Detected Tables."/>

                    <DockPanel Grid.Row="2" Margin="0,0,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Detected Tables"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="Select the table whose columns, rows, and preview match the real chart."
                                       Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>

                        <ListBox x:Name="TablesList"
                                 Style="{StaticResource CandidateListBoxStyle}"
                                 ItemContainerStyle="{StaticResource CandidateListBoxItemStyle}"
                                 ItemTemplate="{StaticResource TableCandidateTemplate}"
                                 SelectionChanged="TablesList_SelectionChanged"/>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource VerticalGridSplitterStyle}"
                          ToolTip="Drag to resize the candidate navigator and preview area."/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="118" MinHeight="88"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*" MinHeight="260"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="112" MinHeight="72"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Candidate Details"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="TxtPageDetails"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtTableDetails"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeLG}"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="1"
                              Style="{StaticResource HorizontalGridSplitterStyle}"
                              ToolTip="Drag to resize Candidate Details and Load Chart Preview."/>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,0,0,0"
                                    Padding="12,8">
                                <DockPanel>
                                    <TextBlock Text="LOAD CHART PREVIEW"
                                               Style="{StaticResource PanelSectionHeader}"/>
                                    <TextBlock Text="Parsed grid"
                                               DockPanel.Dock="Right"
                                               Style="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource TextDisabledBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>

                            <DataGrid x:Name="PreviewGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      AlternationCount="2"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      CanUserResizeColumns="True"
                                      CanUserReorderColumns="False"
                                      FrozenColumnCount="1"
                                      RowHeaderWidth="0"
                                      HorizontalScrollBarVisibility="Visible"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True"
                                      ClipToBounds="True">
                                <DataGrid.Resources>
                                    <Style TargetType="{x:Type ScrollViewer}">
                                        <Setter Property="CanContentScroll" Value="True"/>
                                        <Setter Property="HorizontalScrollBarVisibility" Value="Visible"/>
                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Grid>

                        <GridSplitter Grid.Column="1"
                                      Style="{StaticResource VerticalGridSplitterStyle}"
                                      ToolTip="Drag to resize parsed grid and source PDF preview."/>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0,6,0,0"
                                    Padding="12,8">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="Fit Page"
                                                Height="24"
                                                MinWidth="72"
                                                Margin="0,0,6,0"
                                                Padding="8,0"
                                                Style="{StaticResource ButtonSecondary}"
                                                Click="SourcePreviewFitPage_Click"/>
                                        <Button Content="Find Table"
                                                Height="24"
                                                MinWidth="76"
                                                Margin="0,0,6,0"
                                                Padding="8,0"
                                                Style="{StaticResource ButtonSecondary}"
                                                Click="SourcePreviewFindTable_Click"/>
                                        <Button Content="-"
                                                Height="24"
                                                Width="30"
                                                Margin="0,0,6,0"
                                                Style="{StaticResource ButtonSecondary}"
                                                Click="SourcePreviewZoomOut_Click"/>
                                        <Button Content="+"
                                                Height="24"
                                                Width="30"
                                                Style="{StaticResource ButtonSecondary}"
                                                Click="SourcePreviewZoomIn_Click"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="SOURCE PDF PREVIEW"
                                                   Style="{StaticResource PanelSectionHeader}"/>
                                        <TextBlock x:Name="TxtSourcePreviewStatus"
                                                   Text="Select a detected table to render the original PDF page."
                                                   Style="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0"
                                    ClipToBounds="True">
                                <ScrollViewer x:Name="SourcePdfScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="{DynamicResource BackgroundBrush}">
                                    <Canvas x:Name="SourcePdfCanvas"
                                            Background="{DynamicResource BackgroundBrush}"
                                            Width="1"
                                            Height="1">
                                        <Image x:Name="SourcePdfImage"
                                               Stretch="None"
                                               SnapsToDevicePixels="True"/>
                                        <Rectangle x:Name="SourcePdfTableHighlight"
                                                   Stroke="{StaticResource PrimaryBrush}"
                                                   StrokeThickness="3"
                                                   Fill="#22E69152"
                                                   Visibility="Collapsed"
                                                   IsHitTestVisible="False"/>
                                    </Canvas>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="3"
                              Style="{StaticResource HorizontalGridSplitterStyle}"
                              ToolTip="Drag to resize Load Chart Preview and Import Notes."/>

                <Border Grid.Row="4"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,6">
                            <TextBlock Text="i"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeLG}"
                                       FontWeight="Bold"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Import Notes"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="0"/>
                        </StackPanel>

                        <TextBox x:Name="TxtWarnings"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 BorderThickness="0"
                                 FontFamily="{StaticResource FontPrimary}"
                                 FontSize="{StaticResource FontSizeSM}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtBottomStatus"
                           Grid.Column="0"
                           Style="{StaticResource TextCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button x:Name="BtnImportSelected"
                        Grid.Column="1"
                        Content="Import Selected Table"
                        Width="180"
                        Height="34"
                        Style="{StaticResource ButtonPrimary}"
                        Click="ImportSelected_Click"/>

                <Button Grid.Column="3"
                        Content="Cancel"
                        Width="110"
                        Height="34"
                        Style="{StaticResource ButtonSecondary}"
                        Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
