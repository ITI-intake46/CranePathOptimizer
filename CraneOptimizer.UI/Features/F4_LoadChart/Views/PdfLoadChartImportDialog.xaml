<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.PdfLoadChartImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="PDF Load Chart Import"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
        Width="1500"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource FontPrimary}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="DialogScrollBarStyle"
               TargetType="ScrollBar"
               BasedOn="{StaticResource SharedScrollBarStyle}"/>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource DialogScrollBarStyle}"/>

        <!-- ── Dialog font scale (local) ──────────────────────────────────
             Increased for better readability throughout the dialog. -->
        <sys:Double x:Key="FontSizeXS">13</sys:Double>
        <sys:Double x:Key="FontSizeSM">13</sys:Double>
        <sys:Double x:Key="FontSizeMD">14</sys:Double>
        <sys:Double x:Key="FontSizeBase">14</sys:Double>
        <sys:Double x:Key="FontSizeLG">16</sys:Double>
        <sys:Double x:Key="FontSizeXL">19</sys:Double>
        <sys:Double x:Key="FontSize2XL">22</sys:Double>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextTitle}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="GridSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ShowsPreview" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Border x:Name="Grip"
                                    Background="{DynamicResource BorderBrush}"
                                    Opacity="0.35"
                                    CornerRadius="2"
                                    Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource SecondaryBrush}"/>
                                <Setter TargetName="Grip" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource SecondaryBrush}"/>
                                <Setter TargetName="Grip" Property="Opacity" Value="0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalGridSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource GridSplitterStyle}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        </Style>

        <Style x:Key="HorizontalGridSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource GridSplitterStyle}">
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="ResizeDirection" Value="Rows"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        </Style>

        <Style x:Key="CandidateListBoxStyle"
               TargetType="ListBox"
               BasedOn="{StaticResource SharedListBoxStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="CandidateListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="3,1,1,1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             PAGE CARD  –  Page number · Table count · Confidence
             ═══════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="PageCandidateTemplate">
            <Grid MinHeight="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Page number badge -->
                <Border Grid.Column="0"
                        Width="58"
                        MinWidth="58"
                        Height="58"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Page"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PageNumber}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSize2XL}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Right side: table count + confidence -->
                <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Table count -->
                    <TextBlock Grid.Row="0"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeMD}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap">
                        <Run Text="{Binding Tables.Count, Mode=OneWay}"/>
                        <Run Text=" tables detected"/>
                    </TextBlock>

                    <!-- Confidence badge -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,3"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ConfidenceLabel}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeMD}"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════════
             TABLE CARD  –  Table name · Extracted info · Confidence
             ═══════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="TableCandidateTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header row: title + confidence badge -->
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Border DockPanel.Dock="Right"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,3"
                            Margin="10,0,0,0">
                        <TextBlock Text="{Binding ConfidenceLabel}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeMD}"
                                   FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="{Binding DisplayTitle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeLG}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <!-- Extracted info: boom columns + radius rows (no line-requirement suffix) -->
                <TextBlock Grid.Row="1"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeMD}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap">
                    <Run Text="{Binding BoomColumnCount, Mode=OneWay}"/>
                    <Run Text=" visual boom columns"/>
                    <LineBreak/>
                    <Run Text="{Binding RadiusRowCount, Mode=OneWay}"/>
                    <Run Text=" capacity radius rows"/>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <Style x:Key="PreviewToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource SharedDataGridStyle}">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="Cell"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18,14"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <TextBlock Text="PDF Load Chart Import"
                           Style="{StaticResource TextTitle}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSize2XL}"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDocumentSummary"
                           Margin="16,0,0,0"
                           Style="{StaticResource TextCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeMD}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- ── Main content area ───────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="240" MaxWidth="440"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="680"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: Pages + Detected Tables -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="160"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*" MinHeight="140"/>
                    </Grid.RowDefinitions>

                    <!-- Pages section -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Pages"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="Sorted by PDF page order. Choose the page that contains the correct crane load chart."
                                       Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>

                        <ListBox x:Name="PagesList"
                                 Style="{StaticResource CandidateListBoxStyle}"
                                 ItemContainerStyle="{StaticResource CandidateListBoxItemStyle}"
                                 ItemTemplate="{StaticResource PageCandidateTemplate}"
                                 SelectionChanged="PagesList_SelectionChanged"/>
                    </DockPanel>

                    <GridSplitter Grid.Row="1"
                                  Style="{StaticResource HorizontalGridSplitterStyle}"
                                  ToolTip="Drag to resize Pages and Detected Tables."/>

                    <!-- Detected Tables section -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Detected Tables"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="Select the table whose columns, rows, and preview match the real chart."
                                       Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>

                        <ListBox x:Name="TablesList"
                                 Style="{StaticResource CandidateListBoxStyle}"
                                 ItemContainerStyle="{StaticResource CandidateListBoxItemStyle}"
                                 ItemTemplate="{StaticResource TableCandidateTemplate}"
                                 SelectionChanged="TablesList_SelectionChanged"/>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource VerticalGridSplitterStyle}"
                          ToolTip="Drag to resize the candidate navigator and preview area."/>

            <!-- Right panel: Preview only (Candidate Details and Import Notes removed) -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ParsedPreviewColumn" Width="*" MinWidth="360"/>
                        <ColumnDefinition x:Name="SourcePreviewSplitterColumn" Width="8"/>
                        <ColumnDefinition x:Name="SourcePreviewColumn" Width="*" MinWidth="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- Load Chart Preview (parsed grid) -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="6,0,0,0"
                                Padding="12,8">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            Margin="8,0,0,0">
                                    <TextBlock Text="Parsed grid"
                                               Style="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource TextDisabledBrush}"
                                               FontSize="{StaticResource FontSizeSM}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ToggleButton x:Name="BtnToggleSourcePreview"
                                                  Content="Hide PDF Preview"
                                                  IsChecked="True"
                                                  Height="26"
                                                  MinWidth="130"
                                                  Padding="10,0"
                                                  Style="{StaticResource PreviewToggleButtonStyle}"
                                                  Click="SourcePreviewVisibilityToggle_Click"
                                                  ToolTip="Hide the original PDF preview pane and expand the parsed grid."/>
                                </StackPanel>
                                <TextBlock Text="Load Chart Preview"
                                           Style="{StaticResource PanelSectionHeader}"
                                           FontSize="{StaticResource FontSizeLG}"/>
                            </DockPanel>
                        </Border>

                        <DataGrid x:Name="PreviewGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  AlternationCount="2"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  CanUserResizeColumns="True"
                                  CanUserReorderColumns="False"
                                  FrozenColumnCount="1"
                                  RowHeaderWidth="0"
                                  HorizontalScrollBarVisibility="Visible"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True"
                                  ClipToBounds="True">
                            <DataGrid.Resources>
                                <Style TargetType="{x:Type ScrollViewer}">
                                    <Setter Property="CanContentScroll" Value="True"/>
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Visible"/>
                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Grid>

                    <GridSplitter x:Name="SourcePreviewSplitter"
                                  Grid.Column="1"
                                  Style="{StaticResource VerticalGridSplitterStyle}"
                                  ToolTip="Drag to resize parsed grid and source PDF preview."/>

                    <!-- Source PDF Preview -->
                    <Grid x:Name="SourcePdfPreviewPane"
                          Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="0,6,0,0"
                                Padding="12,8">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="Fit Page"
                                            Height="26"
                                            MinWidth="72"
                                            Margin="0,0,6,0"
                                            Padding="8,0"
                                            Style="{StaticResource ButtonSecondary}"
                                            Click="SourcePreviewFitPage_Click"/>
                                    <Button Content="Find Table"
                                            Height="26"
                                            MinWidth="76"
                                            Margin="0,0,6,0"
                                            Padding="8,0"
                                            Style="{StaticResource ButtonSecondary}"
                                            Click="SourcePreviewFindTable_Click"/>
                                    <Button Content="-"
                                            Height="26"
                                            Width="30"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource ButtonSecondary}"
                                            Click="SourcePreviewZoomOut_Click"/>
                                    <Button Content="+"
                                            Height="26"
                                            Width="30"
                                            Style="{StaticResource ButtonSecondary}"
                                            Click="SourcePreviewZoomIn_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Source PDF Preview"
                                               Style="{StaticResource PanelSectionHeader}"
                                               FontSize="{StaticResource FontSizeLG}"/>
                                    <TextBlock x:Name="TxtSourcePreviewStatus"
                                               Text="Select a detected table to render the original PDF page."
                                               Style="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource TextDisabledBrush}"
                                               FontSize="{StaticResource FontSizeSM}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="SourcePdfScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="{DynamicResource BackgroundBrush}">
                                <Canvas x:Name="SourcePdfCanvas"
                                        Background="{DynamicResource BackgroundBrush}"
                                        Width="1"
                                        Height="1">
                                    <Image x:Name="SourcePdfImage"
                                           Stretch="None"
                                           SnapsToDevicePixels="True"/>
                                    <Rectangle x:Name="SourcePdfTableHighlight"
                                               Stroke="{StaticResource PrimaryBrush}"
                                               StrokeThickness="3"
                                               Fill="#22E69152"
                                               Visibility="Collapsed"
                                               IsHitTestVisible="False"/>
                                </Canvas>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtBottomStatus"
                           Grid.Column="0"
                           Style="{StaticResource TextCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeMD}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button x:Name="BtnImportSelected"
                        Grid.Column="1"
                        Content="Import Selected Table"
                        Width="190"
                        Height="36"
                        Style="{StaticResource ButtonPrimary}"
                        Click="ImportSelected_Click"/>

                <Button Grid.Column="3"
                        Content="Cancel"
                        Width="110"
                        Height="36"
                        Style="{StaticResource ButtonSecondary}"
                        Click="Cancel_Click"/>
            </Grid>
        </Border>

        <!-- ── Hidden elements required by code-behind ─────────────────── -->
        <!-- TxtPageDetails, TxtTableDetails, TxtWarnings, TxtSelectionSummary are
             written by the code-behind for internal logic but not shown in the UI. -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="TxtPageDetails"/>
            <TextBlock x:Name="TxtTableDetails"/>
            <TextBox   x:Name="TxtWarnings" IsReadOnly="True" AcceptsReturn="True"/>
            <TextBlock x:Name="TxtSelectionSummary"/>
        </StackPanel>
    </Grid>
</Window>
