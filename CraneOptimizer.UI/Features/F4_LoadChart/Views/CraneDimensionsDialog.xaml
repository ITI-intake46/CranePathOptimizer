<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.CraneDimensionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crane Dimensions"
        Width="460" Height="420"
        MinWidth="420" MinHeight="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Crane Dimensions" Style="{StaticResource TextTitle}"/>
                <TextBlock Text="Store transport and outrigger dimensions on the crane record."
                           Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="TRANSPORT DIMENSIONS"
                               Style="{StaticResource PanelSectionHeader}"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblVehicleLength" Text="Total Length (m)" Style="{StaticResource PropertyLabel}"/>
                    <TextBox x:Name="TxtVehicleLength" Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblVehicleHeight" Text="Transport Height (m)" Style="{StaticResource PropertyLabel}"/>
                    <TextBox x:Name="TxtVehicleHeight" Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblVehicleWidth" Text="Travel Width (m)" Style="{StaticResource PropertyLabel}"/>
                    <TextBox x:Name="TxtVehicleWidth" Margin="0,0,0,12"/>

                    <TextBlock Text="OUTRIGGER CONFIGURATION"
                               Style="{StaticResource PanelSectionHeader}"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblOutriggerWidth" Text="Outrigger Span (pad to pad) (m)" Style="{StaticResource PropertyLabel}"/>
                    <TextBox x:Name="TxtOutriggerWidth" Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblOutriggerLength" Text="Span to Span (front to rear) (m)" Style="{StaticResource PropertyLabel}"/>
                    <TextBox x:Name="TxtOutriggerLength"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Text="All fields are optional."/>

                <Button Grid.Column="1" Width="110" Height="34" Content="Apply"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnApply_Click"/>
                <Button Grid.Column="3" Width="90" Height="34" Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
