<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.CraneDimensionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Crane Dimensions"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
        Width="760" Height="780"
        MinWidth="700" MinHeight="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- ── Local font scale (+2px over global compact tokens) ──────── -->
        <sys:Double x:Key="FontSizeXS">13</sys:Double>
        <sys:Double x:Key="FontSizeSM">13</sys:Double>
        <sys:Double x:Key="FontSizeMD">14</sys:Double>
        <sys:Double x:Key="FontSizeBase">14</sys:Double>
        <sys:Double x:Key="FontSizeLG">15</sys:Double>
        <sys:Double x:Key="FontSizeXL">18</sys:Double>

        <!-- ── Local style overrides: force white text on dark backgrounds ── -->
        <Style x:Key="TextCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="TextTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource FontSizeLG}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="PropertyLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"        Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"          Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,8,0,4"/>
        </Style>

        <Style x:Key="PanelSectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource FontSizeMD}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Crane Dimensions"
                           Style="{StaticResource TextTitle}"/>
                <TextBlock Text="Enter the crane's required transport and operating footprint dimensions."
                           Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="TRANSPORT DIMENSIONS"
                               Style="{StaticResource PanelSectionHeader}"
                               Margin="0,0,0,10"/>

                    <!-- PDF metadata notice -->
                    <Border x:Name="MetadataSummaryPanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="PDF metadata applied"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeSM}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock x:Name="TxtMetadataSummary"
                                           Margin="0,3,0,0"
                                           Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button x:Name="BtnViewMetadataEvidence"
                                    Grid.Column="1"
                                    Content="View details"
                                    Width="110"
                                    Height="30"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ButtonOutlined}"
                                    Click="BtnViewMetadataEvidence_Click"/>
                        </Grid>
                    </Border>

                    <!-- Transport fields -->
                    <TextBlock x:Name="LblVehicleLength" Text="Total Length * (m)"
                               Style="{StaticResource PropertyLabel}"/>
                    <TextBox x:Name="TxtVehicleLength" Margin="0,0,0,3"/>
                    <TextBlock x:Name="HintVehicleLength"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblVehicleHeight" Text="Transport Height * (m)"
                               Style="{StaticResource PropertyLabel}"/>
                    <TextBox x:Name="TxtVehicleHeight" Margin="0,0,0,3"/>
                    <TextBlock x:Name="HintVehicleHeight"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblVehicleWidth" Text="Travel Width * (m)"
                               Style="{StaticResource PropertyLabel}"/>
                    <TextBox x:Name="TxtVehicleWidth" Margin="0,0,0,3"/>
                    <TextBlock x:Name="HintVehicleWidth"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,0,0,12"/>

                    <!-- Outrigger section -->
                    <StackPanel x:Name="OutriggerFieldsPanel">
                        <TextBlock Text="OUTRIGGER CONFIGURATION"
                                   Style="{StaticResource PanelSectionHeader}"
                                   Margin="0,4,0,10"/>

                        <Border x:Name="OutriggerMetadataNotice"
                                Visibility="Collapsed"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,10">
                            <TextBlock x:Name="TxtOutriggerMetadataNotice"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock x:Name="LblOutriggerWidth"
                                   Text="Outrigger Span (pad to pad) * (m)"
                                   Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TxtOutriggerWidth" Margin="0,0,0,3"/>
                        <TextBlock x:Name="HintOutriggerWidth"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="LblOutriggerLength"
                                   Text="Span to Span (front to rear) * (m)"
                                   Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TxtOutriggerLength" Margin="0,0,0,3"/>
                        <TextBlock x:Name="HintOutriggerLength"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <Border x:Name="OnRubberNotice"
                            Visibility="Collapsed"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <TextBlock Text="On Rubber selected. Outrigger dimensions are not applicable."
                                   Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Fields marked * are required."/>

                <Button Grid.Column="1" Width="110" Height="34" Content="Apply"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnApply_Click"/>
                <Button Grid.Column="3" Width="90" Height="34" Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
