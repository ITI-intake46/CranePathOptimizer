<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.CraneDimensionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crane Dimensions"
        Width="460"
        Height="420"
        MinWidth="420"
        MinHeight="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6"
                Padding="18,14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Crane Dimensions"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="16"
                           FontWeight="Bold"/>
                <TextBlock Text="Store transport and outrigger dimensions on the crane record."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="11"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="TRANSPORT DIMENSIONS"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Total Length (mm)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtVehicleLength" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,8"/>

                    <TextBlock Text="Transport Height (mm)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtVehicleHeight" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,8"/>

                    <TextBlock Text="Travel Width (mm)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtVehicleWidth" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,12"/>

                    <TextBlock Text="OUTRIGGER CONFIGURATION"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Outrigger Span (pad to pad) (mm)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtOutriggerWidth" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,8"/>

                    <TextBlock Text="Span to Span (front to rear) (mm)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtOutriggerLength" Style="{StaticResource FieldTextBoxStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="11"
                           Text="All fields are optional."/>

                <Button Grid.Column="1"
                        Width="110"
                        Height="34"
                        Content="Apply"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnApply_Click"/>

                <Button Grid.Column="3"
                        Width="90"
                        Height="34"
                        Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
