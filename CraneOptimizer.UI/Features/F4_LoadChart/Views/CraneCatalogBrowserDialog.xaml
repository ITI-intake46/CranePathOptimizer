<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.CraneCatalogBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crane Catalog Browser"
        Width="900" Height="620"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="CatalogLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
        <Style x:Key="CatalogVal" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="18,12">
            <StackPanel>
                <TextBlock Text="🏗  Crane Catalog"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="15" FontWeight="Bold"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="11" Margin="0,2,0,0"
                           Text="Browse saved cranes and load charts. Select a chart to assign it to the active crane."/>
            </StackPanel>
        </Border>

        <!-- ── Main area ──────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: search + catalog list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search box -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Margin="0,0,0,8">
                    <TextBox x:Name="TxtSearch"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0" Padding="8,6"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             TextChanged="TxtSearch_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Foreground="#555" FontSize="10"
                                                                   FontStyle="Italic" Margin="10,0,0,0"
                                                                   Text="🔍  Search cranes..."/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>

                <!-- Catalog list -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5"
                        Background="{DynamicResource BackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CatalogListPanel" Margin="0,4"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Right: details -->
            <Grid Grid.Column="2">

                <!-- Empty state -->
                <Border x:Name="DetailEmpty"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Background="{DynamicResource BackgroundBrush}"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🏗" FontSize="42"
                                   HorizontalAlignment="Center" Opacity="0.18"/>
                        <TextBlock Text="Select a crane from the list"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="13" HorizontalAlignment="Center"
                                   Margin="0,10,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Detail panel -->
                <ScrollViewer x:Name="DetailScroll"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel Margin="0,0,4,0">

                        <!-- Crane model header -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="DetailModel"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="DetailMfg"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Available charts -->
                        <TextBlock Text="AVAILABLE LOAD CHARTS"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="9" FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource BackgroundBrush}"
                                CornerRadius="5"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Padding="8,6">
                            <ScrollViewer MaxHeight="200"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ChartListPanel" Margin="0,2"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Selected chart info -->
                        <TextBlock x:Name="TxtSelectedChart"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="10" Margin="0,8,0,4"
                                   Visibility="Collapsed"/>

                        <!-- Mini data preview grid -->
                        <Border x:Name="MiniPreview"
                                Background="{DynamicResource BackgroundBrush}"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed" MaxHeight="180">
                            <DataGrid x:Name="MiniGrid"
                                      IsReadOnly="True" AutoGenerateColumns="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      Background="Transparent"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      FontSize="9" RowHeight="18"
                                      HeadersVisibility="Column"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── Bottom bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="10" VerticalAlignment="Center"
                           Text="Loading catalog..."/>

                <Button x:Name="BtnAssign" Grid.Column="1"
                        Content="✓ Assign to Active Crane"
                        Style="{StaticResource ButtonPrimary}"
                        Width="170" IsEnabled="False"
                        Click="BtnAssign_Click"
                        ToolTip="Assign the selected load chart to the currently selected crane"/>

                <Button Grid.Column="3" Content="+ Import New Chart"
                        Style="{StaticResource ButtonSecondary}"
                        Width="140" Click="BtnImport_Click"/>

                <Button Grid.Column="5" Content="Close"
                        Style="{StaticResource ButtonSecondary}"
                        Width="80" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
