<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.CraneCatalogBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Crane Catalog Browser"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
        Width="980" Height="660"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- ── Local font scale (+2px over global compact tokens) ──────── -->
        <sys:Double x:Key="FontSizeXS">13</sys:Double>
        <sys:Double x:Key="FontSizeSM">13</sys:Double>
        <sys:Double x:Key="FontSizeMD">14</sys:Double>
        <sys:Double x:Key="FontSizeBase">14</sys:Double>
        <sys:Double x:Key="FontSizeLG">15</sys:Double>
        <sys:Double x:Key="FontSizeXL">18</sys:Double>

        <!-- ── Local style overrides: force white foreground ───────────── -->
        <Style x:Key="TextCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="TextTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource FontSizeLG}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="PropertyLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PropertyValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource FontSizeMD}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── DataGrid dark-theme overrides ──────────────────────────── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"              Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground"              Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"             Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="GridLinesVisibility"     Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush"  Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground"           Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="RowHeight"               Value="36"/>
            <Setter Property="ColumnHeaderHeight"      Value="40"/>
            <Setter Property="FontFamily"              Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"                Value="{StaticResource FontSizeMD}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"              Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"              Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"             Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"         Value="0,0,1,1"/>
            <Setter Property="Padding"                 Value="10,0"/>
            <Setter Property="FontFamily"              Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"                Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight"              Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Foreground"              Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"             Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="Padding"                 Value="8,0"/>
            <Setter Property="FontFamily"              Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"                Value="{StaticResource FontSizeSM}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="FocusVisualStyle"        Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBox item style: white text, dark selection -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground"              Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Padding"                 Value="10,8"/>
            <Setter Property="FontFamily"              Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"                Value="{StaticResource FontSizeMD}"/>
            <Setter Property="FocusVisualStyle"        Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtHeaderTitle"
                           Text="Crane Catalog Manager"
                           Style="{StaticResource TextTitle}"/>
                <TextBlock x:Name="TxtHeaderSubtitle"
                           Text="Manage saved crane load charts: import new charts, edit specifications, or delete outdated catalog entries."
                           Margin="0,4,0,0"
                           Style="{StaticResource TextCaption}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: search + list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="TxtSearch"
                         Grid.Row="0"
                         Margin="0,0,0,8"
                         TextChanged="TxtSearch_TextChanged"/>

                <Border Grid.Row="1"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <ListBox x:Name="LstCranes"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="LstCranes_SelectionChanged"
                             DisplayMemberPath="Name"/>
                </Border>
            </Grid>

            <!-- Right: detail panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Name / mfg / dimensions -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock x:Name="DetailModel"
                                   Text="Select a crane"
                                   Style="{StaticResource TextTitle}"/>
                        <TextBlock x:Name="DetailMfg"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource TextCaption}"/>
                        <TextBlock x:Name="DetailDimensions"
                                   Margin="0,6,0,0"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Stats row -->
                <Border Grid.Row="1"
                        Margin="0,10,0,10"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6" Padding="12">
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Outrigger" Style="{StaticResource PropertyLabel}"/>
                            <TextBlock x:Name="DetailOutrigger" Style="{StaticResource PropertyValue}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Counterweight" Style="{StaticResource PropertyLabel}"/>
                            <TextBlock x:Name="DetailCounterweight" Style="{StaticResource PropertyValue}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Points" Style="{StaticResource PropertyLabel}"/>
                            <TextBlock x:Name="DetailPointCount" Style="{StaticResource PropertyValue}"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Data grid -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <DataGrid x:Name="MiniGrid"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Loading cranes..."/>

                <Button x:Name="BtnImport" Grid.Column="1" Width="120" Content="Import New"
                        Style="{StaticResource ButtonOutlined}"
                        Click="BtnImport_Click"/>
                <Button x:Name="BtnEdit" Grid.Column="3" Width="90" Content="Edit"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnEdit_Click"/>
                <Button x:Name="BtnDelete" Grid.Column="5" Width="90" Content="Delete"
                        Style="{StaticResource ButtonDestructive}"
                        Click="BtnDelete_Click"/>
                <Button Grid.Column="7" Width="80" Content="Close"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
