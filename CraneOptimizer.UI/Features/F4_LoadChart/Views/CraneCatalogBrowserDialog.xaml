<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.CraneCatalogBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crane Catalog Browser"
        Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
        Width="980" Height="660"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtHeaderTitle"
                           Text="Saved Crane Load Charts"
                           Style="{StaticResource TextTitle}"/>
                <TextBlock x:Name="TxtHeaderSubtitle"
                           Text="Browse saved cranes, inspect the stored specification, then edit or delete it."
                           Margin="0,4,0,0"
                           Style="{StaticResource TextCaption}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: search + list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="TxtSearch"
                         Grid.Row="0"
                         Margin="0,0,0,8"
                         TextChanged="TxtSearch_TextChanged"/>

                <Border Grid.Row="1"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <ListBox x:Name="LstCranes"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="LstCranes_SelectionChanged"
                             DisplayMemberPath="Name"/>
                </Border>
            </Grid>

            <!-- Right: detail panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Name / mfg / dimensions -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock x:Name="DetailModel"
                                   Text="Select a crane"
                                   Style="{StaticResource TextTitle}"/>
                        <TextBlock x:Name="DetailMfg"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource TextCaption}"/>
                        <TextBlock x:Name="DetailDimensions"
                                   Margin="0,6,0,0"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Stats row -->
                <Border Grid.Row="1"
                        Margin="0,10,0,10"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6" Padding="12">
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Outrigger" Style="{StaticResource PropertyLabel}"/>
                            <TextBlock x:Name="DetailOutrigger" Style="{StaticResource PropertyValue}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Counterweight" Style="{StaticResource PropertyLabel}"/>
                            <TextBlock x:Name="DetailCounterweight" Style="{StaticResource PropertyValue}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Points" Style="{StaticResource PropertyLabel}"/>
                            <TextBlock x:Name="DetailPointCount" Style="{StaticResource PropertyValue}"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Data grid -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <DataGrid x:Name="MiniGrid"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Text="Loading cranes..."/>

                <Button x:Name="BtnImport" Grid.Column="1" Width="120" Content="Import New"
                        Style="{StaticResource ButtonOutlined}"
                        Click="BtnImport_Click"/>
                <Button x:Name="BtnEdit" Grid.Column="3" Width="90" Content="Edit"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnEdit_Click"/>
                <Button x:Name="BtnDelete" Grid.Column="5" Width="90" Content="Delete"
                        Style="{StaticResource ButtonDestructive}"
                        Click="BtnDelete_Click"/>
                <Button Grid.Column="7" Width="80" Content="Close"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
