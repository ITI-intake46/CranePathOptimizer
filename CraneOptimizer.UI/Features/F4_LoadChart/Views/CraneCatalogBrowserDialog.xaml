<Window x:Class="CraneOptimizer.UI.Features.F4_LoadChart.Views.CraneCatalogBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crane Catalog Browser"
        Width="980"
        Height="660"
        MinWidth="780"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6"
                Padding="18,14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Saved Crane Load Charts"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="16"
                           FontWeight="Bold"/>
                <TextBlock Text="Browse saved cranes, inspect the stored specification, then edit or delete it."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="11"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="TxtSearch"
                         Grid.Row="0"
                         Margin="0,0,0,8"
                         Padding="8,6"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         TextChanged="TxtSearch_TextChanged"/>

                <Border Grid.Row="1"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ListBox x:Name="LstCranes"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             SelectionChanged="LstCranes_SelectionChanged"
                             DisplayMemberPath="Name"/>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock x:Name="DetailModel"
                                   Text="Select a crane"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="DetailMfg"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="11"/>
                        <TextBlock x:Name="DetailDimensions"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,10,0,10"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="6"
                        Padding="12">
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Outrigger"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="10"/>
                            <TextBlock x:Name="DetailOutrigger"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Counterweight"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="10"/>
                            <TextBlock x:Name="DetailCounterweight"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Points"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="10"/>
                            <TextBlock x:Name="DetailPointCount"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <DataGrid x:Name="MiniGrid"
                              IsReadOnly="True"
                              AutoGenerateColumns="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="Transparent"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="11"
                           Text="Loading cranes..."/>

                <Button Grid.Column="1"
                        Width="120"
                        Content="Import New"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnImport_Click"/>

                <Button Grid.Column="3"
                        Width="90"
                        Content="Edit"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnEdit_Click"/>

                <Button Grid.Column="5"
                        Width="90"
                        Content="Delete"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnDelete_Click"/>

                <Button Grid.Column="7"
                        Width="80"
                        Content="Close"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
