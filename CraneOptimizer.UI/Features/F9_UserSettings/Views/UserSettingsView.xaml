<UserControl
    x:Class="CraneOptimizer.UI.Features.F9_Settings.Views.UserSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource BackgroundBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0" Orientation="Horizontal">

            <Border Padding="8,6">
                <StackPanel Width="300" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border
                            Width="4"
                            Height="22"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource PrimaryBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXL}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="User Settings" />
                    </StackPanel>
                    <TextBlock
                        Margin="16,0,0,0"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeSM}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="View your account details and manage your licence" />
                </StackPanel>
            </Border>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Width="480" Style="{StaticResource RibbonCommandGroup}" Tag="Project units">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Click="OpenUnits_Click"
                        Content="Units"
                        Style="{StaticResource RibbonMajorPrimaryCommandTile}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeLG}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="Units" />
                        <TextBlock
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Controls how dimensions and weights are displayed. Calculations and storage stay normalized."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Width="330" Style="{StaticResource RibbonCommandGroup}" Tag="User information">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                        <TextBlock
                            Width="110"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="User ID:" />
                        <TextBlock
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding UserId, FallbackValue='â€”'}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                        <TextBlock
                            Width="110"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Name:" />
                        <TextBlock
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding UserName, FallbackValue='â€”'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="110"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Offline available until:" />
                        <TextBlock
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSM}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding OfflineUntil, FallbackValue='â€”'}" />
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Width="360" Style="{StaticResource RibbonCommandGroup}" Tag="Licence information">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="44"
                        Height="44"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Text="ًں”‘" />
                    </Border>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeLG}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding LicenceName, FallbackValue='CraneOptimizer Free'}" />
                        <TextBlock
                            Cursor="Hand"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="View licence details" />
                    </StackPanel>
                    <Border
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Background="{StaticResource SuccessBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="Bold"
                            Foreground="#1A1A1A"
                            Text="âœ“ ACTIVE" />
                    </Border>
                </StackPanel>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Width="270" Style="{StaticResource RibbonCommandGroup}" Tag="Connection status">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource SuccessBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeXS}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Connection quality: good" />
                    <Border Margin="12,0,0,0" Padding="8,4" Background="{StaticResource SuccessBrush}" CornerRadius="3">
                        <TextBlock
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="Bold"
                            Foreground="#1A1A1A"
                            Text="â—ڈ Active" />
                    </Border>
                </StackPanel>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="ACCOUNT">
                <Button
                    Command="{Binding LogoutCommand}"
                    Content="Logout"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeSM}"
                    FontWeight="SemiBold"
                    Style="{StaticResource RibbonMajorDestructiveCommandTile}"
                    Tag="🚪" />
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
