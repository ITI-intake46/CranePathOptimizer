<UserControl x:Class="CraneOptimizer.UI.Features.F9_Settings.Views.UserSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">



    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="50,40" MaxWidth="800" HorizontalAlignment="Left">

            <!-- Page header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Width="4" Height="22"
                        Background="{StaticResource PrimaryBrush}"
                        Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="User Settings"
                           FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                           FontFamily="{StaticResource FontPrimary}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock Text="View your account details and manage your licence"
                       FontSize="{StaticResource FontSizeSM}"
                       FontFamily="{StaticResource FontPrimary}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="16,0,0,40"/>

            <!-- User information -->
            <TextBlock Text="User information"
                       FontSize="{StaticResource FontSizeLG}"
                       FontWeight="SemiBold"
                       FontFamily="{StaticResource FontPrimary}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,15"/>

            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="25" Margin="0,0,0,30">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="User ID:"
                                   Width="200"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding UserId, FallbackValue='—'}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Name:"
                                   Width="200"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding UserName, FallbackValue='—'}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Offline available until:"
                                   Width="200"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding OfflineUntil, FallbackValue='—'}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Licence information -->
            <TextBlock Text="Licence information"
                       FontSize="{StaticResource FontSizeLG}"
                       FontWeight="SemiBold"
                       FontFamily="{StaticResource FontPrimary}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,15"/>

            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="25" Margin="0,0,0,40">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="4"
                            Background="{DynamicResource SurfaceBrush}"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="🔑" FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding LicenceName, FallbackValue='CraneOptimizer Free'}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeLG}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="View licence details"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Cursor="Hand"/>
                    </StackPanel>
                    <Border Background="{StaticResource SuccessBrush}"
                            CornerRadius="4" Padding="12,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="✓ ACTIVE"
                                   Foreground="#1A1A1A"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Connection status -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="20,14" Margin="0,0,0,40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Connection quality: good"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{StaticResource SuccessBrush}"
                            CornerRadius="3" Padding="8,4">
                        <TextBlock Text="● Active"
                                   Foreground="#1A1A1A"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Logout -->
            <Button Content="🚪  Logout"
                    Width="160" Height="40"
                    HorizontalAlignment="Left"
                    Style="{StaticResource ButtonDestructive}"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeSM}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,50"
                    Command="{Binding LogoutCommand}"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
