<UserControl x:Class="CraneOptimizer.UI.Features.F1_IfcViewerControl.Views.IfcViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helix="http://helix-toolkit.org/wpf"
             xmlns:osnap="clr-namespace:CraneOptimizer.UI.Features.F15_ObjectSnap.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Border Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Viewport header  -->
            <Border
                Grid.Row="0"
                Height="30"
                Padding="12,0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <Button
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Click="ResetCamera_Click"
                        Content="⊙ Reset View"
                        DockPanel.Dock="Right"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeSM}"
                        FontWeight="SemiBold"
                        Style="{StaticResource ButtonSecondary}" />
                    <StackPanel
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="GridUnitLabel"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="GRID m" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextDisabledBrush}"
                            Text="X" />
                        <TextBox
                            x:Name="GridSizeXTextBox"
                            Width="44"
                            Height="20"
                            Margin="4,0,6,0"
                            Padding="3,0"
                            VerticalContentAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            Text="50"
                            ToolTip="Grid size on X axis in meters" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            Foreground="{DynamicResource TextDisabledBrush}"
                            Text="Y" />
                        <TextBox
                            x:Name="GridSizeYTextBox"
                            Width="44"
                            Height="20"
                            Margin="4,0,6,0"
                            Padding="3,0"
                            VerticalContentAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            Text="50"
                            ToolTip="Grid size on Y axis in meters" />
                        <Button
                            Height="20"
                            Padding="6,0"
                            VerticalAlignment="Center"
                            Click="ApplyGridSize_Click"
                            Content="Apply"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Apply manual grid size" />
                        <Button
                            Height="20"
                            Margin="3,0,0,0"
                            Padding="6,0"
                            VerticalAlignment="Center"
                            Click="AutoGridSize_Click"
                            Content="Auto"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Fit grid to current building" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  Viewport stack  -->
            <Grid Grid.Row="1" ClipToBounds="True">

                <!--  3D VIEW  -->
                <helix:HelixViewport3D
                    x:Name="IfcViewer"
                    MouseDown="IfcViewer_MouseDown"
                    MouseMove="IfcViewer_MouseMove"
                    MouseUp="IfcViewer_MouseUp"
                    PreviewMouseDown="IfcViewer_PreviewMouseDown"
                    PreviewMouseMove="IfcViewer_PreviewMouseMove"
                    PreviewMouseUp="IfcViewer_PreviewMouseUp"
                    Background="{DynamicResource BackgroundBrush}"
                    CameraRotationMode="Turntable"
                    InfiniteSpin="False"
                    IsPanEnabled="True"
                    IsRotationEnabled="True"
                    IsZoomEnabled="True"
                    PreviewMouseWheel="IfcViewer_PreviewMouseWheel"
                    RotateAroundMouseDownPoint="True"
                    RotationSensitivity="1"
                    ShowCoordinateSystem="True"
                    ShowViewCube="True"
                    ZoomAroundMouseDownPoint="True"
                    ZoomSensitivity="2"
                    IsHeadLightEnabled="False">

                    <helix:HelixViewport3D.Style>
                        <Style TargetType="{x:Type helix:HelixViewport3D}">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IfcViewer.IsPlacementMode}" Value="True">
                                    <Setter Property="Cursor" Value="Cross" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Drawing.IsDrawing}" Value="True">
                                    <Setter Property="Cursor" Value="Cross" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Drawing.IsMeasuring}" Value="True">
                                    <Setter Property="Cursor" Value="Cross" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </helix:HelixViewport3D.Style>

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#3A3A3A" />
                                <DirectionalLight Direction="-1,-2,-1.5" Color="#FFFFFF" />
                                <DirectionalLight Direction="1,1,0.5" Color="#557799" />
                                <DirectionalLight Direction="0.3,1,-2" Color="#334466" />
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                </helix:HelixViewport3D>

                <!--  ── SELECTION RUBBER-BAND OVERLAY ─────────────────
                      Sits between the viewport and the osnap indicator.
                      IsHitTestVisible=False lets all mouse events fall
                      through to the HelixViewport3D below.               -->
                <Canvas x:Name="SelectionCanvas"
                        IsHitTestVisible="False"
                        Background="Transparent"
                        ClipToBounds="True"/>

                <!--  ── OSNAP INDICATOR OVERLAY ──────────────────────
                      Transparent Canvas floats above the 3D viewport.
                      IsHitTestVisible=False means ALL mouse events still
                      reach the HelixViewport3D below it.                   -->
                <Canvas x:Name="MeasurementOverlayCanvas"
                        IsHitTestVisible="False"
                        Background="Transparent"
                        ClipToBounds="True"/>

                <Canvas x:Name="OsnapOverlayCanvas"
                        IsHitTestVisible="False"
                        Background="Transparent"
                        ClipToBounds="True"/>

                <!--  🔥 IFC LOADING OVERLAY  -->
                <Border Background="{DynamicResource SurfaceOverlayBrush}" 
                        Visibility="{Binding IfcViewer.IsLoading, 
                    Converter={StaticResource BoolToVisibilityConverter}}">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeLG}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding IfcViewer.Status}" />

                        <ProgressBar
                            Width="220"
                            Height="8"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding IfcViewer.Progress}" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,24,0,0"
                    Padding="16,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Visibility="{Binding IfcViewer.IsPlacementMode, 
                    Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeSM}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding IfcViewer.PlacementPrompt}" />
                </Border>

            </Grid>

            <Border
                Grid.Row="2"
                Padding="8,2"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Render Quality" />
                        <ComboBox
                            x:Name="RenderQualityCombo"
                            Width="112"
                            Height="24"
                            VerticalAlignment="Center"
                            ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                            SelectedIndex="1"
                            SelectionChanged="RenderQualityCombo_SelectionChanged"
                            Style="{StaticResource DarkComboBox}"
                            ToolTip="High: detailed IFC meshes. Medium: simplified meshes. Low: batched boxes for large models.">
                            <ComboBoxItem Content="High" Tag="High" ToolTip="Full detailed IFC meshes with best visual quality." />
                            <ComboBoxItem Content="Medium" Tag="Medium" ToolTip="Simplified IFC meshes with reduced geometry complexity." />
                            <ComboBoxItem Content="Low" Tag="Low" ToolTip="Lightweight batched bounding boxes for maximum performance." />
                        </ComboBox>
                    </StackPanel>

                    <Rectangle
                        Width="1"
                        Height="12"
                        Margin="8,0"
                        DockPanel.Dock="Left"
                        Fill="{DynamicResource BorderBrush}" />

                    <osnap:OsnapStatusPanel
                        x:Name="OsnapPanel"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
