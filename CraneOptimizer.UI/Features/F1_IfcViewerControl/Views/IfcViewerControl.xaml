<UserControl x:Class="CraneOptimizer.UI.Features.F1_IfcViewerControl.Views.IfcViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helix="http://helix-toolkit.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ViewportIconFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Rectangle Margin="-2"
                                   Stroke="{DynamicResource PrimaryBrush}"
                                   StrokeThickness="1"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <!--  Viewport stack  -->
            <Grid ClipToBounds="True">

                <!--  3D VIEW  -->
                <helix:HelixViewport3D
                    x:Name="IfcViewer"
                    MouseDown="IfcViewer_MouseDown"
                    MouseMove="IfcViewer_MouseMove"
                    MouseUp="IfcViewer_MouseUp"
                    PreviewMouseDown="IfcViewer_PreviewMouseDown"
                    PreviewMouseMove="IfcViewer_PreviewMouseMove"
                    PreviewMouseUp="IfcViewer_PreviewMouseUp"
                    Background="{DynamicResource BackgroundBrush}"
                    CameraRotationMode="Turntable"
                    InfiniteSpin="False"
                    IsPanEnabled="True"
                    IsRotationEnabled="True"
                    IsZoomEnabled="True"
                    PreviewMouseWheel="IfcViewer_PreviewMouseWheel"
                    RotateAroundMouseDownPoint="True"
                    RotationSensitivity="1"
                    ShowCoordinateSystem="True"
                    ShowViewCube="True"
                    ZoomAroundMouseDownPoint="True"
                    ZoomSensitivity="2"
                    IsHeadLightEnabled="False">

                    <helix:HelixViewport3D.Style>
                        <Style TargetType="{x:Type helix:HelixViewport3D}">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IfcViewer.IsPlacementMode}" Value="True">
                                    <Setter Property="Cursor" Value="Cross" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Drawing.IsDrawing}" Value="True">
                                    <Setter Property="Cursor" Value="Cross" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Drawing.IsMeasuring}" Value="True">
                                    <Setter Property="Cursor" Value="Cross" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </helix:HelixViewport3D.Style>

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#3A3A3A" />
                                <DirectionalLight Direction="-1,-2,-1.5" Color="#FFFFFF" />
                                <DirectionalLight Direction="1,1,0.5" Color="#557799" />
                                <DirectionalLight Direction="0.3,1,-2" Color="#334466" />
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                </helix:HelixViewport3D>

                <Grid
                    Width="{Binding ViewCubeWidth, ElementName=IfcViewer}"
                    Height="{Binding ViewCubeHeight, ElementName=IfcViewer}"
                    Margin="0,0,8,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="20"
                    Background="{x:Null}">
                    <Button Width="28"
                            Height="28"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            AutomationProperties.HelpText="Restore the default viewport orientation and framing."
                            AutomationProperties.Name="Reset View"
                            Click="ResetCamera_Click"
                            ToolTip="Reset View">
                        <Button.Style>
                            <Style BasedOn="{StaticResource ToolbarButton}" TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource ViewportIconFocusVisual}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Path Width="14"
                                                  Height="14"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M12,2 L2,10 L4,10 L4,22 L10,22 L10,15 L14,15 L14,22 L20,22 L20,10 L22,10 Z"
                                                  Fill="{TemplateBinding Foreground}"
                                                  Stretch="Uniform" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!--  ── SELECTION RUBBER-BAND OVERLAY ─────────────────
                      Sits between the viewport and the osnap indicator.
                      IsHitTestVisible=False lets all mouse events fall
                      through to the HelixViewport3D below.               -->
                <Canvas x:Name="SelectionCanvas"
                        IsHitTestVisible="False"
                        Background="Transparent"
                        ClipToBounds="True"/>

                <!--  ── OSNAP INDICATOR OVERLAY ──────────────────────
                      Transparent Canvas floats above the 3D viewport.
                      IsHitTestVisible=False means ALL mouse events still
                      reach the HelixViewport3D below it.                   -->
                <Canvas x:Name="MeasurementOverlayCanvas"
                        IsHitTestVisible="False"
                        Background="Transparent"
                        ClipToBounds="True"/>

                <Canvas x:Name="OsnapOverlayCanvas"
                        IsHitTestVisible="False"
                        Background="Transparent"
                        ClipToBounds="True"/>

                <!--  🔥 IFC LOADING OVERLAY  -->
                <Border Background="{DynamicResource SurfaceOverlayBrush}" Visibility="{Binding IfcViewer.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeLG}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding IfcViewer.Status}" />

                        <ProgressBar
                            Width="220"
                            Height="8"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding IfcViewer.Progress}" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,24,0,0"
                    Padding="16,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Visibility="{Binding IfcViewer.IsPlacementMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeSM}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding IfcViewer.PlacementPrompt}" />
                </Border>

            </Grid>
        </Grid>
    </Border>
</UserControl>
