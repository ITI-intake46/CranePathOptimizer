<UserControl
    x:Class="CraneOptimizer.UI.Features.F2_IfcViewer.Views.IfcTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0" Orientation="Horizontal">

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="LOAD MODEL">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding IfcViewer.LoadIfcCommand}" Content="Load IFC" FontSize="{StaticResource FontSizeXS}" Style="{StaticResource RibbonMajorLeadingCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="📦" />
                        </Button.Tag>
                    </Button>
                    <Button Command="{Binding IfcViewer.MergeIfcCommand}" Content="Merge IFC" FontSize="{StaticResource FontSizeXS}" Style="{StaticResource RibbonMajorMiddleCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="🔗" />
                        </Button.Tag>
                    </Button>
                    <Button Command="{Binding IfcViewer.MoveIfcCommand}" Content="Move IFC" FontSize="{StaticResource FontSizeXS}" Style="{StaticResource RibbonMajorMiddleCommandTile}">
                        <Button.Tag>
                            <Viewbox
                                Width="30"
                                Height="30"
                                Stretch="Uniform">
                                <Canvas Width="32" Height="32">
                                    <Path
                                        Data="M16,3 L16,29 M16,3 L9,10 M16,3 L23,10 M16,29 L9,22 M16,29 L23,22 M3,16 L29,16 M3,16 L10,9 M3,16 L10,23 M29,16 L22,9 M29,16 L22,23"
                                        Stroke="{StaticResource PrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="3.4" />
                                </Canvas>
                            </Viewbox>
                        </Button.Tag>
                    </Button>
                    <Button Command="{Binding IfcViewer.DeleteIfcCommand}" Content="Delete IFC" FontSize="{StaticResource FontSizeXS}" Style="{StaticResource RibbonMajorTrailingCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="🗑" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="DISPLAY">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Toggle COG Markers" Style="{StaticResource RibbonMajorLeadingCommandTile}" ToolTip="Toggle COG Markers">
                        <Button.Tag>
                            <TextBlock Text="⊙" />
                        </Button.Tag>
                    </Button>
                    <Button Content="Color by Weight" Style="{StaticResource RibbonMajorMiddleCommandTile}" ToolTip="Color by Weight">
                        <Button.Tag>
                            <TextBlock Text="🎨" />
                        </Button.Tag>
                    </Button>
                    <Button Content="Export Element List" Style="{StaticResource RibbonMajorTrailingCommandTile}" ToolTip="Export Element List" Width="{StaticResource RibbonMajorLongCommandWidth}">
                        <Button.Tag>
                            <TextBlock Text="📊" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="FILTER">
                <Button
                    Command="{Binding ElementManagement.ShowFilterDialogCommand}"
                    Content="Filter"
                    FontSize="{StaticResource FontSizeXS}"
                    Style="{StaticResource RibbonMajorCommandTile}">
                    <Button.Tag>
                        <Viewbox
                            Width="26"
                            Height="26">
                            <Canvas Width="24" Height="24">
                                <Polygon Fill="{StaticResource PrimaryBrush}" Points="2,3 22,3 14,13 14,21 10,21 10,13" />
                                <Ellipse
                                    Canvas.Left="15"
                                    Canvas.Top="1"
                                    Width="8"
                                    Height="8"
                                    Fill="{StaticResource DestructiveBrush}"
                                    Visibility="Collapsed" />
                            </Canvas>
                        </Viewbox>
                    </Button.Tag>
                </Button>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="SITE LAYOUT">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Upload DXF" FontSize="{StaticResource FontSizeXS}" Style="{StaticResource RibbonMajorLeadingCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="📐" />
                        </Button.Tag>
                    </Button>
                    <Button Content="Align DXF" FontSize="{StaticResource FontSizeXS}" Style="{StaticResource RibbonMajorTrailingCommandTile}">
                        <Button.Tag>
                            <TextBlock FontSize="26" Text="🎯" />
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
