<UserControl
    x:Class="CraneOptimizer.UI.Features.F2_IfcViewer.Views.IfcTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

        <StackPanel Margin="4,0" Orientation="Horizontal">

            <!--  ── Load Model ─────────────────────────  -->
            <Border Padding="4,4,0,0">
                <DockPanel Width="210" LastChildFill="False">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="LOAD MODEL" />

                    <StackPanel Orientation="Horizontal">

                        <!--  Load IFC  -->
                        <Button Command="{Binding IfcViewer.LoadIfcCommand}" Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,8,0,2"
                                    FontSize="26"
                                    Text="📦" />
                                <TextBlock Text="Load IFC" />
                            </StackPanel>
                        </Button>

                        <!--  Merge IFC (placeholder)  -->
                        <Button Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,8,0,2"
                                    FontSize="26"
                                    Text="🔗" />
                                <TextBlock Text="Merge IFC" />
                            </StackPanel>
                        </Button>

                        <!--  Clear  -->
                        <Button Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,8,0,2"
                                    FontSize="26"
                                    Text="🗑" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <!--  ── Display ─────────────────────────  -->
            <Border Padding="8,8,0,0">
                <DockPanel>

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="DISPLAY" />

                    <StackPanel>

                        <Button
                            Width="160"
                            Margin="0,0,0,2"
                            Style="{StaticResource RibbonSmallBtn}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" Text="⊙" />
                                <TextBlock Text="Toggle COG Markers" />
                            </StackPanel>
                        </Button>

                        <Button
                            Width="160"
                            Margin="0,0,0,2"
                            Style="{StaticResource RibbonSmallBtn}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" Text="🎨" />
                                <TextBlock Text="Color by Weight" />
                            </StackPanel>
                        </Button>

                        <Button Width="160" Style="{StaticResource RibbonSmallBtn}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" Text="📊" />
                                <TextBlock Text="Export Element List" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <!--  ── Filter ─────────────────────────  -->
            <Border Padding="4,4,4,0">
                <DockPanel Width="84">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="FILTER" />

                    <Button Width="84" Style="{StaticResource RibbonLargeBtn}">

                        <StackPanel HorizontalAlignment="Center">

                            <Viewbox
                                Width="26"
                                Height="26"
                                Margin="0,8,0,2">
                                <Canvas Width="24" Height="24">

                                    <Polygon Fill="{StaticResource PrimaryBrush}" Points="2,3 22,3 14,13 14,21 10,21 10,13" />

                                    <!--  Indicator  -->
                                    <Ellipse
                                        Canvas.Left="15"
                                        Canvas.Top="1"
                                        Width="8"
                                        Height="8"
                                        Fill="{StaticResource DestructiveBrush}"
                                        Visibility="Collapsed" />

                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="Filter" />

                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <!--  ── Site Layout ─────────────────────────  -->
            <Border Padding="4,4,0,0">
                <DockPanel Width="140">

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GroupLabel}"
                        Text="SITE LAYOUT" />

                    <StackPanel Orientation="Horizontal">

                        <Button Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,8,0,2"
                                    FontSize="26"
                                    Text="📐" />
                                <TextBlock Text="Upload DXF" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource RibbonLargeBtn}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,8,0,2"
                                    FontSize="26"
                                    Text="🎯" />
                                <TextBlock Text="Align DXF" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>