<Window x:Class="CraneOptimizer.UI.Features.F2_IfcViewer.Views.ElementFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter &amp; Sort Elements"
        Width="680" MinWidth="560"
        Height="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontPrimary}"
        FontSize="12">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HSep" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill"   Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>
        <Style x:Key="FilterTag" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Margin"          Value="0,0,6,4"/>
        </Style>
        <DataTemplate x:Key="CheckableItemTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            CornerRadius="8" Padding="5,1" Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Count}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"/>
                    </Border>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title bar       -->
            <RowDefinition Height="Auto"/>
            <!-- Active tag strip-->
            <RowDefinition Height="*"/>
            <!-- Tab control     -->
            <RowDefinition Height="Auto"/>
            <!-- Footer          -->
        </Grid.RowDefinitions>

        <!-- ── Title bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Filter &amp; Sort Elements"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtSubtitle"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtActiveFilters"
                           Foreground="{StaticResource PrimaryBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Active filter tag strip ────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,8">
            <WrapPanel x:Name="TagsPanel"/>
        </Border>

        <!-- ── Tab control ────────────────────────────────────────────── -->
        <TabControl Grid.Row="2"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                           Padding="0,0,0,0">

            <!-- Tab 1: Filters -->
            <TabItem Header="Filters">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                               Background="{DynamicResource BackgroundBrush}">
                    <StackPanel Margin="16,14,16,16">

                        <!-- Search -->
                        <TextBlock Text="SEARCH" Style="{StaticResource SectionHeader}"/>
                        <TextBox x:Name="TxtSearch"
                                 Background="{DynamicResource SurfaceElevatedBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1" Padding="8,5"
                                 TextChanged="TxtSearch_TextChanged"
                                 Margin="0,0,0,12"/>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Element Type -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ELEMENT TYPE" Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}"
                                    Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                    Click="BtnSelectAllTypes_Click">All</Button>
                            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}"
                                    Padding="6,2" FontSize="10"
                                    Click="BtnClearAllTypes_Click">None</Button>
                        </Grid>
                        <ItemsControl x:Name="TypesList"
                                      ItemTemplate="{StaticResource CheckableItemTemplate}"
                                      Margin="0,0,0,12"/>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Weight range -->
                        <TextBlock Text="WEIGHT RANGE (kg)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="TxtWeightRange"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtWeightMin"
                                     Background="{DynamicResource SurfaceElevatedBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1" Padding="8,5"
                                     TextChanged="WeightRange_Changed"/>
                            <TextBlock Grid.Column="1" Text="-"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtWeightMax" Grid.Column="2"
                                     Background="{DynamicResource SurfaceElevatedBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1" Padding="8,5"
                                     TextChanged="WeightRange_Changed"/>
                        </Grid>
                        <Slider x:Name="SliderWeightMax"
                                Minimum="0" Maximum="50000" Value="50000"
                                Foreground="{StaticResource PrimaryBrush}"
                                Margin="0,4,0,12"
                                ValueChanged="SliderWeight_Changed"/>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Height range -->
                        <TextBlock Text="HEIGHT RANGE (m)" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtHeightMin"
                                     Background="{DynamicResource SurfaceElevatedBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1" Padding="8,5"
                                     TextChanged="HeightRange_Changed"/>
                            <TextBlock Grid.Column="1" Text="-"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtHeightMax" Grid.Column="2"
                                     Background="{DynamicResource SurfaceElevatedBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1" Padding="8,5"
                                     TextChanged="HeightRange_Changed"/>
                        </Grid>
                        <Slider x:Name="SliderHeightMax"
                                Minimum="0" Maximum="500" Value="500"
                                Foreground="{StaticResource PrimaryBrush}"
                                Margin="0,4,0,12"
                                ValueChanged="SliderHeight_Changed"/>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Material -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MATERIAL" Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}"
                                    Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                    Click="BtnSelectAllMaterials_Click">All</Button>
                            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}"
                                    Padding="6,2" FontSize="10"
                                    Click="BtnClearAllMaterials_Click">None</Button>
                        </Grid>
                        <TextBlock x:Name="TxtNoMaterials"
                                   Text="No material data in this model."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" Visibility="Collapsed"
                                   Margin="0,0,0,12"/>
                        <ItemsControl x:Name="MaterialsList"
                                      ItemTemplate="{StaticResource CheckableItemTemplate}"
                                      Margin="0,0,0,12"/>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <!-- Options -->
                        <TextBlock Text="OPTIONS" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="ChkShowUnplaced"
                                  Content="Include unplaced elements"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Checked="Options_Changed" Unchecked="Options_Changed"
                                  Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkOnlySelected"
                                  Content="Show only currently selected elements"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Checked="OnlySelected_Changed"
                                  Unchecked="OnlySelected_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Sort & Group -->
            <TabItem Header="Sort &amp; Group">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                               Background="{DynamicResource BackgroundBrush}">
                    <StackPanel Margin="16,14,16,16">
                        <TextBlock Text="SORT BY" Style="{StaticResource SectionHeader}"/>
                        <ComboBox x:Name="CboSortBy"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                  Margin="0,0,0,8">
                            <ComboBoxItem Content="Name"/>
                            <ComboBoxItem Content="Type"/>
                            <ComboBoxItem Content="Weight (kg)"/>
                            <ComboBoxItem Content="Height (m)"/>
                            <ComboBoxItem Content="Material"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="RbAscending" Content="Ascending"
                                         GroupName="SortDir" IsChecked="True"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,16,0"/>
                            <RadioButton x:Name="RbDescending" Content="Descending"
                                         GroupName="SortDir"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Rectangle Style="{StaticResource HSep}"/>

                        <TextBlock Text="GROUP BY" Style="{StaticResource SectionHeader}"/>
                        <ComboBox x:Name="CboGroupBy"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                            <ComboBoxItem Content="None" IsSelected="True"/>
                            <ComboBoxItem Content="Type"/>
                            <ComboBoxItem Content="Storey / Level"/>
                            <ComboBoxItem Content="Material"/>
                            <ComboBoxItem Content="Weight class"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ── Footer ─────────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Reset All Filters"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnReset_Click" Padding="14,6"/>

                <!-- preview count -->
                <TextBlock Grid.Column="1" x:Name="TxtPreviewCount"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Button Grid.Column="2" Content="Apply"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnApply_Click" Padding="20,8"/>

                <Button Grid.Column="4" Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnCancel_Click" Padding="14,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
