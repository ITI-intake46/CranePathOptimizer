<Window x:Class="CraneOptimizer.UI.Features.F2_IfcViewer.Views.ElementFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter &amp; Sort Elements"
        Width="680" MinWidth="560"
        Height="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontPrimary}"
        FontSize="{StaticResource FontSizeBase}">

    <Window.Resources>
        <!-- FilterTag kept: referenced from code-behind to build the active tag strip -->
        <Style x:Key="FilterTag" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Margin"          Value="0,0,6,4"/>
        </Style>
        <DataTemplate x:Key="CheckableItemTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeXS}"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            CornerRadius="8" Padding="5,1" Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Count}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeXS}"/>
                    </Border>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Filter &amp; Sort Elements" Style="{StaticResource TextTitle}"/>
                    <TextBlock x:Name="TxtSubtitle" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtActiveFilters"
                           Foreground="{StaticResource PrimaryBrush}"
                           FontSize="{StaticResource FontSizeXS}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Active filter tag strip -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,8">
            <WrapPanel x:Name="TagsPanel"/>
        </Border>

        <!-- Tab control -->
        <TabControl Grid.Row="2"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Padding="0">

            <!-- Tab 1: Filters -->
            <TabItem Header="Filters">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource BackgroundBrush}">
                    <StackPanel Margin="16,14,16,16">

                        <TextBlock Text="SEARCH" Style="{StaticResource PanelSectionHeader}"/>
                        <TextBox x:Name="TxtSearch" Margin="0,0,0,12"
                                 TextChanged="TxtSearch_TextChanged"/>

                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,10"/>

                        <!-- Element Type -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ELEMENT TYPE" Style="{StaticResource PanelSectionHeader}"
                                       VerticalAlignment="Center" Margin="0"/>
                            <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}"
                                    Padding="6,2" Margin="0,0,4,0"
                                    Click="BtnSelectAllTypes_Click">All</Button>
                            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}"
                                    Padding="6,2"
                                    Click="BtnClearAllTypes_Click">None</Button>
                        </Grid>
                        <ItemsControl x:Name="TypesList"
                                      ItemTemplate="{StaticResource CheckableItemTemplate}"
                                      Margin="0,0,0,12"/>

                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,10"/>

                        <!-- Weight range -->
                        <TextBlock Text="WEIGHT RANGE (kg)" Style="{StaticResource PanelSectionHeader}"/>
                        <TextBlock x:Name="TxtWeightRange"
                                   Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtWeightMin" TextChanged="WeightRange_Changed"/>
                            <TextBlock Grid.Column="1" Text="-"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtWeightMax" Grid.Column="2" TextChanged="WeightRange_Changed"/>
                        </Grid>
                        <Slider x:Name="SliderWeightMax" Minimum="0" Maximum="50000" Value="50000"
                                Foreground="{StaticResource PrimaryBrush}"
                                Margin="0,4,0,12" ValueChanged="SliderWeight_Changed"/>

                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,10"/>

                        <!-- Height range -->
                        <TextBlock Text="HEIGHT RANGE (m)" Style="{StaticResource PanelSectionHeader}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtHeightMin" TextChanged="HeightRange_Changed"/>
                            <TextBlock Grid.Column="1" Text="-"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtHeightMax" Grid.Column="2" TextChanged="HeightRange_Changed"/>
                        </Grid>
                        <Slider x:Name="SliderHeightMax" Minimum="0" Maximum="500" Value="500"
                                Foreground="{StaticResource PrimaryBrush}"
                                Margin="0,4,0,12" ValueChanged="SliderHeight_Changed"/>

                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,10"/>

                        <!-- Material -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MATERIAL" Style="{StaticResource PanelSectionHeader}"
                                       VerticalAlignment="Center" Margin="0"/>
                            <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}"
                                    Padding="6,2" Margin="0,0,4,0"
                                    Click="BtnSelectAllMaterials_Click">All</Button>
                            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}"
                                    Padding="6,2"
                                    Click="BtnClearAllMaterials_Click">None</Button>
                        </Grid>
                        <TextBlock x:Name="TxtNoMaterials"
                                   Text="No material data in this model."
                                   Style="{StaticResource TextCaption}"
                                   Visibility="Collapsed" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="MaterialsList"
                                      ItemTemplate="{StaticResource CheckableItemTemplate}"
                                      Margin="0,0,0,12"/>

                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,10"/>

                        <!-- Options -->
                        <TextBlock Text="OPTIONS" Style="{StaticResource PanelSectionHeader}"/>
                        <CheckBox x:Name="ChkShowUnplaced"
                                  Content="Include unplaced elements"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Checked="Options_Changed" Unchecked="Options_Changed"
                                  Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkOnlySelected"
                                  Content="Show only currently selected elements"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Checked="OnlySelected_Changed"
                                  Unchecked="OnlySelected_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Sort & Group -->
            <TabItem Header="Sort &amp; Group">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource BackgroundBrush}">
                    <StackPanel Margin="16,14,16,16">
                        <TextBlock Text="SORT BY" Style="{StaticResource PanelSectionHeader}"/>
                        <ComboBox x:Name="CboSortBy"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                  Margin="0,0,0,8">
                            <ComboBoxItem Content="Name"/>
                            <ComboBoxItem Content="Type"/>
                            <ComboBoxItem Content="Weight (kg)"/>
                            <ComboBoxItem Content="Height (m)"/>
                            <ComboBoxItem Content="Material"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="RbAscending" Content="Ascending"
                                         GroupName="SortDir" IsChecked="True"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,16,0"/>
                            <RadioButton x:Name="RbDescending" Content="Descending"
                                         GroupName="SortDir"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,10"/>

                        <TextBlock Text="GROUP BY" Style="{StaticResource PanelSectionHeader}"/>
                        <ComboBox x:Name="CboGroupBy"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                            <ComboBoxItem Content="None" IsSelected="True"/>
                            <ComboBoxItem Content="Type"/>
                            <ComboBoxItem Content="Storey / Level"/>
                            <ComboBoxItem Content="Material"/>
                            <ComboBoxItem Content="Weight class"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Reset All Filters"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnReset_Click" Padding="14,6"/>

                <TextBlock Grid.Column="1" x:Name="TxtPreviewCount"
                           Style="{StaticResource TextCaption}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <Button Grid.Column="2" Content="Apply"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnApply_Click" Padding="20,8"/>

                <Button Grid.Column="4" Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Click="BtnCancel_Click" Padding="14,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
