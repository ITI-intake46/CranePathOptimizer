<Window x:Class="CraneOptimizer.UI.Features.F2_IfcViewer.Views.IFCLoadOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IFC Load Options"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙"
                                   FontSize="{StaticResource FontSizeLG}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="IFC Load Options"
                                   FontSize="{StaticResource FontSizeSM}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="28" Height="28"
                            Style="{StaticResource TitleBarButton}"
                            Click="BtnCancel_Click" Content="✕"
                            FontSize="{StaticResource FontSizeXS}"/>
                </Grid>
            </Border>

            <!-- Options content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,8,16,8">

                    <!-- File path display -->
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="File: "
                                       FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtFilePath" Text="—"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Coordinate Reference -->
                    <TextBlock Style="{StaticResource PanelSectionHeader}"
                               Text="COORDINATE REFERENCE"
                               Margin="0,12,0,4"/>
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <RadioButton x:Name="RadLocalOnly" IsChecked="True" GroupName="CoordMode">
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="Local Only"
                                               FontSize="{StaticResource FontSizeBase}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Use model local coordinates only. IFC survey/georeferencing metadata will be stored as metadata but not activated."
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RadIfcOrigin" GroupName="CoordMode" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="IFC Origin Mapping"
                                               FontSize="{StaticResource FontSizeBase}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="The model stays in local coordinates. Local (0,0,0) maps to IFC Survey Easting/Northing/Elevation."
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                            <Border x:Name="BdrStatus" BorderThickness="0" CornerRadius="4" Padding="8,6" Margin="0,10,0,0" Background="{DynamicResource SurfaceBrush}">
                                <TextBlock x:Name="TxtStatus" Text="Scanning georeferencing..."
                                           FontSize="{StaticResource FontSizeXS}"
                                           FontWeight="Medium"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Annotation & Reference -->
                    <TextBlock Style="{StaticResource PanelSectionHeader}"
                               Text="ANNOTATION &amp; REFERENCE OBJECTS"/>
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <CheckBox x:Name="ChkHideGrids" IsChecked="True" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Grids  (IfcGrid)"
                                               FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Structural reference grid lines"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ChkHideLevels" IsChecked="True" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Levels / Storeys  (IfcBuildingStorey)"
                                               FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Floor level markers and elevation planes"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ChkHideAnnotations" IsChecked="True" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Annotations  (IfcAnnotation)"
                                               FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Text labels, dimension marks, symbols"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ChkHideSite" IsChecked="False" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Site  (IfcSite)"
                                               FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Site terrain and boundary geometry"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Spatial & Volume -->
                    <TextBlock Style="{StaticResource PanelSectionHeader}"
                               Text="SPATIAL &amp; VOLUME OBJECTS"/>
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <CheckBox x:Name="ChkHideSpaces" IsChecked="True" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Spaces / Rooms  (IfcSpace)"
                                               FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Room and area volume boxes"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ChkHideOpenings" IsChecked="True" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Opening Elements  (IfcOpeningElement)"
                                               FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Door/window cutout voids"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ChkHideVirtualElements" IsChecked="True" Margin="0,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Virtual Elements  (IfcVirtualElement)"
                                               FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Invisible boundary/placeholder elements"
                                               FontSize="{StaticResource FontSizeXS}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Note -->
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,10,0,4">
                        <TextBlock Text="These settings only affect 3D rendering. All elements remain available in the element list."
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer buttons -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,6,6">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="Select All" Width="80" Height="28"
                                Style="{StaticResource ButtonSecondary}"
                                Click="BtnSelectAll_Click"/>
                        <Button Content="Clear All"  Width="80" Height="28"
                                Margin="8,0,0,0"
                                Style="{StaticResource ButtonSecondary}"
                                Click="BtnClearAll_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Cancel" Width="80" Height="32"
                                Style="{StaticResource ButtonSecondary}"
                                Click="BtnCancel_Click"/>
                        <Button Content="Load"   Width="90" Height="32"
                                FontWeight="SemiBold" Margin="8,0,0,0"
                                Style="{StaticResource ButtonPrimary}"
                                Click="BtnLoad_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
