<UserControl
    x:Class="CraneOptimizer.UI.Features.F2_IfcViewer.Views.IfcViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helix="http://helix-toolkit.org/wpf">

    <Grid>
        <helix:HelixViewport3D
            x:Name="IfcViewer"
            Background="{DynamicResource BackgroundBrush}"
            CameraRotationMode="Turntable"
            InfiniteSpin="False"
            IsPanEnabled="True"
            IsRotationEnabled="True"
            IsZoomEnabled="True"
            MouseDown="IfcViewer_MouseDown"
            MouseMove="IfcViewer_MouseMove"
            RotateAroundMouseDownPoint="True"
            RotationSensitivity="1"
            ShowCoordinateSystem="True"
            ShowViewCube="True"
            ZoomAroundMouseDownPoint="True"
            ZoomSensitivity="2">

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#3A3A3A" />
                        <DirectionalLight Direction="-1,-2,-1.5" Color="#FFFFFF" />
                        <DirectionalLight Direction="1,1,0.5" Color="#557799" />
                        <DirectionalLight Direction="0.3,1,-2" Color="#334466" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

        </helix:HelixViewport3D>

        <!--  IFC Loading Overlay  -->
        <Border Background="#AA000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding Status}" />

                <ProgressBar
                    Width="220"
                    Height="8"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Progress}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>