<UserControl
    x:Class="CraneOptimizer.UI.Features.F5_ElementManagement.Views.ElementManagementControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:CraneOptimizer.UI.Features.F5_ElementManagement.Views"
    Background="{DynamicResource SurfaceBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Elements header  -->
            <RowDefinition Height="*" />
            <!--  Elements list  -->
            <RowDefinition Height="4" />
            <!--  H-splitter  -->
            <RowDefinition Height="200" MinHeight="130" />
            <!--  Properties  -->
        </Grid.RowDefinitions>

        <!--  Elements header  -->
        <Border
            Grid.Row="0"
            Height="30"
            Padding="10,0"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <!--  Active filter indicator stripe  -->
                    <Border
                        Width="3"
                        Height="12"
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource PrimaryBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Style="{StaticResource PanelSectionHeader}" Text="BUILDING ELEMENTS" />
                </StackPanel>

                <!--  Count badge + Toolbar  -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border
                        Padding="6,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="SemiBold"
                            Text="{Binding CountLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                            <Setter Property="Foreground" Value="#1A1A1A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!--  FIX-P6: Toolbar buttons  -->
                    <Button Command="{Binding FocusElementCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Focus in 3D" Margin="0,0,2,0">
                        <TextBlock Text="🎯" FontSize="11"/>
                    </Button>
                    <Button Command="{Binding IsolateElementCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Isolate Element" Margin="0,0,2,0">
                        <TextBlock Text="🏗" FontSize="11"/>
                    </Button>
                    <Button Command="{Binding ResetViewCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Reset View (Esc)">
                        <TextBlock Text="🔄" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Elements list  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ListBox
                x:Name="ElementsList"
                BorderThickness="0"
                Background="Transparent"
                ItemsSource="{Binding FilteredElements}"
                SelectedItem="{Binding SelectedElement, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="ElementBorder"
                            Style="{StaticResource ElementListItem}"
                            Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Grid.Column="0"
                                    Width="7"
                                    Height="7"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeSM}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding DisplayName}" />
                                    </TextBlock>
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeXS}"
                                        Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding Type}" />
                                        <Run Foreground="{DynamicResource BorderBrush}" Text=" | " />
                                        <Run Text="{Binding Mark, FallbackValue='—'}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                    <Condition Binding="{Binding ElementColor}" Value="#E74C3C" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource HeavySelectedBrush}" />
                                <Setter TargetName="ElementBorder" Property="BorderBrush" Value="{StaticResource DestructiveBrush}" />
                                <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                    <Condition Binding="{Binding ElementColor}" Value="#F39C12" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource MediumSelectedBrush}" />
                                <Setter TargetName="ElementBorder" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                    <Condition Binding="{Binding ElementColor}" Value="#FFFFFF" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource NormalSelectedBrush}" />
                                <Setter TargetName="ElementBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1" />
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!--  Horizontal splitter (Elements / Properties)  -->
        <GridSplitter
            Grid.Row="2"
            Height="4"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource BorderBrush}"
            Cursor="SizeNS"
            ShowsPreview="True" />

        <!--  Properties panel  -->
        <Border
            Grid.Row="3"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <views:ElementPropertiesView />
        </Border>
    </Grid>
</UserControl>
