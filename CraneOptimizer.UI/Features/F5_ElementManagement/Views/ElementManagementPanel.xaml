<UserControl x:Class="CraneOptimizer.UI.Features.F5_ElementManagement.Views.ElementManagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="PropertyCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="8,0,6,0" />
        </Style>

        <Style x:Key="PropertyLabelText"
               BasedOn="{StaticResource PropertyCellText}"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="PropertyValueText"
               BasedOn="{StaticResource PropertyCellText}"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <DataTemplate x:Key="PropertyRowTemplate">
            <Border MinHeight="25"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource PropertyLabelText}"
                               Text="{Binding Name}"
                               ToolTip="{Binding Name}" />

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource PropertyValueText}"
                               Text="{Binding Value}"
                               ToolTip="{Binding Value}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="8,6"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,1">
                <TextBlock VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeXS}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding SelectedElementName}" />
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ElementProperties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0"
                                          Background="{DynamicResource SurfaceBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          BorderThickness="0,0,0,1"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid MinHeight="30" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="{StaticResource FontSizeXS}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name, StringFormat='{}{0} properties'}" />
                                        </Grid>
                                    </Expander.Header>

                                    <Grid Background="{DynamicResource SurfaceElevatedBrush}">
                                        <ItemsControl ItemTemplate="{StaticResource PropertyRowTemplate}"
                                                      ItemsSource="{Binding Children}" />
                                    </Grid>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Margin="18,48"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedElement}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="{StaticResource FontSizeSM}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="No Element Selected" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Select an element to inspect its BIM properties."
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
