<UserControl x:Class="CraneOptimizer.UI.Features.F5_ElementManagement.Views.ElementManagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="PropertyHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="PropertyCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="PropertyCellBorder" TargetType="Border">
            <Setter Property="MinHeight" Value="23" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <DataTemplate x:Key="PropertyRowTemplate">
            <Grid MinHeight="23">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*" />
                    <ColumnDefinition Width="58*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PropertyCellBorder}">
                    <TextBlock Style="{StaticResource PropertyCellText}" Text="{Binding Name}" />
                </Border>

                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Style="{StaticResource PropertyCellText}" Text="{Binding Value}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="8,6"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Concrete Density (kg/m3)" />

                    <TextBox Grid.Column="1"
                             Height="26"
                             Margin="10,0,0,0"
                             Padding="8,2"
                             VerticalContentAlignment="Center"
                             FontFamily="{StaticResource FontPrimary}"
                             FontSize="{StaticResource FontSizeXS}"
                             Text="{Binding ConcreteDensityKgPerM3, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                    <Button Grid.Column="2"
                            Height="26"
                            Margin="8,0,0,0"
                            Padding="12,0"
                            Background="{StaticResource PrimaryBrush}"
                            Command="{Binding SaveDensityCommand}"
                            Content="Save Density"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <TextBlock Grid.Column="3"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource ErrorBrush}"
                               Text="{Binding DensityValidationMessage}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="8,6"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeXS}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding SelectedElementName}" />

                    <TextBox Grid.Column="1"
                             Height="26"
                             Margin="10,0,0,0"
                             Padding="8,2"
                             VerticalContentAlignment="Center"
                             FontSize="{StaticResource FontSizeXS}"
                             Text="{Binding PropertySearchText, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ElementProperties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0"
                                          Background="{DynamicResource SurfaceBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          BorderThickness="0,0,0,1"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <TextBlock MinHeight="24"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeXS}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Name}" />
                                    </Expander.Header>

                                    <Grid Background="{DynamicResource SurfaceElevatedBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="23" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42*" />
                                                <ColumnDefinition Width="58*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource PropertyCellBorder}">
                                                <TextBlock Style="{StaticResource PropertyHeaderText}" Text="Name" />
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Style="{StaticResource PropertyHeaderText}" Text="Value" />
                                            </Border>
                                        </Grid>

                                        <ItemsControl Grid.Row="1"
                                                      ItemTemplate="{StaticResource PropertyRowTemplate}"
                                                      ItemsSource="{Binding Children}" />
                                    </Grid>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Margin="18,48"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedElement}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="{StaticResource FontSizeSM}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="No Element Selected" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Select an element to inspect its BIM properties."
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
