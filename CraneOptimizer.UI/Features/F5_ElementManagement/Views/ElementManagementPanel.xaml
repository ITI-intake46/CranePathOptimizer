<UserControl x:Class="CraneOptimizer.UI.Features.F5_ElementManagement.Views.ElementManagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
                <RowDefinition Height="200" MinHeight="130" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Height="30"
                Padding="10,0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Width="3"
                            Height="12"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource PrimaryBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Style="{StaticResource PanelSectionHeader}" Text="BUILDING ELEMENTS" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeXS}"
                            FontWeight="SemiBold"
                            Text="{Binding CountLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                            <Setter Property="Foreground" Value="#1A1A1A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredElements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="ElementBorder"
                                MouseLeftButtonDown="ElementItem_Click"
                                Style="{StaticResource ElementListItem}"
                                Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Grid.Column="0"
                                        Width="7"
                                        Height="7"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            FontFamily="{StaticResource FontPrimary}"
                                            FontSize="{StaticResource FontSizeSM}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Run Text="{Binding DisplayName}" />
                                        </TextBlock>
                                        <TextBlock
                                            Margin="0,1,0,0"
                                            FontFamily="{StaticResource FontPrimary}"
                                            FontSize="{StaticResource FontSizeXS}"
                                            Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding Type}" />
                                            <Run Foreground="{DynamicResource BorderBrush}" Text=" | " />
                                            <Run Text="{Binding Mark, FallbackValue='-'}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                        <Condition Binding="{Binding ElementColor}" Value="#E74C3C" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource HeavySelectedBrush}" />
                                    <Setter TargetName="ElementBorder" Property="BorderBrush" Value="{StaticResource DestructiveBrush}" />
                                    <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                        <Condition Binding="{Binding ElementColor}" Value="#F39C12" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource MediumSelectedBrush}" />
                                    <Setter TargetName="ElementBorder" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                    <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                        <Condition Binding="{Binding ElementColor}" Value="#FFFFFF" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="ElementBorder" Property="Background" Value="{StaticResource NormalSelectedBrush}" />
                                    <Setter TargetName="ElementBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    <Setter TargetName="ElementBorder" Property="BorderThickness" Value="3,0,0,1" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter
                Grid.Row="2"
                Height="4"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource BorderBrush}"
                Cursor="SizeNS"
                ShowsPreview="True" />

            <Border
                Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Height="26"
                        Padding="10,0"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource PanelSectionHeader}" Text="PROPERTIES" />
                    </Border>

                    <Border
                        Grid.Row="1"
                        Padding="6,5"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Border
                            Padding="6,4"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="🔍" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSM}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="{Binding SelectedElementName, FallbackValue='No element selected'}" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,0">
                            <Border Style="{StaticResource PropertyRow}">
                                <TextBlock
                                    Margin="0,12"
                                    FontStyle="Italic"
                                    Style="{StaticResource PropertyLabel}"
                                    Text="Select an element to view properties"
                                    TextAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
