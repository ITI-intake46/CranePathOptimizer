<Window x:Class="WPF_IFC_test1.CranePositionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crane Position"
        Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B"
        ResizeMode="NoResize">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🏗️ Enter Crane Position"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Specify the coordinates in meters where the crane should be placed"
                       FontSize="11"
                       Foreground="#CCCCCC"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Input Fields -->
        <StackPanel Grid.Row="1">
            <!-- X Coordinate -->
            <Border Background="#3C3C3C" Padding="12" Margin="0,0,0,12" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="X:" Foreground="White" FontWeight="Bold" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBox x:Name="txtX" Grid.Column="1" Text="0" 
                             Background="#2B2B2B" Foreground="White" BorderBrush="#007ACC"
                             Padding="8" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="m" Foreground="#CCCCCC" 
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Y Coordinate -->
            <Border Background="#3C3C3C" Padding="12" Margin="0,0,0,12" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Y:" Foreground="White" FontWeight="Bold" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBox x:Name="txtY" Grid.Column="1" Text="0" 
                             Background="#2B2B2B" Foreground="White" BorderBrush="#007ACC"
                             Padding="8" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="m" Foreground="#CCCCCC" 
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Z Coordinate -->
            <Border Background="#3C3C3C" Padding="12" Margin="0,0,0,0" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Z:" Foreground="White" FontWeight="Bold" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBox x:Name="txtZ" Grid.Column="1" Text="0" 
                             Background="#2B2B2B" Foreground="White" BorderBrush="#007ACC"
                             Padding="8" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="m" Foreground="#CCCCCC" 
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="✓ OK" Width="100" Margin="0,0,10,0" Click="OK_Click"
                    Background="#007ACC" Foreground="White" Padding="12,8"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0098FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="✕ Cancel" Width="100" Click="Cancel_Click"
                    Background="#3C3C3C" Foreground="White" Padding="12,8"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4C4C4C"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>