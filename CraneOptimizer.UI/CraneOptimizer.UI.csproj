<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Resources\Images\CraneIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controls\**" />
    <Compile Remove="Converters\**" />
    <Compile Remove="Features\F10_Themes\**" />
    <Compile Remove="Features\F6_CranePlacement\**" />
    <Compile Remove="Interaction\**" />
    <Compile Remove="Views\**" />
    <EmbeddedResource Remove="Controls\**" />
    <EmbeddedResource Remove="Converters\**" />
    <EmbeddedResource Remove="Features\F10_Themes\**" />
    <EmbeddedResource Remove="Features\F6_CranePlacement\**" />
    <EmbeddedResource Remove="Interaction\**" />
    <EmbeddedResource Remove="Views\**" />
    <None Remove="Controls\**" />
    <None Remove="Converters\**" />
    <None Remove="Features\F10_Themes\**" />
    <None Remove="Features\F6_CranePlacement\**" />
    <None Remove="Interaction\**" />
    <None Remove="Views\**" />
    <Page Remove="Controls\**" />
    <Page Remove="Converters\**" />
    <Page Remove="Features\F10_Themes\**" />
    <Page Remove="Features\F6_CranePlacement\**" />
    <Page Remove="Interaction\**" />
    <Page Remove="Views\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="Data\crane.db" />
    <None Remove="Resources\Icons\map-pin-check %281%29_white.png" />
    <None Remove="Resources\Icons\map-pin-check.png" />
    <None Remove="Resources\Icons\map-pin-x %281%29_white.png" />
    <None Remove="Resources\Icons\map-pin-x.png" />
    <None Remove="Resources\Icons\map-pin_check.png" />
    <None Remove="Resources\Icons\map-pin_X.png" />
    <None Remove="Resources\Icons\ruler.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\CanonicalCatalog.crane.db">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\acceptance\catalog\catalog-manifest.json" Link="Data\CanonicalCatalog.manifest.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CraneOptimizer.AI\CraneOptimizer.AI.csproj" />
    <ProjectReference Include="..\CraneOptimizer.Application\CraneOptimizer.Application.csproj" />
    <ProjectReference Include="..\CraneOptimizer.Infrastructure\CraneOptimizer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Core\Rendering\" />
    <Folder Include="Features\F15_ObjectSnap\Models\" />
    <Folder Include="Features\F15_ObjectSnap\Views\" />
    <Folder Include="Features\F15_ObjectSnap\ViewModels\" />
    <Folder Include="Features\F15_ObjectSnap\Services\" />
    <Folder Include="Features\F4_LoadChart\Services\" />
    <Folder Include="Features\F4_LoadChart\ViewModels\" />
    <Folder Include="Features\F5_ElementManagement\" />
    <Folder Include="Features\F9_UserSettings\" />
    <Folder Include="Features\F16_Filter\" />
    <Folder Include="Resources\Images\" />
    <Folder Include="Shared\Assets\" />
    <Folder Include="Shell\ViewModels\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Geometry" Version="3.1.2" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.14" />
    <PackageReference Include="netDxf" Version="2023.11.10" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="PDFtoImage" Version="5.2.0" />
    <PackageReference Include="Xbim.Essentials" Version="6.0.587" />
    <PackageReference Include="Xbim.Geometry" Version="5.1.820" />
    <PackageReference Include="Xbim.Ifc" Version="6.0.587" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\map-pin-check (1)_white.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Icons\map-pin-check.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Icons\map-pin-x (1)_white.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Icons\map-pin-x.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Icons\map-pin_check.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Icons\map-pin_X.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Icons\ruler.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Images\construction_home.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Images\CraneIcon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Images\CraneIcon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <Target Name="CopyXbimNativeDllToOutput" AfterTargets="Build">
    <ItemGroup>
      <XbimNativeDll Include="$(NuGetPackageRoot)xbim.geometry.engine.interop\5.1.820\**\Xbim.Geometry.Engine64.dll" />
    </ItemGroup>
    <Error Condition="'@(XbimNativeDll)' == ''" Text="Xbim.Geometry.Engine64.dll was not restored; IFC geometry build is blocked." />
    <Copy SourceFiles="@(XbimNativeDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(TargetDir)Xbim.Geometry.Engine64.dll')" Text="IFC native geometry engine is missing from the application output." />
  </Target>
  <Target Name="CopyXbimNativeDllToPublish" AfterTargets="Publish">
    <ItemGroup>
      <XbimPublishNativeDll Include="$(NuGetPackageRoot)xbim.geometry.engine.interop\5.1.820\**\Xbim.Geometry.Engine64.dll" />
    </ItemGroup>
    <Error Condition="'@(XbimPublishNativeDll)' == ''" Text="Xbim.Geometry.Engine64.dll was not restored; IFC geometry publish is blocked." />
    <Copy SourceFiles="@(XbimPublishNativeDll)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)Xbim.Geometry.Engine64.dll')" Text="IFC native geometry engine is missing from the published application." />
  </Target>

</Project>
