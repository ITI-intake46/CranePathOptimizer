<UserControl x:Class="CraneOptimizer.UI.Core.Controls.ParameterHelpIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="16" d:DesignWidth="16"
             VerticalAlignment="Center">
    <UserControl.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1"
                BorderBrush="{StaticResource SecondaryBrush}"
                Background="Transparent" Cursor="Help" ToolTipService.InitialShowDelay="100">
            <TextBlock Text="i" FontFamily="{StaticResource FontPrimary}" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryBrush}" Margin="0,-1,0,0"/>
            <Border.ToolTip>
                <ToolTip x:Name="HelpToolTip">
                    <StackPanel Width="280">
                        <TextBlock x:Name="TxtDisplayName" Style="{StaticResource TextTitle}" 
                                   FontFamily="{StaticResource FontPrimary}" 
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        
                        <TextBlock x:Name="TxtDescription" Style="{StaticResource TextBody}" 
                                   FontFamily="{StaticResource FontPrimary}" 
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,4" />
                        
                        <Grid Margin="0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="↑ Increase: " Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtIncrease" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" TextWrapping="Wrap" Width="200" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="↓ Decrease: " Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtDecrease" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" TextWrapping="Wrap" Width="200" />
                            </StackPanel>
                        </Grid>
                        
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,4" />
                        
                        <Grid Margin="0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Valid:" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="TxtValid" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" TextWrapping="Wrap" />
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Recommended:" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="TxtRecommended" Grid.Row="1" Grid.Column="1" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}" />
                        </Grid>
                        
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,4" />
                        
                        <Grid Margin="0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Performance:" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="TxtPerformance" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" TextWrapping="Wrap" />
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Quality:" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="TxtQuality" Grid.Row="1" Grid.Column="1" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" TextWrapping="Wrap" />
                        </Grid>
                        
                        <StackPanel x:Name="PanelSpecialNote" Visibility="Collapsed" Margin="0,6,0,0">
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,4" />
                            <TextBlock Text="Note:" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                            <TextBlock x:Name="TxtSpecialNote" Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontPrimary}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>
        </Border>
    </Grid>
</UserControl>
