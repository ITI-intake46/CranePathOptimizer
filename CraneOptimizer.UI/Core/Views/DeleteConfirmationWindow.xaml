<Window
    x:Class="CraneOptimizer.UI.Core.Views.DeleteConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Icon="pack://application:,,,/CraneOptimizer.UI;component/Resources/Images/CraneIcon.png"
    Background="{DynamicResource BackgroundBrush}"
    FontFamily="{StaticResource FontPrimary}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown">

    <Border
        Background="{DynamicResource BackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PrimaryBrush}" />

            <Grid Grid.Row="1" Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource DestructiveBrush}"
                        CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="17"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="!" />
                    </Border>

                    <TextBlock
                        x:Name="HeadingText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeLG}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>

                <TextBlock
                    x:Name="MessageText"
                    Grid.Row="1"
                    Margin="36,14,0,0"
                    FontSize="{StaticResource FontSizeBase}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    LineHeight="20"
                    TextWrapping="Wrap" />

                <StackPanel
                    Grid.Row="2"
                    Margin="0,22,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="CancelButton"
                        MinWidth="88"
                        Height="32"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="Cancel"
                        Style="{StaticResource ButtonSecondary}" />
                    <Button
                        x:Name="DeleteButton"
                        MinWidth="88"
                        Height="32"
                        Click="DeleteButton_Click"
                        Style="{StaticResource ButtonDestructive}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
