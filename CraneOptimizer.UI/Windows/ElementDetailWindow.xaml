<Window x:Class="WPF_IFC_test1.ElementDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="Element Details"
        Height="700" Width="1000"
        Background="#1E1E1E"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush"    Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBrush"       Color="#252526"/>
        <SolidColorBrush x:Key="Surface2Brush"      Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextBrush"          Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="AccentBrush"        Color="#007ACC"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#3F3F46"/>
        <SolidColorBrush x:Key="HoverBrush"         Color="#2A2D2E"/>

        <Style x:Key="PropertyLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Margin"            Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PropertyValue" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping"      Value="Wrap"/>
        </Style>
        <Style x:Key="PropertyRow" TargetType="Border">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0" Background="#2D2D30"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0"
                           Text="Element Details"
                           FontSize="13" Foreground="White"
                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⊙ Reset View" Click="ResetCamera_Click"
                            Padding="8,0" Width="90" Height="35"
                            Background="Transparent" Foreground="#AAAACC"
                            BorderThickness="0" FontSize="11" Cursor="Hand"/>
                    <Button Content="✕" Width="45" Height="35"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="16" FontWeight="Bold"
                            Click="CloseWindow_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"   MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="350" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- 3D VIEWER -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Surface2Brush}"
                            Padding="12,10" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="🎨 Element Viewer"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <helix:HelixViewport3D x:Name="ElementViewer" Grid.Row="1"
                                           Background="#111118"
                                           ShowViewCube="True"
                                           ShowCoordinateSystem="True"
                                           CameraRotationMode="Turntable">

                        <!-- Three-point lighting rig -->
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <!-- Soft ambient: keep shadowed faces visible -->
                                    <AmbientLight Color="#404040"/>
                                    <!-- Key light: strong, upper front-right -->
                                    <DirectionalLight Color="#FFFFFF"  Direction="-1,-2,-1.5"/>
                                    <!-- Fill light: softer, opposite side -->
                                    <DirectionalLight Color="#557799"  Direction="1,1,0.5"/>
                                    <!-- Rim light: from behind, separates from background -->
                                    <DirectionalLight Color="#334466"  Direction="0.3,1,-2"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>

                        <helix:HelixViewport3D.Camera>
                            <PerspectiveCamera Position="10,10,10"
                                               LookDirection="-1,-1,-1"
                                               UpDirection="0,0,1"
                                               FieldOfView="45"/>
                        </helix:HelixViewport3D.Camera>

                    </helix:HelixViewport3D>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ShowsPreview="True" Cursor="SizeWE"/>

            <!-- PROPERTIES -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource Surface2Brush}"
                            Padding="12,10" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="📋 Properties"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PropertiesPanel" Margin="0"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
