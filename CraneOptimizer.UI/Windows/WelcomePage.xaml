<Window x:Class="WPF_IFC_test1.WelcomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WPF_IFC_test1"
        Title="Crane Optimization - Welcome"
        Height="700" Width="1200"
        WindowState="Maximized"
        Background="#2B2B2B"
        Icon="/Assest/CraneIcon.png"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="YellowPrimary" Color="#D4AF37"/>
        <SolidColorBrush x:Key="YellowDark" Color="#B8960F"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#D4AF37"/>
        <SolidColorBrush x:Key="MainBg" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="CardBg" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>

        <!-- Menu Button Style -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C5A028"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Selected Menu Button -->
        <Style x:Key="SelectedMenuButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Background" Value="#8B7A1F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Sub Menu Button Style -->
        <Style x:Key="SubMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="40,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C5A028"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Section -->
                <StackPanel Grid.Row="0" Margin="20,30,20,30" HorizontalAlignment="Center">
                    <Image Source="/Assest/CraneIcon.png" 
                           Width="80" 
                           Height="80"
                           Margin="0,0,0,15"/>
                    <TextBlock Text="Crane Optimization" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Menu Items -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="WelcomeButton" 
                            Content="🏠 Welcome" 
                            Style="{StaticResource SelectedMenuButton}" 
                            Click="Welcome_Click"/>
                    <Button x:Name="ProjectListButton" 
                            Content="📋 Project list" 
                            Style="{StaticResource MenuButton}" 
                            Click="ProjectList_Click"/>
                    <Button Content="➕ Create project" 
                            Style="{StaticResource MenuButton}" 
                            Click="CreateProject_Click"/>
                    <Button Content="📥 Import project" 
                            Style="{StaticResource MenuButton}" 
                            Click="ImportProject_Click"/>
                    <Button x:Name="RecentProjectsButton"
                            Content="🕒 Recent projects" 
                            Style="{StaticResource MenuButton}" 
                            Click="RecentProjects_Click"/>

                    <!-- Settings with Sub-menu -->
                    <Button x:Name="SettingsButton" 
                            Content="⚙️ Settings" 
                            Style="{StaticResource MenuButton}" 
                            Click="Settings_Click"/>

                    <!-- Settings Sub-menu (Initially Collapsed) -->
                    <StackPanel x:Name="SettingsSubMenu" Visibility="Collapsed">
                        <Button Content="🔧 Application settings" 
                                Style="{StaticResource SubMenuButton}" 
                                Click="ApplicationSettings_Click"/>
                        <Button Content="👤 User settings" 
                                Style="{StaticResource SubMenuButton}" 
                                Click="UserSettings_Click"/>
                    </StackPanel>

                    <Separator Background="#B8960F" Margin="10,15" Height="1"/>
                    <Button Content="ℹ️ Application user and description" 
                            Style="{StaticResource MenuButton}" 
                            Click="AppInfo_Click"/>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="20,20">
                    <TextBlock Text="© 2024 Crane Optimization" 
                               FontSize="10"
                               Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" 
                    Background="#1E1E1E"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Crane Optimization" 
                               FontSize="13"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="—" 
                                Width="45" Height="35"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="16"
                                Click="MinimizeWindow_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3E3E42"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="MaximizeButton"
                                Content="☐" 
                                Width="45" Height="35"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="16"
                                Click="MaximizeWindow_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3E3E42"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="✕" 
                                Width="45" Height="35"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="16"
                                Click="CloseWindow_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E81123"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Container -->
            <Grid Grid.Row="1">
                <!-- WELCOME CONTENT (same as before) -->
                <Grid x:Name="WelcomeContent" Background="{StaticResource MainBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Section -->
                    <Border Grid.Row="0" Background="#3C3C3C" Padding="40,30">
                        <StackPanel>
                            <TextBlock Text="PROJECT OVERVIEW" 
                                       FontSize="18" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Select or create a project to get started" 
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Content Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Crane Image -->
                        <Border Grid.Column="0" Background="#E0E0E0" Margin="40,30,20,40">
                            <Image Source="/Assest/StartUpImage.png" Stretch="Uniform"/>
                        </Border>

                        <!-- Right: Quick Actions (same as before) -->
                        <StackPanel Grid.Column="1" Margin="20,30,40,40">
                            <TextBlock Text="START" 
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,15"/>

                            <Button Background="{StaticResource CardBg}" BorderThickness="0" Padding="20,15" Margin="0,0,0,10" Cursor="Hand" Click="CreateProject_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4C4C4C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="➕ Create project" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                            </Button>

                            <Button Background="{StaticResource CardBg}" BorderThickness="0" Padding="20,15" Margin="0,0,0,10" Cursor="Hand" Click="ProjectList_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4C4C4C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📂 Project list" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                            </Button>

                            <Button Background="{StaticResource CardBg}" BorderThickness="0" Padding="20,15" Margin="0,0,0,10" Cursor="Hand" Click="ApplicationSettings_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4C4C4C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="🔧 Application settings" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                            </Button>

                            <Button Background="{StaticResource CardBg}" BorderThickness="0" Padding="20,15" Margin="0,0,0,10" Cursor="Hand" Click="UserSettings_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4C4C4C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="👤 User settings" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                            </Button>

                            <Button Background="{StaticResource CardBg}" BorderThickness="0" Padding="20,15" Cursor="Hand" Click="WhatsNew_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4C4C4C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="⭐ Show What's New" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                            </Button>

                            <TextBlock Text="RECENT PROJECTS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,30,0,15"/>
                            <Border Background="{StaticResource CardBg}" CornerRadius="5" Padding="20">
                                <TextBlock Text="No projects available" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Background="#5C4F1A" CornerRadius="5" Padding="15" Margin="0,20,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FFE5A1" LineHeight="18">
                                    <Run Text="Start your crane optimization in the next level. This application helps you plan crane positions to maximize efficiency, reduce costs, and ensure top-level project safety and success!"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- PROJECT LIST CONTENT - Now using UserControl! -->
                <local:ProjectListControl x:Name="ProjectListContent" 
                                         Visibility="Collapsed"/>

                <!-- RECENT PROJECTS CONTENT - UserControl with DataGrid! -->
                <local:RecentProjectsControl x:Name="RecentProjectsContent" 
                                            Visibility="Collapsed"/>

                <!-- IMPORT PROJECT CONTENT -->
                <local:ImportProjectControl x:Name="ImportProjectContent" 
                           Visibility="Collapsed"/>

                <!-- CREATE PROJECT CONTENT -->
                <local:CreateProjectControl x:Name="CreateProjectContent" 
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
