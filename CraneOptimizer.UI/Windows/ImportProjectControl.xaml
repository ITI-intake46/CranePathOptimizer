<UserControl x:Class="WPF_IFC_test1.ImportProjectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2B2B2B">

    <UserControl.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D4AF37"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#C5A028"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#555555"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4C4C4C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="25"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="Transparent" Padding="40,30,40,20">
            <StackPanel>
                <TextBlock Text="Import Project" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Import an existing IFC project into your workspace" 
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     Margin="40,0,40,40">
            <StackPanel MaxWidth="800">
                
                <!-- Import Methods Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="📥 Select Import Method" 
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Method 1: Browse File -->
                        <Border Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="20"
                                Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="📂" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Browse IFC File" 
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1"
                                          Text="Select an IFC file from your computer"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,0,0,15"/>

                                <Button Grid.Row="2"
                                        Content="🗂️ Browse Files..."
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Left"
                                        Click="BrowseFile_Click"/>
                            </Grid>
                        </Border>

                        <!-- Method 2: Drag & Drop -->
                        <!-- Method 2: Drag & Drop -->
                        <Border x:Name="DropZone"
                                        Background="{StaticResource Surface2Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="5"
                                        Padding="40"
                                        AllowDrop="True"
                                        Drop="DropZone_Drop"
                                        DragEnter="DropZone_DragEnter"
                                        DragLeave="DropZone_DragLeave">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📦" 
                                          FontSize="48"
                                          HorizontalAlignment="Center"
                                          Opacity="0.5"
                                          Margin="0,0,0,15"/>
                                <TextBlock Text="Drag &amp; Drop IFC File Here" 
                                          FontSize="16"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,5"/>
                                <TextBlock Text="Or click Browse Files above" 
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Selected File Info Card -->
                <Border x:Name="FileInfoCard"
                        Style="{StaticResource Card}"
                        Visibility="Collapsed"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="📄 Selected File" 
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                      Text="File Name:" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtFileName"
                                      Grid.Row="0" Grid.Column="1"
                                      Text="-"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                      Text="Location:"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtFileLocation"
                                      Grid.Row="1" Grid.Column="1"
                                      Text="-"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                      Text="File Size:"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtFileSize"
                                      Grid.Row="2" Grid.Column="1"
                                      Text="-"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                      Text="Project Name:"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,10"/>
                            <TextBox x:Name="txtProjectName"
                                    Grid.Row="3" Grid.Column="1"
                                    Style="{StaticResource DarkTextBox}"
                                    Margin="0,0,0,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel x:Name="ActionButtons"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           Visibility="Collapsed">
                    <Button Content="🗑️ Clear"
                            Style="{StaticResource SecondaryButton}"
                            Click="Clear_Click"
                            Margin="0,0,15,0"/>
                    <Button Content="✅ Import Project"
                            Style="{StaticResource ModernButton}"
                            Click="ImportProject_Click"/>
                </StackPanel>

                <!-- Recent Imports -->
                <Border Style="{StaticResource Card}" Margin="0,30,0,0">
                    <StackPanel>
                        <TextBlock Text="🕒 Recent Imports" 
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,15"/>

                        <StackPanel x:Name="RecentImportsPanel">
                            <TextBlock Text="No recent imports"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontStyle="Italic"
                                      HorizontalAlignment="Center"
                                      Margin="0,20"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>