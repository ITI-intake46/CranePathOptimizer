<Window x:Class="WPF_IFC_test1.ApplicationSettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Settings"
        Height="800" Width="1400"
        WindowState="Maximized"
        Background="#1E1E1E"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="YellowSidebar" Color="#2D2D30"/>
        <SolidColorBrush x:Key="YellowHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="GrayBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DarkBg" Color="#252526"/>
        <SolidColorBrush x:Key="TextDark" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextLight" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFB900"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource YellowHover}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Selected Sidebar Button -->
        <Style x:Key="SelectedSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#094771"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="CustomSlider" TargetType="Slider">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Background="#3F3F46" 
                                    Height="8" 
                                    CornerRadius="4"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource AccentYellow}" 
                                                       Height="8" 
                                                       CornerRadius="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource AccentYellow}" 
                                                        Stroke="#FFFFFF" 
                                                        StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                        Grid.Column="2"
                                        Focusable="false"
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press"
                                        Background="#252526"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left"
                                                                Content="{TemplateBinding Content}"/>
                                                <TextBlock Grid.Column="1"
                                                          Text="▼"
                                                          FontSize="10"
                                                          Foreground="#CCCCCC"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                            IsHitTestVisible="False"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            Margin="10,0,30,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                  Placement="Bottom"
                                  IsOpen="{TemplateBinding IsDropDownOpen}"
                                  AllowsTransparency="True"
                                  Focusable="False"
                                  PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                     SnapsToDevicePixels="True"
                                     MinWidth="{TemplateBinding ActualWidth}"
                                     MaxHeight="200">
                                    <Border x:Name="DropDownBorder"
                                           Background="#252526"
                                           BorderBrush="{StaticResource BorderColor}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Margin="0,4,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                               Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- RadioButton Style -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource YellowSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#252526" Padding="15,0">
                    <TextBlock Text="PROJECT OVERVIEW" 
                               Foreground="{StaticResource TextLight}" 
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Menu Buttons -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button Content="⚙️ Application settings" 
                            Style="{StaticResource SelectedSidebarButton}"/>
                    <Button Content="👤 User settings" 
                            Style="{StaticResource SidebarButton}"
                            Click="UserSettings_Click"/>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#252526" Padding="15,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 mustafa abdo" 
                                   Foreground="{StaticResource TextLight}" 
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,20,0"/>
                        <TextBlock Text="🔑 License info" 
                                   Foreground="{StaticResource TextLight}" 
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT -->
        <Grid Grid.Column="1" Background="{StaticResource GrayBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="#252526"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Application Settings" 
                               Foreground="{StaticResource TextDark}"
                               VerticalAlignment="Center"
                               Margin="15,0"
                               FontSize="13"/>

                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Right">
                        <Button Content="—" 
                                Width="45" Height="40"
                                Background="Transparent"
                                Foreground="{StaticResource TextLight}"
                                BorderThickness="0"
                                Click="MinimizeWindow_Click"
                                Cursor="Hand"/>
                        <Button Content="☐" 
                                Width="45" Height="40"
                                Background="Transparent"
                                Foreground="{StaticResource TextLight}"
                                BorderThickness="0"
                                Click="MaximizeWindow_Click"
                                Cursor="Hand"/>
                        <Button Content="✕" 
                                Width="45" Height="40"
                                Background="Transparent"
                                Foreground="{StaticResource TextLight}"
                                BorderThickness="0"
                                Click="CloseWindow_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E81123"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="50,40" MaxWidth="800" HorizontalAlignment="Left">

                    <!-- Header -->
                    <TextBlock Text="Application settings" 
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,40"/>

                    <!-- Language -->
                    <TextBlock Text="Language" 
                               FontSize="14"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,10"/>
                    <ComboBox x:Name="LanguageComboBox"
                              Height="40"
                              FontSize="13"
                              Margin="0,0,0,30">
                        <ComboBoxItem Content="English" IsSelected="True"/>
                        <ComboBoxItem Content="Deutsch"/>
                        <ComboBoxItem Content="Français"/>
                        <ComboBoxItem Content="العربية"/>
                    </ComboBox>

                    <!-- Scene Color Theme -->
                    <TextBlock Text="Scene color theme" 
                               FontSize="14"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,10"/>
                    <ComboBox x:Name="ThemeComboBox"
                              Height="40"
                              FontSize="13"
                              Margin="0,0,0,30">
                        <ComboBoxItem Content="Dark" IsSelected="True"/>
                        <ComboBoxItem Content="Light"/>
                    </ComboBox>

                    <!-- Font Size -->
                    <TextBlock Text="Font size" 
                               FontSize="14"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,10"/>
                    <ComboBox x:Name="FontSizeComboBox"
                              Height="40"
                              FontSize="13"
                              Margin="0,0,0,30">
                        <ComboBoxItem Content="Small"/>
                        <ComboBoxItem Content="Medium" IsSelected="True"/>
                        <ComboBoxItem Content="Large"/>
                    </ComboBox>

                    <!-- Factor of Safety -->
                    <TextBlock Text="Factor of Safety (%)" 
                               FontSize="14"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,10" Height="43">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <Slider x:Name="SafetyFactorSlider"
                                Grid.Column="0"
                                Minimum="25"
                                Maximum="100"
                                Value="75"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Style="{StaticResource CustomSlider}"
                                Margin="0,0,20,0"
                                ValueChanged="SafetyFactorSlider_ValueChanged" Height="42"/>

                        <Border Grid.Column="1"
                                Background="{StaticResource DarkBg}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <TextBlock x:Name="SafetyFactorValue"
                                       Text="75%"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentYellow}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="Adjust the factor of safety for crane operations (25% - 100%)" 
                               FontSize="11"
                               Foreground="{StaticResource TextLight}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,30"/>

                    <!-- Graphic Quality -->
                    <TextBlock Text="Graphic quality" 
                               FontSize="14"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,10"/>
                    <ComboBox x:Name="GraphicQualityComboBox"
                              Height="40"
                              FontSize="13"
                              Margin="0,0,0,30">
                        <ComboBoxItem Content="Quality"/>
                        <ComboBoxItem Content="Performance" IsSelected="True"/>
                    </ComboBox>

                    <!-- Units -->
                    <TextBlock Text="Units" 
                               FontSize="14"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,10"/>
                    <ComboBox x:Name="UnitsComboBox"
                              Height="40"
                              FontSize="13"
                              Margin="0,0,0,30">
                        <ComboBoxItem Content="Metric (m, kg)" IsSelected="True"/>
                        <ComboBoxItem Content="Imperial (ft, lb)"/>
                    </ComboBox>

                    <!-- Tooltips -->
                    <TextBlock Text="Tooltips" 
                               FontSize="14"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <RadioButton x:Name="TooltipsShowRadio"
                                    Content="Show" 
                                    GroupName="Tooltips"
                                    IsChecked="True"
                                    FontSize="13"
                                    Margin="0,0,20,0"/>
                        <RadioButton x:Name="TooltipsHideRadio"
                                    Content="Hide" 
                                    GroupName="Tooltips"
                                    FontSize="13"/>
                    </StackPanel>

                    <!-- Save User Behavior -->
                    <TextBlock Text="Save user behavior" 
                               FontSize="14"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="BehaviorAllowRadio"
                                    Content="Allow" 
                                    GroupName="Behavior"
                                    IsChecked="True"
                                    FontSize="13"
                                    Margin="0,0,20,0"/>
                        <RadioButton x:Name="BehaviorDenyRadio"
                                    Content="Deny" 
                                    GroupName="Behavior"
                                    FontSize="13"/>
                    </StackPanel>
                    <TextBlock Text="By agreeing to the recording and transfer of the user behavior, the software can be further improved." 
                               FontSize="11"
                               Foreground="{StaticResource TextLight}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,50"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" 
                                Width="120"
                                Height="40"
                                Background="{StaticResource DarkBg}"
                                Foreground="{StaticResource TextDark}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                FontSize="14"
                                Cursor="Hand"
                                Margin="0,0,15,0"
                                Click="Cancel_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                       BorderBrush="{TemplateBinding BorderBrush}"
                                                       BorderThickness="{TemplateBinding BorderThickness}"
                                                       CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                     VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3E3E42"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Save" 
                                Width="120"
                                Height="40"
                                Background="{StaticResource AccentYellow}"
                                Foreground="Black"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="Save_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                       CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                     VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFC929"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
