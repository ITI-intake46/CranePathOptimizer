<UserControl x:Class="WPF_IFC_test1.RecentProjectsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#CCCCCC">

    <UserControl.Resources>
        <!-- DataGrid Style -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- DataGrid Header Style -->
        <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="Transparent" Padding="40,20">
            <StackPanel>
                <TextBlock Text="Recent projects" 
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#333333"/>
                <TextBlock x:Name="ProjectCountText"
                           Text="3 Projects" 
                           FontSize="12"
                           Foreground="#666666"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="40,0,40,20">
            <!-- Large "Recent Projects" Watermark -->
            <TextBlock Text="Recent Projects" 
                       FontSize="100"
                       FontWeight="Bold"
                       Foreground="#999999"
                       Opacity="0.15"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Projects Table -->
            <DataGrid x:Name="ProjectsDataGrid"
                      Style="{StaticResource DataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                      CellStyle="{StaticResource CellStyle}"
                      MouseDoubleClick="ProjectsDataGrid_MouseDoubleClick">

                <DataGrid.Columns>
                    <!-- Project Name -->
                    <DataGridTextColumn Header="Project Name" 
                                       Binding="{Binding Name}" 
                                       Width="*"
                                       MinWidth="200"/>

                    <!-- Last Modified -->
                    <DataGridTextColumn Header="Last Modified" 
                                       Binding="{Binding LastModified}" 
                                       Width="180"/>

                    <!-- Location -->
                    <DataGridTextColumn Header="Location" 
                                       Binding="{Binding Location}" 
                                       Width="250"/>

                    <!-- IFC File -->
                    <DataGridTextColumn Header="IFC File" 
                                       Binding="{Binding IfcFile}" 
                                       Width="200"/>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusColor}"
                                       CornerRadius="3"
                                       Padding="8,4"
                                       HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" 
                                              Foreground="White"
                                              FontSize="11"
                                              FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Open" 
                                           Padding="8,4"
                                           Margin="0,0,5,0"
                                           Background="#4CAF50"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Cursor="Hand"
                                           Click="OpenProject_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="3"
                                                                   Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                                 VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#45A049"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Delete" 
                                           Padding="8,4"
                                           Background="#F44336"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Cursor="Hand"
                                           Click="DeleteProject_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="3"
                                                                   Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                                 VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DA190B"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- No Projects Message (shown when table is empty) -->
            <StackPanel x:Name="NoProjectsPanel"
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Visibility="Collapsed">
                <TextBlock Text="🕒" 
                           FontSize="80"
                           HorizontalAlignment="Center"
                           Opacity="0.3"
                           Margin="0,0,0,20"/>

                <TextBlock Text="No recent projects" 
                           FontSize="16"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Projects you work on will appear here" 
                           FontSize="13"
                           Foreground="#999999"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Footer with buttons -->
        <Border Grid.Row="2" Background="Transparent">
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Left"
                       Margin="40,20">
                <Button Content="🔄 Refresh"
                        Background="Transparent"
                        Foreground="#333333"
                        BorderThickness="1"
                        BorderBrush="#999999"
                        Padding="15,8"
                        FontSize="12"
                        Cursor="Hand"
                        Margin="0,0,15,0"
                        Click="Refresh_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="3"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                             VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EEEEEE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="🗑️ Clear All"
                        Background="Transparent"
                        Foreground="#333333"
                        BorderThickness="1"
                        BorderBrush="#999999"
                        Padding="15,8"
                        FontSize="12"
                        Cursor="Hand"
                        Margin="0,0,15,0"
                        Click="ClearAll_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="3"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                             VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="➕ New Project"
                        Background="#666666"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,8"
                        FontSize="12"
                        Cursor="Hand"
                        Click="NewProject_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               CornerRadius="3"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                             VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#555555"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
