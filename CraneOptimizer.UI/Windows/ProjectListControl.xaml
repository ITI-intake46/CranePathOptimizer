<UserControl x:Class="WPF_IFC_test1.ProjectListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#CCCCCC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with "Project list" text -->
        <Border Grid.Row="0" Background="Transparent" Padding="40,20">
            <StackPanel>
                <TextBlock Text="Project list" 
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#333333"/>
                <TextBlock Text="0 Projects" 
                           FontSize="12"
                           Foreground="#666666"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Large "Project List" Watermark -->
            <TextBlock Text="Project List" 
                       FontSize="120"
                       FontWeight="Bold"
                       Foreground="#999999"
                       Opacity="0.2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Content -->
            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                <TextBlock Text="📋" 
                           FontSize="80"
                           HorizontalAlignment="Center"
                           Opacity="0.3"
                           Margin="0,0,0,20"/>

                <TextBlock Text="No projects available" 
                           FontSize="16"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Create Project Button -->
                <Button Content="+ Create project"
                        Background="#666666"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="20,12"
                        FontSize="14"
                        Cursor="Hand"
                        Click="CreateProject_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               CornerRadius="3"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                             VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#555555"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Footer with buttons -->
        <Border Grid.Row="2" Background="Transparent">
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Left"
                       Margin="40,20">
                <Button Content="🔄 Update list"
                        Background="Transparent"
                        Foreground="#333333"
                        BorderThickness="1"
                        BorderBrush="#999999"
                        Padding="15,8"
                        FontSize="12"
                        Cursor="Hand"
                        Margin="0,0,15,0"
                        Click="UpdateList_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="3"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                             VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EEEEEE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="🔑 License info"
                        Background="Transparent"
                        Foreground="#333333"
                        BorderThickness="1"
                        BorderBrush="#999999"
                        Padding="15,8"
                        FontSize="12"
                        Cursor="Hand"
                        Click="LicenseInfo_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="3"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                             VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EEEEEE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
