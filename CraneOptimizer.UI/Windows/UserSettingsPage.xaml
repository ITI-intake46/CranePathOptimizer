<Window x:Class="WPF_IFC_test1.UserSettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Settings"
        Height="800" Width="1400"
        WindowState="Maximized"
        Background="#1E1E1E"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="YellowSidebar" Color="#2D2D30"/>
        <SolidColorBrush x:Key="YellowHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="GrayBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DarkBg" Color="#252526"/>
        <SolidColorBrush x:Key="TextDark" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextLight" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ActiveBadge" Color="#2E7D32"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFB900"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>
        <SolidColorBrush x:Key="CardBg" Color="#2D2D30"/>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource YellowHover}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Selected Sidebar Button -->
        <Style x:Key="SelectedSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#094771"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                        Grid.Column="2"
                                        Focusable="false"
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press"
                                        Background="#252526"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left"
                                                                Content="{TemplateBinding Content}"/>
                                                <TextBlock Grid.Column="1"
                                                          Text="▼"
                                                          FontSize="10"
                                                          Foreground="#CCCCCC"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                            IsHitTestVisible="False"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            Margin="10,0,30,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                  Placement="Bottom"
                                  IsOpen="{TemplateBinding IsDropDownOpen}"
                                  AllowsTransparency="True"
                                  Focusable="False"
                                  PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                     SnapsToDevicePixels="True"
                                     MinWidth="{TemplateBinding ActualWidth}"
                                     MaxHeight="200">
                                    <Border x:Name="DropDownBorder"
                                           Background="#252526"
                                           BorderBrush="{StaticResource BorderColor}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Margin="0,4,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                               Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource YellowSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#252526" Padding="15,0">
                    <TextBlock Text="PROJECT OVERVIEW" 
                               Foreground="{StaticResource TextLight}" 
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Menu Buttons -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button Content="⚙️ Application settings" 
                            Style="{StaticResource SidebarButton}"
                            Click="ApplicationSettings_Click"/>
                    <Button Content="👤 User settings" 
                            Style="{StaticResource SelectedSidebarButton}"/>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#252526" Padding="15,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 mustafa abdo" 
                                   Foreground="{StaticResource TextLight}" 
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,20,0"/>
                        <TextBlock Text="🔑 License info" 
                                   Foreground="{StaticResource TextLight}" 
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="LicenseInfo_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT -->
        <Grid Grid.Column="1" Background="{StaticResource GrayBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="#252526"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="User Settings" 
                               Foreground="{StaticResource TextDark}"
                               VerticalAlignment="Center"
                               Margin="15,0"
                               FontSize="13"/>

                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Right">
                        <Button Content="—" 
                                Width="45" Height="40"
                                Background="Transparent"
                                Foreground="{StaticResource TextLight}"
                                BorderThickness="0"
                                Click="MinimizeWindow_Click"
                                Cursor="Hand"/>
                        <Button Content="☐" 
                                Width="45" Height="40"
                                Background="Transparent"
                                Foreground="{StaticResource TextLight}"
                                BorderThickness="0"
                                Click="MaximizeWindow_Click"
                                Cursor="Hand"/>
                        <Button Content="✕" 
                                Width="45" Height="40"
                                Background="Transparent"
                                Foreground="{StaticResource TextLight}"
                                BorderThickness="0"
                                Click="CloseWindow_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E81123"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="50,40" MaxWidth="800" HorizontalAlignment="Left">

                    <!-- Header -->
                    <TextBlock Text="User settings" 
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,40"/>

                    <!-- User Information Section -->
                    <TextBlock Text="User information" 
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,15"/>

                    <Border Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="25"
                            Margin="0,0,0,30">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="User ID:" 
                                           Width="200"
                                           FontSize="13"
                                           Foreground="{StaticResource TextLight}"/>
                                <TextBlock x:Name="UserIdText"
                                           Text="ispgt71e@uiebehrr.extranet" 
                                           FontSize="13"
                                           Foreground="{StaticResource TextDark}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Name:" 
                                           Width="200"
                                           FontSize="13"
                                           Foreground="{StaticResource TextLight}"/>
                                <TextBlock x:Name="UserNameText"
                                           Text="mustafa abdo" 
                                           FontSize="13"
                                           Foreground="{StaticResource TextDark}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Offline available until:" 
                                           Width="200"
                                           FontSize="13"
                                           Foreground="{StaticResource TextLight}"/>
                                <TextBlock x:Name="OfflineUntilText"
                                           Text="01/13/2026 17:13:40 +02:00" 
                                           FontSize="13"
                                           Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- License Information Section -->
                    <TextBlock Text="License information" 
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextDark}"
                               Margin="0,0,0,15"/>

                    <Border Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="25"
                            Margin="0,0,0,40">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔑" 
                                       FontSize="32"
                                       VerticalAlignment="Center"
                                       Margin="0,0,20,0"/>
                            <TextBlock Text="Crane Planner Free" 
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDark}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>
                            <Border Background="{StaticResource ActiveBadge}"
                                    CornerRadius="4"
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✓ ACTIVE" 
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Logout Button -->
                    <Button Content="⏻ Logout" 
                            Width="150"
                            Height="40"
                            HorizontalAlignment="Left"
                            Background="#D32F2F"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Logout_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                 VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#B71C1C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Right Status -->
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="30,0,30,30"
                       Opacity="0.8">
                <TextBlock Text="🌐 Connection quality: good" 
                           FontSize="11"
                           Foreground="{StaticResource TextLight}"
                           Margin="0,0,15,0"/>
                <Border Background="#4CAF50"
                        CornerRadius="3"
                        Padding="8,4">
                    <TextBlock Text="✓ Active" 
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
