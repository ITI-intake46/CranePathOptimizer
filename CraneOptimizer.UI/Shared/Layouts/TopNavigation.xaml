<UserControl
    x:Class="CraneOptimizer.UI.Shared.Layouts.TopNavigation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AnalyzeViews="clr-namespace:CraneOptimizer.UI.Features.F8_GAOptimizer.Views"
    xmlns:CraneViews="clr-namespace:CraneOptimizer.UI.Features.F3_CraneSetup.Views"
    xmlns:DxfViews="clr-namespace:CraneOptimizer.UI.Features.F11_DXF.Views"
    xmlns:F9Views="clr-namespace:CraneOptimizer.UI.Features.F9_Settings.Views"
    xmlns:IfcViews="clr-namespace:CraneOptimizer.UI.Features.F2_IfcViewer.Views"
    xmlns:ZonesViews="clr-namespace:CraneOptimizer.UI.Features.F7_Zones.Views"
    xmlns:F18Views="clr-namespace:CraneOptimizer.UI.Features.F18_CoordinateReference.Views"
    xmlns:project="clr-namespace:CraneOptimizer.UI.F10_ProjectManagement.Views"
    xmlns:ReportViews="clr-namespace:CraneOptimizer.UI.Features.F12_Reports.Views"
    xmlns:config="clr-namespace:CraneOptimizer.UI.Core.Configuration"
    xmlns:AiAdvisorViews="clr-namespace:CraneOptimizer.AI.Views;assembly=CraneOptimizer.AI">

    <Border
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <!--  Tab selector strip  -->
                <RowDefinition Height="120" />
                <!--  Tab content area  -->
            </Grid.RowDefinitions>

            <!--  â”€â”€ ROW 0: Tab selector strip â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
            <Border
                Grid.Row="0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel VerticalAlignment="Stretch" Orientation="Horizontal">

                    <RadioButton
                        x:Name="TabHome"
                        Checked="Tab_Checked"
                        Content="HOME"
                        GroupName="RibbonTabs"
                        IsChecked="True"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabIFC"
                        Checked="Tab_Checked"
                        Content="IFC MODEL"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabDXF"
                        Checked="Tab_Checked"
                        Content="DXF"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabCranes"
                        Checked="Tab_Checked"
                        Content="CRANES"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabZones"
                        Checked="Tab_Checked"
                        Content="ZONES"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabAnalyze"
                        Checked="Tab_Checked"
                        Content="ANALYZE"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabReports"
                        Checked="Tab_Checked"
                        Content="REPORTS"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />
                    <RadioButton
                        x:Name="TabAiCopilot"
                        Checked="Tab_Checked"
                        Content="AI COPILOT"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <!-- Temporarily hidden by product decision. Keep logic intact for future re-enable. -->
                    <RadioButton
                        x:Name="TabSettings"
                        Checked="Tab_Checked"
                        Content="SETTINGS"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}"
                        Visibility="{Binding Source={x:Static config:AppFeatureFlags.ShowSettingsTab}, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Temporarily hidden by product decision. Keep logic intact for future re-enable. -->
                    <RadioButton
                        x:Name="TabCoordinateReference"
                        Checked="Tab_Checked"
                        Content="COORDINATE REFERENCE"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}"
                        Visibility="{Binding Source={x:Static config:AppFeatureFlags.ShowCoordinateReferenceUi}, Converter={StaticResource BoolToVisibilityConverter}}" />

                </StackPanel>
            </Border>

            <!--  â”€â”€ ROW 1: Tab content â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
            <Grid Grid.Row="1">

                <!--  â”€â”€ HOME tab â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
                <project:HomeTabView x:Name="PanelHome" Visibility="Visible" />

                <!--  â”€â”€ IFC MODEL tab â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
                <IfcViews:IfcTabView x:Name="PanelIFC" Visibility="Collapsed" />

                <!--  â”€â”€ DXF tab â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
                <DxfViews:DXFTabView x:Name="PanelDXF" Visibility="Collapsed" />

                <!--  â”€â”€ CRANES tab â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
                <CraneViews:CranesTabView x:Name="PanelCranes" DataContext="{Binding}" Visibility="Collapsed" />

                <!--  â”€â”€ ZONES tab â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
                <ZonesViews:ZonesTabView x:Name="PanelZones" Visibility="Collapsed" />

                <!--  â”€â”€ ANALYZE tab â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
                <AnalyzeViews:AnalyzeTabView
                    x:Name="PanelAnalyze"
                    DataContext="{Binding CranePlacement}"
                    Visibility="Collapsed" />

                <!--  â”€â”€ REPORTS tab â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
                <ReportViews:ReportsTabView
                    x:Name="PanelReports"
                    DataContext="{Binding CranePlacement}"
                    Visibility="Collapsed" />
                <AiAdvisorViews:AiAdvisorTabView
                    x:Name="PanelAiCopilot"
                    Visibility="Collapsed" />

                <!-- Temporarily hidden by product decision. Keep logic intact for future re-enable. -->
                <F9Views:UserSettingsView x:Name="PanelSettings" Visibility="{Binding Source={x:Static config:AppFeatureFlags.ShowSettingsTab}, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Temporarily hidden by product decision. Keep logic intact for future re-enable. -->
                <F18Views:CoordinateReferenceView x:Name="PanelCoordinateReference" DataContext="{Binding CoordinateReference}" Visibility="{Binding Source={x:Static config:AppFeatureFlags.ShowCoordinateReferenceUi}, Converter={StaticResource BoolToVisibilityConverter}}" />

            </Grid>
        </Grid>
    </Border>
</UserControl>


