<UserControl
    x:Class="CraneOptimizer.UI.Shared.Layouts.TopNavigation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AnalyzeViews="clr-namespace:CraneOptimizer.UI.Features.F8_GAOptimizer.Views"
    xmlns:CraneViews="clr-namespace:CraneOptimizer.UI.Features.F3_CraneSetup.Views"
    xmlns:DxfViews="clr-namespace:CraneOptimizer.UI.Features.F11_DXF.Views"
    xmlns:F9Views="clr-namespace:CraneOptimizer.UI.Features.F9_Settings.Views"
    xmlns:IfcViews="clr-namespace:CraneOptimizer.UI.Features.F2_IfcViewer.Views"
    xmlns:ZonesViews="clr-namespace:CraneOptimizer.UI.Features.F7_Zones.Views"
    xmlns:F18Views="clr-namespace:CraneOptimizer.UI.Features.F18_CoordinateReference.Views"
    xmlns:project="clr-namespace:CraneOptimizer.UI.F10_ProjectManagement.Views"
    xmlns:ReportViews="clr-namespace:CraneOptimizer.UI.Features.F12_Reports.Views">

    <Border
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <!--  Tab selector strip  -->
                <RowDefinition Height="120" />
                <!--  Tab content area  -->
            </Grid.RowDefinitions>

            <!--  ── ROW 0: Tab selector strip ────────────────────────────────  -->
            <Border
                Grid.Row="0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel VerticalAlignment="Stretch" Orientation="Horizontal">

                    <RadioButton
                        x:Name="TabHome"
                        Checked="Tab_Checked"
                        Content="HOME"
                        GroupName="RibbonTabs"
                        IsChecked="True"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabIFC"
                        Checked="Tab_Checked"
                        Content="IFC MODEL"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabDXF"
                        Checked="Tab_Checked"
                        Content="DXF"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabCranes"
                        Checked="Tab_Checked"
                        Content="CRANES"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabZones"
                        Checked="Tab_Checked"
                        Content="ZONES"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabAnalyze"
                        Checked="Tab_Checked"
                        Content="ANALYZE"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabReports"
                        Checked="Tab_Checked"
                        Content="REPORTS"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabSettings"
                        Checked="Tab_Checked"
                        Content="SETTINGS"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                    <RadioButton
                        x:Name="TabCoordinateReference"
                        Checked="Tab_Checked"
                        Content="COORDINATE REFERENCE"
                        GroupName="RibbonTabs"
                        Style="{StaticResource RibbonTabBtn}" />

                </StackPanel>
            </Border>

            <!--  ── ROW 1: Tab content ────────────────────────────────────────  -->
            <Grid Grid.Row="1">

                <!--  ── HOME tab ───────────────────────────────────────────────  -->
                <project:HomeTabView x:Name="PanelHome" Visibility="Visible" />

                <!--  ── IFC MODEL tab ───────────────────────────────────────────  -->
                <IfcViews:IfcTabView x:Name="PanelIFC" Visibility="Collapsed" />

                <!--  ── DXF tab ─────────────────────────────────────────────────  -->
                <DxfViews:DXFTabView x:Name="PanelDXF" Visibility="Collapsed" />

                <!--  ── CRANES tab ──────────────────────────────────────────────  -->
                <CraneViews:CranesTabView x:Name="PanelCranes" DataContext="{Binding}" Visibility="Collapsed" />

                <!--  ── ZONES tab ───────────────────────────────────────────────  -->
                <ZonesViews:ZonesTabView x:Name="PanelZones" Visibility="Collapsed" />

                <!--  ── ANALYZE tab ─────────────────────────────────────────────  -->
                <AnalyzeViews:AnalyzeTabView
                    x:Name="PanelAnalyze"
                    DataContext="{Binding CranePlacement}"
                    Visibility="Collapsed" />

                <!--  ── REPORTS tab ────────────────────────────────────────────────  -->
                <ReportViews:ReportsTabView
                    x:Name="PanelReports"
                    DataContext="{Binding CranePlacement}"
                    Visibility="Collapsed" />

                <F9Views:UserSettingsView x:Name="PanelSettings" Visibility="Collapsed" />

                <F18Views:CoordinateReferenceView x:Name="PanelCoordinateReference" DataContext="{Binding CoordinateReference}" Visibility="Collapsed" />

            </Grid>
        </Grid>
    </Border>
</UserControl>
