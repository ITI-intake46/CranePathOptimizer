<UserControl
    x:Class="CraneOptimizer.AI.Companion.Views.AiCompanionStatusStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="360"
    MaxWidth="720"
    Height="22"
    Focusable="False">

    <Border
        Padding="8,0"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1,0,1,0"
        CornerRadius="0">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox
                Grid.Column="0"
                Width="12"
                Height="12"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                Stretch="Uniform">
                <Path
                    Data="M 4,10 C 4,8.34 5.34,7 7,7 H 17 C 18.66,7 20,8.34 20,10 V 18 C 20,19.1 19.1,20 18,20 H 6 C 4.9,20 4,19.1 4,18 Z M 12,7 V 4 M 10,4 H 14 M 9,12 V 14 M 15,12 V 14 M 8,17 H 16"
                    Stroke="{StaticResource PrimaryBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6" />
            </Viewbox>

            <TextBlock
                Grid.Column="1"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeXS}"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryBrush}"
                Text="AI" />

            <TextBlock
                Grid.Column="2"
                MaxWidth="210"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeXS}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding MissionRootCause}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ClipToBounds="True"
                ToolTip="{Binding MissionRootCause}" />

            <Button
                Grid.Column="3"
                MinWidth="52"
                Height="18"
                Margin="8,0,0,0"
                Padding="7,0"
                AutomationProperties.Name="Open AI Assist"
                Click="AssistButton_Click"
                Content="Open"
                FontSize="{StaticResource FontSizeXS}"
                Style="{StaticResource ToolbarButton}"
                ToolTip="Open AI Assist for the full diagnosis, evidence, recommended action, and local-model tools."
                ToolTipService.ShowOnDisabled="True" />

            <Button
                Grid.Column="4"
                Width="18"
                Height="18"
                Margin="4,0,0,0"
                Padding="0"
                AutomationProperties.Name="Hide AI Companion"
                Click="HideButton_Click"
                Content="&#x00D7;"
                FontSize="11"
                FontWeight="Bold"
                Style="{StaticResource ToolbarButton}"
                ToolTip="Hide AI Companion from the status bar"
                ToolTipService.ShowOnDisabled="True" />
        </Grid>
    </Border>
</UserControl>
