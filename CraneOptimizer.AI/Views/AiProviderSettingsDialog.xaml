<Window x:Class="CraneOptimizer.AI.Views.AiProviderSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Provider Settings"
        Width="640" Height="720" MinWidth="580" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Configure AI provider" />
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="Cloud providers use your own API key. Keys are stored in Windows Credential Manager and never written to the settings JSON, logs, copied context, or Git." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,14" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Provider" />
                <TextBlock x:Name="ProviderNameText" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" />

                <TextBlock Grid.Row="1" Margin="0,14,12,0" VerticalAlignment="Center" Text="Base URL" />
                <TextBox x:Name="BaseUrlTextBox" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" />

                <TextBlock Grid.Row="2" Margin="0,10,12,0" VerticalAlignment="Center" Text="Chat path" />
                <TextBox x:Name="ChatPathTextBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" />

                <TextBlock Grid.Row="3" Margin="0,10,12,0" VerticalAlignment="Center" Text="Models path" />
                <TextBox x:Name="ModelsPathTextBox" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" />

                <TextBlock Grid.Row="4" Margin="0,10,12,0" VerticalAlignment="Center" Text="Default model" />
                <TextBox x:Name="DefaultModelTextBox" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" />

                <TextBlock Grid.Row="5" Margin="0,10,12,0" VerticalAlignment="Center" Text="Authentication" />
                <ComboBox x:Name="AuthenticationComboBox" Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" SelectionChanged="AuthenticationComboBox_SelectionChanged">
                    <ComboBoxItem Content="Bearer" />
                    <ComboBoxItem Content="ApiKeyHeader" />
                    <ComboBoxItem Content="None" />
                </ComboBox>

                <TextBlock Grid.Row="6" Margin="0,10,12,0" VerticalAlignment="Center" Text="API-key header" />
                <TextBox x:Name="ApiKeyHeaderTextBox" Grid.Row="6" Grid.Column="1" Margin="0,10,0,0" />

                <TextBlock x:Name="ApiKeyLabel" Grid.Row="7" Margin="0,10,12,0" VerticalAlignment="Center" Text="API key" />
                <Grid x:Name="ApiKeyGrid" Grid.Row="7" Grid.Column="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyPasswordBox" ToolTip="Leave blank to keep the currently stored key." />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,4" Click="RemoveKey_Click" Content="Remove key" />
                </Grid>

                <TextBlock Grid.Row="8" Margin="0,10,12,0" VerticalAlignment="Center" Text="App URL header" />
                <TextBox x:Name="AppUrlTextBox" Grid.Row="8" Grid.Column="1" Margin="0,10,0,0" ToolTip="Optional HTTP-Referer value used by providers such as OpenRouter." />

                <TextBlock Grid.Row="9" Margin="0,10,12,0" VerticalAlignment="Center" Text="App title header" />
                <TextBox x:Name="AppTitleTextBox" Grid.Row="9" Grid.Column="1" Margin="0,10,0,0" ToolTip="Optional X-OpenRouter-Title value." />


                <TextBlock Grid.Row="10" Margin="0,10,12,0" VerticalAlignment="Top" Text="Additional headers" />
                <TextBox x:Name="AdditionalHeadersTextBox" Grid.Row="10" Grid.Column="1" Margin="0,10,0,0" MinHeight="72"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         ToolTip="Optional non-secret request headers, one per line as Header=Value. Authentication, token, secret, credential, and Content-Type header names are blocked; use the protected API-key controls." />

                <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Margin="0,18,0,0">
                    <CheckBox x:Name="ModelDiscoveryCheckBox" Content="Discover model IDs from the provider when supported" />
                    <CheckBox x:Name="StreamingCheckBox" Margin="0,8,0,0" Content="Enable streaming responses" />
                    <CheckBox x:Name="SendTemperatureCheckBox" Margin="0,8,0,0" Content="Send the temperature parameter (disable for models that reject it)" />
                    <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Left" Padding="16,6" Click="TestConnection_Click" Content="Save and test" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button MinWidth="82" Margin="0,0,8,0" IsCancel="True" Content="Cancel" />
                <Button MinWidth="82" IsDefault="True" Click="Save_Click" Content="Save" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
