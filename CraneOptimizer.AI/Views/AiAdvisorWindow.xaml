<Window
    x:Class="CraneOptimizer.AI.Views.AiAdvisorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rendering="clr-namespace:CraneOptimizer.AI.Rendering"
    Title="AI Optimization Studio"
    Width="1360"
    Height="820"
    MinWidth="1000"
    MinHeight="640"
    Background="{DynamicResource BackgroundBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="AiSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource PropertyLabel}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <Style x:Key="AiCard" TargetType="Border">
            <Setter Property="Padding" Value="11" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>

        <Style x:Key="AiSoftCard" TargetType="Border" BasedOn="{StaticResource AiCard}">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        </Style>

        <Style x:Key="AiPill" TargetType="Border">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="AiComposerTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MaxHeight" Value="78" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style x:Key="AiComposerActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.92" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="AiEditableModelComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="IsTextSearchEnabled" Value="True" />
            <Setter Property="StaysOpenOnEdit" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ModelSelectorBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="ModelSelectionPresenter"
                                                      Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" />

                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Margin="1"
                                             Padding="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             CaretBrush="{StaticResource PrimaryBrush}"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontFamily="{TemplateBinding FontFamily}"
                                             FontSize="{TemplateBinding FontSize}"
                                             Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="Hidden" />

                                    <ToggleButton x:Name="ModelDropDownToggle"
                                                  Grid.Column="1"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Click="ModelDropDownToggle_Click"
                                                  ClickMode="Press"
                                                  Cursor="Hand"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ToolTip="Show discovered model IDs">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Path Width="8"
                                                          Height="5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 4 4 L 8 0"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1.5" />
                                                </Grid>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ModelSelectionPresenter" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModelSelectorBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ModelSelectorBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModelSelectorBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiProviderActionButton" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="6,6,6,4" Padding="10" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Margin="0,0,10,0" Background="{StaticResource PrimaryBrush}" CornerRadius="17">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="White" Text="AI" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="AI Optimization Studio" />
                        <WrapPanel Margin="0,5,0,0">
                            <Border Style="{StaticResource AiPill}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding SelectedModelLabel}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Style="{StaticResource AiPill}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding HistoryCountLabel}" />
                            </Border>
                            <Border Style="{StaticResource AiPill}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="Advisory only" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button MinWidth="76" Margin="0,0,5,0" Command="{Binding AnalyzeCurrentResultCommand}" Content="Refresh" Style="{StaticResource ButtonSecondary}" ToolTip="Refresh deterministic result and workflow context." />
                    <Button MinWidth="96" Margin="0,0,5,0" Command="{Binding CopyContextCommand}" Content="Copy Context" Style="{StaticResource ButtonSecondary}" ToolTip="Copy the exact context payload used by the AI." />
                    <Button MinWidth="78" Margin="0,0,5,0" Command="{Binding ExportAnswerCommand}" Content="Export MD" Style="{StaticResource ButtonSecondary}" ToolTip="Export the current AI response as Markdown." />
                    <Button MinWidth="120" Command="{Binding ExportReportAppendixCommand}" Content="Report Appendix" Style="{StaticResource ButtonPrimary}" ToolTip="Export the current AI response as a report appendix with safety disclaimer and context snapshot." />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="6,0,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="276" MinWidth="242" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource AiCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AiSectionLabel}" Text="ADVISOR" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="Health" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding HealthLabel}" />
                        </StackPanel>
                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18" Text="{Binding AdvisorSummary}" TextWrapping="Wrap" />

                        <Expander Margin="0,12,0,0" Header="Deterministic recommendations" IsExpanded="True">
                            <ScrollViewer MaxHeight="134"
                                          Margin="0,8,0,0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly"
                                          VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{Binding Recommendations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding Severity}" />
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding SuggestedAction}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource AiCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AiSectionLabel}" Text="QUICK QUESTIONS" />
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" Text="safe prompts" />
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Margin="0,0,6,6" Command="{Binding SetQuickQuestionCommand}" CommandParameter="What can this software do and what should I click first?" Content="Start here" Style="{StaticResource ButtonSecondary}" />
                            <Button Margin="0,0,6,6" Command="{Binding SetQuickQuestionCommand}" CommandParameter="Guide me step-by-step from IFC import to an optimization report using exact tab and button names." Content="IFC → Report" Style="{StaticResource ButtonSecondary}" />
                            <Button Margin="0,0,6,6" Command="{Binding SetQuickQuestionCommand}" CommandParameter="Diagnose the current workflow readiness and produce Status, Evidence, Recommendation, Next Click, Risk, and Confidence." Content="Readiness" Style="{StaticResource ButtonSecondary}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource AiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AiSectionLabel}" Text="RECENT ANSWERS" />
                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Restore a prior question and answer." TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="56" Command="{Binding ClearHistoryCommand}" Content="Clear" Style="{StaticResource ButtonSecondary}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="No saved answers yet." TextWrapping="Wrap" Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding ResponseHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,7" Padding="10" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectHistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ButtonSecondary}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="16" MaxHeight="48" Text="{Binding Preview}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="104" MinHeight="76" MaxHeight="210" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="178" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource AiSectionLabel}" Text="PROVIDER" />
                        <ComboBox Grid.Column="1" Margin="10,0,14,0" VerticalAlignment="Center"
                                  DisplayMemberPath="DisplayName" ItemsSource="{Binding Providers}"
                                  SelectedValuePath="Id" SelectedValue="{Binding SelectedProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource AiSectionLabel}" Text="MODEL" />
                        <ComboBox x:Name="ModelSelector"
                                  Grid.Column="3"
                                  Margin="10,0,14,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding InstalledModels}"
                                  SelectedItem="{Binding SelectedDiscoveredModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource AiEditableModelComboBox}"
                                  Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{Binding ModelName}" />
                        <StackPanel Grid.Column="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button Command="{Binding CheckOllamaCommand}"
                                    Content="Check"
                                    Style="{StaticResource AiProviderActionButton}"
                                    ToolTip="Test the selected provider and discover model IDs where supported." />
                            <Button Command="{Binding ConfigureProviderCommand}"
                                    Content="Configure"
                                    Style="{StaticResource AiProviderActionButton}"
                                    ToolTip="Configure endpoint, protected API key, model discovery, and streaming." />
                            <Button Command="{Binding BenchmarkModelsCommand}"
                                    Content="Benchmark"
                                    Style="{StaticResource AiProviderActionButton}"
                                    ToolTip="Benchmark selected or discovered models without including project data." />
                            <Button Command="{Binding PullModelCommand}"
                                    Content="Pull"
                                    IsEnabled="{Binding CanPullModel}"
                                    Margin="0"
                                    Style="{StaticResource AiProviderActionButton}"
                                    ToolTip="Pull the selected model into local Ollama. Cloud models are not downloaded."
                                    Visibility="{Binding IsOllamaSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="5" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ProviderModeLabel}" />
                            <TextBlock MaxWidth="260" Margin="0,2,0,0" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ProviderPrivacyLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProviderPrivacyLabel}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource AiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AiSectionLabel}" Text="ANSWER" />
                                <TextBlock Margin="0,4,12,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Provider-neutral Markdown response. Audit details stay collapsed unless you need evidence, context, docs, or benchmarks." TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Margin="14,0,0,0">
                                <Button Margin="0,0,6,0" Command="{Binding CopyAnswerCommand}" Content="Copy" Style="{StaticResource ButtonSecondary}" />
                                <Button Margin="0,0,6,0" Command="{Binding ExportAnswerCommand}" Content="Export" Style="{StaticResource ButtonSecondary}" />
                                <Button Command="{Binding ExportReportAppendixCommand}" Content="Report Appendix" Style="{StaticResource ButtonSecondary}" />
                            </WrapPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                            <rendering:MarkdownPreviewControl Markdown="{Binding AiAnswer, Mode=OneWay}" />
                        </Border>

                        <Expander Grid.Row="2" Margin="0,9,0,0" Header="Audit details: Context Cards, raw Markdown, evidence, local docs, and benchmarks" IsExpanded="False">
                            <TabControl Height="226" Margin="0,8,0,0">
                                <TabItem Header="Context Cards">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl Margin="10" ItemsSource="{Binding ContextCards}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Text="{Binding Value}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Agent Run">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding AgentExecutionLabel}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AgentConclusion}" TextWrapping="Wrap" />
                                        <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding AgentExecutionTrace}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding Sequence}" />
                                                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontWeight="SemiBold" Text="{Binding ToolName}" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="2" Margin="8,0,0,0" Foreground="{StaticResource PrimaryBrush}" Text="{Binding StatusLabel}" />
                                                                    </Grid>
                                                                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Purpose}" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,4,0,0" FontSize="11" Text="{Binding Summary}" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Governance}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AgentGovernanceSummary}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,10,0,5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding AgentActionsLabel}" TextWrapping="Wrap" Visibility="{Binding AgentActionsVisibility}" />
                                                <ItemsControl ItemsSource="{Binding AgentActionProposals}" Visibility="{Binding AgentActionsVisibility}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                                <StackPanel>
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EvidenceLabel}" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Risk}" TextWrapping="Wrap" />
                                                                    <Expander Margin="0,6,0,0" Header="Review details" Visibility="{Binding RequiresExplicitApproval, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <StackPanel Margin="0,6,0,0">
                                                                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="Impact" />
                                                                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Impact}" TextWrapping="Wrap" />
                                                                            <TextBlock Margin="0,6,0,0" FontSize="10" FontWeight="SemiBold" Text="Reversibility" />
                                                                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Reversibility}" TextWrapping="Wrap" />
                                                                            <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ApprovalScope}" TextWrapping="Wrap" />
                                                                            <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ToolArgumentsLabel}" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Expander>
                                                                    <WrapPanel Margin="0,7,0,0">
                                                                        <Button Margin="0,0,6,0" Command="{Binding DataContext.ExecuteAgentActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{Binding ApprovalLabel}" Style="{StaticResource ButtonPrimary}" />
                                                                        <Button Command="{Binding DataContext.RejectAgentActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Reject" Style="{StaticResource ButtonSecondary}" Visibility="{Binding RequiresExplicitApproval, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Margin="0,2,0,0" Padding="9" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding AgentActionAuditVisibility}">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding AgentActionAuditLabel}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AgentActionStatus}" TextWrapping="Wrap" />
                                                        <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding AgentActionAudit}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,6" Padding="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                                                        <StackPanel>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding ToolName}" TextWrapping="Wrap" />
                                                                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="9" Foreground="{StaticResource PrimaryBrush}" Text="{Binding AuditLabel}" />
                                                                            </Grid>
                                                                            <TextBlock Margin="0,3,0,0" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Summary}" TextWrapping="Wrap" />
                                                                            <TextBlock Margin="0,3,0,0" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Governance}" TextWrapping="Wrap" />
                                                                            <TextBlock Margin="0,3,0,0" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AuditMetadataLabel}" TextWrapping="Wrap" />
                                                                            <TextBlock Margin="0,3,0,0" FontSize="9" Foreground="{StaticResource PrimaryBrush}" Text="{Binding ArtifactLabel}" TextWrapping="Wrap" Visibility="{Binding HasArtifact, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            <TextBlock Margin="0,2,0,0" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ArtifactIntegrityLabel}" TextWrapping="Wrap" Visibility="{Binding HasArtifact, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="RAG Grounding">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding GroundingEvidenceLabel}" TextWrapping="Wrap" />
                                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding GroundingCitations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                                    <Run Foreground="{StaticResource PrimaryBrush}" Text="[" />
                                                                    <Run Foreground="{StaticResource PrimaryBrush}" Text="{Binding Id}" />
                                                                    <Run Foreground="{StaticResource PrimaryBrush}" Text="]" />
                                                                    <Run Text=" " />
                                                                    <Run Text="{Binding SourceLabel}" />
                                                                </TextBlock>
                                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Snippet}" TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ScoreLabel}" TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SourceLocator}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Prompt Templates">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectedPromptTemplateSummary}" TextWrapping="Wrap" />
                                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding PromptTemplates}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                                                            <Run Text="• " />
                                                            <Run FontWeight="SemiBold" Text="{Binding Title}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding AppliesWhen}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Raw Markdown">
                                    <TextBox Padding="10" AcceptsReturn="True" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalScrollBarVisibility="Disabled" IsReadOnly="True" Text="{Binding AiAnswer, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </TabItem>
                                <TabItem Header="Evidence">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl Margin="10" ItemsSource="{Binding Evidence}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,0,7" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Context JSON">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Padding="10" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ContextPreview}" TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Software Map">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Padding="10" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SoftwareGuideText}" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Local Docs">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Padding="10" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding LastDocumentContext}" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="XAML Inventory">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Padding="10" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding LastXamlInventory}" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Benchmarks">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding BenchmarkSummary}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ModelCapabilitySummary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ModelBenchmarks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                                                            <Run Text="• " />
                                                            <Run FontWeight="SemiBold" Text="{Binding Model}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding DisplayStatus}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Expander>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="Drag to resize the AI Studio prompt composer." />

                <Border Grid.Row="3" Padding="10" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AiSectionLabel}" Text="ASK AI STUDIO" />
                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Ask a workflow, result, safety, or report question. Private project context is attached automatically." TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Enter sends · Shift+Enter new line · drag top edge to resize" />
                        </Grid>

                        <Border Grid.Row="1" Margin="0,8,0,0" Padding="12,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid VerticalAlignment="Stretch">
                                    <TextBox x:Name="QuestionComposer" Style="{StaticResource AiComposerTextBox}" PreviewKeyDown="QuestionComposer_PreviewKeyDown" Text="{Binding UserQuestion, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,2,76,0" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" Text="Ask what to do next, why a result failed, or how to prepare a report…" TextWrapping="Wrap" Visibility="{Binding IsQuestionEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,10,0" MaxWidth="220" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ComposerStateText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <Button Command="{Binding ToggleOllamaCommand}" Content="{Binding ComposerActionText}" Style="{StaticResource AiComposerActionButton}" ToolTip="{Binding ComposerActionToolTip}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="6,0,6,6" Padding="7" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <TextBlock Margin="14,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding OllamaStatusText}" TextWrapping="Wrap" />
                    <TextBlock Margin="14,0,0,0" Foreground="Tomato" Text="{Binding LastError}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Margin="16,0,0,0" Padding="10,5" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Advisory only · engineering review required" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
