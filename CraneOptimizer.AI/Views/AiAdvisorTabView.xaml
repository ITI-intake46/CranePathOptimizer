<UserControl
    x:Class="CraneOptimizer.AI.Views.AiAdvisorTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0" Orientation="Horizontal">

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="AI COPILOT">
                <Button Click="OpenAdvisor_Click" ContentTemplate="{x:Null}" Style="{StaticResource RibbonMajorPrimaryCommandTile}">
                    <Button.Tag>
                        <TextBlock FontSize="22" Text="🤖" />
                    </Button.Tag>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Open Copilot" />
                </Button>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="RESULT CHECK">
                <UniformGrid Rows="1">
                    <Button
                        Command="{Binding AnalyzeCurrentResultCommand}"
                        Content="Analyze Current Result"
                        Style="{StaticResource RibbonMajorSecondaryCommandTile}"
                        Tag="🔎"
                        ToolTip="Analyze Current Result" />
                    <Button
                        Click="OpenAdvisor_Click"
                        Content="Ask Local Ollama"
                        FontWeight="SemiBold"
                        Style="{StaticResource RibbonMajorSecondaryCommandTile}"
                        Tag="💬" />
                </UniformGrid>
            </ContentControl>

            <Rectangle Margin="4,0" Style="{StaticResource RibbonSep}" />

            <Border
                Width="620"
                Margin="8,6,8,6"
                Padding="10"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="AI Studio:" />
                        <TextBlock FontWeight="SemiBold" Text="Mission Control آ· RAG آ· ModelOps آ· What-if آ· Reports" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                        <Border Margin="0,0,6,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="Agent stack" />
                        </Border>
                        <Border Margin="0,0,6,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="Grounded evidence" />
                        </Border>
                        <Border Margin="0,0,6,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="Local Ollama" />
                        </Border>
                        <Border Margin="0,0,0,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="Explainable trace" />
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Row="2" Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="Health:" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding HealthLabel}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="3"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding AdvisorSummary}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
