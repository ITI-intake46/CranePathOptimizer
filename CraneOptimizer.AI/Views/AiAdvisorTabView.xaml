<UserControl
    x:Class="CraneOptimizer.AI.Views.AiAdvisorTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <Border Padding="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock
                    Margin="4,0,0,6"
                    Style="{StaticResource PropertyLabel}"
                    Text="AI COPILOT" />

                <Button
                    Width="120"
                    Height="70"
                    Click="OpenAdvisor_Click"
                    Style="{StaticResource ButtonPrimary}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontSize="22" Text="🤖" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontWeight="SemiBold"
                            Text="Open Copilot" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,18,0">
                <TextBlock
                    Margin="4,0,0,6"
                    Style="{StaticResource PropertyLabel}"
                    Text="RESULT CHECK" />

                <Button
                    Margin="0,0,0,4"
                    Command="{Binding AnalyzeCurrentResultCommand}"
                    Content="🔎 Analyze Current Result"
                    Style="{StaticResource ButtonSecondary}" />

                <Button
                    Click="OpenAdvisor_Click"
                    Content="💬 Ask Local Ollama"
                    FontWeight="SemiBold"
                    Style="{StaticResource ButtonSecondary}" />
            </StackPanel>

            <Border
                Grid.Column="2"
                Padding="10"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="AI Studio:" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Mission Control · RAG · ModelOps · What-if · Reports" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                        <Border Margin="0,0,6,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="Agent stack" />
                        </Border>
                        <Border Margin="0,0,6,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="Grounded evidence" />
                        </Border>
                        <Border Margin="0,0,6,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="Local Ollama" />
                        </Border>
                        <Border Margin="0,0,0,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="Explainable trace" />
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Row="2" Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="Health:" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding HealthLabel}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="3"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding AdvisorSummary}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
