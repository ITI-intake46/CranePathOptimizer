<UserControl
    x:Class="CraneOptimizer.AI.Views.AiAdvisorTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource SurfaceBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0" Orientation="Horizontal">

            <ContentControl Style="{StaticResource RibbonSingleCommandGroup}" Tag="AI STUDIO">
                <Button
                    x:Name="OpenCopilotRibbonButton"
                    AutomationProperties.Name="Open full AI Studio"
                    Click="OpenAdvisor_Click"
                    Content="Open Full Studio"
                    Style="{StaticResource RibbonMajorCommandTile}"
                    ToolTip="Open the full AI Optimization Studio. Project context stays on this device unless you explicitly export or copy it."
                    ToolTipService.ShowOnDisabled="True">
                    <Button.Tag>
                        <Grid Width="24" Height="24">
                            <Path
                                Data="M 4,10 C 4,8.34 5.34,7 7,7 H 17 C 18.66,7 20,8.34 20,10 V 18 C 20,19.1 19.1,20 18,20 H 6 C 4.9,20 4,19.1 4,18 Z M 12,7 V 4 M 10,4 H 14 M 9,12 V 14 M 15,12 V 14 M 8,17 H 16"
                                Stroke="{DynamicResource TextSecondaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.6" />
                        </Grid>
                    </Button.Tag>
                </Button>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <ContentControl Style="{StaticResource RibbonCommandGroup}" Tag="RESULT CHECK">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="AnalyzeCurrentResultRibbonButton"
                        AutomationProperties.Name="Analyze current optimization result"
                        Command="{Binding AnalyzeCurrentResultCommand}"
                        Content="Analyze Current Result"
                        Style="{StaticResource RibbonMajorLeadingCommandTile}"
                        ToolTip="Analyze the current optimization result with local deterministic advisor rules. If no result is available, run the GA optimizer first."
                        ToolTipService.ShowOnDisabled="True"
                        Width="{StaticResource RibbonMajorLongCommandWidth}">
                        <Button.Tag>
                            <Grid Width="24" Height="24">
                                <Path
                                    Data="M 4,18 V 14 M 8,18 V 10 M 12,18 V 12 M 16,18 V 7 M 18.5,18.5 L 22,22 M 19,11 A 5,5 0 1 1 9,11 A 5,5 0 1 1 19,11"
                                    Stroke="{DynamicResource TextSecondaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.6" />
                            </Grid>
                        </Button.Tag>
                    </Button>
                    <Button
                        x:Name="AskLocalOllamaRibbonButton"
                        AutomationProperties.Name="Ask local Ollama"
                        Click="OpenAdvisor_Click"
                        Content="Ask Local Ollama"
                        Style="{StaticResource RibbonMajorTrailingCommandTile}"
                        ToolTip="Open AI Studio to ask the selected local Ollama model. If the action is unavailable, check Ollama and select an installed model in Studio."
                        ToolTipService.ShowOnDisabled="True">
                        <Button.Tag>
                            <Grid Width="24" Height="24">
                                <Path
                                    Data="M 5,5 H 19 C 20.1,5 21,5.9 21,7 V 15 C 21,16.1 20.1,17 19,17 H 11 L 6,21 V 17 H 5 C 3.9,17 3,16.1 3,15 V 7 C 3,5.9 3.9,5 5,5 Z M 7,9 H 17 M 7,13 H 14"
                                    Stroke="{DynamicResource TextSecondaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.6" />
                            </Grid>
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </ContentControl>

            <Rectangle Style="{StaticResource RibbonSep}" />

            <Border
                Width="620"
                Height="{StaticResource RibbonCommandGroupHeight}"
                Margin="8,0"
                Padding="10"
                VerticalAlignment="Top"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="AI Studio:" />
                        <TextBlock FontWeight="SemiBold" Text="Mission Control &#x2022; RAG &#x2022; ModelOps &#x2022; What-if &#x2022; Reports" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                        <Border Margin="0,0,6,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="Agent stack" />
                        </Border>
                        <Border Margin="0,0,6,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="Grounded evidence" />
                        </Border>
                        <Border Margin="0,0,6,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="Processing: local device" />
                        </Border>
                        <Border Margin="0,0,0,4" Padding="7,3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="Explainable trace" />
                        </Border>
                    </WrapPanel>

                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="Result status:" />
                        <TextBlock
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="{Binding HealthLabel}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="18,0,6,0"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="Local model:" />
                        <TextBlock
                            Grid.Column="3"
                            FontWeight="SemiBold"
                            Text="{Binding OllamaStatusText}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding OllamaStatusText}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="3"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding AdvisorSummary}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        ToolTip="{Binding AdvisorSummary}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
